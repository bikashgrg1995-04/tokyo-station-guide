
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tokyo-guide-jp",
  "account_id": "eaca2e3c15980fb95bc9f48578c08593",
  "main": "dist/server/entry.mjs",
  "compatibility_date": "2026-10-03",
  "assets": {
    "directory": "dist/client",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "tokyo-guide-jp-db",
      "database_id": "d8d94a48-4be7-4d01-98dd-6271337b7e42",
      "migrations_dir": "db/migrations"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "SESSION",
      "id": "eb15c0f8b7c94319bacfa80341e0d61b"
    }
  ],
  "images": {
    "binding": "IMAGES"
  }
}