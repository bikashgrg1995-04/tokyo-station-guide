---
import Button from "./Button.astro";
import ConfirmDialog from "./ConfirmDialog.astro";

interface Facility {
  id: number;
  name: string;
  slug: string;
  icon: string | null;
  sort_order: number;
  note?: string | null;
}

interface Props {
  stationName: string;
  assignedFacilities?: Facility[];
  availableFacilities: Facility[];
}

const {
  stationName,
  assignedFacilities = [],
  availableFacilities,
} = Astro.props;
---

<!-- ========================================
     Facilities
======================================== -->

<section class="admin-panel">

  <div class="admin-panel-body">

    <div class="admin-station-form">

      <!-- Header -->

      <div class="admin-station-form-header">

        <div
          style="
            display:flex;
            justify-content:space-between;
            align-items:center;
            gap:16px;
          "
        >

          <div>

            <h3>
              Facilities
            </h3>

            <p>
              Manage the facilities available at
              <strong>{stationName}</strong>.
              Changes are applied when you save the station.
            </p>

          </div>

          {
            availableFacilities.length > 0 && (
              <Button
                type="button"
                variant="primary"
                id="open-add-facility-button"
              >
                + Add Facility
              </Button>
            )
          }

        </div>

      </div>


      <!-- ========================================
           Temporary Facility Inputs
      ======================================== -->

      <div id="station-facility-inputs">

        {
          assignedFacilities.map(
            (facility) => (
              <input
                type="hidden"
                name="facility_ids"
                value={facility.id}
                data-facility-input={facility.id}
              />
            ),
          )
        }

      </div>


      <!-- ========================================
           Facility Table
      ======================================== -->

      <div class="admin-table-wrapper">

        <table
          class="admin-table"
          id="station-facilities-table"
        >

          <thead>

            <tr>

              <th>
                Facility
              </th>

              <th>
                Slug
              </th>

              <th>
                Actions
              </th>

            </tr>

          </thead>


          <tbody id="station-facilities-body">

            {
              assignedFacilities.length > 0 ? (

                assignedFacilities.map(
                  (facility) => (

                    <tr
                      data-facility-row
                      data-facility-id={facility.id}
                    >

                      <td>

                        <div class="admin-line-name">
                          {facility.name}
                        </div>

                      </td>

                      <td>

                        <span class="admin-line-slug">
                          {facility.slug}
                        </span>

                      </td>

                      <td>

                        <div class="admin-table-actions">

                          <button
                            type="button"
                            class="admin-table-action admin-table-action-delete"
                            data-remove-facility={facility.id}
                            data-facility-name={facility.name}
                          >
                            Remove
                          </button>

                        </div>

                      </td>

                    </tr>

                  ),
                )

              ) : (

                <tr id="station-facilities-empty-row">

                  <td colspan="3">

                    <div class="admin-empty">

                      <div class="admin-empty-icon">
                        ◦
                      </div>

                      <h3>
                        No Facilities Assigned
                      </h3>

                      <p>
                        There are currently no facilities
                        assigned to this station.
                      </p>

                    </div>

                  </td>

                </tr>

              )
            }

          </tbody>

        </table>

      </div>


      <!-- ========================================
           All Facilities Assigned
      ======================================== -->

      <p
        id="all-facilities-message"
        style="
          margin-top:12px;
          opacity:0.7;
        "
        hidden
      >
        All available facilities are already assigned
        to this station.
      </p>

    </div>

  </div>

</section>


<!-- ========================================
     Add Facilities Modal
======================================== -->

<div
  id="add-facility-modal"
  class="admin-line-station-modal"
  hidden
  aria-hidden="true"
>

  <div
    class="admin-line-station-modal-backdrop"
    data-close-add-facility-modal
  ></div>


  <div
    class="admin-line-station-modal-dialog"
    role="dialog"
    aria-modal="true"
    aria-labelledby="add-facility-modal-title"
    aria-describedby="add-facility-modal-description"
  >

    <!-- Modal Header -->

    <div class="admin-line-station-modal-header">

      <div>

        <h2 id="add-facility-modal-title">
          Add Facilities
        </h2>

        <p id="add-facility-modal-description">
          Select one or more facilities to add to
          {stationName}.
        </p>

      </div>


      <button
        type="button"
        class="admin-line-station-modal-close"
        id="close-add-facility-modal"
        aria-label="Close add facilities dialog"
      >
        ×
      </button>

    </div>


    <!-- ========================================
         Available Facilities
    ======================================== -->

    {
      availableFacilities.length > 0 ? (

        <div
          class="admin-form"
          id="add-facilities-form"
        >

          <div class="admin-facility-checkbox-grid">

            {
              availableFacilities.map(
                (facility) => (

                  <label
                    class="admin-facility-checkbox-item"
                    data-facility-option
                    data-facility-option-id={facility.id}
                  >

                    <input
                      type="checkbox"
                      value={facility.id}
                      class="add-facility-checkbox"
                      data-facility-id={facility.id}
                      data-facility-name={facility.name}
                      data-facility-slug={facility.slug}
                    />

                    <span>
                      {facility.name}
                    </span>

                  </label>

                ),
              )
            }

          </div>


          <!-- Selected Count -->

          <p
            id="selected-facility-count"
            style="
              margin-top:14px;
              opacity:0.7;
            "
          >
            0 facilities selected
          </p>


          <!-- Modal Actions -->

          <div class="admin-form-actions">

            <Button
              type="button"
              variant="secondary"
              id="cancel-add-facilities"
            >
              Cancel
            </Button>

            <Button
              type="button"
              variant="primary"
              id="add-selected-facilities"
              disabled
            >
              Add Selected
            </Button>

          </div>

        </div>

      ) : (

        <div class="admin-empty">

          <h3>
            No Facilities Available
          </h3>

          <p>
            All facilities from the master list are already
            assigned to this station.
          </p>

        </div>

      )
    }

  </div>

</div>


<!-- ========================================
     Remove Facility Confirmation
======================================== -->

<ConfirmDialog
  id="remove-facility-confirm-dialog"
  title="Remove Facility"
  description="Are you sure you want to remove this facility from the station?"
  confirmText="Remove"
  cancelText="Cancel"
  variant="danger"
/>


<script>
  /* ========================================
     Elements
  ======================================== */

  const addFacilityModal =
    document.getElementById(
      "add-facility-modal",
    );

  const openAddFacilityButton =
    document.getElementById(
      "open-add-facility-button",
    );

  const closeAddFacilityButton =
    document.getElementById(
      "close-add-facility-modal",
    );

  const cancelAddFacilitiesButton =
    document.getElementById(
      "cancel-add-facilities",
    );

  const closeAddFacilityBackdrop =
    document.querySelector(
      "[data-close-add-facility-modal]",
    );

  const facilityCheckboxes =
    document.querySelectorAll(
      ".add-facility-checkbox",
    );

  const selectedFacilityCount =
    document.getElementById(
      "selected-facility-count",
    );

  const addSelectedFacilitiesButton =
    document.getElementById(
      "add-selected-facilities",
    );

  const facilityBody =
    document.getElementById(
      "station-facilities-body",
    );

  const facilityInputs =
    document.getElementById(
      "station-facility-inputs",
    );

  const allFacilitiesMessage =
    document.getElementById(
      "all-facilities-message",
    );


  /* ========================================
     Helpers
  ======================================== */

  function facilityAlreadySelected(
    facilityId: number,
  ): boolean {
    return !!document.querySelector(
      `[data-facility-row][data-facility-id="${facilityId}"]`,
    );
  }


  function updateFacilityEmptyState(): void {

    if (
      !(facilityBody instanceof HTMLElement)
    ) {
      return;
    }

    const rows =
      facilityBody.querySelectorAll(
        "[data-facility-row]",
      );

    const emptyRow =
      document.getElementById(
        "station-facilities-empty-row",
      );

    if (rows.length === 0) {

      if (!emptyRow) {

        facilityBody.innerHTML = `
          <tr id="station-facilities-empty-row">
            <td colspan="3">
              <div class="admin-empty">

                <div class="admin-empty-icon">
                  ◦
                </div>

                <h3>
                  No Facilities Assigned
                </h3>

                <p>
                  There are currently no facilities
                  assigned to this station.
                </p>

              </div>
            </td>
          </tr>
        `;

      }

    } else {

      emptyRow?.remove();

    }
  }


  function updateAllFacilitiesMessage(): void {

    if (
      !(allFacilitiesMessage instanceof HTMLElement)
    ) {
      return;
    }

    const facilityOptions =
      document.querySelectorAll(
        "[data-facility-option]",
      );

    if (facilityOptions.length === 0) {
      allFacilitiesMessage.hidden = true;
      return;
    }

    const visibleOptions =
      Array.from(facilityOptions).filter(
        (option) =>
          option instanceof HTMLElement &&
          option.style.display !== "none",
      );

    allFacilitiesMessage.hidden =
      visibleOptions.length > 0;
  }


  function syncFacilityOptions(): void {

    const rows =
      document.querySelectorAll(
        "[data-facility-row]",
      );

    const selectedIds =
      new Set<number>();

    rows.forEach((row) => {

      if (!(row instanceof HTMLElement)) {
        return;
      }

      const facilityId = Number(
        row.dataset.facilityId,
      );

      if (
        Number.isInteger(facilityId) &&
        facilityId > 0
      ) {
        selectedIds.add(facilityId);
      }

    });


    facilityCheckboxes.forEach(
      (checkbox) => {

        if (
          !(checkbox instanceof HTMLInputElement)
        ) {
          return;
        }

        const facilityId = Number(
          checkbox.dataset.facilityId,
        );

        const selected =
          selectedIds.has(facilityId);

        checkbox.checked = false;
        checkbox.disabled = selected;

        const option =
          checkbox.closest(
            "[data-facility-option]",
          );

        if (
          option instanceof HTMLElement
        ) {
          option.style.display =
            selected
              ? "none"
              : "";
        }

      },
    );

    updateAllFacilitiesMessage();
  }


  function addFacilityToTable(
    facilityId: number,
    facilityName: string,
    facilitySlug: string,
  ): void {

    if (
      !(facilityBody instanceof HTMLElement) ||
      !(facilityInputs instanceof HTMLElement)
    ) {
      return;
    }

    if (
      facilityAlreadySelected(
        facilityId,
      )
    ) {
      return;
    }


    const row =
      document.createElement("tr");

    row.setAttribute(
      "data-facility-row",
      "",
    );

    row.setAttribute(
      "data-facility-id",
      String(facilityId),
    );


    row.innerHTML = `
      <td>
        <div class="admin-line-name">
          ${facilityName}
        </div>
      </td>

      <td>
        <span class="admin-line-slug">
          ${facilitySlug}
        </span>
      </td>

      <td>
        <div class="admin-table-actions">

          <button
            type="button"
            class="admin-table-action admin-table-action-delete"
            data-remove-facility="${facilityId}"
            data-facility-name="${facilityName}"
          >
            Remove
          </button>

        </div>
      </td>
    `;


    facilityBody.appendChild(row);


    const input =
      document.createElement("input");

    input.type = "hidden";
    input.name = "facility_ids";
    input.value = String(facilityId);

    input.setAttribute(
      "data-facility-input",
      String(facilityId),
    );


    facilityInputs.appendChild(input);


    updateFacilityEmptyState();
    syncFacilityOptions();

  }


  function removeFacilityFromTable(
    facilityId: number,
  ): void {

    const row =
      document.querySelector(
        `[data-facility-row][data-facility-id="${facilityId}"]`,
      );

    const input =
      document.querySelector(
        `[data-facility-input="${facilityId}"]`,
      );


    row?.remove();
    input?.remove();


    updateFacilityEmptyState();
    syncFacilityOptions();

  }


  /* ========================================
     Modal
  ======================================== */

  function openAddFacilityModal(): void {

    if (
      !(addFacilityModal instanceof HTMLDivElement)
    ) {
      return;
    }

    syncFacilityOptions();

    addFacilityModal.hidden = false;

    addFacilityModal.setAttribute(
      "aria-hidden",
      "false",
    );

    updateSelectedFacilityCount();

  }


  function closeAddFacilityModal(): void {

    if (
      !(addFacilityModal instanceof HTMLDivElement)
    ) {
      return;
    }

    facilityCheckboxes.forEach(
      (checkbox) => {

        if (
          checkbox instanceof HTMLInputElement
        ) {
          checkbox.checked = false;
        }

      },
    );

    updateSelectedFacilityCount();

    addFacilityModal.hidden = true;

    addFacilityModal.setAttribute(
      "aria-hidden",
      "true",
    );

  }


  function updateSelectedFacilityCount(): void {

    if (
      !(selectedFacilityCount instanceof HTMLElement)
    ) {
      return;
    }

    const selectedCount =
      document.querySelectorAll(
        ".add-facility-checkbox:checked",
      ).length;


    selectedFacilityCount.textContent =
      `${selectedCount} ${
        selectedCount === 1
          ? "facility"
          : "facilities"
      } selected`;


    if (
      addSelectedFacilitiesButton instanceof
      HTMLButtonElement
    ) {
      addSelectedFacilitiesButton.disabled =
        selectedCount === 0;
    }

  }


  openAddFacilityButton?.addEventListener(
    "click",
    openAddFacilityModal,
  );


  facilityCheckboxes.forEach(
    (checkbox) => {

      checkbox.addEventListener(
        "change",
        updateSelectedFacilityCount,
      );

    },
  );


  closeAddFacilityButton?.addEventListener(
    "click",
    closeAddFacilityModal,
  );


  cancelAddFacilitiesButton?.addEventListener(
    "click",
    closeAddFacilityModal,
  );


  closeAddFacilityBackdrop?.addEventListener(
    "click",
    closeAddFacilityModal,
  );


  /* ========================================
     Add Selected
  ======================================== */

  addSelectedFacilitiesButton?.addEventListener(
    "click",
    () => {

      const selectedCheckboxes =
        Array.from(
          facilityCheckboxes,
        ).filter(
          (checkbox) =>
            checkbox instanceof HTMLInputElement &&
            checkbox.checked,
        );


      if (
        selectedCheckboxes.length === 0
      ) {
        updateSelectedFacilityCount();
        return;
      }


      selectedCheckboxes.forEach(
        (checkbox) => {

          if (
            !(checkbox instanceof HTMLInputElement)
          ) {
            return;
          }


          const facilityId = Number(
            checkbox.dataset.facilityId,
          );

          const facilityName =
            checkbox.dataset.facilityName ??
            "";

          const facilitySlug =
            checkbox.dataset.facilitySlug ??
            "";


          if (
            !Number.isInteger(facilityId) ||
            facilityId <= 0
          ) {
            return;
          }


          addFacilityToTable(
            facilityId,
            facilityName,
            facilitySlug,
          );

        },
      );


      closeAddFacilityModal();

    },
  );


  /* ========================================
     Remove Facility
  ======================================== */

  const removeFacilityDialog =
    document.getElementById(
      "remove-facility-confirm-dialog",
    );


  if (
    removeFacilityDialog instanceof HTMLDivElement
  ) {

    let pendingFacilityId:
      number | null = null;


    facilityBody?.addEventListener(
      "click",
      (event) => {

        const target =
          event.target;

        if (
          !(target instanceof HTMLElement)
        ) {
          return;
        }


        const removeButton =
          target.closest(
            "[data-remove-facility]",
          );


        if (
          !(removeButton instanceof HTMLElement)
        ) {
          return;
        }


        const facilityId = Number(
          removeButton.getAttribute(
            "data-remove-facility",
          ),
        );


        if (
          !Number.isInteger(facilityId) ||
          facilityId <= 0
        ) {
          return;
        }


        pendingFacilityId =
          facilityId;


        const facilityName =
          removeButton.getAttribute(
            "data-facility-name",
          ) ??
          "this facility";


        removeFacilityDialog.dispatchEvent(
          new CustomEvent(
            "dialog:open",
            {
              detail: {
                name: facilityName,
              },
            },
          ),
        );

      },
    );


    removeFacilityDialog.addEventListener(
      "confirm",
      () => {

        if (
          pendingFacilityId === null
        ) {
          return;
        }


        removeFacilityFromTable(
          pendingFacilityId,
        );


        pendingFacilityId = null;

      },
    );

  }


  /* ========================================
     Initial State
  ======================================== */

  updateFacilityEmptyState();
  syncFacilityOptions();
  updateSelectedFacilityCount();

</script>