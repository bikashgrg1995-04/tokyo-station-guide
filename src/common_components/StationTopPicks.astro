---
import Button from "./Button.astro";
import ConfirmDialog from "./ConfirmDialog.astro";

interface TopPick {
  id: number;
  name: string;
  name_japanese: string | null;
  slug: string;
  category: string;
  description: string | null;
  image_url: string | null;
  sort_order?: number;
  walking_minutes?: number | null;
}

interface Props {
  stationName: string;
  assignedTopPicks?: TopPick[];
  availableTopPicks: TopPick[];
}

const {
  stationName,
  assignedTopPicks = [],
  availableTopPicks,
} = Astro.props;
---

<!-- ========================================
     Top Picks
======================================== -->

<section class="admin-panel">

  <div class="admin-panel-body">

    <div class="admin-station-form">

      <!-- Header -->

      <div class="admin-station-form-header">

        <div
          style="
            display:flex;
            justify-content:space-between;
            align-items:center;
            gap:16px;
          "
        >

          <div>

            <h3>
              Top Picks
            </h3>

            <p>
              Manage the top picks available at
              <strong>{stationName}</strong>.
              Changes are applied when you save the station.
            </p>

          </div>

          {
            availableTopPicks.length > 0 && (
              <Button
                type="button"
                variant="primary"
                id="open-add-top-pick-button"
              >
                + Add Top Pick
              </Button>
            )
          }

        </div>

      </div>


      <!-- ========================================
           Temporary Top Pick Inputs
      ======================================== -->

      <div id="station-top-pick-inputs">

        {
          assignedTopPicks.map(
            (topPick) => (
              <input
                type="hidden"
                name="top_pick_ids"
                value={topPick.id}
                data-top-pick-input={topPick.id}
              />
            ),
          )
        }

      </div>


      <!-- ========================================
           Top Pick Table
      ======================================== -->

      <div class="admin-table-wrapper">

        <table
          class="admin-table"
          id="station-top-picks-table"
        >

          <thead>

            <tr>

              <th>
                Top Pick
              </th>

              <th>
                Slug
              </th>

              <th>
                Category
              </th>

              <th>
                Actions
              </th>

            </tr>

          </thead>


          <tbody id="station-top-picks-body">

            {
              assignedTopPicks.length > 0 ? (

                assignedTopPicks.map(
                  (topPick) => (

                    <tr
                      data-top-pick-row
                      data-top-pick-id={topPick.id}
                    >

                      <td>

                        <div class="admin-line-name">
                          {topPick.name}
                        </div>

                        {
                          topPick.name_japanese && (
                            <div
                              style="
                                margin-top:4px;
                                opacity:0.65;
                                font-size:0.85rem;
                              "
                            >
                              {topPick.name_japanese}
                            </div>
                          )
                        }

                      </td>


                      <td>

                        <span class="admin-line-slug">
                          {topPick.slug}
                        </span>

                      </td>


                      <td>

                        <span class="admin-line-slug">
                          {topPick.category}
                        </span>

                      </td>


                      <td>

                        <div class="admin-table-actions">

                          <button
                            type="button"
                            class="admin-table-action admin-table-action-delete"
                            data-remove-top-pick={topPick.id}
                            data-top-pick-name={topPick.name}
                          >
                            Remove
                          </button>

                        </div>

                      </td>

                    </tr>

                  ),
                )

              ) : (

                <tr id="station-top-picks-empty-row">

                  <td colspan="4">

                    <div class="admin-empty">

                      <div class="admin-empty-icon">
                        ◦
                      </div>

                      <h3>
                        No Top Picks Assigned
                      </h3>

                      <p>
                        There are currently no top picks
                        assigned to this station.
                      </p>

                    </div>

                  </td>

                </tr>

              )
            }

          </tbody>

        </table>

      </div>


      <!-- ========================================
           All Top Picks Assigned
      ======================================== -->

      <p
        id="all-top-picks-message"
        style="
          margin-top:12px;
          opacity:0.7;
        "
        hidden
      >
        All available top picks are already assigned
        to this station.
      </p>

    </div>

  </div>

</section>


<!-- ========================================
     Add Top Picks Modal
======================================== -->

<div
  id="add-top-pick-modal"
  class="admin-line-station-modal"
  hidden
  aria-hidden="true"
>

  <div
    class="admin-line-station-modal-backdrop"
    data-close-add-top-pick-modal
  ></div>


  <div
    class="admin-line-station-modal-dialog"
    role="dialog"
    aria-modal="true"
    aria-labelledby="add-top-pick-modal-title"
    aria-describedby="add-top-pick-modal-description"
  >

    <!-- Modal Header -->

    <div class="admin-line-station-modal-header">

      <div>

        <h2 id="add-top-pick-modal-title">
          Add Top Picks
        </h2>

        <p id="add-top-pick-modal-description">
          Select one or more top picks to add to
          {stationName}.
        </p>

      </div>


      <button
        type="button"
        class="admin-line-station-modal-close"
        id="close-add-top-pick-modal"
        aria-label="Close add top picks dialog"
      >
        ×
      </button>

    </div>


    <!-- ========================================
         Available Top Picks
    ======================================== -->

    {
      availableTopPicks.length > 0 ? (

        <div
          class="admin-form"
          id="add-top-picks-form"
        >

          <div class="admin-facility-checkbox-grid">

            {
              availableTopPicks.map(
                (topPick) => (

                  <label
                    class="admin-facility-checkbox-item"
                    data-top-pick-option
                    data-top-pick-option-id={topPick.id}
                  >

                    <input
                      type="checkbox"
                      value={topPick.id}
                      class="add-top-pick-checkbox"
                      data-top-pick-id={topPick.id}
                      data-top-pick-name={topPick.name}
                      data-top-pick-slug={topPick.slug}
                      data-top-pick-category={topPick.category}
                    />

                    <span>

                      <strong>
                        {topPick.name}
                      </strong>

                      <small
                        style="
                          display:block;
                          margin-top:3px;
                          opacity:0.65;
                        "
                      >
                        {topPick.category}
                      </small>

                    </span>

                  </label>

                ),
              )
            }

          </div>


          <!-- Selected Count -->

          <p
            id="selected-top-pick-count"
            style="
              margin-top:14px;
              opacity:0.7;
            "
          >
            0 top picks selected
          </p>


          <!-- Modal Actions -->

          <div class="admin-form-actions">

            <Button
              type="button"
              variant="secondary"
              id="cancel-add-top-picks"
            >
              Cancel
            </Button>

            <Button
              type="button"
              variant="primary"
              id="add-selected-top-picks"
              disabled
            >
              Add Selected
            </Button>

          </div>

        </div>

      ) : (

        <div class="admin-empty">

          <h3>
            No Top Picks Available
          </h3>

          <p>
            All top picks from the master list are already
            assigned to this station.
          </p>

        </div>

      )
    }

  </div>

</div>


<!-- ========================================
     Remove Top Pick Confirmation
======================================== -->

<ConfirmDialog
  id="remove-top-pick-confirm-dialog"
  title="Remove Top Pick"
  description="Are you sure you want to remove this top pick from the station?"
  confirmText="Remove"
  cancelText="Cancel"
  variant="danger"
/>


<script>
  /* ========================================
     Elements
  ======================================== */

  const addTopPickModal =
    document.getElementById(
      "add-top-pick-modal",
    );

  const openAddTopPickButton =
    document.getElementById(
      "open-add-top-pick-button",
    );

  const closeAddTopPickButton =
    document.getElementById(
      "close-add-top-pick-modal",
    );

  const cancelAddTopPicksButton =
    document.getElementById(
      "cancel-add-top-picks",
    );

  const closeAddTopPickBackdrop =
    document.querySelector(
      "[data-close-add-top-pick-modal]",
    );

  const topPickCheckboxes =
    document.querySelectorAll(
      ".add-top-pick-checkbox",
    );

  const selectedTopPickCount =
    document.getElementById(
      "selected-top-pick-count",
    );

  const addSelectedTopPicksButton =
    document.getElementById(
      "add-selected-top-picks",
    );

  const topPickBody =
    document.getElementById(
      "station-top-picks-body",
    );

  const topPickInputs =
    document.getElementById(
      "station-top-pick-inputs",
    );

  const allTopPicksMessage =
    document.getElementById(
      "all-top-picks-message",
    );


  /* ========================================
     Helpers
  ======================================== */

  function topPickAlreadySelected(
    topPickId: number,
  ): boolean {
    return !!document.querySelector(
      `[data-top-pick-row][data-top-pick-id="${topPickId}"]`,
    );
  }


  function updateTopPickEmptyState(): void {

    if (
      !(topPickBody instanceof HTMLElement)
    ) {
      return;
    }

    const rows =
      topPickBody.querySelectorAll(
        "[data-top-pick-row]",
      );

    const emptyRow =
      document.getElementById(
        "station-top-picks-empty-row",
      );

    if (rows.length === 0) {

      if (!emptyRow) {

        topPickBody.innerHTML = `
          <tr id="station-top-picks-empty-row">
            <td colspan="4">
              <div class="admin-empty">

                <div class="admin-empty-icon">
                  ◦
                </div>

                <h3>
                  No Top Picks Assigned
                </h3>

                <p>
                  There are currently no top picks
                  assigned to this station.
                </p>

              </div>
            </td>
          </tr>
        `;

      }

    } else {

      emptyRow?.remove();

    }

  }


  function updateAllTopPicksMessage(): void {

    if (
      !(allTopPicksMessage instanceof HTMLElement)
    ) {
      return;
    }

    const topPickOptions =
      document.querySelectorAll(
        "[data-top-pick-option]",
      );

    if (topPickOptions.length === 0) {

      allTopPicksMessage.hidden = true;
      return;

    }

    const visibleOptions =
      Array.from(topPickOptions).filter(
        (option) =>
          option instanceof HTMLElement &&
          option.style.display !== "none",
      );

    allTopPicksMessage.hidden =
      visibleOptions.length > 0;

  }


  function syncTopPickOptions(): void {

    const rows =
      document.querySelectorAll(
        "[data-top-pick-row]",
      );

    const selectedIds =
      new Set<number>();

    rows.forEach((row) => {

      if (!(row instanceof HTMLElement)) {
        return;
      }

      const topPickId =
        Number(
          row.dataset.topPickId,
        );

      if (
        Number.isInteger(topPickId) &&
        topPickId > 0
      ) {
        selectedIds.add(topPickId);
      }

    });


    topPickCheckboxes.forEach(
      (checkbox) => {

        if (
          !(checkbox instanceof HTMLInputElement)
        ) {
          return;
        }

        const topPickId =
          Number(
            checkbox.dataset.topPickId,
          );

        const selected =
          selectedIds.has(topPickId);

        checkbox.checked = false;
        checkbox.disabled = selected;

        const option =
          checkbox.closest(
            "[data-top-pick-option]",
          );

        if (
          option instanceof HTMLElement
        ) {
          option.style.display =
            selected
              ? "none"
              : "";
        }

      },
    );

    updateAllTopPicksMessage();

  }


  function addTopPickToTable(
    topPickId: number,
    topPickName: string,
    topPickSlug: string,
    topPickCategory: string,
  ): void {

    if (
      !(topPickBody instanceof HTMLElement) ||
      !(topPickInputs instanceof HTMLElement)
    ) {
      return;
    }

    if (
      topPickAlreadySelected(
        topPickId,
      )
    ) {
      return;
    }


    const row =
      document.createElement("tr");

    row.setAttribute(
      "data-top-pick-row",
      "",
    );

    row.setAttribute(
      "data-top-pick-id",
      String(topPickId),
    );


    row.innerHTML = `
      <td>
        <div class="admin-line-name">
          ${topPickName}
        </div>
      </td>

      <td>
        <span class="admin-line-slug">
          ${topPickSlug}
        </span>
      </td>

      <td>
        <span class="admin-line-slug">
          ${topPickCategory}
        </span>
      </td>

      <td>
        <div class="admin-table-actions">

          <button
            type="button"
            class="admin-table-action admin-table-action-delete"
            data-remove-top-pick="${topPickId}"
            data-top-pick-name="${topPickName}"
          >
            Remove
          </button>

        </div>
      </td>
    `;


    topPickBody.appendChild(row);


    const input =
      document.createElement("input");

    input.type = "hidden";
    input.name = "top_pick_ids";
    input.value = String(topPickId);

    input.setAttribute(
      "data-top-pick-input",
      String(topPickId),
    );


    topPickInputs.appendChild(input);


    updateTopPickEmptyState();
    syncTopPickOptions();

  }


  function removeTopPickFromTable(
    topPickId: number,
  ): void {

    const row =
      document.querySelector(
        `[data-top-pick-row][data-top-pick-id="${topPickId}"]`,
      );

    const input =
      document.querySelector(
        `[data-top-pick-input="${topPickId}"]`,
      );


    row?.remove();
    input?.remove();


    updateTopPickEmptyState();
    syncTopPickOptions();

  }


  /* ========================================
     Modal
  ======================================== */

  function openAddTopPickModal(): void {

    if (
      !(addTopPickModal instanceof HTMLDivElement)
    ) {
      return;
    }

    syncTopPickOptions();

    addTopPickModal.hidden = false;

    addTopPickModal.setAttribute(
      "aria-hidden",
      "false",
    );

    updateSelectedTopPickCount();

  }


  function closeAddTopPickModal(): void {

    if (
      !(addTopPickModal instanceof HTMLDivElement)
    ) {
      return;
    }

    topPickCheckboxes.forEach(
      (checkbox) => {

        if (
          checkbox instanceof HTMLInputElement
        ) {
          checkbox.checked = false;
        }

      },
    );

    updateSelectedTopPickCount();

    addTopPickModal.hidden = true;

    addTopPickModal.setAttribute(
      "aria-hidden",
      "true",
    );

  }


  function updateSelectedTopPickCount(): void {

    if (
      !(selectedTopPickCount instanceof HTMLElement)
    ) {
      return;
    }

    const selectedCount =
      document.querySelectorAll(
        ".add-top-pick-checkbox:checked",
      ).length;


    selectedTopPickCount.textContent =
      `${selectedCount} ${
        selectedCount === 1
          ? "top pick"
          : "top picks"
      } selected`;


    if (
      addSelectedTopPicksButton instanceof
      HTMLButtonElement
    ) {
      addSelectedTopPicksButton.disabled =
        selectedCount === 0;
    }

  }


  openAddTopPickButton?.addEventListener(
    "click",
    openAddTopPickModal,
  );


  topPickCheckboxes.forEach(
    (checkbox) => {

      checkbox.addEventListener(
        "change",
        updateSelectedTopPickCount,
      );

    },
  );


  closeAddTopPickButton?.addEventListener(
    "click",
    closeAddTopPickModal,
  );


  cancelAddTopPicksButton?.addEventListener(
    "click",
    closeAddTopPickModal,
  );


  closeAddTopPickBackdrop?.addEventListener(
    "click",
    closeAddTopPickModal,
  );


  /* ========================================
     Add Selected
  ======================================== */

  addSelectedTopPicksButton?.addEventListener(
    "click",
    () => {

      const selectedCheckboxes =
        Array.from(
          topPickCheckboxes,
        ).filter(
          (checkbox) =>
            checkbox instanceof HTMLInputElement &&
            checkbox.checked,
        );


      if (
        selectedCheckboxes.length === 0
      ) {
        updateSelectedTopPickCount();
        return;
      }


      selectedCheckboxes.forEach(
        (checkbox) => {

          if (
            !(checkbox instanceof HTMLInputElement)
          ) {
            return;
          }


          const topPickId =
            Number(
              checkbox.dataset.topPickId,
            );

          const topPickName =
            checkbox.dataset.topPickName ??
            "";

          const topPickSlug =
            checkbox.dataset.topPickSlug ??
            "";

          const topPickCategory =
            checkbox.dataset.topPickCategory ??
            "";


          if (
            !Number.isInteger(topPickId) ||
            topPickId <= 0
          ) {
            return;
          }


          addTopPickToTable(
            topPickId,
            topPickName,
            topPickSlug,
            topPickCategory,
          );

        },
      );


      closeAddTopPickModal();

    },
  );


  /* ========================================
     Remove Top Pick
  ======================================== */

  const removeTopPickDialog =
    document.getElementById(
      "remove-top-pick-confirm-dialog",
    );


  if (
    removeTopPickDialog instanceof HTMLDivElement
  ) {

    let pendingTopPickId:
      number | null = null;


    topPickBody?.addEventListener(
      "click",
      (event) => {

        const target =
          event.target;

        if (
          !(target instanceof HTMLElement)
        ) {
          return;
        }


        const removeButton =
          target.closest(
            "[data-remove-top-pick]",
          );


        if (
          !(removeButton instanceof HTMLElement)
        ) {
          return;
        }


        const topPickId =
          Number(
            removeButton.getAttribute(
              "data-remove-top-pick",
            ),
          );


        if (
          !Number.isInteger(topPickId) ||
          topPickId <= 0
        ) {
          return;
        }


        pendingTopPickId =
          topPickId;


        const topPickName =
          removeButton.getAttribute(
            "data-top-pick-name",
          ) ??
          "this top pick";


        removeTopPickDialog.dispatchEvent(
          new CustomEvent(
            "dialog:open",
            {
              detail: {
                name: topPickName,
              },
            },
          ),
        );

      },
    );


    removeTopPickDialog.addEventListener(
      "confirm",
      () => {

        if (
          pendingTopPickId === null
        ) {
          return;
        }


        removeTopPickFromTable(
          pendingTopPickId,
        );


        pendingTopPickId = null;

      },
    );

  }


  /* ========================================
     Initial State
  ======================================== */

  updateTopPickEmptyState();
  syncTopPickOptions();
  updateSelectedTopPickCount();

</script>