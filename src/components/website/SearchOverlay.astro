<div class="search-overlay" id="search-overlay" hidden>
  <div class="search-backdrop" id="search-backdrop"></div>

  <div class="search-panel">
    <div class="search-bar">
      <form id="search-form" autocomplete="off">
        <svg class="search-icon" viewBox="0 0 24 24" aria-hidden="true"
          ><circle cx="11" cy="11" r="7"></circle><path d="M20 20l-3.6-3.6"
          ></path></svg
        >
        <input
          type="search"
          id="search-input"
          placeholder="Search stations or codes"
          aria-label="Search stations or codes"
          data-i18n-attr="placeholder:search.placeholder;aria-label:search.placeholder"
        />
      </form>

      <button
        class="search-cancel"
        id="close-search"
        type="button"
        data-i18n="search.cancel"
        data-i18n-attr="aria-label:search.close"
        aria-label="Close search"
      >
        Cancel
      </button>
    </div>

    <div id="search-home">
      <section
        class="search-section"
        id="featured-section"
        aria-labelledby="featured-title"
      >
        <div class="search-section-head">
          <h3 id="featured-title" data-i18n="search.featured">
            Popular Station Hubs
          </h3>
        </div>

        <div id="featured-stations" class="featured-stations"></div>
      </section>

      <p class="search-tip" id="search-tip" data-i18n="search.tip">
      Tip: search by station code — “G19”, “JY01”, “KS42”
      </p>

      <section
        class="search-section"
        id="recent-section"
        aria-labelledby="recent-title"
        hidden
      >
        <div class="search-section-head">
          <h3 id="recent-title" data-i18n="search.recent">Recent</h3>
        </div>

        <div id="recent-stations" class="recent-stations"></div>
      </section>
    </div>

    <div id="search-results" class="search-results"></div>
  </div>
</div>
