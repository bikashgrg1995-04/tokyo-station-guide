
<div class="station-sheet" id="station-sheet" hidden>
  <div class="sheet-backdrop" id="sheet-backdrop"></div>

  <div
    class="sheet-panel"
    role="dialog"
    aria-modal="true"
    aria-labelledby="sheet-en"
  >
    <span class="sheet-grip" aria-hidden="true"></span>

    <header class="sheet-head">
      <span class="sheet-badge">
        <small id="sheet-prefix"></small>
        <b id="sheet-num"></b>
      </span>

      <div class="sheet-title">
        <strong id="sheet-jp"></strong>
        <span id="sheet-en"></span>
      </div>

      <button
        class="round"
        id="sheet-close"
        type="button"
        aria-label="Close"
      >
        ×
      </button>
    </header>

    <div class="sheet-body" id="sheet-body"></div>

    <div class="sheet-foot">
      <button
        class="sheet-cta"
        id="sheet-suggest-edit"
        type="button"
        aria-expanded="false"
        aria-controls="sheet-edit-form"
      >
        Suggest an Edit →
      </button>
    </div>

    <section
      class="sheet-edit-form"
      id="sheet-edit-form"
      aria-label="Suggest station edits"
      hidden
    >
      <header class="sheet-edit-head">
        <h3>Suggest an Edit</h3>
        <p>
          Help us keep station information accurate.
          Your suggestion will be reviewed before any changes are published.
        </p>
      </header>

      <form id="station-suggestion-form">
        <input
          type="hidden"
          id="suggestion-station-id"
          name="stationId"
        />

        <div class="form-field">
          <label for="suggestion-name">Station name (English)</label>
          <input
            id="suggestion-name"
            name="name"
            type="text"
            maxlength="150"
            autocomplete="off"
          />
        </div>

        <div class="form-field">
          <label for="suggestion-name-japanese">Station name (Japanese)</label>
          <input
            id="suggestion-name-japanese"
            name="nameJapanese"
            type="text"
            maxlength="150"
            autocomplete="off"
          />
        </div>

        <div class="form-field">
          <label for="suggestion-description">Description</label>
          <textarea
            id="suggestion-description"
            name="description"
            maxlength="1000"
            rows="3"
          ></textarea>
        </div>

        <div class="form-field">
          <label for="suggestion-about">About this station</label>
          <textarea
            id="suggestion-about"
            name="about"
            maxlength="1000"
            rows="3"
          ></textarea>
        </div>

        <div class="form-field">
          <label for="suggestion-latitude">Latitude</label>
          <input
            id="suggestion-latitude"
            name="latitude"
            type="number"
            min="-90"
            max="90"
            step="any"
          />
        </div>

        <div class="form-field">
          <label for="suggestion-longitude">Longitude</label>
          <input
            id="suggestion-longitude"
            name="longitude"
            type="number"
            min="-180"
            max="180"
            step="any"
          />
        </div>

        <div class="form-field">
          <label for="suggestion-reason">What should be changed?</label>
          <textarea
            id="suggestion-reason"
            name="reason"
            maxlength="1000"
            rows="3"
            placeholder="Explain your suggested changes..."
          ></textarea>
        </div>

        <div class="form-field">
          <label for="suggestion-submitter-name">Your name (optional)</label>
          <input
            id="suggestion-submitter-name"
            name="submitterName"
            type="text"
            maxlength="100"
            autocomplete="name"
          />
        </div>

        <div class="form-field">
          <label for="suggestion-submitter-email">Your email (optional)</label>
          <input
            id="suggestion-submitter-email"
            name="submitterEmail"
            type="email"
            maxlength="254"
            autocomplete="email"
          />
        </div>

        <div
          class="suggestion-message"
          id="suggestion-message"
          role="status"
          aria-live="polite"
          hidden
        ></div>

        <div class="suggestion-actions">
          <button type="button" id="sheet-cancel-edit">
            Cancel
          </button>
          <button type="submit" id="sheet-submit-edit">
            Submit Suggestion
          </button>
        </div>
      </form>
    </section>
  </div>
</div>
