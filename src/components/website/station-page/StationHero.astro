---
import type { StationPageData } from "../../../lib/db/station-page";

export interface Props {
  station: StationPageData;
}

const { station } = Astro.props;

const first = station.lines[0];
const code = first?.station_code ?? null;
const codeColor = first?.color ?? "#8a93a0";

// Operators of the lines that serve this station, each once.
const operators = [
  ...new Map(
    station.lines
      .filter((line) => line.operator_name)
      .map((line) => [line.operator_name, line.operator_name_japanese]),
  ),
];

const day = (value: string | null) => (value ? value.slice(0, 10) : "");
const updated = day(station.updated_at);
const checked = day(station.verified_at);

// Draft notice: shown until the page content is finished (see also robots=noindex in the page).
const isDraft = true;
---

<section class="sp-hero">
  <nav class="sp-crumbs" aria-label="Breadcrumb">
    <a href="/" data-i18n="sp.site">tokyoguide.jp</a>
    <span aria-hidden="true">›</span>
    <span aria-current="page">
      <span data-pick data-en={`${station.name} Station`} data-jp={station.name_japanese ? `${station.name_japanese}駅` : ""}>{station.name} Station</span>
    </span>
  </nav>

  {
    (code || station.region || station.region_japanese) && (
      <p class="sp-code-row">
        {code && <span class="sp-code" style={`--c:${codeColor}`}>{code}</span>}
        {(station.region || station.region_japanese) && (
          <span
            class="sp-region"
            data-pick
            data-en={station.region ?? ""}
            data-jp={station.region_japanese ?? ""}
          >
            {station.region}
          </span>
        )}
      </p>
    )
  }

  <h1 class="sp-title">
    <span data-station-en>{station.name} Station</span>
    {station.name_japanese && <span class="sp-title-jp" lang="ja">{station.name_japanese}駅</span>}
  </h1>

  {
    (station.description || station.description_japanese) && (
      <p
        class="sp-lead"
        data-pick
        data-en={station.description ?? ""}
        data-jp={station.description_japanese ?? ""}
      >
        {station.description}
      </p>
    )
  }

  <div class="sp-meta">
    {
      operators.length > 0 && (
        <p class="sp-operators">
          {operators.map(([name, jp], index) => (
            <>
              {index > 0 && <span aria-hidden="true"> · </span>}
              <span data-pick data-en={name ?? ""} data-jp={jp ?? ""}>{name}</span>
            </>
          ))}
        </p>
      )
    }

    {
      station.location_url && (
        <a
          class="sp-maps"
          href={station.location_url}
          target="_blank"
          rel="noopener noreferrer"
        >
          <svg viewBox="0 0 24 24"><path d="M12 21s-6-5.6-6-10.5A6 6 0 0 1 18 10.5C18 15.4 12 21 12 21zM12 12.5a2 2 0 1 0 0-4 2 2 0 0 0 0 4z"></path></svg>
          <span data-i18n="sp.openMap">Open in Google Maps</span>
        </a>
      )
    }
  </div>

  <p class="sp-byline">
    <span data-i18n="sp.by">By TokyoGuide.jp</span>
    {updated && (<>
      <span aria-hidden="true"> · </span>
      <span data-i18n-date="sp.updated" data-date={updated}>Last updated {updated}</span>
    </>)}
    {checked && (<>
      <span aria-hidden="true"> · </span>
      <span data-i18n-date="sp.checked" data-date={checked}>Checked in person on {checked}; details we could not check on site are marked</span>
    </>)}
    {isDraft && (<>
      <span aria-hidden="true"> · </span>
      <strong class="sp-draft" data-i18n="sp.draft">DRAFT (noindex): verify facts, add photos, then set status to "published"</strong>
    </>)}
  </p>
</section>
