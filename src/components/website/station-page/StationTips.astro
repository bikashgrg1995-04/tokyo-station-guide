---
// Exits & station tips: exits table, a footnote, exit photos with captions, tips.
import type { StationPageData } from "../../../lib/db/station-page";

export interface Props {
  station: StationPageData;
  mediaBase: string;
}

const { station, mediaBase } = Astro.props;
const photos = station.exits.filter((e) => e.photo);
const src = (key: string) => (/^https?:\/\//i.test(key) ? key : `${mediaBase}/${key}`);
---

<div class="sp-tips">
  {
    station.exits.length > 0 && (
      <div class="sp-tips-scroll">
        <table class="sp-tips-table">
          <thead>
            <tr>
              <th data-i18n="sp.tp.exit">Exit</th>
              <th data-i18n="sp.tp.leads">Leads to</th>
            </tr>
          </thead>
          <tbody>
            {station.exits.map((e) => (
              <tr>
                <th scope="row" data-pick data-en={e.name} data-jp={e.name_japanese ?? ""}>{e.name}</th>
                <td data-pick data-en={e.description ?? ""} data-jp={e.description_japanese ?? ""}>{e.description}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    )
  }

  {
    station.exits_note && (
      <p class="sp-tips-note" data-pick data-en={station.exits_note} data-jp={station.exits_note_japanese ?? ""}>
        {station.exits_note}
      </p>
    )
  }

  {
    photos.length > 0 && (
      <div class="sp-tips-photos">
        {photos.map((p) => (
          <figure>
            <img src={src(p.photo ?? "")} alt={p.name} loading="lazy" decoding="async" />
            <figcaption>
              <b data-pick data-en={p.name} data-jp={p.name_japanese ?? ""}>{p.name}</b>
              {p.photo_caption && (
                <span data-pick data-en={p.photo_caption} data-jp={p.photo_caption_japanese ?? ""}>{p.photo_caption}</span>
              )}
            </figcaption>
          </figure>
        ))}
      </div>
    )
  }

  {
    station.tips.length > 0 && (
      <ul class="sp-tips-list">
        {station.tips.map((t) => (
          <li data-pick data-en={t.tip} data-jp={t.tip_japanese ?? ""}>{t.tip}</li>
        ))}
      </ul>
    )
  }
</div>
