---
import type { StationPageData } from "../../../lib/db/station-page";
import { ICONS, type StationSectionDef } from "./sections";

export interface Props {
  section: StationSectionDef;
  station: StationPageData;
}

const { section, station } = Astro.props;
const isLines = section.id === "lines";
const isOverview = section.id === "overview";
---

<section class="sp-section" id={section.id} data-section={section.id}>
  <header class="sp-section-head">
    <svg viewBox="0 0 24 24"><path d={ICONS[section.icon]}></path></svg>
    <h2 data-i18n={`sp.s.${section.id}`}>{section.title}</h2>
  </header>

  <div class="sp-section-body">
    {
      isOverview && (station.description || station.description_japanese) ? (
        <p
          class="sp-text"
          data-pick
          data-en={station.description ?? ""}
          data-jp={station.description_japanese ?? ""}
        >
          {station.description}
        </p>
      ) : isLines && station.lines.length > 0 ? (
        <ul class="sp-line-list">
          {station.lines.map((line) => (
            <li style={`--c:${line.color ?? "#8a93a0"}`}>
              <i class="sp-chip-dot"></i>
              <span data-pick data-en={line.name} data-jp={line.name_japanese ?? ""}>{line.name}</span>
              {line.station_code && <b>{line.station_code}</b>}
            </li>
          ))}
        </ul>
      ) : (
        <div class="sp-skeleton" aria-hidden="true">
          <i style="width:92%"></i>
          <i style="width:78%"></i>
          <i style="width:55%"></i>
        </div>
      )
    }

    {
      !(isOverview || (isLines && station.lines.length > 0)) && (
        <p class="sp-soon" data-i18n="sp.soon">Content for this section is coming soon.</p>
      )
    }
  </div>
</section>
