---
import type { StationPageData } from "../../../lib/db/station-page";
import { ICONS, type StationSectionDef } from "./sections";
import PlatformMap from "./PlatformMap.astro";
import StationOverview from "./StationOverview.astro";
import StationSides from "./StationSides.astro";
import StationRoutes from "./StationRoutes.astro";
import StationTips from "./StationTips.astro";
import StationAlong from "./StationAlong.astro";
import StationTrainLines from "./StationTrainLines.astro";

export interface Props {
  section: StationSectionDef;
  station: StationPageData;
  mediaBase: string;
}

const { section, station, mediaBase } = Astro.props;
const isLines = section.id === "lines";
const isOverview = section.id === "overview";
const isSides = section.id === "sides" && (station.sides.length > 0 || Boolean(station.sides_note));
const isAlong = section.id === "along" && station.lines.some((l) => l.prev || l.next || l.station_code);
const isTips =
  section.id === "tips" &&
  (station.exits.length > 0 || station.tips.length > 0 || Boolean(station.exits_note));
const isRoutes = section.id === "getting" && (station.routes.length > 0 || Boolean(station.routes_note));
const isMap = section.id === "map" && station.platforms.length > 0;
---

<section class="sp-section" id={section.id} data-section={section.id}>
  <header class="sp-section-head">
    <svg viewBox="0 0 24 24"><path d={ICONS[section.icon]}></path></svg>
    <h2 data-i18n={`sp.s.${section.id}`}>{section.title}</h2>
  </header>

  <div class="sp-section-body">
    {
      isMap ? (
        <PlatformMap platforms={station.platforms} />
      ) : isOverview && (station.description || station.description_japanese) ? (
        <StationOverview station={station} />
      ) : isAlong ? (
        <StationAlong station={station} />
      ) : isTips ? (
        <StationTips station={station} mediaBase={mediaBase} />
      ) : isRoutes ? (
        <StationRoutes station={station} />
      ) : isSides ? (
        <StationSides station={station} />
      ) : isLines && station.lines.length > 0 ? (
        <StationTrainLines station={station} />
      ) : (
        <div class="sp-skeleton" aria-hidden="true">
          <i style="width:92%"></i>
          <i style="width:78%"></i>
          <i style="width:55%"></i>
        </div>
      )
    }

    {
      !(isMap || isAlong || isTips || isRoutes || isSides || isOverview || (isLines && station.lines.length > 0)) && (
        <p class="sp-soon" data-i18n="sp.soon">Content for this section is coming soon.</p>
      )
    }
  </div>
</section>
