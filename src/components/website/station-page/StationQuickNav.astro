---
import { ICONS, QUICK_LINKS } from "./sections";
---

<!-- Quick jump buttons under the main photo -->
<nav class="sp-quick" aria-label="Jump to">
  {
    QUICK_LINKS.map((link) => (
      <a href={`#${link.target}`}>
        <svg viewBox="0 0 24 24"><path d={ICONS[link.icon]}></path></svg>
        <span data-i18n={`sp.q.${link.key}`}>{link.title}</span>
      </a>
    ))
  }
</nav>
