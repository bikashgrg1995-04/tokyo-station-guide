<main class="stage" id="stage">
  <svg
    id="map"
    role="img"
    aria-label="Railway line map"
    preserveAspectRatio="xMidYMid meet"
  >
    <defs>
      <linearGradient id="car-grad" x1="0" y1="0" x2="1" y2="0">
        <stop offset="0" stop-color="#d9dee5"></stop>
        <stop offset="0.1" stop-color="#f3f5f7"></stop>
        <stop offset="0.5" stop-color="#ffffff"></stop>
        <stop offset="0.9" stop-color="#f0f2f5"></stop>
        <stop offset="1" stop-color="#d5dbe2"></stop>
      </linearGradient>
      <linearGradient id="ac-grad" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0" stop-color="#f6f7f9"></stop>
        <stop offset="1" stop-color="#e2e6eb"></stop>
      </linearGradient>
      <linearGradient id="ac-in-grad" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0" stop-color="#b4bac2"></stop>
        <stop offset="1" stop-color="#a1a7af"></stop>
      </linearGradient>
      <linearGradient id="cab-grad" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0" stop-color="#2f343c"></stop>
        <stop offset="1" stop-color="#191c21"></stop>
      </linearGradient>
      <linearGradient id="beam-grad" x1="0" y1="1" x2="0" y2="0">
        <stop offset="0" stop-color="#fffbe0" stop-opacity="0.95"></stop>
        <stop offset="1" stop-color="#fffbe0" stop-opacity="0"></stop>
      </linearGradient>
      <radialGradient id="glow-grad">
        <stop offset="0" stop-color="#f0e8ae" stop-opacity="0.62"></stop>
        <stop offset="0.3" stop-color="#f0e8ae" stop-opacity="0.48"></stop>
        <stop offset="0.6" stop-color="#ebe2a4" stop-opacity="0.18"></stop>
        <stop offset="0.85" stop-color="#ebe2a4" stop-opacity="0.05"></stop>
        <stop offset="1" stop-color="#ebe2a4" stop-opacity="0"></stop>
      </radialGradient>
      <radialGradient id="bulb-grad">
        <stop offset="0" stop-color="#ffffff" stop-opacity="1"></stop>
        <stop offset="0.25" stop-color="#fff8d0" stop-opacity="0.95"></stop>
        <stop offset="0.6" stop-color="#f0e8ae" stop-opacity="0.35"></stop>
        <stop offset="1" stop-color="#f0e8ae" stop-opacity="0"></stop>
      </radialGradient>
    </defs>
    <g id="scenery" aria-hidden="true">
      <path
        class="sc-bay"
        d="M600 830C780 600 1020 520 1600 560L1600 1600L600 1600Z"></path>
      <path
        class="sc-river"
        d="M690 -560C700 -320 640 -120 650 100S620 340 680 520S800 730 970 850"
      ></path>
      <rect class="sc-park" x="-470" y="-40" width="100" height="90" rx="22" transform="rotate(-12 -420 5)"></rect>
      <rect class="sc-park" x="-290" y="-90" width="90" height="100" rx="22" transform="rotate(14 -245 -40)"></rect>
      <rect class="sc-park" x="880" y="140" width="60" height="70" rx="16" transform="rotate(-8 910 175)"></rect>
      <rect class="sc-park" x="1080" y="340" width="70" height="70" rx="18" transform="rotate(12 1115 375)"></rect>
      <rect class="sc-park" x="930" y="590" width="80" height="80" rx="20" transform="rotate(-10 970 630)"></rect>
      <rect class="sc-park" x="-130" y="770" width="70" height="80" rx="18" transform="rotate(10 -95 810)"></rect>
      <rect class="sc-park" x="-340" y="430" width="90" height="90" rx="22" transform="rotate(8 -295 475)"></rect>
      <rect class="sc-park" x="1250" y="-50" width="80" height="80" rx="20" transform="rotate(-14 1290 -10)"></rect>
    </g>
    <g id="track"></g>
    <g id="labels"></g>
    <g id="glow"></g>
    <g id="train"></g>
  </svg>

</main>
