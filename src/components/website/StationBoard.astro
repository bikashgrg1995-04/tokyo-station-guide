---
import LinesDialog from "./LinesDialog.astro";
import ComingSoonDialog from "./ComingSoonDialog.astro";
---

<section class="board" aria-live="polite">
  <div class="board-card">
    <LinesDialog />

    <button
      class="line-pill"
      id="line-toggle"
      aria-expanded="false"
      aria-haspopup="dialog"
      aria-controls="lines-dialog"
    >
      <i class="dot"></i>
      <span id="line-name">Select line</span>
      <svg viewBox="0 0 24 24"><path d="M8 9l4-4 4 4M8 15l4 4 4-4"></path></svg>
    </button>

    <div class="board-main">
      <button class="board-action" id="info-link" type="button">
        <svg viewBox="0 0 24 24"
          ><circle cx="12" cy="12" r="9"></circle><path d="M12 11v5.5M12 7.8v.1"
          ></path></svg
        >
        <span data-i18n="board.info">Info</span>
      </button>

      <div class="current">
        <span class="code" id="cur-code"></span>
        <strong id="cur-jp">—</strong>
        <span class="cur-en" id="cur-en"></span>
      </div>

      <button
        class="board-action"
        id="page-link"
        type="button"
        aria-haspopup="dialog"
      >
        <svg viewBox="0 0 24 24"
          ><path d="M7 3h7l5 5v13H7z"></path><path
            d="M14 3v5h5M10 13h6M10 17h6"></path></svg
        >
        <span data-i18n="board.page">Page</span>
        <svg class="chev" viewBox="0 0 24 24"><path d="M9 6l6 6-6 6"></path></svg>
      </button>
    </div>

    <div class="board-nav">
      <button
        class="side prev"
        id="prev-btn"
        aria-label="Previous station"
        data-i18n-attr="aria-label:board.prev"
      >
        <svg class="arrow" viewBox="0 0 24 24"><path d="M15 5l-7 7 7 7"></path></svg>
        <span class="badge" id="prev-num"></span>
        <span class="side-text">
          <b id="prev-jp"></b>
          <small id="prev-en"></small>
        </span>
      </button>

      <i class="board-divider" aria-hidden="true"></i>

      <button
        class="side next"
        id="next-btn"
        aria-label="Next station"
        data-i18n-attr="aria-label:board.next"
      >
        <span class="side-text">
          <b id="next-jp"></b>
          <small id="next-en"></small>
        </span>
        <span class="badge" id="next-num"></span>
        <svg class="arrow" viewBox="0 0 24 24"><path d="M9 5l7 7-7 7"></path></svg>
      </button>
    </div>
  </div>
</section>

<ComingSoonDialog />
