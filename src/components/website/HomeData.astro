---
export interface Props {
  transitData: unknown;
  searchable: unknown;
  featuredStations: unknown;
}

const { transitData, searchable, featuredStations } = Astro.props;

/** JSON for an inline script block: "<" is escaped so the data can never close the block early. */
const toJson = (value: unknown) =>
  JSON.stringify(value).replace(/</g, "\\u003c");
---

<script
  type="application/json"
  id="transit-data"
  set:html={toJson(transitData)}
/>
<script
  type="application/json"
  id="search-data"
  set:html={toJson(searchable)}
/>
<script
  type="application/json"
  id="featured-stations-data"
  set:html={toJson(featuredStations)}
/>
