---
import "../../styles/admin/station-section-nav.css";

export interface Props {
  stationName: string;
  stationId: number;
  groups: { key: string; label: string }[];
  active: string;
}

const { stationName, stationId, groups, active } = Astro.props;
---

<nav class="station-section-nav" aria-label={`${stationName} sections`}>
  <p class="station-section-nav-title">{stationName}</p>
  <ul>
    {
      groups.map((g) => (
        <li>
          <a
            href={`/admin/stations/${stationId}/edit?g=${g.key}`}
            class:list={[{ "is-active": g.key === active }]}
            aria-current={g.key === active ? "page" : undefined}
          >
            {g.label}
          </a>
          {g.key === "details" && (
            <a class="station-submenu-link" href={`/admin/stations/${stationId}/edit?g=details#stats`}>Page stat cards</a>
          )}
        </li>
      ))
    }
  </ul>
  <p class="station-section-nav-group">Global catalogs</p>
  <ul>
    <li><a href="/admin/hotels">Hotels</a></li>
    <li><a href="/admin/restaurants">Restaurants</a></li>
    <li><a href="/admin/places">Places</a></li>
  </ul>
</nav>
