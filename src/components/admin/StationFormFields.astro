---
/**
 * Station fields shared by the Add and Edit pages, in a compact 12-column
 * grid. The verification switch is part of the grid, so there is no separate
 * verification panel.
 */
import { topPickImageSrc } from "../../lib/storage/station-images";
import type {
  StationFormErrors,
  StationFormValues,
} from "../../lib/validators/station";

export interface Props {
  values: StationFormValues;
  errors: StationFormErrors;
  /** Main photo saved for this station (R2 key), when editing. */
  mainImage?: string | null;
}

const { values, errors, mainImage = null } = Astro.props;
const mainImageSrc = topPickImageSrc(mainImage);

const {
  name,
  nameJapanese,
  slug,
  locationUrl,
  description,
  descriptionJapanese,
  about,
  aboutJapanese,
  region,
  regionJapanese,
  isVerified,
  verifiedAt,
} = values;
---

<div class="admin-station-fields">
  <!-- Station Name -->
  <div class="admin-form-group span-4">
    <label for="name">Station Name</label>

    <input
      id="name"
      name="name"
      type="text"
      placeholder="e.g. Tokyo Station"
      value={name}
      required
      aria-invalid={errors.name ? "true" : "false"}
      aria-describedby={errors.name ? "name-error" : undefined}
    />

    {
      errors.name && (
        <small id="name-error" class="admin-form-error">
          {errors.name}
        </small>
      )
    }
  </div>

  <!-- Japanese Name -->
  <div class="admin-form-group span-4">
    <label for="name_japanese">Japanese Name</label>

    <input
      id="name_japanese"
      name="name_japanese"
      type="text"
      class="admin-station-japanese-input"
      placeholder="e.g. 東京駅"
      value={nameJapanese}
      aria-invalid={errors.nameJapanese ? "true" : "false"}
      aria-describedby={errors.nameJapanese ? "name-japanese-error" : undefined}
    />

    {
      errors.nameJapanese && (
        <small id="name-japanese-error" class="admin-form-error">
          {errors.nameJapanese}
        </small>
      )
    }
  </div>

  <!-- Slug -->
  <div class="admin-form-group span-4">
    <label for="slug">
      Slug <span class="admin-label-hint">lowercase, numbers, hyphens</span>
    </label>

    <input
      id="slug"
      name="slug"
      type="text"
      placeholder="e.g. tokyo-station"
      value={slug}
      required
      aria-invalid={errors.slug ? "true" : "false"}
      aria-describedby={errors.slug ? "slug-error" : undefined}
    />

    {
      errors.slug && (
        <small id="slug-error" class="admin-form-error">
          {errors.slug}
        </small>
      )
    }
  </div>

  <!-- Location link -->
  <div class="admin-form-group span-6">
    <label for="location_url">
      Location link <span class="admin-label-hint">map URL</span>
    </label>

    <input
      id="location_url"
      name="location_url"
      type="url"
      maxlength="500"
      placeholder="e.g. https://maps.app.goo.gl/..."
      value={locationUrl}
      aria-invalid={errors.locationUrl ? "true" : "false"}
      aria-describedby={errors.locationUrl ? "location-url-error" : undefined}
    />

    {
      errors.locationUrl && (
        <small id="location-url-error" class="admin-form-error">
          {errors.locationUrl}
        </small>
      )
    }
  </div>

  <!-- Verification (not a .admin-form-group: its switch has its own styles) -->
  <div class="admin-station-verified span-6" data-verification>
    <span class="admin-station-field-label">Verification</span>

    <div class="admin-verification-toggle">
      <span class="admin-verification-title">Verified station</span>

      <input
        id="verified_at"
        name="verified_at"
        type="date"
        class="admin-verified-date"
        value={verifiedAt}
        disabled={!isVerified}
        aria-label="Verification date"
        aria-invalid={errors.verifiedAt ? "true" : "false"}
      />

      <label class="admin-switch" for="is_verified">
        <input
          id="is_verified"
          name="is_verified"
          type="checkbox"
          checked={isVerified}
          aria-label="Mark this station as verified"
        />
        <span class="admin-switch-slider"></span>
      </label>
    </div>

    {
      errors.verifiedAt && (
        <small class="admin-form-error">{errors.verifiedAt}</small>
      )
    }
  </div>

  <!-- Description -->
  <div class="admin-form-group span-6">
    <label for="description">Description</label>

    <textarea
      id="description"
      name="description"
      rows="3"
      class="admin-station-description"
      placeholder="Brief description of this station..."
      aria-invalid={errors.description ? "true" : "false"}
      aria-describedby={errors.description ? "description-error" : undefined}
      >{description}</textarea
    >

    {
      errors.description && (
        <small id="description-error" class="admin-form-error">
          {errors.description}
        </small>
      )
    }
  </div>

  <!-- Location label on the station page -->
  <div class="admin-form-group span-6">
    <label for="region">
      Location <span class="admin-label-hint">shown under the station code, e.g. Chiyoda City · Tokyo</span>
    </label>
    <input
      id="region"
      name="region"
      type="text"
      maxlength="100"
      placeholder="e.g. Chiyoda City · Tokyo"
      value={region}
      aria-invalid={errors.region ? "true" : "false"}
    />
    {errors.region && <small class="admin-form-error">{errors.region}</small>}
  </div>

  <div class="admin-form-group span-6">
    <label for="region_japanese">Japanese Location</label>
    <input
      id="region_japanese"
      name="region_japanese"
      type="text"
      lang="ja"
      maxlength="100"
      placeholder="例: 東京・千代田区"
      value={regionJapanese}
      aria-invalid={errors.regionJapanese ? "true" : "false"}
    />
    {errors.regionJapanese && <small class="admin-form-error">{errors.regionJapanese}</small>}
  </div>

  <!-- Main photo of the station page -->
  <div class="admin-form-group span-12">
    <label for="main_image_file">
      Main photo <span class="admin-label-hint">station page, PNG, WebP or JPEG up to 2 MB</span>
    </label>

    {
      mainImageSrc && (
        <div class="admin-photo-current">
          <img src={mainImageSrc} alt="Current main photo" loading="lazy" />
        </div>
      )
    }

    <input
      id="main_image_file"
      name="main_image_file"
      type="file"
      accept="image/png,image/webp,image/jpeg"
      aria-invalid={errors.mainImage ? "true" : "false"}
    />

    {
      mainImageSrc && (
        <label class="admin-check-inline">
          <input type="checkbox" name="remove_main_image" />
          Remove the current photo
        </label>
      )
    }

    {
      errors.mainImage ? (
        <small class="admin-form-error">{errors.mainImage}</small>
      ) : (
        <small>
          {mainImageSrc
            ? "Choose a new file to replace the current photo."
            : "Optional. Shown at the top of the station page."}
        </small>
      )
    }
  </div>

  <!-- About -->
  <div class="admin-form-group span-6">
    <label for="about">
      About <span class="admin-label-hint">station popup, up to 150 characters</span>
    </label>

    <textarea
      id="about"
      name="about"
      maxlength="150"
      rows="3"
      class="admin-station-description"
      placeholder="Short text shown in the About section of the station popup..."
      aria-invalid={errors.about ? "true" : "false"}
      aria-describedby={errors.about ? "about-error" : undefined}
      >{about}</textarea
    >

    {
      errors.about && (
        <small id="about-error" class="admin-form-error">
          {errors.about}
        </small>
      )
    }
  </div>

  <!-- Japanese Description -->
  <div class="admin-form-group span-6">
    <label for="description_japanese">Japanese Description</label>

    <textarea
      id="description_japanese"
      name="description_japanese"
      rows="3"
      lang="ja"
      class="admin-station-description"
      placeholder="この駅の簡単な説明..."
      aria-invalid={errors.descriptionJapanese ? "true" : "false"}
      aria-describedby={errors.descriptionJapanese ? "description-japanese-error" : undefined}
      >{descriptionJapanese}</textarea
    >

    {
      errors.descriptionJapanese && (
        <small id="description-japanese-error" class="admin-form-error">
          {errors.descriptionJapanese}
        </small>
      )
    }
  </div>

  <!-- Japanese About -->
  <div class="admin-form-group span-6">
    <label for="about_japanese">
      Japanese About <span class="admin-label-hint">up to 150 characters</span>
    </label>

    <textarea
      id="about_japanese"
      name="about_japanese"
      maxlength="150"
      rows="3"
      lang="ja"
      class="admin-station-description"
      placeholder="駅ポップアップの「概要」に表示される短い文章..."
      aria-invalid={errors.aboutJapanese ? "true" : "false"}
      aria-describedby={errors.aboutJapanese ? "about-japanese-error" : undefined}
      >{aboutJapanese}</textarea
    >

    {
      errors.aboutJapanese && (
        <small id="about-japanese-error" class="admin-form-error">
          {errors.aboutJapanese}
        </small>
      )
    }
  </div>
</div>

<script>
  import "../../scripts/admin/station-form-fields";
</script>
