---
import type {
  StationFormErrors,
  StationFormValues,
} from "../../lib/validators/station";

export interface Props {
  values: StationFormValues;
  errors: StationFormErrors;
}

const { values, errors } = Astro.props;

const {
  name,
  nameJapanese,
  slug,
  latitude: latitudeValue,
  longitude: longitudeValue,
  description,
  about,
} = values;
---

<div class="admin-form-grid">
  <!-- Station Name -->

  <div class="admin-form-group">
    <label for="name"> Station Name </label>

    <input
      id="name"
      name="name"
      type="text"
      placeholder="e.g. Tokyo Station"
      value={name}
      required
      aria-invalid={errors.name ? "true" : "false"}
      aria-describedby={errors.name ? "name-error" : undefined}
    />

    {
      errors.name && (
        <small id="name-error" class="admin-form-error">
          {errors.name}
        </small>
      )
    }
  </div>

  <!-- Japanese Name -->

  <div class="admin-form-group">
    <label for="name_japanese"> Japanese Name </label>

    <input
      id="name_japanese"
      name="name_japanese"
      type="text"
      class="admin-station-japanese-input"
      placeholder="e.g. 東京駅"
      value={nameJapanese}
      aria-invalid={errors.nameJapanese ? "true" : "false"}
      aria-describedby={errors.nameJapanese ? "name-japanese-error" : undefined}
    />

    {
      errors.nameJapanese && (
        <small id="name-japanese-error" class="admin-form-error">
          {errors.nameJapanese}
        </small>
      )
    }
  </div>

  <!-- Slug -->

  <div class="admin-form-group full-width">
    <label for="slug"> Slug </label>

    <input
      id="slug"
      name="slug"
      type="text"
      placeholder="e.g. tokyo-station"
      value={slug}
      required
      aria-invalid={errors.slug ? "true" : "false"}
      aria-describedby={errors.slug ? "slug-error" : "slug-help"}
    />

    {
      errors.slug ? (
        <small id="slug-error" class="admin-form-error">
          {errors.slug}
        </small>
      ) : (
        <small id="slug-help">
          Used in the station URL. Use lowercase letters, numbers, and hyphens.
        </small>
      )
    }
  </div>

  <!-- Latitude -->

  <div class="admin-form-group">
    <label for="latitude"> Latitude </label>

    <input
      id="latitude"
      name="latitude"
      type="number"
      step="any"
      placeholder="e.g. 35.681236"
      value={latitudeValue}
      aria-invalid={errors.latitude ? "true" : "false"}
      aria-describedby={errors.latitude ? "latitude-error" : "latitude-help"}
    />

    {
      errors.latitude ? (
        <small id="latitude-error" class="admin-form-error">
          {errors.latitude}
        </small>
      ) : (
        <small id="latitude-help">Optional. Range: -90 to 90.</small>
      )
    }
  </div>

  <!-- Longitude -->

  <div class="admin-form-group">
    <label for="longitude"> Longitude </label>

    <input
      id="longitude"
      name="longitude"
      type="number"
      step="any"
      placeholder="e.g. 139.767125"
      value={longitudeValue}
      aria-invalid={errors.longitude ? "true" : "false"}
      aria-describedby={errors.longitude ? "longitude-error" : "longitude-help"}
    />

    {
      errors.longitude ? (
        <small id="longitude-error" class="admin-form-error">
          {errors.longitude}
        </small>
      ) : (
        <small id="longitude-help">Optional. Range: -180 to 180.</small>
      )
    }
  </div>

  <!-- Description -->

  <div class="admin-form-group full-width">
    <label for="description"> Description </label>

    <textarea
      id="description"
      name="description"
      rows="5"
      class="admin-station-description"
      placeholder="Brief description of this station..."
      aria-invalid={errors.description ? "true" : "false"}
      aria-describedby={errors.description ? "description-error" : undefined}
      >{description}</textarea
    >

    {
      errors.description && (
        <small id="description-error" class="admin-form-error">
          {errors.description}
        </small>
      )
    }
  </div>

  <!-- About -->

  <div class="admin-form-group full-width">
    <label for="about"> About (station popup) </label>

    <textarea
      id="about"
      name="about"
      rows="4"
      class="admin-station-description"
      placeholder="Short text shown in the About section of the station popup..."
      aria-invalid={errors.about ? "true" : "false"}
      aria-describedby={errors.about ? "about-error" : undefined}
      >{about}</textarea
    >

    {
      errors.about ? (
        <small id="about-error" class="admin-form-error">
          {errors.about}
        </small>
      ) : (
        <small>Optional. Up to 1000 characters.</small>
      )
    }
  </div>
</div>
