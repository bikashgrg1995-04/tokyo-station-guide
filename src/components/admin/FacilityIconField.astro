---
import { iconUrl, isUploadedIcon } from "../../lib/storage/facility-icons";

export interface Props {
  /** Typed icon text (emoji or built-in name). */
  value: string;
  /** Icon currently saved for this facility, if any. */
  saved?: string | null;
  /** Dark-theme icon currently saved for this facility, if any. */
  savedDark?: string | null;
  textError?: string;
  fileError?: string;
  darkFileError?: string;
}

const {
  value,
  saved = null,
  savedDark = null,
  textError = "",
  fileError = "",
  darkFileError = "",
} = Astro.props;

const uploaded = isUploadedIcon(saved) ? saved : null;
const uploadedDark = isUploadedIcon(savedDark) ? savedDark : null;
const text = isUploadedIcon(value) ? "" : value;
---

<div class="admin-form-group">
  <label for="icon_file">Icon file (light theme)</label>

  {
    uploaded && (
      <div class="admin-icon-current">
        <img
          src={iconUrl(uploaded)}
          alt="Current icon"
          width="44"
          height="44"
        />

        <label class="admin-icon-remove">
          <input type="checkbox" name="remove_icon" />
          Remove this icon
        </label>
      </div>
    )
  }

  <input
    id="icon_file"
    name="icon_file"
    type="file"
    accept="image/png,image/webp,image/jpeg,image/svg+xml"
    aria-invalid={fileError ? "true" : "false"}
    aria-describedby={fileError ? "icon-file-error" : undefined}
  />

  {
    fileError ? (
      <small id="icon-file-error" class="admin-form-error">
        {fileError}
      </small>
    ) : (
      <small>
        Optional. PNG, WebP, JPEG or SVG, up to 512 KB. Use a square image
        (for example 128 × 128). It is stored in the site's R2 bucket.
      </small>
    )
  }
</div>

<div class="admin-form-group">
  <label for="icon_dark_file">Icon file (dark theme)</label>

  {
    uploadedDark && (
      <div class="admin-icon-current is-dark">
        <img
          src={iconUrl(uploadedDark)}
          alt="Current dark icon"
          width="44"
          height="44"
        />

        <label class="admin-icon-remove">
          <input type="checkbox" name="remove_icon_dark" />
          Remove this dark icon
        </label>
      </div>
    )
  }

  <input
    id="icon_dark_file"
    name="icon_dark_file"
    type="file"
    accept="image/png,image/webp,image/jpeg,image/svg+xml"
    aria-invalid={darkFileError ? "true" : "false"}
    aria-describedby={darkFileError ? "icon-dark-file-error" : undefined}
  />

  {
    darkFileError ? (
      <small id="icon-dark-file-error" class="admin-form-error">
        {darkFileError}
      </small>
    ) : (
      <small>
        Optional. Shown instead of the icon above when the website is in dark
        mode. Without it, the normal icon is used in both themes.
      </small>
    )
  }
</div>

<div class="admin-form-group">
  <label for="icon">Icon text</label>

  <input
    id="icon"
    name="icon"
    type="text"
    maxlength="100"
    value={text}
    placeholder="🚻"
    aria-invalid={textError ? "true" : "false"}
    aria-describedby={textError ? "icon-error" : undefined}
  />

  {
    textError ? (
      <small id="icon-error" class="admin-form-error">
        {textError}
      </small>
    ) : (
      <small>
        Optional. An emoji or built-in icon name, used only when no icon file
        is uploaded.
      </small>
    )
  }
</div>
