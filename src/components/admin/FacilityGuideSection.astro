---
import "../../styles/admin/tables.css";
import "../../styles/admin/station-item-modal.css";
import EmptyState from "../common/EmptyState.astro";
import type { FacilityGuideResult } from "../../lib/services/station-facility-guide";

export interface Props {
  stationName: string;
  form: FacilityGuideResult;
  src: (key: string) => string;
}

const { stationName, form, src } = Astro.props;
const nextOrder = form.items.reduce((m, t) => Math.max(m, t.sort_order), 0) + 1;
const reopen = form.posted
  ? JSON.stringify({ mode: form.errorFor === "item-new" ? "create" : "update", values: form.posted })
  : "";
---

<section class="admin-panel" id="facility-guide">
  <div class="admin-panel-body">
    <h3 style="margin:0 0 4px">Facilities guide</h3>
    <p class="sim-sub" style="margin:0 0 10px">
      The "Facilities" section on the {stationName} public page. A facility with a description is listed in the table; one with a photo also gets a photo card.
    </p>

    {form.formError && !form.posted && <div class="admin-form-error" role="alert">{form.formError}</div>}

    <div class="sim-toolbar">
      <input id="sim-search" type="search" placeholder="Search guide..." aria-label="Search facilities guide" />
      <button type="button" id="sim-add" class="sim-add" data-next-order={nextOrder}>+ Add</button>
    </div>

    {
      form.items.length === 0 ? (
        <EmptyState icon="🛈" title="No guide entries yet" description="Click Add to describe a facility." />
      ) : (
        <div class="admin-table-wrapper">
          <table class="admin-table sim-table">
            <thead>
              <tr><th>Order</th><th>Photo</th><th>Facility</th><th>What to know</th><th>Actions</th></tr>
            </thead>
            <tbody>
              {form.items.map((t) => (
                <tr class="sim-row" data-search={`${t.name} ${t.name_japanese ?? ""} ${t.description ?? ""}`.toLowerCase()}>
                  <td>{t.sort_order}</td>
                  <td>{t.photo ? <img class="admin-photo-thumb" src={src(t.photo)} alt="" loading="lazy" /> : <span class="admin-table-muted">—</span>}</td>
                  <td>
                    <strong>{t.name || t.name_japanese}</strong>
                    {t.name && t.name_japanese && <div class="sim-sub" lang="ja">{t.name_japanese}</div>}
                  </td>
                  <td><div class="sim-clip">{t.description || t.description_japanese || "—"}</div></td>
                  <td>
                    <div class="sim-actions">
                      <button
                        type="button"
                        class="admin-table-action admin-table-action-edit sim-edit"
                        data-item={JSON.stringify({
                          item_id: String(t.id),
                          name: t.name,
                          name_japanese: t.name_japanese ?? "",
                          description: t.description ?? "",
                          description_japanese: t.description_japanese ?? "",
                          photo_caption: t.photo_caption ?? "",
                          photo_caption_japanese: t.photo_caption_japanese ?? "",
                          sort_order: String(t.sort_order),
                          photo_url: t.photo ? src(t.photo) : "",
                        })}
                      >
                        Edit
                      </button>
                      <form method="POST" onsubmit="return confirm('Delete this facility guide entry?')">
                        <input type="hidden" name="item_id" value={t.id} />
                        <input type="hidden" name="guide_action" value="guide_delete" />
                        <button type="submit" class="admin-table-action admin-table-action-delete">Delete</button>
                      </form>
                    </div>
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
          <p id="sim-empty-search" class="sim-empty-search" hidden>No matching entries.</p>
        </div>
      )
    }
  </div>
</section>

<div
  id="sim-modal"
  class="sim-modal"
  hidden
  data-create-action="guide_create"
  data-update-action="guide_update"
  data-add-title="Add facility guide entry"
  data-edit-title="Edit facility guide entry"
  data-add-label="Add"
  data-reopen={reopen}
>
  <div class="sim-backdrop" data-close></div>
  <section class="sim-dialog" role="dialog" aria-modal="true" aria-labelledby="sim-title">
    <h2 id="sim-title">Add facility guide entry</h2>
    {form.formError && form.posted && <div class="admin-form-error" role="alert">{form.formError}</div>}
    <form id="sim-form" method="POST" enctype="multipart/form-data" class="admin-form">
      <input type="hidden" name="guide_action" value="guide_create" />
      <input type="hidden" name="item_id" value="" />
      <div class="sim-grid2">
        <div class="admin-form-group"><label for="sim-n">Name</label><input id="sim-n" name="name" required maxlength="150" placeholder="Coin lockers" /></div>
        <div class="admin-form-group"><label for="sim-nj">Name (Japanese)</label><input id="sim-nj" name="name_japanese" lang="ja" maxlength="150" /></div>
        <div class="admin-form-group"><label for="sim-d">What to know</label><textarea id="sim-d" name="description" rows="3" maxlength="1500"></textarea></div>
        <div class="admin-form-group"><label for="sim-dj">What to know (Japanese)</label><textarea id="sim-dj" name="description_japanese" lang="ja" rows="3" maxlength="1500"></textarea></div>
        <div class="admin-form-group"><label for="sim-c">Photo caption</label><textarea id="sim-c" name="photo_caption" rows="2" maxlength="400"></textarea></div>
        <div class="admin-form-group"><label for="sim-cj">Photo caption (Japanese)</label><textarea id="sim-cj" name="photo_caption_japanese" lang="ja" rows="2" maxlength="400"></textarea></div>
      </div>
      <div class="admin-form-group"><label for="sim-o">Order</label><input id="sim-o" name="sort_order" type="number" min="0" value="0" /></div>
      <div class="admin-form-group">
        <label>Photo (optional, PNG, JPEG or WebP up to 2 MB)</label>
        <div id="sim-photo-preview" hidden>
          <img alt="" style="display:block;width:120px;max-width:100%;margin-bottom:6px;border-radius:8px" />
          <label><input type="checkbox" name="remove_photo" /> Remove the current photo</label>
        </div>
        <input name="photo_file" type="file" accept="image/png,image/jpeg,image/webp" />
      </div>
      <div class="sim-foot">
        <button type="button" class="common-button common-button-secondary" data-close>Cancel</button>
        <button type="submit" id="sim-submit" class="common-button common-button-primary">Add</button>
      </div>
    </form>
  </section>
</div>

<script>
  import "../../scripts/admin/station-item-modal";
</script>
