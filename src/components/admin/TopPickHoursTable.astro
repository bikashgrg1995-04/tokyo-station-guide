---
import "../../styles/admin/top-pick-hours.css";
import type { TopPickOpeningHour } from "../../lib/db/top-picks";

export interface Props {
  /** Hours currently in the form (saved values or re-rendered input). */
  openingHours: TopPickOpeningHour[];
}

const { openingHours } = Astro.props;

const DAYS = [
  { value: 0, label: "Sunday" },
  { value: 1, label: "Monday" },
  { value: 2, label: "Tuesday" },
  { value: 3, label: "Wednesday" },
  { value: 4, label: "Thursday" },
  { value: 5, label: "Friday" },
  { value: 6, label: "Saturday" },
];

const rows = DAYS.map((day) => {
  const hours = openingHours.find((hour) => hour.day_of_week === day.value) ?? {
    day_of_week: day.value,
    is_closed: false,
    opening_time: "09:00",
    closing_time: "17:00",
    last_entry_time: "",
  };

  return { ...day, hours };
});
---

<div class="admin-hours" data-hours-table>
  <table class="admin-hours-table">
    <thead>
      <tr>
        <th scope="col">Day</th>
        <th scope="col" class="admin-hours-closed-col">Closed</th>
        <th scope="col">Opens</th>
        <th scope="col">Closes</th>
        <th scope="col">Last entry</th>
      </tr>
    </thead>

    <tbody>
      <!-- Bulk row: fills every open day. These inputs are not submitted. -->
      <tr class="admin-hours-bulk">
        <th scope="row">All days</th>
        <td class="admin-hours-closed-col">
          <button type="button" class="admin-hours-apply" data-hours-apply>
            Apply
          </button>
        </td>
        <td>
          <input
            type="time"
            value="09:00"
            data-bulk="opening"
            aria-label="Opening time for all days"
          />
        </td>
        <td>
          <input
            type="time"
            value="17:00"
            data-bulk="closing"
            aria-label="Closing time for all days"
          />
        </td>
        <td>
          <input
            type="time"
            data-bulk="last_entry"
            aria-label="Last entry time for all days"
          />
        </td>
      </tr>

      {
        rows.map(({ value, label, hours }) => (
          <tr
            class:list={["admin-hours-row", { "is-closed": hours.is_closed }]}
            data-hours-row
          >
            <th scope="row">{label}</th>

            <td class="admin-hours-closed-col">
              <input
                id={`closed_${value}`}
                name={`closed_${value}`}
                type="checkbox"
                checked={hours.is_closed}
                data-hours-closed
                aria-label={`${label} closed`}
              />
            </td>

            <td>
              <input
                id={`opening_time_${value}`}
                name={`opening_time_${value}`}
                type="time"
                value={hours.opening_time ?? ""}
                disabled={hours.is_closed}
                data-field="opening"
                aria-label={`${label} opening time`}
              />
            </td>

            <td>
              <input
                id={`closing_time_${value}`}
                name={`closing_time_${value}`}
                type="time"
                value={hours.closing_time ?? ""}
                disabled={hours.is_closed}
                data-field="closing"
                aria-label={`${label} closing time`}
              />
            </td>

            <td>
              <input
                id={`last_entry_time_${value}`}
                name={`last_entry_time_${value}`}
                type="time"
                value={hours.last_entry_time ?? ""}
                disabled={hours.is_closed}
                data-field="last_entry"
                aria-label={`${label} last entry time`}
              />
            </td>
          </tr>
        ))
      }
    </tbody>
  </table>

  <p class="admin-hours-note">
    Last entry is optional. Closed days are saved without times.
  </p>
</div>

<script>
  import "../../scripts/admin/top-pick-hours";
</script>

