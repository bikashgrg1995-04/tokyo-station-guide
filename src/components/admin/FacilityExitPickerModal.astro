---
import "../../styles/admin/facility-exit-picker.css";
import type { StationFloor } from "../../lib/db/station-floors";
import type { StationExit } from "../../lib/db/station-exits";

interface Props {
  exits: StationExit[];
  floors: StationFloor[];
  /** Link to the page where exits are created. */
  manageExitsHref?: string;
}

const { exits, floors, manageExitsHref } = Astro.props;

const floorNames = new Map(
  floors.map((floor) => [floor.id, floor.name]),
);
---

<div
  id="facility-exit-picker-modal"
  class="facility-exit-picker-modal"
  hidden
>
  <div class="facility-exit-picker-backdrop" data-close-facility-exit-picker></div>

  <section
    class="facility-exit-picker-dialog"
    role="dialog"
    aria-modal="true"
    aria-labelledby="facility-exit-picker-title"
  >
    <header class="facility-exit-picker-header">
      <div>
        <h2 id="facility-exit-picker-title">Select Nearby Exits</h2>
        <p>Select one or more exits for this facility.</p>
      </div>

      <button
        type="button"
        class="admin-table-action"
        aria-label="Close"
        data-close-facility-exit-picker
      >
        ✕
      </button>
    </header>

    <div class="facility-exit-picker-body">
      <div class="facility-exit-picker-filters">
        <button
          type="button"
          class="facility-exit-floor-filter active"
          data-exit-floor-filter="all"
        >
          All Floors
        </button>

        {floors.map((floor) => (
          <button
            type="button"
            class="facility-exit-floor-filter"
            data-exit-floor-filter={String(floor.id)}
          >
            {floor.name}
          </button>
        ))}
      </div>

      <div class="facility-exit-picker-list">
        {exits.length > 0 ? (
          exits.map((exit) => (
            <label
              class="facility-exit-picker-option"
              data-exit-floor={String(exit.floor_id)}
            >
              <input
                type="checkbox"
                value={String(exit.id)}
                data-facility-exit-option
              />

              <span class="facility-exit-picker-option-copy">
                <strong>{exit.name}</strong>
                <small>
                  {floorNames.get(exit.floor_id) ?? "Unknown floor"}
                  {exit.code ? ` · ${exit.code}` : ""}
                </small>
              </span>
            </label>
          ))
        ) : (
          <p class="facility-exit-picker-empty">
            No exits have been created for this station yet.
            {manageExitsHref && (
              <>
                {" "}
                <a href={manageExitsHref}>Manage exits</a>
              </>
            )}
          </p>
        )}
      </div>
    </div>

    <footer class="facility-exit-picker-footer">
      <span data-facility-exit-selection-count>0 exits selected</span>

      <div>
        <button
          type="button"
          class="admin-table-action"
          data-close-facility-exit-picker
        >
          Cancel
        </button>

        <button
          type="button"
          class="admin-table-action"
          data-save-facility-exits
        >
          Apply Selected Exits
        </button>
      </div>
    </footer>
  </section>
</div>

