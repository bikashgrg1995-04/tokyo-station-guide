---
import "../../styles/admin/forms.css";
import "../../styles/admin/operators.css";

import Alert from "../common/Alert.astro";
import type { PlaceKindInfo } from "../../lib/db/places";
import type { PlaceFormResult } from "../../lib/services/places";

export interface Props {
  info: PlaceKindInfo;
  form: PlaceFormResult;
}

const { info, form } = Astro.props;
const v = form.values;
const place = form.place;
const lower = info.label.toLowerCase();
const img = (k: string) => (/^https?:\/\//i.test(k) ? k : `/media/${k}`);
---

<div class="admin-content">
  <div class="admin-page-header">
    <div>
      <h2>{place ? `Edit ${info.label}` : `Add ${info.label}`}</h2>
      <p>
        {info.label} details shown on the station pages. The place relative to each station (for example
        "Marunouchi South Exit, 1 min") is set when you assign it to a station.
      </p>
    </div>
  </div>

  <section class="admin-panel">
    <div class="admin-panel-body">
      <div class="admin-operator-form">
        {form.formError && <Alert>{form.formError}</Alert>}

        <form method="POST" class="admin-form" enctype="multipart/form-data">
          <div class="admin-form-group">
            <label for="name">Name</label>
            <input id="name" name="name" required maxlength="150" value={v.name} />
          </div>

          <div class="admin-form-group">
            <label for="name_japanese">Japanese name</label>
            <input id="name_japanese" name="name_japanese" lang="ja" maxlength="150" value={v.nameJapanese} />
          </div>

          <div class="admin-form-group">
            <label for="slug">Slug</label>
            <input id="slug" name="slug" maxlength="80" value={v.slug} placeholder="Leave empty to create it from the name" />
          </div>

          <div class="admin-form-group">
            <label for="kind">Kind</label>
            <input id="kind" name="kind" maxlength="80" value={v.kind} placeholder={info.kind === "hotel" ? "In the station building" : "Tsukemen"} />
          </div>

          <div class="admin-form-group">
            <label for="kind_japanese">Kind (Japanese)</label>
            <input id="kind_japanese" name="kind_japanese" lang="ja" maxlength="80" value={v.kindJapanese} />
          </div>

          <div class="admin-form-group">
            <label for="description">Description</label>
            <textarea id="description" name="description" rows="4" maxlength="800">{v.description}</textarea>
          </div>

          <div class="admin-form-group">
            <label for="description_japanese">Description (Japanese)</label>
            <textarea id="description_japanese" name="description_japanese" lang="ja" rows="4" maxlength="800">{v.descriptionJapanese}</textarea>
          </div>

          <div class="admin-form-group">
            <label for="map_url">Map link</label>
            <input id="map_url" name="map_url" type="url" maxlength="500" value={v.mapUrl} placeholder="https://maps.google.com/..." />
          </div>

          {
            info.hasBooking && (
              <div class="admin-form-group">
                <label for="booking_url">Booking.com link (the "Check prices" button)</label>
                <input id="booking_url" name="booking_url" type="url" maxlength="500" value={v.bookingUrl} placeholder="https://www.booking.com/..." />
              </div>
            )
          }

          <div class="admin-form-group">
            <label for="photo_file">Photo (optional, PNG, JPEG or WebP up to 2 MB)</label>
            {
              place?.photo && (
                <div>
                  <img src={img(place.photo)} alt="" style="display:block;width:160px;max-width:100%;margin-bottom:8px;border-radius:8px" />
                  <label><input type="checkbox" name="remove_photo" /> Remove the current photo</label>
                </div>
              )
            }
            <input id="photo_file" name="photo_file" type="file" accept="image/png,image/jpeg,image/webp" />
          </div>

          <div class="admin-form-actions">
            <button type="submit" class="common-button common-button-primary">{place ? "Save changes" : `Add ${lower}`}</button>
            <a href={`/admin/${info.route}`} class="common-button common-button-secondary">Cancel</a>
          </div>
        </form>
      </div>
    </div>
  </section>
</div>
