---
import "../../styles/admin/station-exits-panel.css";
import Button from "../common/Button.astro";
import SearchInput from "../common/SearchInput.astro";
import EmptyState from "../common/EmptyState.astro";
import ConfirmDialog from "../common/ConfirmDialog.astro";

import type { StationExit } from "../../lib/db/station-exits";
import type { StationFloor } from "../../lib/db/station-floors";
import type {
  StationExitFormErrors,
  StationExitFormValues,
} from "../../lib/validators/station-exit";

interface Props {
  mediaBase?: string;
  stationName: string;
  stationId: number;
  exits: StationExit[];
  floors: StationFloor[];
  values: StationExitFormValues;
  errors: StationExitFormErrors;
  formError: string;
  editingId: number | null;
  nextSortOrder: number;
}

const {
  mediaBase = "/media",
  stationName,
  stationId,
  exits,
  floors,
  values,
  errors,
  formError,
  editingId,
  nextSortOrder,
} = Astro.props;

const floorName = (floorId: number) =>
  floors.find((floor) => floor.id === floorId)?.name ?? "Unknown floor";

const hasValidationErrors = Object.values(errors).some(Boolean);
const showModalInitially = editingId !== null || hasValidationErrors;

const editExit = exits.find((exit) => exit.id === editingId);

// After a failed save the posted values win; otherwise show the saved exit.
const formValues =
  editingId !== null && editExit && !hasValidationErrors && !formError
    ? {
        floorId: String(editExit.floor_id),
        name: editExit.name,
        nameJapanese: editExit.name_japanese ?? "",
        code: editExit.code ?? "",
        colorCode: editExit.color_code ?? "",
        description: editExit.description ?? "",
        descriptionJapanese: editExit.description_japanese ?? "",
        photoCaption: editExit.photo_caption ?? "",
        photoCaptionJapanese: editExit.photo_caption_japanese ?? "",
        photo: "",
        sortOrder: String(editExit.sort_order),
      }
    : values;

const showDeleteError =
  Boolean(formError) && editingId === null && !hasValidationErrors;

const DEFAULT_COLOR = "#2563EB";
const pickerColor = /^#[0-9a-fA-F]{6}$/.test(formValues.colorCode)
  ? formValues.colorCode
  : DEFAULT_COLOR;
---

<section class="admin-panel" id="station-exits">
  <div class="admin-panel-body admin-table-panel-body">
    {showDeleteError && (
      <div class="admin-form-error" role="alert">
        {formError}
      </div>
    )}

    <div class="admin-list-toolbar">
      <form
        class="admin-search-form"
        role="search"
        onsubmit="return false;"
      >
        <SearchInput
          id="exit-search"
          name="search"
          placeholder="Search exits..."
          ariaLabel="Search exits by name, code, floor or description"
        />
      </form>

      <div class="admin-toolbar-actions">
        <button
          type="button"
          class="common-button common-button-danger common-button-medium"
          data-bulk-delete
        >
          Delete
        </button>
        {floors.length > 0 && (
        <Button type="button" variant="primary" id="open-add-exit">
          + Add Exit
        </Button>
      )}
      </div>
    </div>

    <div class="admin-table-meta">
      <span id="exit-results-count" aria-live="polite">
        {exits.length} Total Exits
      </span>
    </div>

    {floors.length === 0 ? (
      <EmptyState
        icon="⌕"
        title="Add a floor first"
        description="Every exit belongs to a floor. Create at least one floor for this station."
      >
        <a
          class="admin-table-action"
          href={`/admin/stations/${stationId}/floors`}
        >
          Manage Floors
        </a>
      </EmptyState>
    ) : exits.length > 0 ? (
      <>
        <div class="admin-table-wrapper">
          <table class="admin-table">
            <thead>
              <tr>
                <th class="admin-select-cell">
                  <input type="checkbox" class="admin-row-checkbox" data-bulk-all aria-label="Select all exits" />
                </th>
                <th>Exit</th>
                <th>Floor</th>
                <th>Code</th>
                <th>Color</th>
                <th>Description</th>
                <th>Actions</th>
              </tr>
            </thead>

            <tbody>
              {exits.map((exit) => (
                <tr
                  data-exit-row
                  data-search={`${exit.name} ${exit.name_japanese ?? ""} ${exit.code ?? ""} ${floorName(exit.floor_id)} ${exit.description ?? ""} ${exit.description_japanese ?? ""}`.toLowerCase()}
                >
                  <td class="admin-select-cell">
                    <input type="checkbox" class="admin-row-checkbox" data-bulk-select value={exit.id} aria-label="Select exit" />
                  </td>
                  <td>
                    <strong>{exit.name}</strong>
                    {exit.name_japanese && (
                      <div class="admin-table-muted" lang="ja">
                        {exit.name_japanese}
                      </div>
                    )}
                  </td>
                  <td>
                    <span class="admin-floor-pill">
                      {floorName(exit.floor_id)}
                    </span>
                  </td>
                  <td>
                    {exit.code || <span class="admin-table-muted">—</span>}
                  </td>
                  <td>
                    {exit.color_code ? (
                      <span class="exit-color-chip">
                        <span
                          class="exit-color-swatch"
                          style={`background:${exit.color_code}`}
                        ></span>
                        {exit.color_code}
                      </span>
                    ) : (
                      <span class="admin-table-muted">—</span>
                    )}
                  </td>
                  <td class="exit-description-cell">
                    {exit.description || (
                      <span class="admin-table-muted">—</span>
                    )}
                  </td>
                  <td>
                    <div class="admin-table-actions">
                      <button
                        type="button"
                        class="admin-table-action admin-table-action-edit"
                        data-edit-exit
                        data-id={exit.id}
                        data-floor-id={exit.floor_id}
                        data-name={exit.name}
                        data-name-japanese={exit.name_japanese ?? ""}
                        data-code={exit.code ?? ""}
                        data-color-code={exit.color_code ?? ""}
                        data-description={exit.description ?? ""}
                        data-description-japanese={exit.description_japanese ?? ""}
                        data-photo={exit.photo ? (/^https?:\/\//i.test(exit.photo) ? exit.photo : `${mediaBase}/${exit.photo}`) : ""}
                        data-photo-caption={exit.photo_caption ?? ""}
                        data-photo-caption-japanese={exit.photo_caption_japanese ?? ""}
                        data-sort-order={exit.sort_order}
                      >
                        Edit
                      </button>

                      <button
                        type="button"
                        class="admin-table-action admin-table-action-delete js-delete-exit"
                        data-exit-id={exit.id}
                        data-exit-name={exit.name}
                      >
                        Delete
                      </button>
                    </div>
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>

        <div class="admin-table-footer">
          <span id="exit-page-info" aria-live="polite"></span>

          <label class="admin-exit-page-size" for="exit-page-size">
            Rows
            <select id="exit-page-size">
              <option value="10" selected>10</option>
              <option value="25">25</option>
              <option value="50">50</option>
            </select>
          </label>

          <div class="admin-table-pagination" id="exit-page-nav"></div>
        </div>

        <div id="exit-no-results" hidden>
          <EmptyState
            icon="⌕"
            title="No exits found"
            description="Try a different search term."
          />
        </div>
      </>
    ) : (
      <EmptyState
        icon="⌕"
        title="No exits yet"
        description="Add the first exit for this station to get started."
      />
    )}
  </div>
</section>

<!-- Add / Edit modal -->
{floors.length > 0 && (
  <div
    id="exit-modal"
    class:list={[
      "admin-line-station-modal",
      showModalInitially ? "is-open" : "",
    ]}
    hidden={!showModalInitially}
    aria-hidden={showModalInitially ? "false" : "true"}
  >
    <div
      class="admin-line-station-modal-backdrop"
      data-close-exit-modal
    ></div>

    <div
      class="admin-line-station-modal-dialog"
      role="dialog"
      aria-modal="true"
      aria-labelledby="exit-modal-title"
    >
      <div class="admin-line-station-modal-header">
        <div>
          <h2 id="exit-modal-title">
            {editingId ? "Edit Exit" : "Add Exit"}
          </h2>
          <p>
            Manage an exit of <strong>{stationName}</strong>. Several exits
            can belong to the same floor.
          </p>
        </div>

        <button
          type="button"
          class="admin-line-station-modal-close"
          data-close-exit-modal
          aria-label="Close exit form"
        >
          ×
        </button>
      </div>

      <form method="POST" enctype="multipart/form-data" class="admin-form" id="exit-form">
        <input
          type="hidden"
          name="exit_action"
          id="exit-action"
          value={editingId ? "update" : "create"}
        />

        <input
          type="hidden"
          name="exit_id"
          id="exit-id"
          value={editingId ?? ""}
        />

        {formError && !showDeleteError && (
          <div class="admin-form-error" role="alert">
            {formError}
          </div>
        )}

        <div class="admin-form-group">
          <label for="exit-floor">Floor</label>
          <select id="exit-floor" name="floor_id" required>
            <option value="">Select a floor</option>
            {floors.map((floor) => (
              <option
                value={floor.id}
                selected={String(floor.id) === formValues.floorId}
              >
                {floor.name}
                {floor.name_japanese ? ` · ${floor.name_japanese}` : ""}
              </option>
            ))}
          </select>
          {errors.floorId && (
            <small class="admin-field-error">{errors.floorId}</small>
          )}
        </div>

        <div class="exit-form-row">
          <div class="admin-form-group">
            <label for="exit-name">Exit Name</label>
            <input
              id="exit-name"
              name="name"
              required
              maxlength="150"
              placeholder="e.g. North Exit"
              value={formValues.name}
            />
            {errors.name && (
              <small class="admin-field-error">{errors.name}</small>
            )}
          </div>

          <div class="admin-form-group">
            <label for="exit-code">Code (optional)</label>
            <input
              id="exit-code"
              name="code"
              maxlength="50"
              placeholder="e.g. A1"
              value={formValues.code}
            />
            {errors.code && (
              <small class="admin-field-error">{errors.code}</small>
            )}
          </div>
        </div>

        <div class="admin-form-group">
          <label for="exit-name-japanese">Japanese Name (optional)</label>
          <input
            id="exit-name-japanese"
            name="name_japanese"
            lang="ja"
            maxlength="150"
            placeholder="例: 北口"
            value={formValues.nameJapanese}
          />
          {errors.nameJapanese && (
            <small class="admin-field-error">{errors.nameJapanese}</small>
          )}
        </div>

        <div class="exit-form-row">
          <div class="admin-form-group">
            <label for="exit-color-code">Color (optional)</label>
            <div class="exit-color-field">
              <input
                type="color"
                id="exit-color-picker"
                value={pickerColor}
                aria-label="Choose exit color"
              />
              <input
                id="exit-color-code"
                name="color_code"
                maxlength="7"
                pattern="^#([0-9a-fA-F]{6})$"
                placeholder={DEFAULT_COLOR}
                value={formValues.colorCode}
              />
              <button
                type="button"
                class="admin-table-action"
                id="exit-color-clear"
              >
                Clear
              </button>
            </div>
            {errors.colorCode && (
              <small class="admin-field-error">{errors.colorCode}</small>
            )}
          </div>

          <div class="admin-form-group">
            <label for="exit-sort-order">Sort Order</label>
            <input
              id="exit-sort-order"
              name="sort_order"
              type="number"
              min="0"
              step="1"
              required
              value={formValues.sortOrder}
              data-default={nextSortOrder}
            />
            {errors.sortOrder && (
              <small class="admin-field-error">{errors.sortOrder}</small>
            )}
          </div>
        </div>

        <div class="admin-form-group">
          <label for="exit-description">Description (optional)</label>
          <textarea
            id="exit-description"
            name="description"
            rows="3"
            maxlength="500"
            placeholder="Optional directions or details"
          >{formValues.description}</textarea>
          {errors.description && (
            <small class="admin-field-error">{errors.description}</small>
          )}
        </div>

        <div class="admin-form-group">
          <label for="exit-description-japanese">
            Japanese Description (optional)
          </label>
          <textarea
            id="exit-description-japanese"
            name="description_japanese"
            lang="ja"
            rows="3"
            maxlength="500"
            placeholder="道順や詳細(任意)"
          >{formValues.descriptionJapanese}</textarea>
          {errors.descriptionJapanese && (
            <small class="admin-field-error">{errors.descriptionJapanese}</small>
          )}
        </div>

        <div class="admin-form-group">
          <label for="exit-photo-file">Photo (optional, PNG, JPEG or WebP up to 2 MB)</label>
          <div id="exit-photo-current" hidden>
            <img id="exit-photo-preview" alt="" style="display:block;width:140px;max-width:100%;margin-bottom:8px;border-radius:8px" />
            <label><input type="checkbox" name="remove_photo" /> Remove the current photo</label>
          </div>
          <input id="exit-photo-file" name="photo_file" type="file" accept="image/png,image/jpeg,image/webp" />
          {errors.photo && <small class="admin-field-error">{errors.photo}</small>}
        </div>

        <div class="admin-form-group">
          <label for="exit-photo-caption">Photo caption (optional)</label>
          <textarea id="exit-photo-caption" name="photo_caption" rows="2" maxlength="400" placeholder="What you see on leaving: ...">{formValues.photoCaption}</textarea>
          {errors.photoCaption && <small class="admin-field-error">{errors.photoCaption}</small>}
        </div>

        <div class="admin-form-group">
          <label for="exit-photo-caption-japanese">Japanese photo caption (optional)</label>
          <textarea id="exit-photo-caption-japanese" name="photo_caption_japanese" lang="ja" rows="2" maxlength="400">{formValues.photoCaptionJapanese}</textarea>
          {errors.photoCaptionJapanese && <small class="admin-field-error">{errors.photoCaptionJapanese}</small>}
        </div>

        <div class="admin-form-actions">
          <Button type="button" variant="secondary" id="cancel-exit-form">
            Cancel
          </Button>

          <Button type="submit" variant="primary" id="exit-submit">
            {editingId ? "Update Exit" : "Add Exit"}
          </Button>
        </div>
      </form>
    </div>
  </div>
)}

<!-- Delete form submitted only after confirmation -->
<form
  method="POST"
  id="delete-exit-form"
  action={`/admin/stations/${stationId}/exits`}
  hidden
>
  <input type="hidden" name="exit_action" value="delete" />
  <input type="hidden" name="exit_id" id="delete-exit-id" value="" />
</form>

<ConfirmDialog
  id="delete-exit-dialog"
  formId="delete-exit-form"
  title="Delete Exit"
  description="Are you sure you want to delete this exit?"
  confirmText="Delete Exit"
  cancelText="Cancel"
  variant="danger"
  showName={true}
  warning="The exit is also removed from the nearby exits of any facility that uses it. This action cannot be undone."
/>

<form
  method="POST"
  id="bulk-delete-exit-form"
  action={`/admin/stations/${stationId}/exits`}
  hidden
>
  <input type="hidden" name="exit_action" value="delete_many" />
</form>

<ConfirmDialog
  id="bulk-delete-exit-dialog"
  formId="bulk-delete-exit-form"
  title="Delete Exits"
  description="Are you sure you want to delete the selected exits?"
  confirmText="Delete Exits"
  cancelText="Cancel"
  variant="danger"
  warning="This action cannot be undone."
/>

<script>
  import "../../scripts/admin/station-exits-panel.ts";
</script>

