---
import Button from "../common/Button.astro";
import ConfirmDialog from "../common/ConfirmDialog.astro";

interface TopPick {
  id: number;
  name: string;
  name_japanese: string | null;
  slug: string;
  category: string;
  description: string | null;
  image_url: string | null;
  sort_order?: number;
  walking_minutes?: number | null;
}

interface Props {
  stationName: string;
  assignedTopPicks?: TopPick[];
  availableTopPicks: TopPick[];
}

const {
  stationName,
  assignedTopPicks = [],
  availableTopPicks,
} = Astro.props;
---

<!-- ========================================
     Top Picks
======================================== -->

<section class="admin-panel">

  <div class="admin-panel-body">

    <div class="admin-station-form">

      <!-- Header -->

      <div class="admin-station-form-header">

        <div
          style="
            display:flex;
            justify-content:space-between;
            align-items:center;
            gap:16px;
          "
        >

          <div>

            <h3>
              Top Picks
            </h3>

            <p>
              Manage the top picks available at
              <strong>{stationName}</strong>.
              Changes are applied when you save the station.
            </p>

          </div>

          {
            availableTopPicks.length > 0 && (
              <Button
                type="button"
                variant="primary"
                id="open-add-top-pick-button"
              >
                + Add Top Pick
              </Button>
            )
          }

        </div>

      </div>


      <!-- ========================================
           Temporary Top Pick Inputs
      ======================================== -->

      <div id="station-top-pick-inputs">

        {
          assignedTopPicks.map(
            (topPick) => (
              <input
                type="hidden"
                name="top_pick_ids"
                value={topPick.id}
                data-top-pick-input={topPick.id}
              />
            ),
          )
        }

      </div>


      <!-- ========================================
           Top Pick Table
      ======================================== -->

      <div class="admin-table-wrapper">

        <table
          class="admin-table"
          id="station-top-picks-table"
        >

          <thead>

            <tr>

              <th>
                Top Pick
              </th>

              <th>
                Slug
              </th>

              <th>
                Category
              </th>

              <th>
                Actions
              </th>

            </tr>

          </thead>


          <tbody id="station-top-picks-body">

            {
              assignedTopPicks.length > 0 ? (

                assignedTopPicks.map(
                  (topPick) => (

                    <tr
                      data-top-pick-row
                      data-top-pick-id={topPick.id}
                    >

                      <td>

                        <div class="admin-line-name">
                          {topPick.name}
                        </div>

                        {
                          topPick.name_japanese && (
                            <div
                              style="
                                margin-top:4px;
                                opacity:0.65;
                                font-size:0.85rem;
                              "
                            >
                              {topPick.name_japanese}
                            </div>
                          )
                        }

                      </td>


                      <td>

                        <span class="admin-line-slug">
                          {topPick.slug}
                        </span>

                      </td>


                      <td>

                        <span class="admin-line-slug">
                          {topPick.category}
                        </span>

                      </td>


                      <td>

                        <div class="admin-table-actions">

                          <button
                            type="button"
                            class="admin-table-action admin-table-action-delete"
                            data-remove-top-pick={topPick.id}
                            data-top-pick-name={topPick.name}
                          >
                            Remove
                          </button>

                        </div>

                      </td>

                    </tr>

                  ),
                )

              ) : (

                <tr id="station-top-picks-empty-row">

                  <td colspan="4">

                    <div class="admin-empty">

                      <div class="admin-empty-icon">
                        ◦
                      </div>

                      <h3>
                        No Top Picks Assigned
                      </h3>

                      <p>
                        There are currently no top picks
                        assigned to this station.
                      </p>

                    </div>

                  </td>

                </tr>

              )
            }

          </tbody>

        </table>

      </div>


      <!-- ========================================
           All Top Picks Assigned
      ======================================== -->

      <p
        id="all-top-picks-message"
        style="
          margin-top:12px;
          opacity:0.7;
        "
        hidden
      >
        All available top picks are already assigned
        to this station.
      </p>

    </div>

  </div>

</section>


<!-- ========================================
     Add Top Picks Modal
======================================== -->

<div
  id="add-top-pick-modal"
  class="admin-line-station-modal"
  hidden
  aria-hidden="true"
>

  <div
    class="admin-line-station-modal-backdrop"
    data-close-add-top-pick-modal
  ></div>


  <div
    class="admin-line-station-modal-dialog"
    role="dialog"
    aria-modal="true"
    aria-labelledby="add-top-pick-modal-title"
    aria-describedby="add-top-pick-modal-description"
  >

    <!-- Modal Header -->

    <div class="admin-line-station-modal-header">

      <div>

        <h2 id="add-top-pick-modal-title">
          Add Top Picks
        </h2>

        <p id="add-top-pick-modal-description">
          Select one or more top picks to add to
          {stationName}.
        </p>

      </div>


      <button
        type="button"
        class="admin-line-station-modal-close"
        id="close-add-top-pick-modal"
        aria-label="Close add top picks dialog"
      >
        ×
      </button>

    </div>


    <!-- ========================================
         Available Top Picks
    ======================================== -->

    {
      availableTopPicks.length > 0 ? (

        <div
          class="admin-form"
          id="add-top-picks-form"
        >

          <div class="admin-facility-checkbox-grid">

            {
              availableTopPicks.map(
                (topPick) => (

                  <label
                    class="admin-facility-checkbox-item"
                    data-top-pick-option
                    data-top-pick-option-id={topPick.id}
                  >

                    <input
                      type="checkbox"
                      value={topPick.id}
                      class="add-top-pick-checkbox"
                      data-top-pick-id={topPick.id}
                      data-top-pick-name={topPick.name}
                      data-top-pick-slug={topPick.slug}
                      data-top-pick-category={topPick.category}
                    />

                    <span>

                      <strong>
                        {topPick.name}
                      </strong>

                      <small
                        style="
                          display:block;
                          margin-top:3px;
                          opacity:0.65;
                        "
                      >
                        {topPick.category}
                      </small>

                    </span>

                  </label>

                ),
              )
            }

          </div>


          <!-- Selected Count -->

          <p
            id="selected-top-pick-count"
            style="
              margin-top:14px;
              opacity:0.7;
            "
          >
            0 top picks selected
          </p>


          <!-- Modal Actions -->

          <div class="admin-form-actions">

            <Button
              type="button"
              variant="secondary"
              id="cancel-add-top-picks"
            >
              Cancel
            </Button>

            <Button
              type="button"
              variant="primary"
              id="add-selected-top-picks"
              disabled
            >
              Add Selected
            </Button>

          </div>

        </div>

      ) : (

        <div class="admin-empty">

          <h3>
            No Top Picks Available
          </h3>

          <p>
            All top picks from the master list are already
            assigned to this station.
          </p>

        </div>

      )
    }

  </div>

</div>


<!-- ========================================
     Remove Top Pick Confirmation
======================================== -->

<ConfirmDialog
  id="remove-top-pick-confirm-dialog"
  title="Remove Top Pick"
  description="Are you sure you want to remove this top pick from the station?"
  confirmText="Remove"
  cancelText="Cancel"
  variant="danger"
/>


<script>
  import "../../scripts/admin/shared/station-top-picks.ts";
</script>