---
import "../../styles/admin/forms.css";
import "../../styles/admin/tables.css";
import "../../styles/admin/operators.css";
import "../../styles/admin/top-pick-stations.css";

import Alert from "../common/Alert.astro";
import EmptyState from "../common/EmptyState.astro";
import Button from "../common/Button.astro";
import type { PlaceKindInfo } from "../../lib/db/places";

export interface Props {
  info: PlaceKindInfo;
  page: any;
}

const { info, page } = Astro.props;
const { place, stations, assignments, assignedStationIds, successMessage, error } = page;
const lower = info.label.toLowerCase();
const ph =
  info.kind === "hotel"
    ? "Marunouchi South Exit, directly connected"
    : "Tokyo Ramen Street, First Avenue B1 south end";
---

<div class="admin-content top-pick-stations">
  {
    place ? (
      <>
        <div class="admin-page-header">
          <div>
            <h2>Manage {info.label} Stations</h2>
            <p>Choose the stations this {lower} appears at, and where it is from each station.</p>
          </div>
        </div>

        <section class="admin-panel">
          <div class="admin-panel-body">
            <h2>{place.name || place.name_japanese}</h2>
            {place.name && place.name_japanese && <p>{place.name_japanese}</p>}

            {successMessage && <Alert>{successMessage}</Alert>}
            {error && <Alert>{error}</Alert>}

            <hr />

            <div class="station-toolbar">
              <div class="station-search">
                <label for="station-search">Search stations</label>
                <input id="station-search" type="search" placeholder="Search station name..." />
              </div>
              <button type="button" id="open-add-modal" class="station-add-button">
                <span aria-hidden="true">+</span> Add Station
              </button>
            </div>

            <div class="admin-operator-form-header">
              <h2>
                Assigned Stations <span class="station-count">{assignments.length}</span>
              </h2>
            </div>

            {
              assignments.length === 0 ? (
                <EmptyState
                  icon="📍"
                  title="No Stations Assigned"
                  description={`Click Add Station to assign this ${lower} to a station.`}
                />
              ) : (
                <div class="station-table-wrap">
                  <table class="admin-table" id="assigned-stations-table">
                    <thead>
                      <tr>
                        <th>Station</th>
                        <th>Location from station</th>
                        <th>Order</th>
                        <th>Actions</th>
                      </tr>
                    </thead>
                    <tbody>
                      {assignments.map((a: any) => (
                        <tr
                          class="station-table-row"
                          data-search={`${a.station_name} ${a.station_name_japanese ?? ""} ${a.station_slug}`.toLowerCase()}
                        >
                          <td>
                            <strong>{a.station_name}</strong>
                            {a.station_name_japanese && <div class="station-secondary">{a.station_name_japanese}</div>}
                          </td>
                          <td>
                            {a.location || a.location_japanese ? (
                              <>
                                <div>{a.location || a.location_japanese}</div>
                                {a.location && a.location_japanese && (
                                  <div class="station-secondary">{a.location_japanese}</div>
                                )}
                              </>
                            ) : (
                              "—"
                            )}
                          </td>
                          <td>{a.sort_order}</td>
                          <td>
                            <div class="station-row-actions">
                              <button
                                type="button"
                                class="admin-table-action js-edit-assignment"
                                data-station-id={a.station_id}
                                data-station-name={a.station_name}
                                data-station-japanese={a.station_name_japanese ?? ""}
                                data-location={a.location ?? ""}
                                data-location-japanese={a.location_japanese ?? ""}
                                data-sort-order={a.sort_order}
                              >
                                Edit
                              </button>
                              <form method="POST" onsubmit="return confirm('Remove this station assignment?')">
                                <input type="hidden" name="action" value="remove" />
                                <input type="hidden" name="station_id" value={a.station_id} />
                                <button type="submit" class="admin-table-action admin-table-action-delete">Remove</button>
                              </form>
                            </div>
                          </td>
                        </tr>
                      ))}
                    </tbody>
                  </table>
                  <p id="station-search-empty" hidden>No matching stations found.</p>
                </div>
              )
            }
          </div>
        </section>

        <div id="station-modal" class="station-modal" hidden aria-hidden="true">
          <div class="station-modal-backdrop" data-close-modal></div>
          <section class="station-modal-dialog" role="dialog" aria-modal="true" aria-labelledby="station-modal-title">
            <header class="station-modal-header">
              <div>
                <h2 id="station-modal-title">Add Station</h2>
                <p id="station-modal-description">Assign this {lower} to a station.</p>
              </div>
              <button type="button" class="station-modal-close" data-close-modal aria-label="Close dialog">&times;</button>
            </header>

            <form id="station-assignment-form" method="POST" class="admin-form">
              <input type="hidden" name="action" value="save" />

              <div class="admin-form-group station-field">
                <div class="station-field-head">
                  <label for="station-picker-search">Station</label>
                  <span id="station-picker-count" class="station-picker-count" aria-live="polite"></span>
                </div>

                <div id="station-chip" class="station-chip" hidden>
                  <span class="station-chip-text">
                    <strong id="station-chip-name"></strong>
                    <span id="station-chip-jp"></span>
                  </span>
                  <button type="button" id="station-chip-clear" class="station-chip-clear">Change</button>
                </div>

                <div id="station-picker-body" class="station-picker-body">
                  <div class="station-picker-input">
                    <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" aria-hidden="true">
                      <circle cx="7" cy="7" r="4.6"></circle>
                      <path d="M10.5 10.5 14 14"></path>
                    </svg>
                    <input id="station-picker-search" type="search" placeholder="Search English or Japanese name" autocomplete="off" aria-label="Search stations" />
                  </div>
                  <div id="station-picker-list" class="station-picker-list" role="list" aria-label="Available stations">
                    {stations.map((s: any) => (
                      <button
                        type="button"
                        class="station-picker-option"
                        data-station-id={s.id}
                        data-station-name={s.name}
                        data-station-japanese={s.name_japanese ?? ""}
                        data-assigned={assignedStationIds.has(s.id) ? "true" : "false"}
                      >
                        <strong>{s.name}</strong>
                        {s.name_japanese && <span>{s.name_japanese}</span>}
                      </button>
                    ))}
                  </div>
                  <p id="station-picker-empty" hidden>No available matching stations found.</p>
                </div>

                <p id="station-picker-selected" class="station-picker-hint" aria-live="polite"></p>

                <select id="modal-station" name="station_id" hidden>
                  <option value="">Select a station</option>
                  {stations.map((s: any) => (
                    <option value={s.id} data-assigned={assignedStationIds.has(s.id) ? "true" : "false"}>
                      {s.name}{s.name_japanese ? ` (${s.name_japanese})` : ""}
                    </option>
                  ))}
                </select>
              </div>

              <div class="admin-form-group">
                <label for="modal-location">Location from this station</label>
                <input id="modal-location" name="location" maxlength="200" placeholder={ph} />
              </div>
              <div class="admin-form-group">
                <label for="modal-location-ja">Location (Japanese)</label>
                <input id="modal-location-ja" name="location_japanese" lang="ja" maxlength="200" />
              </div>
              <div class="admin-form-group">
                <label for="modal-order">Sort Order</label>
                <input id="modal-order" name="sort_order" type="number" min="0" step="1" value="0" required />
              </div>

              <footer class="station-modal-actions">
                <button type="button" class="station-cancel-button" data-close-modal>Cancel</button>
                <button type="submit" class="station-add-button" id="station-modal-submit">Add Station</button>
              </footer>
            </form>
          </section>
        </div>
      </>
    ) : (
      <>
        <div class="admin-page-header">
          <div>
            <h2>{info.label} Not Found</h2>
          </div>
        </div>
        <Button href={`/admin/${info.route}`} variant="secondary">Back to {info.plural}</Button>
      </>
    )
  }
</div>

<Fragment slot="after">
  <script>
    import "../../scripts/admin/place-stations";
  </script>
</Fragment>
