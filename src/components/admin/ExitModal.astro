
---
import Button from "../common/Button.astro";
import EmptyState from "../common/EmptyState.astro";
import type { StationFloor } from "../../lib/db/station-floors";

export interface Props {
  floors: StationFloor[];
}

const { floors } = Astro.props;
---

<div
  id="add-exit-modal"
  class="admin-line-station-modal"
  hidden
  aria-hidden="true"
>
  <div
    class="admin-line-station-modal-backdrop"
    data-close-add-exit-modal
  ></div>

  <div
    class="admin-line-station-modal-dialog"
    role="dialog"
    aria-modal="true"
    aria-labelledby="add-exit-modal-title"
    aria-describedby="add-exit-modal-description"
  >
    <div class="admin-line-station-modal-header">
      <div>
        <h2 id="add-exit-modal-title">Add Station Exits</h2>
        <p id="add-exit-modal-description">
          Select a floor, then enter the exit details. You can add multiple exits to the same floor.
        </p>
      </div>

      <button
        type="button"
        class="admin-line-station-modal-close"
        id="close-add-exit-modal"
        aria-label="Close add exits dialog"
      >
        ×
      </button>
    </div>

    {floors.length > 0 ? (
      <div class="admin-form" id="add-exits-form">
        <fieldset class="exit-floor-selector">
          <legend>Select Floor</legend>

          <div
            id="exit-floor-options"
            class="exit-floor-options"
            role="group"
            aria-label="Choose a floor for the exits"
          >
            {floors.map((floor) => (
              <button
                type="button"
                class="admin-floor-pill"
                data-exit-floor-option
                data-floor-id={floor.id}
                aria-pressed="false"
                title={
                  floor.name_japanese
                    ? `${floor.name} · ${floor.name_japanese}`
                    : floor.name
                }
              >
                {floor.name}
              </button>
            ))}
          </div>

          <input type="hidden" id="selected-exit-floor-id" value="" />
        </fieldset>

        <div class="exit-modal-fields">
          <label>
            Exit name *
            <input
              type="text"
              id="new-exit-name"
              maxlength="150"
              placeholder="e.g. North Exit"
              required
            />
          </label>

          <label>
            Exit code
            <input
              type="text"
              id="new-exit-code"
              maxlength="50"
              placeholder="e.g. A1"
            />
          </label>

          <label>
            Color
            <div class="exit-color-field">
              <input
                type="color"
                id="new-exit-color-picker"
                value="#2563EB"
                aria-label="Choose exit color"
              />
              <input
                type="text"
                id="new-exit-color-code"
                maxlength="7"
                pattern="^#([0-9a-fA-F]{6})$"
                placeholder="#2563EB"
                aria-label="Exit HEX color"
              />
              <button
                type="button"
                class="admin-table-action"
                id="clear-new-exit-color"
              >
                Clear
              </button>
            </div>
          </label>

          <label>
            Description
            <textarea
              id="new-exit-description"
              maxlength="500"
              rows="3"
              placeholder="Optional directions or details"
            ></textarea>
          </label>
        </div>

        <p id="exit-modal-error" class="exit-modal-error" role="alert" hidden></p>

        <div class="admin-form-actions">
          <Button
            type="button"
            variant="secondary"
            id="cancel-add-exits"
          >
            Cancel
          </Button>

          <Button
            type="button"
            variant="primary"
            id="add-new-exit"
            disabled
          >
            Add Exit
          </Button>
        </div>
      </div>
    ) : (
      <EmptyState
        title="No Floors Available"
        description="Create at least one floor for this station before adding exits."
      />
    )}
  </div>
</div>

<style>
  .exit-floor-selector {
    min-width: 0;
    margin: 0 0 1rem;
    padding: 0;
    border: 0;
  }

  .exit-floor-selector legend {
    margin-bottom: 0.65rem;
    font-weight: 600;
  }

  .exit-floor-options {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .admin-floor-pill {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.45rem 0.85rem;
    border: 1px solid var(--admin-border, #d1d5db);
    border-radius: 999px;
    background: var(--admin-muted-bg, #f3f4f6);
    color: var(--admin-text, #374151);
    font: inherit;
    font-size: 0.875rem;
    cursor: pointer;
  }

  .admin-floor-pill[aria-pressed="true"] {
    border-color: var(--admin-primary, #2563eb);
    background: var(--admin-primary, #2563eb);
    color: #fff;
  }

  .exit-modal-fields {
    display: grid;
    gap: 1rem;
  }

  .exit-modal-fields label {
    display: grid;
    gap: 0.4rem;
    font-weight: 600;
  }

  .exit-color-field {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .exit-color-field input[type="color"] {
    width: 2.5rem;
    height: 2.5rem;
    padding: 2px;
  }

  .exit-color-field input[type="text"] {
    width: 7rem;
  }

  .exit-modal-error {
    color: var(--admin-danger, #dc2626);
    font-size: 0.875rem;
  }
</style>
