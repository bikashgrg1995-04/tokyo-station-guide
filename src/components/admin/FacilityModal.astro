---
import Button from "../common/Button.astro";
import EmptyState from "../common/EmptyState.astro";
import type { Facility } from "../../lib/db/facilities";

export interface Props {
  /** Facilities that can still be added. */
  facilities: Facility[];
  /** Text under the dialog title. */
  description: string;
  /** Text shown when there is nothing to add. */
  emptyDescription: string;
}

const { facilities, description, emptyDescription } = Astro.props;
---

<div
      id="add-facility-modal"
      class="admin-line-station-modal"
      hidden
      aria-hidden="true"
    >
      <div
        class="admin-line-station-modal-backdrop"
        data-close-add-facility-modal
      ></div>

      <div
        class="admin-line-station-modal-dialog"
        role="dialog"
        aria-modal="true"
        aria-labelledby="add-facility-modal-title"
        aria-describedby="add-facility-modal-description"
      >
        <div
          class="admin-line-station-modal-header"
        >
          <div>
            <h2 id="add-facility-modal-title">
              Add Facilities
            </h2>

            <p id="add-facility-modal-description">{description}</p>
          </div>

          <button
            type="button"
            class="admin-line-station-modal-close"
            id="close-add-facility-modal"
            aria-label="Close add facilities dialog"
          >
            ×
          </button>
        </div>

        {
          facilities.length > 0 ? (
            <div
              class="admin-form"
              id="add-facilities-form"
            >
              <div class="admin-facility-checkbox-grid">
                {facilities.map(
                  (facility) => (
                    <label
                      class="admin-facility-checkbox-item"
                      data-facility-option
                      data-facility-option-id={
                        facility.id
                      }
                    >
                      <input
                        type="checkbox"
                        value={facility.id}
                        class="add-facility-checkbox"
                        data-facility-id={
                          facility.id
                        }
                        data-facility-name={
                          facility.name
                        }
                      />

                      <span>
                        {facility.name}
                      </span>
                    </label>
                  ),
                )}
              </div>

              <p
                id="selected-facility-count"
                class="admin-feature-message"
              >
                0 facilities selected
              </p>

              <div class="admin-form-actions">
                <Button
                  type="button"
                  variant="secondary"
                  id="cancel-add-facilities"
                >
                  Cancel
                </Button>

                <Button
                  type="button"
                  variant="primary"
                  id="add-selected-facilities"
                  disabled
                >
                  Add Selected
                </Button>
              </div>
            </div>
          ) : (
            <EmptyState
              title="No Facilities Available"
              description={emptyDescription}
            />
          )
        }
      </div>
    </div>
