---
import "../../styles/common/admin-navigation.css";
import ConfirmDialog from "../common/ConfirmDialog.astro";

export interface Props {
  activePath?: string;
}

const { activePath = "/admin" } = Astro.props;

const isActive = (path: string) => {
  if (path === "/admin") {
    return activePath === "/admin";
  }

  return activePath.startsWith(path);
};
---

<aside class="admin-sidebar" id="admin-sidebar">
  <!-- Brand -->
  <div class="admin-brand">
    <div class="admin-brand-top">
      <div class="admin-logo">T</div>

      <div>
        <h1>Tokyo Station Guide</h1>

        <p>Content Management</p>
      </div>
    </div>
  </div>

  <!-- Management -->
  <div class="admin-section-label">Management</div>

  <nav class="admin-nav" aria-label="Management">
    <a
      href="/admin"
      class:list={{
        active: isActive("/admin"),
      }}
      aria-current={isActive("/admin") ? "page" : undefined}
    >
      <span class="admin-nav-icon" aria-hidden="true"> ⌂ </span>

      <span> Dashboard </span>
    </a>

    <a
      href="/admin/operators"
      class:list={{
        active: isActive("/admin/operators"),
      }}
      aria-current={isActive("/admin/operators") ? "page" : undefined}
    >
      <span class="admin-nav-icon" aria-hidden="true"> ◉ </span>

      <span> Operators </span>
    </a>

    <a
      href="/admin/lines"
      class:list={{
        active: isActive("/admin/lines"),
      }}
      aria-current={isActive("/admin/lines") ? "page" : undefined}
    >
      <span class="admin-nav-icon" aria-hidden="true"> ↔ </span>

      <span> Lines </span>
    </a>

    <a
      href="/admin/stations"
      class:list={{
        active: isActive("/admin/stations"),
      }}
      aria-current={isActive("/admin/stations") ? "page" : undefined}
    >
      <span class="admin-nav-icon" aria-hidden="true"> ◎ </span>

      <span> Stations </span>
    </a>

    <a
      href="/admin/facilities"
      class:list={{
        active: isActive("/admin/facilities"),
      }}
      aria-current={isActive("/admin/facilities") ? "page" : undefined}
    >
      <span class="admin-nav-icon" aria-hidden="true"> ▦ </span>

      <span> Facilities </span>
    </a>

        <a
      href="/admin/places"
      class:list={{
        active: isActive("/admin/places"),
      }}
      aria-current={isActive("/admin/places") ? "page" : undefined}
    >
      <span class="admin-nav-icon" aria-hidden="true"> ★ </span>

      <span> Places </span>
    </a>

        <a
      href="/admin/hotels"
      class:list={{
        active: isActive("/admin/hotels"),
      }}
      aria-current={isActive("/admin/hotels") ? "page" : undefined}
    >
      <span class="admin-nav-icon" aria-hidden="true"> 🏨 </span>

      <span> Hotels </span>
    </a>

        <a
      href="/admin/restaurants"
      class:list={{
        active: isActive("/admin/restaurants"),
      }}
      aria-current={isActive("/admin/restaurants") ? "page" : undefined}
    >
      <span class="admin-nav-icon" aria-hidden="true"> 🍴 </span>

      <span> Restaurants </span>
    </a>

    <a
      href="/admin/featured-stations"
      class:list={{
        active: isActive("/admin/featured-stations"),
      }}
      aria-current={isActive("/admin/featured-stations") ? "page" : undefined}
    >
      <span class="admin-nav-icon" aria-hidden="true"> ★ </span>

      <span> Featured Stations </span>
    </a>

    <a
      href="/admin/suggestions"
      class:list={{
        active: isActive("/admin/suggestions"),
      }}
      aria-current={isActive("/admin/suggestions") ? "page" : undefined}
    >
      <span class="admin-nav-icon" aria-hidden="true"> ✎ </span>

      <span> Suggestions </span>
    </a>

  </nav>

  <!-- System -->
  <div class="admin-section-label">System</div>

  <nav class="admin-nav" aria-label="System">
    <a
      href="/admin/settings"
      class:list={{ active: isActive("/admin/settings") }}
      aria-current={isActive("/admin/settings") ? "page" : undefined}
    >
      <span class="admin-nav-icon" aria-hidden="true"> ⚙ </span>

      <span> Settings </span>
    </a>

    <form
      method="POST"
      action="/admin/auth/logout"
      class="admin-logout-form"
      id="admin-logout-form"
    >
      <button
        type="submit"
        class="admin-logout-button"
        id="admin-logout-button"
      >
        <span class="admin-nav-icon" aria-hidden="true"> ↪ </span>

        <span> Logout </span>
      </button>
    </form>
  </nav>

  <!-- Sidebar Bottom -->
  <div class="admin-sidebar-bottom">
    
    <a href="/" class="admin-back-link"> ← Back to website </a>
  </div>
</aside>

<!-- Logout Confirmation -->
<ConfirmDialog
  id="admin-logout-dialog"
  title="Logout"
  description="Are you sure you want to logout from the admin panel?"
  confirmText="Logout"
  cancelText="Cancel"
  variant="danger"
/>

<script>
  import "../../scripts/admin/shared/admin-navigation.ts";
</script>
