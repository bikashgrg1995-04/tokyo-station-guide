---
import SimSection from "../SimSection.astro";
import type { Row } from "../SimSection.astro";
import { handleSights } from "../../../lib/services/station-sights";
import { getStationById } from "../../../lib/db/stations";
import { TOP_PICK_CATEGORIES } from "../../../lib/db/top-picks";

export interface Props {
  station: NonNullable<Awaited<ReturnType<typeof getStationById>>>;
  id: number;
  form: Awaited<ReturnType<typeof handleSights>>;
  mediaBase: string;
}
const { station, form, mediaBase } = Astro.props;
const src = (k: string) => (/^https?:\/\//i.test(k) ? k : `${mediaBase}/${k}`);

const FLAGS = [
  { key: "top", label: "Top pick" },
  { key: "thing", label: "Thing to do" },
  { key: "exit", label: "Which exit?" },
  { key: "trip", label: "Day trip" },
];
const flagsOf = (t: (typeof form.sights)[number]) =>
  [t.is_top_pick && "top", t.is_thing && "thing", t.is_which_exit && "exit", t.is_day_trip && "trip"].filter(Boolean) as string[];

const nextOrder = form.sights.reduce((m, t) => Math.max(m, t.sort_order), 0) + 1;
const rows: Row[] = form.sights.map((t) => {
  const flags = flagsOf(t);
  return {
    id: t.top_pick_id,
    flags: flags.join(" "),
    search: [t.name, t.name_japanese, t.category, t.kind, t.exit_name, t.location, t.location_japanese, ...flags].join(" "),
    item: {
      item_id: String(t.top_pick_id), place_name: t.name || t.name_japanese || "", category: t.category,
      exit_id: t.exit_id ? String(t.exit_id) : "", walking_minutes: t.walking_minutes != null ? String(t.walking_minutes) : "",
      location_type: t.location_type, location: t.location ?? "", location_japanese: t.location_japanese ?? "",
      sort_order: String(t.sort_order),
      is_top_pick: t.is_top_pick ? "on" : "", top_text: t.top_text ?? "", top_text_japanese: t.top_text_japanese ?? "",
      top_caption: t.top_caption ?? "", top_caption_japanese: t.top_caption_japanese ?? "",
      is_thing: t.is_thing ? "on" : "", thing_text: t.thing_text ?? "", thing_text_japanese: t.thing_text_japanese ?? "",
      thing_caption: t.thing_caption ?? "", thing_caption_japanese: t.thing_caption_japanese ?? "",
      is_which_exit: t.is_which_exit ? "on" : "", exit_note: t.exit_note ?? "", exit_note_japanese: t.exit_note_japanese ?? "",
      extra_exits: t.extra_exits.map((x) => x.exit_id).join(","),
      is_day_trip: t.is_day_trip ? "on" : "", travel_time: t.travel_time ?? "", travel_time_japanese: t.travel_time_japanese ?? "",
      transport: t.transport ?? "", transport_japanese: t.transport_japanese ?? "",
    },
    cells: [
      { img: t.image_url ? src(t.image_url) : undefined, main: String(t.sort_order) },
      { main: t.name || t.name_japanese || "", badge: t.category },
      { clip: [t.exit_name, t.walking_minutes != null ? `${t.walking_minutes} min` : ""].filter(Boolean).join(" · ") },
      { badges: flags.map((f) => FLAGS.find((x) => x.key === f)!.label) },
    ],
  };
});
---

<SimSection
  anchor="places"
  title="Places"
  hint={`Every place of <b>${station.name}</b> in one table: choose a place from <a href="/admin/places"><b>Places</b></a>, then tick where the website shows it (Top pick, Thing to do, Which exit?, Day trip). The exit and walking minutes are only for this station.`}
  noun="place"
  columns={["Order", "Place", "Exit · minutes", "Shown in"]}
  rows={rows}
  filters={FLAGS}
  actionName="trip_action"
  createValue="trip_create"
  updateValue="trip_update"
  deleteValue="trip_delete"
  nextOrder={nextOrder}
  formError={form.formError}
  posted={form.posted}
  reopenMode={form.errorFor === "thing-new" ? "create" : "update"}
  searchPlaceholder="Search places..."
  emptyHint="Click Add place and choose a place from Places."
>
  <div data-sim-create-only>
    <div class="sim-grid2">
      <div class="admin-form-group">
        <label>Category</label>
        <select data-sim-filter="existing_id">
          <option value="">All categories</option>
          {TOP_PICK_CATEGORIES.map((c) => <option value={c}>{c}</option>)}
        </select>
      </div>
      <div class="admin-form-group">
        <label>Place</label>
        <select name="existing_id">
          <option value="">Choose a place…</option>
          {form.unlinked.map((u) => <option value={u.id} data-category={u.category}>{u.name}</option>)}
        </select>
      </div>
    </div>
    <p class="sim-hint">Not in the list? <a href="/admin/places/new">Add it in Places</a> first.</p>
  </div>
  <div data-sim-edit-only class="sim-place-line">
    <span>Place</span> <strong data-sim-text="place_name"></strong>
    <a data-sim-href="/admin/places/{id}/edit" target="_blank" rel="noopener">Edit place details ↗</a>
  </div>

  <div class="sim-block">
    <div class="sim-block-head"><strong>At this station</strong><span class="sim-where">Used by every place below: where it is from {station.name}</span></div>
    <div class="sim-grid2">
      <div class="admin-form-group"><label>Exit</label>
        <select name="exit_id"><option value="">— none —</option>{form.exits.map((e) => <option value={e.id}>{e.name}</option>)}</select>
      </div>
      <div class="admin-form-group"><label>Walking minutes</label><input name="walking_minutes" type="number" min="0" max="120" /></div>
      <div class="admin-form-group"><label>Order</label><input name="sort_order" type="number" min="0" value="0" /></div>
      <div class="admin-form-group"><label>Extra location note</label><input name="location" maxlength="150" placeholder="Near the east gate" /></div>
      <div class="admin-form-group"><label>Extra location note (Japanese)</label><input name="location_japanese" maxlength="150" lang="ja" /></div>
    </div>
  </div>

  <p class="sim-hint"><b>Where should it show?</b> Tick one or more. The fields of a ticked place appear below it.</p>

  <div class="sim-flag">
    <label class="sim-flag-head">
      <input type="checkbox" name="is_top_pick" />
      <div><strong>Top pick</strong><span>Website main page and the map popup of this station</span></div>
    </label>
    <div class="sim-flag-body" data-sim-when="is_top_pick" hidden>
      <div class="admin-form-group"><label>Inside / outside</label>
        <select name="location_type"><option value="inside">Inside station</option><option value="outside">Outside</option><option value="inside_outside">Both</option></select>
      </div>
      <div class="sim-grid2">
        <div class="admin-form-group"><label>Top pick info <small>Text in the map popup. Empty = the visitor notes of the place.</small></label><textarea name="top_text" rows="2" maxlength="600"></textarea></div>
        <div class="admin-form-group"><label>Top pick info (Japanese)</label><textarea name="top_text_japanese" rows="2" maxlength="600" lang="ja"></textarea></div>
        <div class="admin-form-group"><label>Image caption <small>Under the place photo in the popup.</small></label><input name="top_caption" maxlength="200" /></div>
        <div class="admin-form-group"><label>Image caption (Japanese)</label><input name="top_caption_japanese" maxlength="200" lang="ja" /></div>
      </div>
    </div>
  </div>

  <div class="sim-flag">
    <label class="sim-flag-head">
      <input type="checkbox" name="is_thing" />
      <div><strong>Thing to do</strong><span>Station page, section "Things to do"</span></div>
    </label>
    <div class="sim-flag-body" data-sim-when="is_thing" hidden>
      <div class="sim-grid2">
        <div class="admin-form-group"><label>Thing to do info <small>Text in the list. Empty = the place description.</small></label><textarea name="thing_text" rows="3" maxlength="1000"></textarea></div>
        <div class="admin-form-group"><label>Thing to do info (Japanese)</label><textarea name="thing_text_japanese" rows="3" maxlength="1000" lang="ja"></textarea></div>
        <div class="admin-form-group"><label>Image caption <small>Under the place photo.</small></label><input name="thing_caption" maxlength="200" /></div>
        <div class="admin-form-group"><label>Image caption (Japanese)</label><input name="thing_caption_japanese" maxlength="200" lang="ja" /></div>
      </div>
    </div>
  </div>

  <div class="sim-flag">
    <label class="sim-flag-head">
      <input type="checkbox" name="is_which_exit" />
      <div><strong>Which exit?</strong><span>Station page, "Which exit?" finder. Needs an exit (set above)</span></div>
    </label>
    <div class="sim-flag-body" data-sim-when="is_which_exit" hidden>
      <div class="sim-grid2">
        <div class="admin-form-group"><label>Exit note <small>Shown next to the exit. Empty = minutes + location note.</small></label><input name="exit_note" maxlength="200" placeholder="Straight ahead, 2 min" /></div>
        <div class="admin-form-group"><label>Exit note (Japanese)</label><input name="exit_note_japanese" maxlength="200" lang="ja" /></div>
      </div>
      <div class="admin-form-group"><label>Also reachable from these exits <small>Optional. Ticked exits list this place too.</small></label>
        <div class="side-exit-checks">
          {form.exits.map((e) => (
            <label class="side-exit-check"><input type="checkbox" name="extra_exits" value={e.id} />{e.name}</label>
          ))}
        </div>
      </div>
    </div>
  </div>

  <div class="sim-flag">
    <label class="sim-flag-head">
      <input type="checkbox" name="is_day_trip" />
      <div><strong>Day trip</strong><span>Station page, section "Day trips"</span></div>
    </label>
    <div class="sim-flag-body" data-sim-when="is_day_trip" hidden>
      <div class="sim-grid2">
        <div class="admin-form-group"><label>Travel time</label><input name="travel_time" maxlength="80" placeholder="≈ 25–40 min" /></div>
        <div class="admin-form-group"><label>Travel time (Japanese)</label><input name="travel_time_japanese" maxlength="80" lang="ja" /></div>
        <div class="admin-form-group"><label>Transport</label><input name="transport" maxlength="150" placeholder="JR lines, direct" /></div>
        <div class="admin-form-group"><label>Transport (Japanese)</label><input name="transport_japanese" maxlength="150" lang="ja" /></div>
      </div>
    </div>
  </div>
</SimSection>
