---
import SimSection from "../SimSection.astro";
import type { Row } from "../SimSection.astro";
import { handlePracticalTips } from "../../../lib/services/station-practical-tips";
import { getStationById } from "../../../lib/db/stations";

export interface Props {
  station: NonNullable<Awaited<ReturnType<typeof getStationById>>>;
  id: number;
  form: Awaited<ReturnType<typeof handlePracticalTips>>;
  mediaBase: string;
}
const { station, form, mediaBase } = Astro.props;
const src = (k: string) => (/^https?:\/\//i.test(k) ? k : `${mediaBase}/${k}`);
void src;

const nextOrder = form.tips.reduce((m, t) => Math.max(m, t.sort_order), 0) + 1;
const rows: Row[] = form.tips.map((t) => ({
  id: t.id,
  search: `${t.tip} ${t.tip_japanese ?? ""}`,
  item: { item_id: String(t.id), tip: t.tip, tip_japanese: t.tip_japanese ?? "", sort_order: String(t.sort_order) },
  cells: [{ main: String(t.sort_order) }, { clip: t.tip || t.tip_japanese || "", sub: t.tip ? (t.tip_japanese ?? "") : "" }],
}));
---

<SimSection
  anchor="practical-tips"
  title="Practical tips"
  hint={`Short bullet points shown under <b>Practical tips</b> on the ${station.name} page (luggage, crowds, best time...).`}
  noun="tip"
  columns={["Order", "Tip"]}
  rows={rows}
  actionName="tips_action"
  createValue="tip_create"
  updateValue="tip_update"
  deleteValue="tip_delete"
  nextOrder={nextOrder}
  formError={form.formError}
  posted={form.posted}
  reopenMode={form.errorFor === "tip-new" ? "create" : "update"}
>
  <div class="admin-form-group"><label>Tip</label><textarea name="tip" required rows="3" maxlength="800"></textarea></div>
  <div class="admin-form-group"><label>Tip (Japanese)</label><textarea name="tip_japanese" lang="ja" rows="3" maxlength="800"></textarea></div>
  <div class="admin-form-group"><label>Order</label><input name="sort_order" type="number" min="0" value="0" /></div>
</SimSection>
