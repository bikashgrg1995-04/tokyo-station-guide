---
import SimSection from "../SimSection.astro";
import type { Row } from "../SimSection.astro";
import { handleTransport } from "../../../lib/services/station-transport";
import { getStationById } from "../../../lib/db/stations";

export interface Props {
  station: NonNullable<Awaited<ReturnType<typeof getStationById>>>;
  id: number;
  form: Awaited<ReturnType<typeof handleTransport>>;
  mediaBase: string;
}
const { station, form, mediaBase } = Astro.props;
const src = (k: string) => (/^https?:\/\//i.test(k) ? k : `${mediaBase}/${k}`);
void src;

const nextOrder = form.items.reduce((m, t) => Math.max(m, t.sort_order), 0) + 1;
const rows: Row[] = form.items.map((t) => ({
  id: t.id,
  search: [t.place, t.place_japanese, t.service, t.notes, t.photo_title].join(" "),
  item: {
    item_id: String(t.id), place: t.place, place_japanese: t.place_japanese ?? "", service: t.service ?? "", service_japanese: t.service_japanese ?? "",
    notes: t.notes ?? "", notes_japanese: t.notes_japanese ?? "", photo_title: t.photo_title ?? "", photo_title_japanese: t.photo_title_japanese ?? "",
    photo_caption: t.photo_caption ?? "", photo_caption_japanese: t.photo_caption_japanese ?? "", sort_order: String(t.sort_order),
    photo_url: t.photo ? src(t.photo) : "",
  },
  cells: [
    { img: t.photo ? src(t.photo) : undefined, main: String(t.sort_order) },
    { main: t.place || t.place_japanese || "" },
    { clip: t.service || t.service_japanese || t.notes || t.notes_japanese || "" },
  ],
}));
---

<SimSection
  anchor="buses-taxis"
  title="Buses & taxis"
  hint={`The <b>Buses &amp; taxis</b> section. A row with service or notes appears in the table (Where / Service / Notes); a row with a photo also gets a photo card (title + caption). Leave service and notes empty to show only the photo card.`}
  noun="row"
  columns={["Order", "Where", "Service / notes"]}
  rows={rows}
  actionName="guide_action"
  createValue="guide_create"
  updateValue="guide_update"
  deleteValue="guide_delete"
  multipart
  nextOrder={nextOrder}
  formError={form.formError}
  posted={form.posted}
  reopenMode={form.errorFor === "item-new" ? "create" : "update"}
>
  <div class="sim-grid2">
    <div class="admin-form-group"><label>Where</label><input name="place" maxlength="150" placeholder="Marunouchi North Exit"></div>
    <div class="admin-form-group"><label>Where (Japanese)</label><input name="place_japanese" maxlength="150" lang="ja"></div>
    <div class="admin-form-group"><label>Service</label><textarea name="service" rows="2" maxlength="400"></textarea></div>
    <div class="admin-form-group"><label>Service (Japanese)</label><textarea name="service_japanese" lang="ja" rows="2" maxlength="400"></textarea></div>
    <div class="admin-form-group"><label>Notes</label><textarea name="notes" rows="2" maxlength="800"></textarea></div>
    <div class="admin-form-group"><label>Notes (Japanese)</label><textarea name="notes_japanese" lang="ja" rows="2" maxlength="800"></textarea></div>
    <div class="admin-form-group"><label>Photo title</label><input name="photo_title" maxlength="150"></div>
    <div class="admin-form-group"><label>Photo title (Japanese)</label><input name="photo_title_japanese" maxlength="150" lang="ja"></div>
    <div class="admin-form-group"><label>Photo caption</label><input name="photo_caption" maxlength="400"></div>
    <div class="admin-form-group"><label>Photo caption (Japanese)</label><input name="photo_caption_japanese" maxlength="400" lang="ja"></div>
  </div>
  <div class="admin-form-group"><label>Order</label><input name="sort_order" type="number" min="0" value="0" /></div>
  <div class="sim-photo">
    <label>Photo (optional, PNG, JPEG or WebP up to 2 MB)</label>
    <div class="sim-photo-prev" data-sim="photo-preview" hidden>
      <img alt="" src="" />
      <label><input type="checkbox" name="remove_photo" /> Remove current photo</label>
    </div>
    <input name="photo_file" type="file" accept="image/png,image/jpeg,image/webp" />
  </div>
</SimSection>
