---
import SimSection from "../SimSection.astro";
import type { Row } from "../SimSection.astro";
import { handleThings } from "../../../lib/services/station-things";
import { getStationById } from "../../../lib/db/stations";

export interface Props {
  station: NonNullable<Awaited<ReturnType<typeof getStationById>>>;
  id: number;
  form: Awaited<ReturnType<typeof handleThings>>;
  mediaBase: string;
}
const { station, form, mediaBase } = Astro.props;
const src = (k: string) => (/^https?:\/\//i.test(k) ? k : `${mediaBase}/${k}`);
void src;

const nextOrder = form.things.reduce((m, t) => Math.max(m, t.sort_order), 0) + 1;
const rows: Row[] = form.things.map((t) => ({
  id: t.id,
  search: [t.name, t.name_japanese, t.kind, t.kind_japanese, t.location, t.location_japanese, t.cost, t.description].join(" "),
  item: {
    item_id: String(t.id), name: t.name, name_japanese: t.name_japanese ?? "", kind: t.kind ?? "", kind_japanese: t.kind_japanese ?? "",
    location: t.location ?? "", location_japanese: t.location_japanese ?? "", cost: t.cost ?? "", cost_japanese: t.cost_japanese ?? "",
    description: t.description ?? "", description_japanese: t.description_japanese ?? "", map_url: t.map_url ?? "",
    sort_order: String(t.sort_order), photo_url: t.photo ? src(t.photo) : "",
  },
  cells: [
    { img: t.photo ? src(t.photo) : undefined, main: String(t.sort_order) },
    { main: t.name || t.name_japanese || "" },
    { clip: [t.kind || t.kind_japanese, t.cost || t.cost_japanese].filter(Boolean).join(" · ") },
  ],
}));
---

<SimSection
  anchor="things-to-do"
  title="Things to do"
  hint={`Places to see near the station, shown under <b>Things to do</b> with a photo. The grey line under the name = kind · location · cost.`}
  noun="place"
  columns={["Order", "Name", "Kind · cost"]}
  rows={rows}
  actionName="trip_action"
  createValue="trip_create"
  updateValue="trip_update"
  deleteValue="trip_delete"
  multipart
  nextOrder={nextOrder}
  formError={form.formError}
  posted={form.posted}
  reopenMode={form.errorFor === "thing-new" ? "create" : "update"}
>
  <div class="sim-grid2">
    <div class="admin-form-group"><label>Name</label><input name="name" maxlength="150" placeholder="Imperial Palace East Gardens"></div>
    <div class="admin-form-group"><label>Name (Japanese)</label><input name="name_japanese" maxlength="150" lang="ja"></div>
    <div class="admin-form-group"><label>Kind</label><input name="kind" maxlength="60" placeholder="Garden"></div>
    <div class="admin-form-group"><label>Kind (Japanese)</label><input name="kind_japanese" maxlength="60" lang="ja"></div>
    <div class="admin-form-group"><label>Location</label><input name="location" maxlength="150" placeholder="Marunouchi North Exit, about 13 min"></div>
    <div class="admin-form-group"><label>Location (Japanese)</label><input name="location_japanese" maxlength="150" lang="ja"></div>
    <div class="admin-form-group"><label>Cost</label><input name="cost" maxlength="100" placeholder="Free"></div>
    <div class="admin-form-group"><label>Cost (Japanese)</label><input name="cost_japanese" maxlength="100" lang="ja"></div>
  </div>
  <div class="admin-form-group"><label>Description</label><textarea name="description" rows="3" maxlength="800"></textarea></div>
  <div class="admin-form-group"><label>Description (Japanese)</label><textarea name="description_japanese" lang="ja" rows="3" maxlength="800"></textarea></div>
  <div class="sim-grid2">
    <div class="admin-form-group"><label>Map link</label><input name="map_url" type="url" maxlength="500" placeholder="https://maps.google.com/..." /></div>
    <div class="admin-form-group"><label>Order</label><input name="sort_order" type="number" min="0" value="0" /></div>
  </div>
  <div class="sim-photo">
    <label>Photo (optional, PNG, JPEG or WebP up to 2 MB)</label>
    <div class="sim-photo-prev" data-sim="photo-preview" hidden>
      <img alt="" src="" />
      <label><input type="checkbox" name="remove_photo" /> Remove current photo</label>
    </div>
    <input name="photo_file" type="file" accept="image/png,image/jpeg,image/webp" />
  </div>
</SimSection>
