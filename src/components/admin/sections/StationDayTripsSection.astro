---
import SimSection from "../SimSection.astro";
import type { Row } from "../SimSection.astro";
import { handleDayTrips } from "../../../lib/services/station-day-trips";
import { getStationById } from "../../../lib/db/stations";

export interface Props {
  station: NonNullable<Awaited<ReturnType<typeof getStationById>>>;
  id: number;
  form: Awaited<ReturnType<typeof handleDayTrips>>;
  mediaBase: string;
}
const { station, form, mediaBase } = Astro.props;
const src = (k: string) => (/^https?:\/\//i.test(k) ? k : `${mediaBase}/${k}`);
void src;

const nextOrder = form.trips.reduce((m, t) => Math.max(m, t.sort_order), 0) + 1;
const rows: Row[] = form.trips.map((t) => ({
  id: t.id,
  search: [t.name, t.name_japanese, t.travel_time, t.transport, t.description].join(" "),
  item: {
    item_id: String(t.id), name: t.name, name_japanese: t.name_japanese ?? "", travel_time: t.travel_time ?? "",
    travel_time_japanese: t.travel_time_japanese ?? "", transport: t.transport ?? "", transport_japanese: t.transport_japanese ?? "",
    description: t.description ?? "", description_japanese: t.description_japanese ?? "", map_url: t.map_url ?? "",
    sort_order: String(t.sort_order), photo_url: t.photo ? src(t.photo) : "",
  },
  cells: [
    { img: t.photo ? src(t.photo) : undefined, main: String(t.sort_order) },
    { main: t.name || t.name_japanese || "" },
    { clip: t.travel_time || t.travel_time_japanese || "" },
  ],
}));
---

<SimSection
  anchor="day-trips"
  title="Day trips"
  hint={`Places reachable in a day from ${station.name}, shown under <b>Day trips</b> with travel time and transport.`}
  noun="day trip"
  columns={["Order", "Destination", "Travel time"]}
  rows={rows}
  actionName="trip_action"
  createValue="trip_create"
  updateValue="trip_update"
  deleteValue="trip_delete"
  multipart
  nextOrder={nextOrder}
  formError={form.formError}
  posted={form.posted}
  reopenMode={form.errorFor === "trip-new" ? "create" : "update"}
>
  <div class="sim-grid2">
    <div class="admin-form-group"><label>Name</label><input name="name" maxlength="150" placeholder="Yokohama"></div>
    <div class="admin-form-group"><label>Name (Japanese)</label><input name="name_japanese" maxlength="150" lang="ja"></div>
    <div class="admin-form-group"><label>Travel time</label><input name="travel_time" maxlength="60" placeholder="≈ 25–40 min"></div>
    <div class="admin-form-group"><label>Travel time (Japanese)</label><input name="travel_time_japanese" maxlength="60" lang="ja"></div>
    <div class="admin-form-group"><label>Transport</label><input name="transport" maxlength="120" placeholder="JR lines, direct"></div>
    <div class="admin-form-group"><label>Transport (Japanese)</label><input name="transport_japanese" maxlength="120" lang="ja"></div>
  </div>
  <div class="admin-form-group"><label>Description</label><textarea name="description" rows="3" maxlength="600"></textarea></div>
  <div class="admin-form-group"><label>Description (Japanese)</label><textarea name="description_japanese" lang="ja" rows="3" maxlength="600"></textarea></div>
  <div class="sim-grid2">
    <div class="admin-form-group"><label>Map link</label><input name="map_url" type="url" maxlength="500" placeholder="https://maps.google.com/..." /></div>
    <div class="admin-form-group"><label>Order</label><input name="sort_order" type="number" min="0" value="0" /></div>
  </div>
  <div class="sim-photo">
    <label>Photo (optional, PNG, JPEG or WebP up to 2 MB)</label>
    <div class="sim-photo-prev" data-sim="photo-preview" hidden>
      <img alt="" src="" />
      <label><input type="checkbox" name="remove_photo" /> Remove current photo</label>
    </div>
    <input name="photo_file" type="file" accept="image/png,image/jpeg,image/webp" />
  </div>
</SimSection>
