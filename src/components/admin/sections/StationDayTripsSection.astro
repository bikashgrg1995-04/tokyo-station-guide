---
import "../../../styles/admin/forms.css";
import "../../../styles/admin/stations.css";
import "../../../styles/admin/station-sides.css";
import { handleDayTrips } from "../../../lib/services/station-day-trips";
import { getStationById } from "../../../lib/db/stations";

export interface Props {
  station: NonNullable<Awaited<ReturnType<typeof getStationById>>>;
  id: number;
  form: Awaited<ReturnType<typeof handleDayTrips>>;
  mediaBase: string;
}

const { station, id, form: __form, mediaBase } = Astro.props;
const form = __form;

const src = (k: string) => (/^https?:\/\//i.test(k) ? k : `${mediaBase}/${k}`);
const nextOrder = form.trips.reduce((max, t) => Math.max(max, t.sort_order), 0) + 1;

const blank = {
  id: 0, name: "", name_japanese: "", travel_time: "", travel_time_japanese: "", transport: "",
  transport_japanese: "", description: "", description_japanese: "", map_url: "", photo: null as string | null,
  sort_order: nextOrder,
};
const forms = [...form.trips.map((t) => ({ t, scope: `trip-${t.id}`, isNew: false })), { t: blank, scope: "trip-new", isNew: true }];
---

<section class="station-section" id="day-trips" data-nav="day-trips">
    <div class="admin-page-header">
      <div>
        <h2>Day trips</h2>
        <p>
          For <strong>{station.name}</strong>: places to visit from the station, shown under "Day trips" with a
          photo, travel time, how to get there and a map link.
        </p>
      </div>
    </div>

    {
      forms.map(({ t, scope, isNew }) => (
        <section class="admin-panel sides-panel">
          <form action="?s=day-trips" method="POST" enctype="multipart/form-data" class="admin-panel-body">
            <h3 class="sides-title">{isNew ? "Add a day trip" : t.name}</h3>
            {!isNew && <input type="hidden" name="item_id" value={t.id} />}
            {form.errorFor === scope && <div class="admin-form-error" role="alert">{form.formError}</div>}
            <div class="admin-form-grid">
              <div class="admin-form-group">
                <label>Name</label>
                <input name="name" required maxlength="150" value={t.name} placeholder="Yokohama" />
              </div>
              <div class="admin-form-group">
                <label>Name (Japanese)</label>
                <input name="name_japanese" lang="ja" maxlength="150" value={t.name_japanese ?? ""} />
              </div>
              <div class="admin-form-group">
                <label>Travel time</label>
                <input name="travel_time" maxlength="60" value={t.travel_time ?? ""} placeholder="≈ 25–40 min" />
              </div>
              <div class="admin-form-group">
                <label>Travel time (Japanese)</label>
                <input name="travel_time_japanese" lang="ja" maxlength="60" value={t.travel_time_japanese ?? ""} />
              </div>
              <div class="admin-form-group">
                <label>How to get there</label>
                <input name="transport" maxlength="120" value={t.transport ?? ""} placeholder="JR lines, direct" />
              </div>
              <div class="admin-form-group">
                <label>How to get there (Japanese)</label>
                <input name="transport_japanese" lang="ja" maxlength="120" value={t.transport_japanese ?? ""} />
              </div>
              <div class="admin-form-group full-width">
                <label>Description</label>
                <textarea name="description" rows="3" maxlength="600">{t.description ?? ""}</textarea>
              </div>
              <div class="admin-form-group full-width">
                <label>Description (Japanese)</label>
                <textarea name="description_japanese" lang="ja" rows="3" maxlength="600">{t.description_japanese ?? ""}</textarea>
              </div>
              <div class="admin-form-group">
                <label>Map link</label>
                <input name="map_url" type="url" maxlength="500" value={t.map_url ?? ""} placeholder="https://maps.google.com/..." />
              </div>
              <div class="admin-form-group">
                <label>Order</label>
                <input name="sort_order" type="number" min="0" value={t.sort_order} />
              </div>
              <div class="admin-form-group full-width">
                <label>Photo (optional, PNG, JPEG or WebP up to 2 MB)</label>
                {t.photo && (
                  <div>
                    <img src={src(t.photo)} alt="" style="display:block;width:160px;max-width:100%;margin-bottom:8px;border-radius:8px" />
                    <label><input type="checkbox" name="remove_photo" /> Remove the current photo</label>
                  </div>
                )}
                <input name="photo_file" type="file" accept="image/png,image/jpeg,image/webp" />
              </div>
            </div>
            <div class="admin-form-actions">
              {isNew ? (
                <button type="submit" name="trip_action" value="trip_create" class="common-button common-button-primary">Add day trip</button>
              ) : (
                <>
                  <button type="submit" name="trip_action" value="trip_update" class="common-button common-button-primary">Save</button>
                  <button type="submit" name="trip_action" value="trip_delete" class="common-button common-button-danger" formnovalidate onclick="return confirm('Delete this day trip?')">Delete</button>
                </>
              )}
            </div>
          </form>
        </section>
      ))
    }
  </section>
