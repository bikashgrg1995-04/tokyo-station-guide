---
import SimSection from "../SimSection.astro";
import type { Row } from "../SimSection.astro";
import { handleStationRoutes } from "../../../lib/services/station-routes";
import { getStationById } from "../../../lib/db/stations";

export interface Props {
  station: NonNullable<Awaited<ReturnType<typeof getStationById>>>;
  id: number;
  form: Awaited<ReturnType<typeof handleStationRoutes>>;
  mediaBase: string;
}
const { station, form } = Astro.props;

const nextOrder = form.routes.reduce((m, r) => Math.max(m, r.sort_order), 0) + 1;
const rows: Row[] = form.routes.map((r) => ({
  id: r.id,
  search: [r.from_place, r.from_place_japanese, r.route, r.travel_time, r.cost].join(" "),
  item: {
    route_id: String(r.id), from_place: r.from_place ?? "", from_place_japanese: r.from_place_japanese ?? "", route: r.route ?? "",
    route_japanese: r.route_japanese ?? "", travel_time: r.travel_time ?? "", travel_time_japanese: r.travel_time_japanese ?? "",
    cost: r.cost ?? "", cost_japanese: r.cost_japanese ?? "", sort_order: String(r.sort_order),
  },
  cells: [
    { main: String(r.sort_order) },
    { main: r.from_place || r.from_place_japanese || "" },
    { clip: r.travel_time || r.travel_time_japanese || "" },
    { clip: r.cost || r.cost_japanese || "" },
  ],
}));
const noteErr = form.errorFor === "note";
---

<SimSection
  anchor="routes"
  title="Getting there"
  hint={`How to reach ${station.name} from airports and other places: one row per route, shown under <b>Getting there</b>, plus one footnote below the table.`}
  noun="route"
  columns={["Order", "From", "Time", "Cost"]}
  rows={rows}
  idField="route_id"
  actionName="route_action"
  createValue="create"
  updateValue="update"
  deleteValue="delete"
  nextOrder={nextOrder}
  formError={noteErr ? "" : form.formError}
  posted={form.posted}
  reopenMode={form.errorFor === "new" ? "create" : "update"}
>
  <div class="sim-grid2">
    <div class="admin-form-group"><label>From</label><input name="from_place" maxlength="80" placeholder="Narita Airport" /></div>
    <div class="admin-form-group"><label>From (Japanese)</label><input name="from_place_japanese" lang="ja" maxlength="80" /></div>
  </div>
  <div class="admin-form-group"><label>Route</label><input name="route" maxlength="500" placeholder="Narita Express (N'EX), direct to the underground platforms" /></div>
  <div class="admin-form-group"><label>Route (Japanese)</label><input name="route_japanese" lang="ja" maxlength="500" /></div>
  <div class="sim-grid2">
    <div class="admin-form-group"><label>Time</label><input name="travel_time" maxlength="60" placeholder="≈ 53 min" /></div>
    <div class="admin-form-group"><label>Time (Japanese)</label><input name="travel_time_japanese" lang="ja" maxlength="60" /></div>
    <div class="admin-form-group"><label>Cost</label><input name="cost" maxlength="120" placeholder="¥3,140" /></div>
    <div class="admin-form-group"><label>Cost (Japanese)</label><input name="cost_japanese" lang="ja" maxlength="120" /></div>
  </div>
  <div class="admin-form-group"><label>Order</label><input name="sort_order" type="number" min="0" value="0" /></div>
  <form slot="after" action="?s=routes" method="POST" class="sim-note admin-form">
    <h3>Footnote under the table</h3>
    {noteErr && <div class="admin-form-error" role="alert">{form.formError}</div>}
    <div class="sim-grid2">
      <div class="admin-form-group"><label>Note</label><textarea name="routes_note" rows="3" maxlength="1000" placeholder="Fares and times as published by the operators on ...">{form.note}</textarea></div>
      <div class="admin-form-group"><label>Note (Japanese)</label><textarea name="routes_note_japanese" lang="ja" rows="3" maxlength="1000">{form.noteJapanese}</textarea></div>
    </div>
    <button type="submit" name="route_action" value="save_note" class="common-button common-button-primary">Save note</button>
  </form>
</SimSection>
