---
import SimSection from "../SimSection.astro";
import type { Row } from "../SimSection.astro";
import { handleSights } from "../../../lib/services/station-sights";
import { getStationById } from "../../../lib/db/stations";
import { TOP_PICK_CATEGORIES } from "../../../lib/db/top-picks";

export interface Props {
  station: NonNullable<Awaited<ReturnType<typeof getStationById>>>;
  id: number;
  form: Awaited<ReturnType<typeof handleSights>>;
  mediaBase: string;
  /** "top" = Top picks (main page / map popup), "thing" = Things to do (station page) */
  list?: "top" | "thing";
}
const { station, form, mediaBase, list = "top" } = Astro.props;
const isTop = list === "top";
const src = (k: string) => (/^https?:\/\//i.test(k) ? k : `${mediaBase}/${k}`);

const nextOrder = form.sights.reduce((m, t) => Math.max(m, t.sort_order), 0) + 1;
const rows: Row[] = form.sights.map((t) => ({
  id: t.top_pick_id,
  search: [t.name, t.name_japanese, t.category, t.kind, t.exit_name, t.location, t.location_japanese].join(" "),
  item: {
    item_id: String(t.top_pick_id), place_name: t.name || t.name_japanese || "", category: t.category,
    exit_id: t.exit_id ? String(t.exit_id) : "", walking_minutes: t.walking_minutes != null ? String(t.walking_minutes) : "",
    location_type: t.location_type, location: t.location ?? "", location_japanese: t.location_japanese ?? "",
    sort_order: String(t.sort_order),
  },
  cells: [
    { img: t.image_url ? src(t.image_url) : undefined, main: String(t.sort_order) },
    { main: t.name || t.name_japanese || "", badge: t.category },
    { clip: [t.exit_name, t.walking_minutes != null ? `${t.walking_minutes} min` : ""].filter(Boolean).join(" · ") },
  ],
}));
---

<SimSection
  anchor={isTop ? "top-picks" : "things-to-do"}
  title={isTop ? "Top picks" : "Things to do"}
  hint={isTop
    ? `Shown on the website's <b>main page and in the map popup</b> of ${station.name}. Choose places from <a href="/admin/places"><b>Places</b></a>; the exit and walking minutes are only for this station.`
    : `Shown on the <b>station page</b> under <b>Things to do</b> (and used by <b>Which exit?</b> when an exit is set). Choose places from <a href="/admin/places"><b>Places</b></a>; the exit and walking minutes are only for this station.`}
  noun={isTop ? "top pick" : "place"}
  columns={["Order", "Place", "Exit · minutes"]}
  rows={rows}
  actionName="trip_action"
  createValue="trip_create"
  updateValue="trip_update"
  deleteValue="trip_delete"
  nextOrder={nextOrder}
  formError={form.formError}
  posted={form.posted}
  reopenMode={form.errorFor === "thing-new" ? "create" : "update"}
  searchPlaceholder={isTop ? "Search top picks..." : "Search places..."}
  emptyHint="Click Add and choose a place from Places."
>
  <div data-sim-create-only>
    <div class="sim-grid2">
      <div class="admin-form-group">
        <label>Category</label>
        <select data-sim-filter="existing_id">
          <option value="">All categories</option>
          {TOP_PICK_CATEGORIES.map((c) => <option value={c}>{c}</option>)}
        </select>
      </div>
      <div class="admin-form-group">
        <label>Place</label>
        <select name="existing_id">
          <option value="">Choose a place…</option>
          {form.unlinked.map((u) => <option value={u.id} data-category={u.category}>{u.name}</option>)}
        </select>
      </div>
    </div>
    <p class="sim-hint">Not in the list? <a href="/admin/places/new">Add it in Places</a> first.</p>
  </div>
  <div data-sim-edit-only class="sim-place-line">
    <span>Place</span> <strong data-sim-text="place_name"></strong>
    <a data-sim-href="/admin/places/{id}/edit" target="_blank" rel="noopener">Edit place details ↗</a>
  </div>
  <div class="sim-block">
    <div class="sim-block-head"><strong>At this station</strong><span class="sim-where">Only for {station.name}: where the place is from here</span></div>
    <div class="sim-grid2">
      <div class="admin-form-group"><label>Exit</label>
        <select name="exit_id"><option value="">— none —</option>{form.exits.map((e) => <option value={e.id}>{e.name}</option>)}</select>
      </div>
      <div class="admin-form-group"><label>Walking minutes</label><input name="walking_minutes" type="number" min="0" max="120" /></div>
      {isTop && (
        <div class="admin-form-group"><label>Inside / outside</label>
          <select name="location_type"><option value="inside">Inside station</option><option value="outside">Outside</option><option value="inside_outside">Both</option></select>
        </div>
      )}
      <div class="admin-form-group"><label>Order</label><input name="sort_order" type="number" min="0" value="0" /></div>
      <div class="admin-form-group"><label>Extra location note</label><input name="location" maxlength="150" placeholder="Near the east gate" /></div>
      <div class="admin-form-group"><label>Extra location note (Japanese)</label><input name="location_japanese" maxlength="150" lang="ja" /></div>
    </div>
  </div>
</SimSection>
