---
import "../../../styles/admin/forms.css";
import "../../../styles/admin/stations.css";
import "../../../styles/admin/tables.css";
import "../../../styles/admin/lines.css";
import StationPlatformsPanel from "../../../components/admin/StationPlatformsPanel.astro";
import { handleStationPlatforms } from "../../../lib/services/station-platforms";
import { getStationById } from "../../../lib/db/stations";

export interface Props {
  station: NonNullable<Awaited<ReturnType<typeof getStationById>>>;
  id: number;
  form: Awaited<ReturnType<typeof handleStationPlatforms>>;
  mediaBase: string;
}

const { station, id, form: __form, mediaBase } = Astro.props;
const platformForm = __form;


---

<section class="station-section" id="platforms" data-nav="platforms">
    <div class="station-section-head">
      <div>
        <h2>Platforms</h2>
        <p>Platform numbers, destinations, railway line and walking guidance, shown under <b>Platforms</b> on the {station.name} page.</p>
      </div>

    
    </div>

    <StationPlatformsPanel
      stationName={station.name}
      stationId={station.id}
      platforms={platformForm.platforms}
      lines={platformForm.lines}
      values={platformForm.values}
      errors={platformForm.errors}
      formError={platformForm.formError}
      editingId={platformForm.editingId}
    />
  </section>
