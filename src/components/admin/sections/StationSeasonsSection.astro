---
import SimSection from "../SimSection.astro";
import type { Row } from "../SimSection.astro";
import { handleStationSeasons } from "../../../lib/services/station-seasons";
import { getStationById } from "../../../lib/db/stations";
import { SEASONS } from "../../../lib/db/station-seasons";
export interface Props {
  station: NonNullable<Awaited<ReturnType<typeof getStationById>>>;
  id: number;
  form: Awaited<ReturnType<typeof handleStationSeasons>>;
  mediaBase: string;
}
const { station, form } = Astro.props;

const cap = (s: string) => s[0].toUpperCase() + s.slice(1);
const rows: Row[] = SEASONS.map((s) => {
  const v = form.seasons[s];
  return {
    id: s,
    search: `${s} ${v?.months ?? ""} ${v?.description ?? ""}`,
    item: {
      season: s, months: v?.months ?? "", months_japanese: v?.months_japanese ?? "",
      description: v?.description ?? "", description_japanese: v?.description_japanese ?? "",
    },
    cells: [
      { main: cap(s) },
      { clip: v?.months || v?.months_japanese || (v ? "" : "— empty, not shown —") },
    ],
    noDelete: true,
  };
});
---

<SimSection
  anchor="seasons"
  title="When to visit"
  hint={`One block per season shown under <b>When to visit</b> on the ${station.name} page. Click Edit on a season; save it empty to hide that season.`}
  noun="season"
  columns={["Season", "Months"]}
  rows={rows}
  canAdd={false}
  editTitle="Edit season"
  formError={form.formError}
  posted={form.posted}
>
  <input type="hidden" name="season" value="" />
  <div class="sim-grid2">
    <div class="admin-form-group"><label>Months</label><input name="months" maxlength="40" placeholder="Mar – May" /></div>
    <div class="admin-form-group"><label>Months (Japanese)</label><input name="months_japanese" lang="ja" maxlength="40" /></div>
  </div>
  <div class="admin-form-group"><label>Text</label><textarea name="description" rows="3" maxlength="600"></textarea></div>
  <div class="admin-form-group"><label>Text (Japanese)</label><textarea name="description_japanese" lang="ja" rows="3" maxlength="600"></textarea></div>
</SimSection>
