---
import SimSection from "../SimSection.astro";
import type { Row } from "../SimSection.astro";
import { handleFacilityEntries } from "../../../lib/services/station-facility-entries";
import { getStationById } from "../../../lib/db/stations";
import { isUploadedIcon, iconUrl } from "../../../lib/storage/facility-icons";

export interface Props {
  station: NonNullable<Awaited<ReturnType<typeof getStationById>>>;
  id: number;
  form: Awaited<ReturnType<typeof handleFacilityEntries>>;
  mediaBase: string;
}
const { station, form, mediaBase } = Astro.props;
const src = (k: string) => (/^https?:\/\//i.test(k) ? k : `${mediaBase}/${k}`);

const nextOrder = form.entries.reduce((m, e) => Math.max(m, e.sort_order ?? 0), 0) + 1;
const rows: Row[] = form.entries.map((e) => {
  const exitNames = e.exits.map((x) => x.name);
  return {
    id: e.id,
    search: [e.name, e.name_japanese, e.floor_name, exitNames.join(" "), e.note, e.note_japanese, e.description, e.description_japanese, e.location_type].join(" "),
    item: {
      item_id: String(e.id), facility_id: String(e.facility_id), floor_id: String(e.floor_id),
      facility_count: String(e.facility_count ?? 1), location_type: e.location_type,
      note: e.note ?? "", note_japanese: e.note_japanese ?? "",
      description: e.description ?? "", description_japanese: e.description_japanese ?? "",
      photo_caption: e.photo_caption ?? "", photo_caption_japanese: e.photo_caption_japanese ?? "",
      sort_order: String(e.sort_order ?? 0), exit_ids: e.exits.map((x) => x.id).join(","),
      photo_url: e.photo ? src(e.photo) : "",
    },
    cells: [
      {
        main: e.name || e.name_japanese || "",
        icon: isUploadedIcon(e.icon) ? iconUrl(e.icon) : undefined,
        emoji: e.icon && !isUploadedIcon(e.icon) ? e.icon : undefined,
        badge: (e.facility_count ?? 1) > 1 ? `×${e.facility_count}` : undefined,
      },
      { main: e.floor_name || e.floor_name_japanese || "", badge: e.location_type === "outside" ? "outside" : e.location_type === "inside_outside" ? "inside & outside" : undefined },
      { clip: exitNames.join(", ") },
      { clip: e.note || e.note_japanese || "" },
      { img: e.photo ? src(e.photo) : undefined, clip: e.description || e.description_japanese || "" },
    ],
  };
});
const canAdd = form.floors.length > 0 && form.facilities.length > 0;
---

<SimSection
  anchor="facilities"
  title="Facilities"
  hint={`Everything a visitor can use at ${station.name}: lockers, ticket offices, toilets... One row = one facility on one floor. Each row has <b>three separate texts</b>: the short <b>map popup</b> text, the <b>Facilities table</b> description on the station page, and the <b>photo caption</b> (photo card on the station page).`}
  noun="facility"
  columns={["Facility", "Floor", "Nearby exits", "Map popup text", "Station page text"]}
  rows={rows}
  actionName="fac_action"
  createValue="fac_create"
  updateValue="fac_update"
  deleteValue="fac_delete"
  multipart
  canAdd={canAdd}
  nextOrder={nextOrder}
  searchPlaceholder="Search facilities, floors, exits..."
  emptyHint={form.floors.length === 0 ? "Add at least one floor first (Floors section)." : "Click Add facility to list the first one."}
  formError={form.formError}
  posted={form.posted}
  reopenMode={form.errorFor === "fac-new" ? "create" : "update"}
>
  <div class="sim-grid2">
    <div class="admin-form-group">
      <label>Facility (icon + name)</label>
      <select name="facility_id" required>
        <option value="">Choose...</option>
        {form.facilities.map((f) => <option value={f.id}>{f.name}{f.name_japanese ? ` · ${f.name_japanese}` : ""}</option>)}
      </select>
    </div>
    <div class="admin-form-group">
      <label>Floor</label>
      <select name="floor_id" required>
        <option value="">Choose...</option>
        {form.floors.map((f) => <option value={f.id}>{f.name}{f.name_japanese ? ` · ${f.name_japanese}` : ""}</option>)}
      </select>
    </div>
    <div class="admin-form-group">
      <label>Inside or outside the station</label>
      <select name="location_type">
        <option value="inside">Inside</option>
        <option value="outside">Outside</option>
        <option value="inside_outside">Inside &amp; outside</option>
      </select>
    </div>
    <div class="admin-form-group">
      <label>Quantity</label>
      <input name="facility_count" type="number" min="1" value="1" />
    </div>
  </div>
  <div class="admin-form-group">
    <label>Nearby exits</label>
    <div class="side-exit-checks">
      {form.exits.length === 0 && <span class="admin-table-muted">Add exits first (Exits section).</span>}
      {form.exits.map((e) => (
        <label class="side-exit-check"><input type="checkbox" name="exit_ids" value={e.id} /> {e.name}</label>
      ))}
    </div>
  </div>
  <div class="sim-block">
    <div class="sim-block-head"><strong>1 · Map popup</strong><span class="sim-where">Shown when a visitor taps this facility on the map</span></div>
    <div class="sim-grid2">
      <div class="admin-form-group"><label>Short text</label><textarea name="note" rows="2" maxlength="300" placeholder="e.g. Coin lockers near the south gates"></textarea></div>
      <div class="admin-form-group"><label>Short text (Japanese)</label><textarea name="note_japanese" lang="ja" rows="2" maxlength="300"></textarea></div>
    </div>
  </div>
  <div class="sim-block">
    <div class="sim-block-head"><strong>2 · Station page · Facilities table</strong><span class="sim-where">The “Where and what to know” column. Leave empty to leave this facility out of the table</span></div>
    <div class="admin-form-group"><label>Description (where it is, price, hours...)</label><textarea name="description" rows="3" maxlength="1500"></textarea></div>
    <div class="admin-form-group"><label>Description (Japanese)</label><textarea name="description_japanese" lang="ja" rows="3" maxlength="1500"></textarea></div>
  </div>
  <div class="sim-block">
    <div class="sim-block-head"><strong>3 · Station page · Photo card</strong><span class="sim-where">A photo card appears under the table only when a photo is added</span></div>
    <div class="sim-photo">
      <label>Photo (optional, PNG, JPEG or WebP up to 2 MB)</label>
      <div class="sim-photo-prev" data-sim="photo-preview" hidden>
        <img alt="" src="" />
        <label><input type="checkbox" name="remove_photo" /> Remove current photo</label>
      </div>
      <input name="photo_file" type="file" accept="image/png,image/jpeg,image/webp" />
    </div>
    <div class="sim-grid2">
      <div class="admin-form-group"><label>Photo caption</label><input name="photo_caption" maxlength="400" /></div>
      <div class="admin-form-group"><label>Photo caption (Japanese)</label><input name="photo_caption_japanese" lang="ja" maxlength="400" /></div>
    </div>
  </div>
  <div class="admin-form-group"><label>Order</label><input name="sort_order" type="number" min="0" value="0" /></div>
</SimSection>
