---
import Alert from "../common/Alert.astro";
import Button from "../common/Button.astro";

export interface Props {
  /** Facilities already assigned to the station (none on the Add page). */
  assigned?: { id: number; name: string }[];
  /** Show the "+ Add" button (there are facilities left to add). */
  canAdd: boolean;
  /** Validation message for the facilities field. */
  error?: string;
  /** Shown by the picker script when every facility has been added. */
  allAddedMessage: string;
}

const { assigned = [], canAdd, error, allAddedMessage } = Astro.props;
---

<section class="admin-panel admin-station-feature-panel">
  <div class="admin-panel-body">
    <div class="admin-station-feature-header">
      <div>
        <h3>Facilities</h3>

        <p><slot /></p>
      </div>

      {
        canAdd && (
          <Button
            type="button"
            variant="primary"
            id="open-add-facility-button"
          >
            + Add
          </Button>
        )
      }
    </div>

    {error && <Alert>{error}</Alert>}

    <!-- Temporary Facility Inputs -->

    <div id="station-facility-inputs">
      {
        assigned.map((facility) => (
          <input
            type="hidden"
            name="facility_ids"
            value={facility.id}
            data-facility-input={facility.id}
          />
        ))
      }
    </div>

    <!-- Facility Table -->

    <div class="admin-table-wrapper">
      <table
        class="admin-table admin-compact-table"
        id="station-facilities-table"
      >
        <thead>
          <tr>
            <th>Facility</th>
            <th>Actions</th>
          </tr>
        </thead>

        <tbody id="station-facilities-body">
          {
            assigned.length > 0 ? (
              assigned.map((facility) => (
                <tr data-facility-row data-facility-id={facility.id}>
                  <td>
                    <div class="admin-line-name">{facility.name}</div>
                  </td>

                  <td>
                    <div class="admin-table-actions">
                      <button
                        type="button"
                        class="admin-table-action admin-table-action-delete"
                        data-remove-facility={facility.id}
                        data-facility-name={facility.name}
                      >
                        Remove
                      </button>
                    </div>
                  </td>
                </tr>
              ))
            ) : (
              <tr id="station-facilities-empty-row">
                <td colspan="2">
                  <div class="admin-feature-empty">No facilities assigned.</div>
                </td>
              </tr>
            )
          }
        </tbody>
      </table>
    </div>

    <p id="all-facilities-message" class="admin-feature-message" hidden>
      {allAddedMessage}
    </p>
  </div>
</section>
