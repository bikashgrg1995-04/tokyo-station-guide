---
import Alert from "../common/Alert.astro";
import Button from "../common/Button.astro";
import PagedTable from "./PagedTable.astro";
import type { StationFacility } from "../../lib/db/facilities";

export interface Props {
  assigned?: StationFacility[];
  canAdd: boolean;
  error?: string;
  allAddedMessage: string;
}

const { assigned = [], canAdd, error, allAddedMessage } = Astro.props;
---

<section class="admin-panel admin-station-feature-panel">
  <div class="admin-panel-body">
    <div class="admin-station-feature-header">
      <div>
        <h3>Facilities</h3>
        <p><slot /></p>
      </div>

      {
        canAdd && (
          <Button type="button" variant="primary" id="open-add-facility-button">
            + Add
          </Button>
        )
      }
    </div>

    {error && <Alert>{error}</Alert>}

    <input type="hidden" name="station_facilities_enabled" value="1" />

    <div id="station-facility-inputs" hidden></div>

    <PagedTable
      id="station-facilities-paged"
      pageSize={10}
      rowSelector="[data-facility-row]"
      noun="facility entries"
      searchLabel="Search assigned facilities"
      searchPlaceholder="Search facility, floor, exit or note..."
    >

    
<div slot="toolbar-end" class="admin-facility-floor-filter">
  <label for="station-facility-floor-filter">Floor</label>

  <select id="station-facility-floor-filter">
    <option value="all">All Floors</option>
    {
      [...new Map(
        assigned.map((facility) => [
          String(facility.floor_id),
          facility.floor_name,
        ]),
      )].map(([floorId, floorName]) => (
        <option value={floorId}>{floorName}</option>
      ))
    }
  </select>
</div>

      <table
        class="admin-table admin-compact-table"
        id="station-facilities-table"
      >
        <thead>
          <tr>
            <th>Facility</th>
            <th>Floor</th>
            <th>Location</th>
            <th>Quantity</th>
            <th>Nearby Exits</th>
            <th>Note (optional)</th>
            <th>Actions</th>
          </tr>
        </thead>

        <tbody id="station-facilities-body">
          {
            assigned.map((facility) => (
              <tr
                data-facility-row
                data-facility-id={facility.facility_id}
                data-floor-id={facility.floor_id}
                data-facility-name={facility.name}
                data-floor-name={facility.floor_name}
              >
                <td>
                  <div class="admin-line-name">{facility.name}</div>
                  <input
                    type="hidden"
                    name="facility_entry_facility_id"
                    value={facility.facility_id}
                  />
                </td>

                <td>
                  <span
                    class="admin-floor-pill"
                    data-floor-pill
                    title={
                      facility.floor_name_japanese
                        ? `${facility.floor_name} · ${facility.floor_name_japanese}`
                        : facility.floor_name
                    }
                  >
                    {facility.floor_name}
                  </span>

                  <input
                    type="hidden"
                    name="facility_entry_floor_id"
                    value={facility.floor_id}
                  />
                </td>

                <td>
                  <select
                    name="facility_entry_location"
                    aria-label={`Location of ${facility.name}`}
                  >
                    <option
                      value="inside"
                      selected={facility.location_type !== "outside"}
                    >
                      Inside
                    </option>
                    <option
                      value="outside"
                      selected={facility.location_type === "outside"}
                    >
                      Outside
                    </option>
                  </select>
                </td>

                <td>
                  <input
                    type="number"
                    name="facility_entry_count"
                    value={facility.facility_count ?? 1}
                    min="1"
                    step="1"
                    required
                    aria-label={`Quantity of ${facility.name}`}
                  />
                </td>

                <td>
                  <div
                    class="facility-exit-pills"
                    data-facility-exit-pills
                    title={facility.exits.map((exit) => exit.name).join(", ")}
                  >
                    {facility.exits.map((exit) => (
                      <span
                        class="facility-exit-pill"
                        data-assigned-exit-id={exit.id}
                        title={`${exit.floor_name}${exit.code ? ` · ${exit.code}` : ""}`}
                      >
                        {exit.name}
                      </span>
                    ))}

                    {facility.exits.length === 0 && (
                      <span class="facility-exit-empty" data-no-exits>
                        No exits assigned
                      </span>
                    )}
                  </div>

                  <input
                    type="hidden"
                    name="facility_entry_exit_ids_json"
                    value={JSON.stringify(
                      facility.exits.map((exit) => exit.id),
                    )}
                    data-facility-exit-ids
                  />

                  <button
                    type="button"
                    class="admin-table-action"
                    data-open-facility-exits
                  >
                    + Add Exits
                  </button>
                </td>

                <td>
                  <input
                    type="text"
                    name="facility_entry_note"
                    value={facility.note ?? ""}
                    placeholder="Optional note (max 15 characters)"
                    maxlength="150"
                    aria-label={`Note for ${facility.name}`}
                  />
                </td>

                <td>
                  <div class="admin-table-actions">
                    <button
                      type="button"
                      class="admin-table-action admin-table-action-delete"
                      data-remove-facility
                      data-facility-name={facility.name}
                      data-floor-name={facility.floor_name}
                    >
                      Remove
                    </button>
                  </div>
                </td>
              </tr>
            ))
          }

          <tr id="station-facilities-empty-row" hidden={assigned.length > 0}>
            <td colspan="7">
              <div class="admin-feature-empty">No facilities assigned.</div>
            </td>
          </tr>
        </tbody>
      </table>
    </PagedTable>

    <p id="all-facilities-message" class="admin-feature-message" hidden>
      {allAddedMessage}
    </p>
  </div>
</section>
