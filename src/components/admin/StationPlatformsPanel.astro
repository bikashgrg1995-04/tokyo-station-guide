---
import "../../styles/admin/station-platforms-panel.css";
import Button from "../common/Button.astro";
import SearchInput from "../common/SearchInput.astro";
import EmptyState from "../common/EmptyState.astro";
import ConfirmDialog from "../common/ConfirmDialog.astro";

import type { StationPlatform } from "../../lib/db/station-platforms";
import type { Line } from "../../lib/db/lines";
import type {
  StationPlatformFormErrors,
  StationPlatformFormValues,
} from "../../lib/validators/station-platform";

interface Props {
  stationName: string;
  stationId: number;
  platforms: StationPlatform[];
  lines: Line[];
  values: StationPlatformFormValues;
  errors: StationPlatformFormErrors;
  formError: string;
  editingId: number | null;
}

const {
  stationName,
  stationId,
  platforms,
  lines,
  values,
  errors,
  formError,
  editingId,
} = Astro.props;

const editPlatform = platforms.find((platform) => platform.id === editingId);
const hasValidationErrors = Object.values(errors).some(Boolean);
const showModalInitially = editingId !== null || hasValidationErrors;

const formValues =
  editingId !== null && editPlatform && !hasValidationErrors
    ? {
        lineId: editPlatform.line_id == null ? "" : String(editPlatform.line_id),
        platformNumber: editPlatform.platform_number,
        destinations: editPlatform.destinations ?? "",
        destinationsJapanese: editPlatform.destinations_japanese ?? "",
        notes: editPlatform.notes ?? "",
        notesJapanese: editPlatform.notes_japanese ?? "",
        group: editPlatform.platform_group ?? "",
        groupJapanese: editPlatform.platform_group_japanese ?? "",
        sortOrder: String(editPlatform.sort_order),
      }
    : values;

const showDeleteError = Boolean(formError) && editingId === null && !hasValidationErrors;
---

<section class="admin-panel" id="station-platforms">
  <div class="admin-panel-body admin-table-panel-body">
    {showDeleteError && (
      <div class="admin-form-error" role="alert">
        {formError}
      </div>
    )}

    <div class="admin-list-toolbar">
      <form action="?s=platforms"
        id="platform-search-form"
        class="admin-search-form"
        role="search"
        onsubmit="return false;"
      >
        <SearchInput
          id="platform-search"
          name="search"
          placeholder="Search platforms..."
          ariaLabel="Search platforms by number, destination, or line"
        />
      </form>

      <div class="admin-toolbar-actions">
        <button
          type="button"
          class="common-button common-button-danger common-button-medium"
          data-bulk-delete
        >
          Delete
        </button>
        <Button type="button" variant="primary" id="open-add-platform">
        + Add Platform
      </Button>
      </div>
    </div>

    <div class="admin-table-meta">
      <span id="platform-results-count" aria-live="polite">
        {platforms.length} • Total Platforms
      </span>
    </div>

    {platforms.length > 0 ? (
      <>
        <div class="admin-table-wrapper">
          <table class="admin-table">
            <thead>
              <tr>
                <th class="admin-select-cell">
                  <input type="checkbox" class="admin-row-checkbox" data-bulk-all aria-label="Select all platforms" />
                </th>
                <th>ID</th>
                <th>Platform</th>
                <th>Destinations</th>
                <th>Railway Line</th>
                <th>Walking Guidance</th>
                <th>Sort Order</th>
                <th>Actions</th>
              </tr>
            </thead>

            <tbody id="platform-table-body">
              {platforms.map((platform) => (
                <tr
                  data-platform-row
                  data-search={`${platform.id} ${platform.platform_number} ${platform.destinations ?? ""} ${platform.destinations_japanese ?? ""} ${platform.line_name ?? ""} ${platform.notes ?? ""} ${platform.notes_japanese ?? ""}`.toLowerCase()}
                >
                  <td class="admin-select-cell">
                    <input type="checkbox" class="admin-row-checkbox" data-bulk-select value={platform.id} aria-label="Select platform" />
                  </td>
                  <td class="admin-table-id">{platform.id}</td>

                  <td>
                    <strong>{platform.platform_number}</strong>
                  </td>

                  <td>
                    {platform.destinations || (
                      <span class="admin-table-muted">—</span>
                    )}
                  </td>

                  <td>
                    {platform.line_name || (
                      <span class="admin-table-muted">—</span>
                    )}
                  </td>

                  <td>
                    {platform.notes ? (
                      <span title={platform.notes}>Available</span>
                    ) : (
                      <span class="admin-table-muted">Not added</span>
                    )}
                  </td>

                  <td>{platform.sort_order}</td>

                  <td>
                    <div class="admin-table-actions">
                      <button
                        type="button"
                        class="admin-table-action admin-table-action-edit"
                        data-edit-platform
                        data-id={platform.id}
                        data-number={platform.platform_number}
                        data-destinations={platform.destinations ?? ""}
                        data-destinations-japanese={platform.destinations_japanese ?? ""}
                        data-line-id={platform.line_id ?? ""}
                        data-notes={platform.notes ?? ""}
                        data-notes-japanese={platform.notes_japanese ?? ""}
                        data-group={platform.platform_group ?? ""}
                        data-group-japanese={platform.platform_group_japanese ?? ""}
                        data-sort-order={platform.sort_order}
                      >
                        Edit
                      </button>

                      <button
                        type="button"
                        class="admin-table-action admin-table-action-delete js-delete-platform"
                        data-platform-id={platform.id}
                        data-platform-name={platform.platform_number}
                      >
                        Delete
                      </button>
                    </div>
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>

        <div class="admin-table-footer">
          <span id="platform-page-info" aria-live="polite"></span>

          <label class="admin-platform-page-size" for="platform-page-size">
            Rows
            <select id="platform-page-size">
              <option value="10" selected>10</option>
              <option value="25">25</option>
              <option value="50">50</option>
            </select>
          </label>

          <div class="admin-table-actions">
            <button
              type="button"
              class="admin-table-action"
              id="platform-prev"
            >
              Previous
            </button>
            <button
              type="button"
              class="admin-table-action"
              id="platform-next"
            >
              Next
            </button>
          </div>
        </div>

        <div id="platform-no-results" hidden>
          <EmptyState
            icon="◉"
            title="No platforms found"
            description="Try a different search term."
          />
        </div>
      </>
    ) : (
      <EmptyState
        icon="◉"
        title="No platforms yet"
        description="Add the first platform for this station to get started."
      />
    )}
  </div>
</section>

<!-- Add / Edit modal -->
<div
  id="platform-modal"
  class:list={[
    "admin-line-station-modal",
    showModalInitially ? "is-open" : "",
  ]}
  hidden={!showModalInitially}
  aria-hidden={showModalInitially ? "false" : "true"}
>
  <div
    class="admin-line-station-modal-backdrop"
    data-close-platform-modal
  ></div>

  <div
    class="admin-line-station-modal-dialog"
    role="dialog"
    aria-modal="true"
    aria-labelledby="platform-modal-title"
  >
    <div class="admin-line-station-modal-header">
      <div>
        <h2 id="platform-modal-title">
          {editingId ? "Edit Platform" : "Add Platform"}
        </h2>
        <p>Manage platform information for <strong>{stationName}</strong>.</p>
      </div>

      <button
        type="button"
        class="admin-line-station-modal-close"
        data-close-platform-modal
        aria-label="Close platform form"
      >
        ×
      </button>
    </div>

    <form action="?s=platforms" method="POST" class="admin-form" id="platform-form">
      <input
        type="hidden"
        name="platform_action"
        id="platform-action"
        value={editingId ? "update" : "create"}
      />

      <input
        type="hidden"
        name="platform_id"
        id="platform-id"
        value={editingId ?? ""}
      />

      {formError && !showDeleteError && (
        <div class="admin-form-error" role="alert">{formError}</div>
      )}

      <div class="admin-form-group">
        <label for="platform_number">Platform Number</label>
        <input
          id="platform_number"
          name="platform_number"
          required
          maxlength="50"
          placeholder="e.g. 1–2 or U 3–4"
          value={formValues.platformNumber}
        />
        {errors.platformNumber && (
          <small class="admin-field-error">{errors.platformNumber}</small>
        )}
      </div>

      <div class="admin-form-group">
        <label for="destinations">Destinations</label>
        <input
          id="destinations"
          name="destinations"
          required
          maxlength="500"
          placeholder="e.g. Shinjuku, Tachikawa"
          value={formValues.destinations}
        />
        {errors.destinations && (
          <small class="admin-field-error">{errors.destinations}</small>
        )}
      </div>

      <div class="admin-form-group">
        <label for="destinations_japanese">Japanese Destinations (optional)</label>
        <input
          id="destinations_japanese"
          name="destinations_japanese"
          lang="ja"
          maxlength="500"
          placeholder="例: 新宿、立川"
          value={formValues.destinationsJapanese}
        />
        {errors.destinationsJapanese && (
          <small class="admin-field-error">{errors.destinationsJapanese}</small>
        )}
      </div>

      <div class="admin-form-group">
        <label for="platform_group">Map group (optional)</label>
        <input
          id="platform_group"
          name="platform_group"
          maxlength="80"
          placeholder="e.g. Deep underground (blank = main diagram)"
          value={formValues.group}
        />
        {errors.group && <small class="admin-field-error">{errors.group}</small>}
      </div>

      <div class="admin-form-group">
        <label for="platform_group_japanese">Japanese map group (optional)</label>
        <input
          id="platform_group_japanese"
          name="platform_group_japanese"
          lang="ja"
          maxlength="80"
          placeholder="例: 地下深部"
          value={formValues.groupJapanese}
        />
        {errors.groupJapanese && (
          <small class="admin-field-error">{errors.groupJapanese}</small>
        )}
      </div>

      <div class="admin-form-group">
        <label for="line_id">Railway Line (optional)</label>
        <select id="line_id" name="line_id">
          <option value="">No line selected</option>
          {lines.map((line) => (
            <option
              value={line.id}
              selected={formValues.lineId === String(line.id)}
            >
              {line.name}{line.code ? ` (${line.code})` : ""}
            </option>
          ))}
        </select>
        {errors.lineId && (
          <small class="admin-field-error">{errors.lineId}</small>
        )}
      </div>

      <div class="admin-form-group">
        <label for="notes">Walking Guidance</label>
        <textarea
          id="notes"
          name="notes"
          rows="4"
          maxlength="2000"
          placeholder="Explain how passengers can reach this platform..."
        >{formValues.notes}</textarea>
        {errors.notes && (
          <small class="admin-field-error">{errors.notes}</small>
        )}
      </div>

      <div class="admin-form-group">
        <label for="notes_japanese">Japanese Walking Guidance (optional)</label>
        <textarea
          id="notes_japanese"
          name="notes_japanese"
          lang="ja"
          rows="4"
          maxlength="2000"
          placeholder="このホームへの行き方を説明してください..."
        >{formValues.notesJapanese}</textarea>
        {errors.notesJapanese && (
          <small class="admin-field-error">{errors.notesJapanese}</small>
        )}
      </div>

      <div class="admin-form-group">
        <label for="sort_order">Sort Order</label>
        <input
          id="sort_order"
          name="sort_order"
          type="number"
          min="0"
          step="1"
          required
          value={formValues.sortOrder}
        />
        {errors.sortOrder && (
          <small class="admin-field-error">{errors.sortOrder}</small>
        )}
      </div>

      <div class="admin-form-actions">
        <Button type="button" variant="secondary" id="cancel-platform-form">
          Cancel
        </Button>

        <Button type="submit" variant="primary" id="platform-submit">
          {editingId ? "Update Platform" : "Add Platform"}
        </Button>
      </div>
    </form>
  </div>
</div>

<!-- Hidden delete form submitted only after confirmation -->
<form
  method="POST"
  id="delete-platform-form"
  action={`/admin/stations/${stationId}/edit?s=platforms`}
  hidden
>
  <input type="hidden" name="platform_action" value="delete" />
  <input type="hidden" name="platform_id" id="delete-platform-id" value="" />
</form>

<ConfirmDialog
  id="delete-platform-dialog"
  formId="delete-platform-form"
  title="Delete Platform"
  description="Are you sure you want to delete this platform?"
  confirmText="Delete Platform"
  cancelText="Cancel"
  variant="danger"
  showName={true}
  warning="This action cannot be undone."
/>

<form
  method="POST"
  id="bulk-delete-platform-form"
  action={`/admin/stations/${stationId}/edit?s=platforms`}
  hidden
>
  <input type="hidden" name="platform_action" value="delete_many" />
</form>

<ConfirmDialog
  id="bulk-delete-platform-dialog"
  formId="bulk-delete-platform-form"
  title="Delete Platforms"
  description="Are you sure you want to delete the selected platforms?"
  confirmText="Delete Platforms"
  cancelText="Cancel"
  variant="danger"
  warning="This action cannot be undone."
/>

<script>
  import "../../scripts/admin/station-platforms-panel.ts";
</script>

