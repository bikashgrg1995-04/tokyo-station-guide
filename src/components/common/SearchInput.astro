---
import "../../styles/common/search-input.css";

export interface Props {
  name?: string;
  id?: string;
  value?: string;
  placeholder?: string;
  ariaLabel?: string;
  autocomplete?: string;
  form?: string;
}

const {
  name = "search",
  id,
  value = "",
  placeholder = "Search...",
  ariaLabel = "Search",
  autocomplete = "off",
  form,
} = Astro.props;
---

<div class="common-search">
  <svg
    class="common-search-icon"
    viewBox="0 0 24 24"
    fill="none"
    aria-hidden="true"
  >
    <circle
      cx="11"
      cy="11"
      r="6.5"
      stroke="currentColor"
      stroke-width="2"
    />

    <path
      d="M16 16L21 21"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
    />
  </svg>

  <input
    type="search"
    name={name}
    id={id}
    value={value}
    placeholder={placeholder}
    aria-label={ariaLabel}
    autocomplete={autocomplete}
    form={form}
    class="common-search-input"
  />
</div>
