---
import WebsiteLayout from "../layouts/WebsiteLayout.astro";
import { getTransitMapData } from "../lib/db/transit-map.ts";
import { getFeaturedStations } from "../lib/db/featured-stations";

import "../styles/website/global.css";
import "../styles/website/theme.css";
import "../styles/website/base.css";
import "../styles/website/header.css";
import "../styles/website/transit.css";
import "../styles/website/station-board.css";
import "../styles/website/lines-dialog.css";
import "../styles/website/search.css";
import "../styles/website/station-sheet.css";
import "../styles/website/responsive.css";

export const prerender = false;

const { env } = await import("cloudflare:workers");
const db = env.DB;

const siteName = "Tokyo Station Guide";
const description =
  "Explore Tokyo railway stations, train lines, station codes, exits, nearby attractions, restaurants, hotels, and useful travel information.";

/* ========================================
   Transit Map Data
======================================== */

const { lines, stationsByLine, searchable } = await getTransitMapData(db);

const featuredStations = await getFeaturedStations(db);

const transitData = {
  lines,
  stationsByLine,
};
---

<WebsiteLayout
  title={`${siteName} | Tokyo Railway & Station Guide`}
  description={description}
>
    <header class="topbar">
      <a href="/" class="brand" aria-label={siteName}>
        <span class="brand-jp">東<i></i>京</span>
        <span class="brand-en">TOKYO</span>
      </a>
      <div class="top-actions">
        <button class="round" id="open-search" aria-label="Search stations">
          <svg viewBox="0 0 24 24"
            ><circle cx="11" cy="11" r="6.5"></circle><path d="m16 16 4.5 4.5"
            ></path></svg
          >
        </button>
        <button class="round" id="theme-toggle" aria-label="Toggle theme">
          <svg class="icon-sun" viewBox="0 0 24 24"
            ><circle cx="12" cy="12" r="4"></circle><path
              d="M12 2v2.5M12 19.5V22M2 12h2.5M19.5 12H22M4.9 4.9l1.8 1.8M17.3 17.3l1.8 1.8M4.9 19.1l1.8-1.8M17.3 6.7l1.8-1.8"
            ></path></svg
          >
          <svg class="icon-moon" viewBox="0 0 24 24"
            ><path d="M20.5 14.2A8.5 8.5 0 1 1 9.8 3.5a6.8 6.8 0 0 0 10.7 10.7z"
            ></path></svg
          >
        </button>
      </div>
    </header>

    <main class="stage" id="stage">
      <svg
        id="map"
        role="img"
        aria-label="Railway line map"
        preserveAspectRatio="xMidYMid meet"
      >
        <defs>
          <pattern
            id="grid"
            width="40"
            height="40"
            patternUnits="userSpaceOnUse"
          >
            <path d="M40 0H0V40" class="grid-lo" transform="translate(1 1)"
            ></path>
            <path d="M40 0H0V40" class="grid-hi"></path>
          </pattern>
          <linearGradient id="car-grad" x1="0" y1="0" x2="1" y2="0">
            <stop offset="0" stop-color="#c9d0d9"></stop>
            <stop offset="0.16" stop-color="#f6f8fa"></stop>
            <stop offset="0.5" stop-color="#ffffff"></stop>
            <stop offset="0.84" stop-color="#f0f3f6"></stop>
            <stop offset="1" stop-color="#c6cdd6"></stop>
          </linearGradient>
          <linearGradient id="ac-grad" x1="0" y1="0" x2="1" y2="0">
            <stop offset="0" stop-color="#aeb6c1"></stop>
            <stop offset="0.5" stop-color="#cfd5dd"></stop>
            <stop offset="1" stop-color="#aab2bd"></stop>
          </linearGradient>
          <linearGradient id="glass-grad" x1="0" y1="0" x2="1" y2="1">
            <stop offset="0" stop-color="#45596d"></stop>
            <stop offset="1" stop-color="#1c2835"></stop>
          </linearGradient>
          <linearGradient id="beam-grad" x1="0" y1="1" x2="0" y2="0">
            <stop offset="0" stop-color="#fff3c4" stop-opacity="0.75"></stop>
            <stop offset="1" stop-color="#fff3c4" stop-opacity="0"></stop>
          </linearGradient>
          <radialGradient id="glow-grad">
            <stop offset="0" stop-color="#f3ecb0" stop-opacity="0.7"></stop>
            <stop offset="0.5" stop-color="#f3ecb0" stop-opacity="0.28"></stop>
            <stop offset="1" stop-color="#fff0b0" stop-opacity="0"></stop>
          </radialGradient>
        </defs>
        <rect x="-3000" y="-3000" width="7000" height="7000" fill="url(#grid)"
        ></rect>
        <g id="track"></g>
        <g id="glow"></g>
        <g id="labels"></g>
        <g id="train"></g>
      </svg>

      <div class="rail-tools left">
        <button class="tool" id="zoom-in" aria-label="Zoom in">+</button>
        <button class="tool" id="zoom-out" aria-label="Zoom out">−</button>
        <button class="tool" id="zoom-reset" aria-label="Reset view">
          <svg viewBox="0 0 24 24"
            ><path d="M4 12a8 8 0 1 0 3-6.2M4 4v4.5h4.5"></path></svg
          >
        </button>
      </div>

      <div class="rail-tools right">
        <a class="tool" id="info-link" href="#" aria-label="Open station page">
          <svg viewBox="0 0 24 24"
            ><circle cx="12" cy="12" r="9"></circle><path
              d="M12 11v5.5M12 7.8v.1"></path></svg
          >
        </a>
      </div>
    </main>

    <section class="board" aria-live="polite">
      <div class="board-card">
        <button
          class="line-pill"
          id="line-toggle"
          aria-expanded="false"
          aria-haspopup="dialog"
          aria-controls="lines-dialog"
        >
          <i class="dot"></i>
          <span id="line-name">Select line</span>
          <svg viewBox="0 0 24 24"
            ><path d="M7 9l-3 3 3 3M17 9l3 3-3 3M4 12h16"></path></svg
          >
        </button>

        <div class="board-row">
          <button class="side prev" id="prev-btn">
            <span class="arrow">←</span>
            <span class="badge" id="prev-num"></span>
            <span class="side-text">
              <b id="prev-jp"></b>
              <small id="prev-en"></small>
            </span>
          </button>

          <div class="current">
            <span class="code" id="cur-code"></span>
            <strong id="cur-jp">—</strong>
            <span class="cur-en" id="cur-en"></span>
          </div>

          <button class="side next" id="next-btn">
            <span class="side-text">
              <b id="next-jp"></b>
              <small id="next-en"></small>
            </span>
            <span class="badge" id="next-num"></span>
            <span class="arrow">→</span>
          </button>
        </div>
      </div>
    </section>

    <div
      class="lines-dialog"
      id="lines-dialog"
      role="dialog"
      aria-modal="true"
      aria-labelledby="lines-title"
      hidden
    >
      <div class="lines-dialog-inner">
        <button
          class="round lines-back"
          id="lines-back"
          aria-label="Back to map"
        >
          <svg viewBox="0 0 24 24"><path d="M15 5l-7 7 7 7"></path></svg>
        </button>
        <h2 id="lines-title">Train Lines</h2>
        <p class="lines-sub" id="lines-sub"></p>
        <div id="lines-groups"></div>
      </div>
    </div>

    <div class="station-sheet" id="station-sheet" hidden>
      <div class="sheet-backdrop" id="sheet-backdrop"></div>

      <div
        class="sheet-panel"
        role="dialog"
        aria-modal="true"
        aria-labelledby="sheet-en"
      >
        <span class="sheet-grip" aria-hidden="true"></span>

        <header class="sheet-head">
          <span class="sheet-badge">
            <small id="sheet-prefix"></small>
            <b id="sheet-num"></b>
          </span>

          <div class="sheet-title">
            <strong id="sheet-jp"></strong>
            <span id="sheet-en"></span>
          </div>

          <button
            class="round"
            id="sheet-close"
            type="button"
            aria-label="Close"
          >
            ×
          </button>
        </header>

        <div class="sheet-body" id="sheet-body"></div>

        <div class="sheet-foot">
          <a class="sheet-cta" id="sheet-full" href="#">Full station page →</a>
        </div>
      </div>
    </div>

    <div class="search-overlay" id="search-overlay" hidden>
      <div class="search-backdrop" id="search-backdrop"></div>

      <div class="search-panel">
        <div class="search-head">
          <h2>Where are you going?</h2>

          <button
            class="round"
            id="close-search"
            aria-label="Close search"
            type="button"
          >
            ×
          </button>
        </div>

        <form id="search-form" autocomplete="off">
          <input
            type="search"
            id="search-input"
            placeholder="Search stations or codes"
            aria-label="Search stations or codes"
          />
        </form>

        <div id="search-home">
          <section
            class="search-section"
            id="featured-section"
            aria-labelledby="featured-title"
          >
            <div class="search-section-head">
              <h3 id="featured-title">Popular Station Hubs</h3>
            </div>

            <div id="featured-stations" class="featured-stations"></div>
          </section>

          <section
            class="search-section"
            id="recent-section"
            aria-labelledby="recent-title"
            hidden
          >
            <div class="search-section-head">
              <h3 id="recent-title">Recent</h3>
            </div>

            <div id="recent-stations" class="recent-stations"></div>
          </section>
        </div>

        <div id="search-results" class="search-results"></div>
      </div>
    </div>

    <script
      type="application/json"
      id="transit-data"
      set:html={JSON.stringify(transitData)}
    />
    <script
      type="application/json"
      id="search-data"
      set:html={JSON.stringify(searchable)}
    />
    <script
      type="application/json"
      id="featured-stations-data"
      set:html={JSON.stringify(featuredStations)}
    />

    <script is:inline>
      (function () {
        var NS = "http://www.w3.org/2000/svg";

        var $ = function (s) {
          return document.querySelector(s);
        };

        var data = JSON.parse($("#transit-data").textContent);
        var searchable = JSON.parse($("#search-data").textContent);
        var featuredStations = JSON.parse(
          $("#featured-stations-data").textContent,
        );

        /* =========================================================
       Theme
    ========================================================= */

        function applyTheme(t) {
          document.documentElement.setAttribute("data-theme", t);

          try {
            localStorage.setItem("tokyo-theme", t);
          } catch (e) {}
        }

        try {
          var saved = localStorage.getItem("tokyo-theme");

          if (saved) {
            applyTheme(saved);
          }
        } catch (e) {}

        $("#theme-toggle").addEventListener("click", function () {
          applyTheme(
            document.documentElement.getAttribute("data-theme") === "dark"
              ? "light"
              : "dark",
          );
        });

        /* =========================================================
       Track Shapes
    ========================================================= */

        /*
         * A track is a list of straight / arc segments.
         * Stations sit at distances along it.
         * Every point carries a normal pointing to the RIGHT
         * of travel.
         */

        function segLine(x1, y1, x2, y2) {
          var len = Math.hypot(x2 - x1, y2 - y1);

          var tx = (x2 - x1) / len;
          var ty = (y2 - y1) / len;

          return {
            len: len,

            d: " L" + x2 + " " + y2,

            at: function (u) {
              return {
                x: x1 + tx * u,
                y: y1 + ty * u,
                tx: tx,
                ty: ty,
              };
            },
          };
        }

        function segArc(cx, cy, r, a0, a1) {
          var dir = a1 >= a0 ? 1 : -1;
          var len = Math.abs(a1 - a0) * r;

          var ex = cx + r * Math.cos(a1);
          var ey = cy + r * Math.sin(a1);

          return {
            len: len,

            d:
              " A" +
              r +
              " " +
              r +
              " 0 " +
              (len > Math.PI * r + 0.01 ? 1 : 0) +
              " " +
              (dir > 0 ? 1 : 0) +
              " " +
              ex +
              " " +
              ey,

            at: function (u) {
              var a = a0 + (dir * u) / r;

              return {
                x: cx + r * Math.cos(a),
                y: cy + r * Math.sin(a),
                tx: -dir * Math.sin(a),
                ty: dir * Math.cos(a),
              };
            },
          };
        }

        function makeTrack(segs, start, closed) {
          var length = 0;

          segs.forEach(function (sg) {
            length += sg.len;
          });

          var d =
            "M" +
            start.x +
            " " +
            start.y +
            segs
              .map(function (sg) {
                return sg.d;
              })
              .join("") +
            (closed ? " Z" : "");

          function raw(s) {
            var acc = 0;

            for (var i = 0; i < segs.length; i++) {
              if (s <= acc + segs[i].len || i === segs.length - 1) {
                return segs[i].at(Math.max(0, Math.min(s - acc, segs[i].len)));
              }

              acc += segs[i].len;
            }
          }

          return {
            closed: closed,
            length: length,
            d: d,

            pointAt: function (s) {
              var p;

              if (closed) {
                s = ((s % length) + length) % length;
                p = raw(s);
              } else if (s < 0) {
                p = raw(0);

                p = {
                  x: p.x + p.tx * s,
                  y: p.y + p.ty * s,
                  tx: p.tx,
                  ty: p.ty,
                };
              } else if (s > length) {
                p = raw(length);

                p = {
                  x: p.x + p.tx * (s - length),
                  y: p.y + p.ty * (s - length),
                  tx: p.tx,
                  ty: p.ty,
                };
              } else {
                p = raw(s);
              }

              p.nx = -p.ty;
              p.ny = p.tx;

              return p;
            },
          };
        }

        var CX = 400;

        function buildTrack(l, n) {
          var shape = l.shape || (n <= 8 ? "line" : "u");

          var t;

          if (shape === "loop") {
            /* Yamanote-style stadium loop */

            var R = 140;
            var S = 440;

            var rx = CX + R;
            var lx = CX - R;

            t = makeTrack(
              [
                segLine(rx, S, rx, 0),

                segArc(CX, 0, R, 0, -Math.PI),

                segLine(lx, 0, lx, S),

                segArc(CX, S, R, Math.PI, 0),
              ],
              {
                x: rx,
                y: S,
              },
              true,
            );

            t.sOf = function (i) {
              return S / 2 + (i / n) * t.length;
            };
          } else if (shape === "u") {
            /* Hairpin */

            var Ru = 100;

            var sp = n > 26 ? 50 : 64;

            var V = Math.max(80, (sp * (n - 1) - Math.PI * Ru) / 2);

            t = makeTrack(
              [
                segLine(CX - Ru, 0, CX - Ru, V),

                segArc(CX, V, Ru, Math.PI, 0),

                segLine(CX + Ru, V, CX + Ru, 0),
              ],
              {
                x: CX - Ru,
                y: 0,
              },
              false,
            );

            t.sOf = function (i) {
              return n > 1 ? (i * t.length) / (n - 1) : 0;
            };
          } else {
            /* Straight line */

            var len = Math.max(90, 90 * (n - 1));

            t = makeTrack(
              [segLine(CX, 0, CX, len)],
              {
                x: CX,
                y: 0,
              },
              false,
            );

            t.sOf = function (i) {
              return n > 1 ? (i * len) / (n - 1) : 0;
            };
          }

          t.shape = shape;

          return t;
        }

        /* =========================================================
       State
    ========================================================= */

        var lineIdx = 0;
        var idx = 0;

        var zoom = 1;

        var svg = $("#map");

        var track = null;

        var VB = {
          x: 0,
          y: 0,
          w: 800,
          h: 960,
        };

        function line() {
          return data.lines[lineIdx];
        }

        function list() {
          return data.stationsByLine[line().id] || [];
        }

        function pointAt(s) {
          return track.pointAt(s);
        }

        function sOf(i) {
          return track.sOf(i);
        }

        function el(name, attrs, parent) {
          var n = document.createElementNS(NS, name);

          for (var k in attrs) {
            n.setAttribute(k, attrs[k]);
          }

          if (parent) {
            parent.appendChild(n);
          }

          return n;
        }

        function num(code) {
          var m = String(code || "").match(/(\d+)\s*$/);

          return m ? m[1] : "";
        }

        /* =========================================================
       Draw Map
    ========================================================= */

        var LABEL_LENS = [24, 42, 60];

        function drawMap() {
          var st = list();

          track = buildTrack(line(), st.length);

          document.documentElement.style.setProperty("--line", line().color);

          var trackG = $("#track");
          var labels = $("#labels");

          trackG.innerHTML = "";
          labels.innerHTML = "";

          el(
            "path",
            {
              d: track.d,
              class: "rail-bed",
            },
            trackG,
          );

          el(
            "path",
            {
              d: track.d,
              class: "rail-base",
            },
            trackG,
          );

          /*
           * Points along the track.
           * Labels must not cover them.
           */

          var samples = [];

          for (var q = 0; q <= track.length; q += 8) {
            samples.push(track.pointAt(q));
          }

          samples.push(track.pointAt(track.length));

          var rects = [];

          var box = {
            x0: Infinity,
            y0: Infinity,
            x1: -Infinity,
            y1: -Infinity,
          };

          function grow(x, y) {
            box.x0 = Math.min(box.x0, x);

            box.y0 = Math.min(box.y0, y);

            box.x1 = Math.max(box.x1, x);

            box.y1 = Math.max(box.y1, y);
          }

          samples.forEach(function (p) {
            grow(p.x - 10, p.y - 10);

            grow(p.x + 10, p.y + 10);
          });

          function hits(r) {
            var c = 0;

            rects.forEach(function (o) {
              if (
                r.x < o.x + o.w + 4 &&
                r.x + r.w + 4 > o.x &&
                r.y < o.y + o.h + 4 &&
                r.y + r.h + 4 > o.y
              ) {
                c++;
              }
            });

            samples.forEach(function (p) {
              if (
                p.x > r.x - 9 &&
                p.x < r.x + r.w + 9 &&
                p.y > r.y - 9 &&
                p.y < r.y + r.h + 9
              ) {
                c++;
              }
            });

            return c;
          }

          /*
           * Straight line:
           * labels right first.
           *
           * Loop / hairpin:
           * labels outside first.
           */

          var prefs = track.shape === "line" ? [-1, 1] : [1, -1];

          var probe = el(
            "text",
            {
              x: 0,
              y: 0,
              class: "label",
            },
            labels,
          );

          st.forEach(function (stn, i) {
            var p = track.pointAt(track.sOf(i));

            probe.textContent = stn.name;

            var bb = probe.getBBox();

            var best = null;

            LABEL_LENS.some(function (len) {
              return prefs.some(function (sd) {
                var dx = p.nx * sd;

                var dy = p.ny * sd;

                var ex = p.x + dx * len;

                var ey = p.y + dy * len;

                var anchor =
                  dx > 0.35 ? "start" : dx < -0.35 ? "end" : "middle";

                var tx =
                  ex + (anchor === "start" ? 9 : anchor === "end" ? -9 : 0);

                var ty = ey + (anchor === "middle" ? (dy < 0 ? -9 : 13) : 3.8);

                var left =
                  tx +
                  (anchor === "end"
                    ? -bb.width
                    : anchor === "middle"
                      ? -bb.width / 2
                      : 0);

                var c = {
                  ex: ex,
                  ey: ey,
                  tx: tx,
                  ty: ty,
                  anchor: anchor,

                  rect: {
                    x: left - 8,
                    y: ty + bb.y - 3,
                    w: bb.width + 16,
                    h: bb.height + 6,
                  },
                };

                c.score = hits(c.rect);

                if (!best || c.score < best.score) {
                  best = c;
                }

                return c.score === 0;
              });
            });

            rects.push(best.rect);

            grow(best.rect.x, best.rect.y);

            grow(best.rect.x + best.rect.w, best.rect.y + best.rect.h);

            var g = el(
              "g",
              {
                class: "stn",
                "data-i": i,
                tabindex: 0,
                role: "button",
                "aria-label": stn.name,
              },
              labels,
            );

            el(
              "line",
              {
                x1: p.x,
                y1: p.y,
                x2: best.ex,
                y2: best.ey,
                class: "leader",
              },
              g,
            );

            el(
              "circle",
              {
                cx: p.x,
                cy: p.y,
                r: 12,
                class: "halo",
              },
              g,
            );

            el(
              "circle",
              {
                cx: p.x,
                cy: p.y,
                r: 7,
                class: "stop-ring",
              },
              g,
            );

            el(
              "circle",
              {
                cx: p.x,
                cy: p.y,
                r: 4.2,
                class: "stop",
              },
              g,
            );

            el(
              "rect",
              {
                x: best.rect.x,
                y: best.rect.y,
                width: best.rect.w,
                height: best.rect.h,
                rx: best.rect.h / 2,
                ry: best.rect.h / 2,
                class: "pill",
              },
              g,
            );

            var text = el(
              "text",
              {
                x: best.tx,
                y: best.ty,
                "text-anchor": best.anchor,
                class: "label",
              },
              g,
            );

            text.textContent = stn.name;

            /*
             * Existing map station click.
             */

            g.addEventListener("click", function () {
              go(i);
            });

            g.addEventListener("keydown", function (e) {
              if (e.key === "Enter" || e.key === " ") {
                e.preventDefault();
                go(i);
              }
            });
          });

          labels.removeChild(probe);

          /*
           * Zoom-1 view:
           * fit whole line.
           */

          var pad = 100;

          var vx = box.x0 - pad;

          var vy = box.y0 - pad;

          var vw = box.x1 - box.x0 + pad * 2;

          var vh = box.y1 - box.y0 + pad * 2;

          var mw = Math.max(vw, 600);

          var mh = Math.max(vh, 760);

          VB = {
            x: vx - (mw - vw) / 2,

            y: vy - (mh - vh) / 2,

            w: mw,
            h: mh,
          };
        }

        /* =========================================================
       Train + Highlight + ViewBox
    ========================================================= */

        var LANE_OFFSET = 7.5;

        var LIGHT_REACH = 80;

        var carEls = [];

        var glowEl = null;

        var carPitch = 30;

        var trainS = 0;

        var trainLane = 1;

        var trainDir = 1;

        var anim = null;

        var reduceMotion =
          window.matchMedia &&
          window.matchMedia("(prefers-reduced-motion: reduce)").matches;

        /*
         * One car, drawn top-down.
         *
         * k:
         * 0 = leading car
         * 1 = middle
         * 2 = last
         */

        function buildCar(k, len) {
          var g = el(
            "g",
            {
              class: "train-car",
            },
            $("#train"),
          );

          var h = len / 2;

          el(
            "rect",
            {
              x: -6.5,
              y: -h,
              width: 13,
              height: len,
              rx: 3.4,
              class: "car-body",
            },
            g,
          );

          el(
            "rect",
            {
              x: -5.9,
              y: -h + 5,
              width: 0.8,
              height: len - 10,
              class: "car-stripe-l",
            },
            g,
          );

          el(
            "rect",
            {
              x: 5.1,
              y: -h + 5,
              width: 0.8,
              height: len - 10,
              class: "car-stripe",
            },
            g,
          );

          /*
           * Roof air-conditioning panels.
           */

          var spots =
            k === 0 ? [0.27, 0.58] : k === 1 ? [0.14, 0.54] : [0.12, 0.46];

          spots.forEach(function (f) {
            var y = -h + len * f;

            var ph = len * 0.25;

            el(
              "rect",
              {
                x: -3.7,
                y: y,
                width: 7.4,
                height: ph,
                rx: 1.4,
                class: "ac",
              },
              g,
            );

            for (var i = 1; i <= 3; i++) {
              el(
                "rect",
                {
                  x: -3,
                  y: y + (ph * i) / 4 - 0.25,
                  width: 6,
                  height: 0.5,
                  class: "ac-line",
                },
                g,
              );
            }
          });

          /*
           * Joints.
           */

          if (k > 0) {
            el(
              "rect",
              {
                x: -4.5,
                y: -h - 1.8,
                width: 9,
                height: 3.6,
                rx: 1.2,
                class: "joint",
              },
              g,
            );
          }

          if (k < 2) {
            el(
              "rect",
              {
                x: -4.5,
                y: h - 1.8,
                width: 9,
                height: 3.6,
                rx: 1.2,
                class: "joint",
              },
              g,
            );
          }

          /*
           * Front cab.
           */

          if (k === 0) {
            el(
              "path",
              {
                d:
                  "M-6.5," +
                  (-h + 7.5) +
                  " L-6.5," +
                  (-h + 3.4) +
                  " Q-6.5," +
                  -h +
                  " -3.1," +
                  -h +
                  " L3.1," +
                  -h +
                  " Q6.5," +
                  -h +
                  " 6.5," +
                  (-h + 3.4) +
                  " L6.5," +
                  (-h + 7.5) +
                  " Z",
                class: "cab",
              },
              g,
            );

            el(
              "rect",
              {
                x: -4.8,
                y: -h + 1.9,
                width: 9.6,
                height: 3.6,
                rx: 1.6,
                class: "glass",
              },
              g,
            );

            el(
              "rect",
              {
                x: -3.8,
                y: -h + 2.5,
                width: 3.2,
                height: 0.7,
                rx: 0.35,
                class: "glint",
              },
              g,
            );

            el(
              "circle",
              {
                cx: -5,
                cy: -h + 1.1,
                r: 1.15,
                class: "lamp",
              },
              g,
            );

            el(
              "circle",
              {
                cx: 5,
                cy: -h + 1.1,
                r: 1.15,
                class: "lamp",
              },
              g,
            );
          }

          /*
           * Rear cab.
           */

          if (k === 2) {
            el(
              "path",
              {
                d:
                  "M-6.5," +
                  (h - 7.5) +
                  " L-6.5," +
                  (h - 3.4) +
                  " Q-6.5," +
                  h +
                  " -3.1," +
                  h +
                  " L3.1," +
                  h +
                  " Q6.5," +
                  h +
                  " 6.5," +
                  (h - 3.4) +
                  " L6.5," +
                  (h - 7.5) +
                  " Z",
                class: "cab",
              },
              g,
            );

            el(
              "rect",
              {
                x: -4.8,
                y: h - 5.5,
                width: 9.6,
                height: 3.6,
                rx: 1.6,
                class: "glass",
              },
              g,
            );

            el(
              "circle",
              {
                cx: -5,
                cy: h - 1.1,
                r: 1.15,
                class: "tail",
              },
              g,
            );

            el(
              "circle",
              {
                cx: 5,
                cy: h - 1.1,
                r: 1.15,
                class: "tail",
              },
              g,
            );
          }

          return g;
        }

        function initTrain() {
          $("#train").innerHTML = "";
          $("#glow").innerHTML = "";

          /*
           * Total train length follows station spacing.
           */

          var spacing = list().length > 1 ? Math.abs(sOf(1) - sOf(0)) : 60;

          var total = Math.max(50, Math.min(spacing * 1.68, 150));

          var gap = 3;

          var carLen = (total - gap * 2) / 3;

          carPitch = carLen + gap;

          carEls = [
            buildCar(0, carLen),
            buildCar(1, carLen),
            buildCar(2, carLen),
          ];

          /*
           * Headlight beam + glow.
           */

          glowEl = el(
            "g",
            {
              class: "headlight",
            },
            $("#glow"),
          );

          var y0 = -carLen / 2;

          [-1, 1].forEach(function (sx) {
            el(
              "polygon",
              {
                points:
                  sx * 5.8 +
                  "," +
                  y0 +
                  " " +
                  sx * 3.6 +
                  "," +
                  y0 +
                  " " +
                  sx * 9 +
                  "," +
                  (y0 - LIGHT_REACH) +
                  " " +
                  sx * 18 +
                  "," +
                  (y0 - LIGHT_REACH),

                fill: "url(#beam-grad)",
              },
              glowEl,
            );
          });

          el(
            "ellipse",
            {
              cx: 0,
              cy: y0 - LIGHT_REACH * 0.78,
              rx: 38,
              ry: LIGHT_REACH * 0.85,
              fill: "url(#glow-grad)",
            },
            glowEl,
          );

          if (anim) {
            cancelAnimationFrame(anim);

            anim = null;
          }

          trainS = sOf(idx);
          trainLane = 1;
          trainDir = 1;

          drawTrain(trainS, trainLane, trainDir);
        }

        /*
         * Each car follows the track curve.
         */

        function drawTrain(s, lane, dir) {
          for (var k = 0; k < 3; k++) {
            var p = pointAt(s + dir * (1 - k) * carPitch);

            var x = p.x + p.nx * lane * LANE_OFFSET;

            var y = p.y + p.ny * lane * LANE_OFFSET;

            var ang = (Math.atan2(dir * p.ny, dir * p.nx) * 180) / Math.PI;

            var t = "translate(" + x + " " + y + ") rotate(" + ang + ")";

            carEls[k].setAttribute("transform", t);

            if (k === 0) {
              glowEl.setAttribute("transform", t);
            }
          }

          return pointAt(s);
        }

        /*
         * Animate train from current position
         * to selected station.
         */

        function moveTrain() {
          var target = sOf(idx);

          var from = trainS;

          if (anim) {
            cancelAnimationFrame(anim);

            anim = null;
          }

          /*
           * Already there.
           */

          if (from === target) {
            setView(drawTrain(trainS, trainLane, trainDir));

            return;
          }

          var fromLane = trainLane;

          var toDir = target > from ? 1 : -1;

          trainDir = toDir;

          var dist = Math.abs(target - from);

          var dur = reduceMotion
            ? 0
            : Math.min(1600, Math.max(500, dist * 1.8));

          /*
           * Reduced motion.
           */

          if (dur === 0) {
            trainS = target;

            trainLane = toDir;

            setView(drawTrain(trainS, trainLane, trainDir));

            return;
          }

          var t0 = performance.now();

          function step(now) {
            var k = Math.min(1, (now - t0) / dur);

            var e = k < 0.5 ? 2 * k * k : 1 - Math.pow(-2 * k + 2, 2) / 2;

            trainS = from + (target - from) * e;

            trainLane = fromLane + (toDir - fromLane) * Math.min(1, k * 3);

            setView(drawTrain(trainS, trainLane, trainDir));

            anim = k < 1 ? requestAnimationFrame(step) : null;
          }

          anim = requestAnimationFrame(step);
        }

        function refreshView() {
          if (list().length) {
            setView(pointAt(trainS));
          }
        }

        function updateMap() {
          document.querySelectorAll(".stn").forEach(function (g) {
            g.classList.toggle(
              "current",
              Number(g.getAttribute("data-i")) === idx,
            );
          });

          /*
           * Move current station to the top
           * of paint order.
           */

          var cur = document.querySelector('.stn[data-i="' + idx + '"]');

          if (cur) {
            cur.parentNode.appendChild(cur);
          }

          moveTrain();
        }

        function setView(p) {
          var vw = VB.w / zoom;

          var vh = VB.h / zoom;

          var fx = VB.x + VB.w / 2;

          var fy = VB.y + VB.h / 2;

          /*
           * When zoomed in, follow train.
           */

          if (zoom > 1 && p) {
            fx = p.x;
            fy = p.y;
          }

          var x = Math.min(Math.max(fx - vw / 2, VB.x), VB.x + VB.w - vw);

          var y = Math.min(Math.max(fy - vh / 2, VB.y), VB.y + VB.h - vh);

          svg.setAttribute("viewBox", x + " " + y + " " + vw + " " + vh);
        }

        /* =========================================================
       Board
    ========================================================= */

        function updateBoard() {
          var l = list();

          var cur = l[idx];

          var prev = l[idx - 1];

          var next = l[idx + 1];

          $("#line-name").textContent = line().name;

          var cw = document.querySelector(".current");

          cw.classList.remove("swap");

          void cw.offsetWidth;

          cw.classList.add("swap");

          $("#cur-jp").textContent = cur ? cur.jp || cur.name : "—";

          $("#cur-en").textContent = cur ? cur.name : "";

          $("#cur-code").textContent = cur ? cur.code || "" : "";

          $("#cur-code").hidden = !(cur && cur.code);

          function side(prefix, s) {
            var btn = $("#" + prefix + "-btn");

            btn.disabled = !s;

            $("#" + prefix + "-jp").textContent = s ? s.jp || s.name : "";

            $("#" + prefix + "-en").textContent = s ? s.name : "";

            $("#" + prefix + "-num").textContent = s ? num(s.code) : "";

            $("#" + prefix + "-num").hidden = !s;
          }

          side("prev", prev);

          side("next", next);

          /*
           * Station information page.
           *
           * This is now the ONLY normal route to
           * station detail from the map UI.
           */

          var info = $("#info-link");

          if (cur && cur.slug) {
            info.href = "/stations/" + encodeURIComponent(cur.slug);
          } else {
            info.href = "#";
          }
        }

        function go(i) {
          var n = list().length;

          if (!n) {
            return;
          }

          idx = Math.max(0, Math.min(i, n - 1));

          updateBoard();
          updateMap();
        }

        /*
         * setLine now accepts an optional station index.
         *
         * resetTrainToZero:
         *   true  = normal manual line selection
         *   false = search-driven line switching
         *
         * For search-driven switching we initialize the train
         * at station 0, then call go(targetIndex), so the train
         * visibly moves toward the searched station.
         */

        function setLine(i, options) {
          options = options || {};

          var targetIndex = Number.isInteger(options.stationIndex)
            ? options.stationIndex
            : 0;

          var animateToStation = options.animateToStation === true;

          lineIdx = i;

          /*
           * Normal line selection starts at station 0.
           */

          idx = animateToStation ? 0 : targetIndex;

          zoom = 1;

          drawMap();

          initTrain();

          updateBoard();

          /*
           * Search-driven line change:
           *
           * train starts at station 0
           * then moves to requested station.
           */

          if (animateToStation) {
            go(targetIndex);
          } else {
            updateMap();
          }

          markActiveRow();
        }

        /* =========================================================
       Search → Map Station Selection
    ========================================================= */

        /*
         * Find a station in a specific line.
         */

        function findStationIndexInLine(lineId, slug) {
          var stations = data.stationsByLine[lineId] || [];

          for (var i = 0; i < stations.length; i++) {
            if (stations[i].slug === slug) {
              return i;
            }
          }

          return -1;
        }

        /*
         * Find every line that contains a station.
         *
         * A station can belong to multiple lines.
         */

        function findLinesForStation(slug) {
          var matches = [];

          data.lines.forEach(function (l, i) {
            var stationIndex = findStationIndexInLine(String(l.id), slug);

            if (stationIndex >= 0) {
              matches.push({
                lineIndex: i,
                stationIndex: stationIndex,
                lineId: l.id,
                lineName: l.name,
              });
            }
          });

          return matches;
        }

        /*
         * Select station from:
         *
         * - Search result
         * - Featured station
         * - Recent station
         *
         * Behavior:
         *
         * 1. If station exists on current line:
         *      stay on current line.
         *
         * 2. If station does not exist on current line:
         *      automatically switch to the first matching line.
         *
         * 3. Train animates toward selected station.
         *
         * Every successful selection is saved to Recent here,
         * so callers must NOT call saveRecentStation themselves.
         */

        function selectStationOnMap(slug) {
          if (!slug) {
            console.warn("[select] empty slug");
            return;
          }

          var station = searchable.find(function (s) {
            return s.slug === slug;
          });

          if (!station) {
            console.warn("[select] slug not in searchable:", slug);
            return;
          }

          var matches = findLinesForStation(station.slug);

          if (!matches.length) {
            console.warn("[select] station not on any line:", station.slug);
            return;
          }

          /*
           * Save every successfully selected station
           * to Recent.
           */
          saveRecentStation(station.slug);

          /*
           * Prefer the current line if possible.
           */
          var selected = matches.find(function (item) {
            return item.lineIndex === lineIdx;
          });

          /*
           * Otherwise use the first matching line.
           */
          if (!selected) {
            selected = matches[0];
          }

          closeSearch();

          /*
           * Same line:
           * Keep current train position and animate
           * directly to the selected station.
           */
          if (selected.lineIndex === lineIdx) {
            go(selected.stationIndex);
            return;
          }

          /*
           * Different line:
           * Switch line and animate train from the
           * beginning of that line to the station.
           */
          setLine(selected.lineIndex, {
            stationIndex: selected.stationIndex,
            animateToStation: true,
          });
        }

        /*
         * Search overlay sends this event.
         *
         * Keeping this as a CustomEvent makes the search
         * system independent from the map internals.
         */

        document.addEventListener("station-select", function (event) {
          var detail = event.detail;

          if (!detail || !detail.slug) {
            return;
          }

          selectStationOnMap(detail.slug);
        });

        /* =========================================================
       Controls
    ========================================================= */

        /* =========================================================
       Station Detail Sheet (info icon)
    ========================================================= */

        var sheet = $("#station-sheet");

        /*
         * Read a field from the line's station object first,
         * then from the matching `searchable` item.
         * Accepts several possible field names.
         */

        function stationField(stn, names) {
          var extra =
            searchable.find(function (s) {
              return s.slug === stn.slug;
            }) || {};

          for (var i = 0; i < names.length; i++) {
            var v = stn[names[i]];

            if (v == null || v === "") {
              v = extra[names[i]];
            }

            if (v != null && v !== "") {
              return v;
            }
          }

          return null;
        }

        /*
         * Accepts: array of strings, array of {name|label|title},
         * JSON string, or comma / newline separated string.
         */

        function toList(v) {
          if (!v) {
            return [];
          }

          if (typeof v === "string") {
            var t = v.trim();

            if (t.charAt(0) === "[") {
              try {
                return toList(JSON.parse(t));
              } catch (e) {}
            }

            return t
              .split(/[,\n]/)
              .map(function (s) {
                return s.trim();
              })
              .filter(Boolean);
          }

          if (Array.isArray(v)) {
            return v
              .map(function (i) {
                return typeof i === "string"
                  ? i.trim()
                  : String((i && (i.name || i.label || i.title)) || "").trim();
              })
              .filter(Boolean);
          }

          return [];
        }

        function stationConnections(stn) {
          var raw = stationField(stn, ["connections"]);

          if (typeof raw === "string") {
            try {
              raw = JSON.parse(raw);
            } catch (e) {
              raw = null;
            }
          }

          var out = [];

          if (Array.isArray(raw)) {
            raw.forEach(function (i) {
              if (typeof i === "string") {
                out.push({ name: i });
              } else if (i && i.name) {
                out.push({ name: i.name, color: i.color });
              }
            });
          }

          if (out.length) {
            return out;
          }

          /*
           * Fallback: other lines that stop at this station.
           */

          findLinesForStation(stn.slug).forEach(function (m) {
            if (m.lineIndex !== lineIdx) {
              out.push({
                name: m.lineName,
                color: data.lines[m.lineIndex].color,
              });
            }
          });

          return out;
        }

        function sheetSection(title, inner) {
          return (
            '<section class="sheet-sec"><h4>' +
            esc(title) +
            "</h4>" +
            inner +
            "</section>"
          );
        }

        function sheetChips(items) {
          return (
            '<div class="sheet-chips">' +
            items
              .map(function (t) {
                return "<span>" + esc(t) + "</span>";
              })
              .join("") +
            "</div>"
          );
        }

        function openSheet() {
          var stn = list()[idx];

          if (!stn) {
            return;
          }

          var m = String(stn.code || "").match(/^([A-Za-z]+)\s*-?\s*(\d+)\s*$/);

          $("#sheet-prefix").textContent = m ? m[1].toUpperCase() : "";
          $("#sheet-num").textContent = m ? m[2] : num(stn.code);
          $("#sheet-jp").textContent = stn.jp || stn.name;
          $("#sheet-en").textContent = stn.name;

          var html = "";

          var about = stationField(stn, ["about", "description", "summary"]);

          if (about) {
            html += sheetSection("About", "<p>" + esc(about) + "</p>");
          }

          var facilities = toList(stationField(stn, ["facilities"]));

          if (facilities.length) {
            html += sheetSection("Facilities", sheetChips(facilities));
          }

          var picks = toList(
            stationField(stn, ["top_picks", "topPicks", "highlights"]),
          );

          if (picks.length) {
            html += sheetSection("Top Picks", sheetChips(picks));
          }

          var conns = stationConnections(stn);

          if (conns.length) {
            html += sheetSection(
              "Connections",
              '<ul class="sheet-conns">' +
                conns
                  .map(function (c) {
                    return (
                      "<li><i" +
                      (c.color ? ' style="--c:' + esc(c.color) + '"' : "") +
                      "></i><b>" +
                      esc(c.name) +
                      "</b></li>"
                    );
                  })
                  .join("") +
                "</ul>",
            );
          }

          $("#sheet-body").innerHTML = html;
          $("#sheet-body").scrollTop = 0;

          $("#sheet-full").href = stn.slug
            ? "/stations/" + encodeURIComponent(stn.slug)
            : "#";

          sheet.hidden = false;

          $("#sheet-close").focus();
        }

        function closeSheet() {
          sheet.hidden = true;
        }

        $("#info-link").addEventListener("click", function (e) {
          if (!list()[idx]) {
            return;
          }

          e.preventDefault();

          openSheet();
        });

        $("#sheet-close").addEventListener("click", closeSheet);

        $("#sheet-backdrop").addEventListener("click", closeSheet);

        $("#prev-btn").addEventListener("click", function () {
          go(idx - 1);
        });

        $("#next-btn").addEventListener("click", function () {
          go(idx + 1);
        });

        var MAX_ZOOM = 6;

        /* =========================================================
       Zoom
    ========================================================= */

        $("#zoom-in").addEventListener("click", function () {
          zoom = Math.min(zoom * 1.5, MAX_ZOOM);

          refreshView();
        });

        $("#zoom-out").addEventListener("click", function () {
          zoom = Math.max(zoom / 1.5, 1);

          refreshView();
        });

        /*
         * Mouse wheel zoom.
         */

        $("#stage").addEventListener(
          "wheel",
          function (e) {
            e.preventDefault();

            var step = e.deltaMode === 1 ? 0.05 : 0.0015;

            zoom = Math.min(
              MAX_ZOOM,
              Math.max(1, zoom * Math.exp(-e.deltaY * step)),
            );

            refreshView();
          },
          {
            passive: false,
          },
        );

        /* =========================================================
       Pan / Drag
    ========================================================= */

        var pan = {
          active: false,

          startX: 0,
          startY: 0,

          startVBX: 0,
          startVBY: 0,
        };

        /*
         * Convert screen movement into SVG/world movement.
         */

        function panBy(dx, dy) {
          var rect = svg.getBoundingClientRect();

          if (!rect.width || !rect.height) {
            return;
          }

          var vw = VB.w / zoom;

          var vh = VB.h / zoom;

          var worldDX = (dx / rect.width) * vw;

          var worldDY = (dy / rect.height) * vh;

          var x = pan.startVBX - worldDX;

          var y = pan.startVBY - worldDY;

          x = Math.min(Math.max(x, VB.x), VB.x + VB.w - vw);

          y = Math.min(Math.max(y, VB.y), VB.y + VB.h - vh);

          svg.setAttribute("viewBox", x + " " + y + " " + vw + " " + vh);
        }

        /* =========================================================
       Desktop Mouse Drag
    ========================================================= */

        $("#stage").addEventListener("mousedown", function (e) {
          if (e.button !== 0) {
            return;
          }

          /*
           * At zoom 1 the whole map is fitted.
           */

          if (zoom <= 1) {
            return;
          }

          pan.active = true;

          pan.startX = e.clientX;

          pan.startY = e.clientY;

          var viewBox = svg.getAttribute("viewBox").split(" ").map(Number);

          pan.startVBX = viewBox[0];

          pan.startVBY = viewBox[1];

          $("#stage").classList.add("is-panning");
        });

        window.addEventListener("mousemove", function (e) {
          if (!pan.active) {
            return;
          }

          panBy(
            e.clientX - pan.startX,

            e.clientY - pan.startY,
          );
        });

        window.addEventListener("mouseup", function () {
          if (!pan.active) {
            return;
          }

          pan.active = false;

          $("#stage").classList.remove("is-panning");
        });

        /* =========================================================
       Touch Pan + Pinch
    ========================================================= */

        var touches = {
          mode: null,

          startX: 0,
          startY: 0,

          startVBX: 0,
          startVBY: 0,

          distance: 0,

          zoomStart: 1,
        };

        function touchDistance(t) {
          return Math.hypot(
            t[0].clientX - t[1].clientX,

            t[0].clientY - t[1].clientY,
          );
        }

        /*
         * One finger = pan.
         * Two fingers = pinch.
         */

        $("#stage").addEventListener(
          "touchstart",
          function (e) {
            if (e.touches.length === 1) {
              if (zoom <= 1) {
                return;
              }

              touches.mode = "pan";

              touches.startX = e.touches[0].clientX;

              touches.startY = e.touches[0].clientY;

              var viewBox = svg.getAttribute("viewBox").split(" ").map(Number);

              touches.startVBX = viewBox[0];

              touches.startVBY = viewBox[1];

              $("#stage").classList.add("is-panning");
            }

            if (e.touches.length === 2) {
              touches.mode = "pinch";

              touches.distance = touchDistance(e.touches);

              touches.zoomStart = zoom;

              $("#stage").classList.remove("is-panning");
            }
          },
          {
            passive: true,
          },
        );

        $("#stage").addEventListener(
          "touchmove",
          function (e) {
            /*
             * Pinch.
             */

            if (touches.mode === "pinch" && e.touches.length === 2) {
              e.preventDefault();

              var distance = touchDistance(e.touches);

              if (!touches.distance) {
                return;
              }

              zoom = Math.min(
                MAX_ZOOM,
                Math.max(1, touches.zoomStart * (distance / touches.distance)),
              );

              refreshView();

              return;
            }

            /*
             * Pan.
             */

            if (touches.mode === "pan" && e.touches.length === 1 && zoom > 1) {
              e.preventDefault();

              pan.startX = touches.startX;

              pan.startY = touches.startY;

              pan.startVBX = touches.startVBX;

              pan.startVBY = touches.startVBY;

              panBy(
                e.touches[0].clientX - touches.startX,

                e.touches[0].clientY - touches.startY,
              );
            }
          },
          {
            passive: false,
          },
        );

        $("#stage").addEventListener(
          "touchend",
          function (e) {
            if (e.touches.length === 0) {
              touches.mode = null;

              $("#stage").classList.remove("is-panning");

              return;
            }

            /*
             * If pinch finishes with one finger,
             * start fresh pan.
             */

            if (e.touches.length === 1) {
              if (zoom <= 1) {
                touches.mode = null;

                return;
              }

              touches.mode = "pan";

              touches.startX = e.touches[0].clientX;

              touches.startY = e.touches[0].clientY;

              var viewBox = svg.getAttribute("viewBox").split(" ").map(Number);

              touches.startVBX = viewBox[0];

              touches.startVBY = viewBox[1];

              $("#stage").classList.add("is-panning");
            }
          },
          {
            passive: true,
          },
        );

        $("#stage").addEventListener(
          "touchcancel",
          function () {
            touches.mode = null;

            $("#stage").classList.remove("is-panning");
          },
          {
            passive: true,
          },
        );

        /* =========================================================
       Reset
    ========================================================= */

        $("#zoom-reset").addEventListener("click", function () {
          zoom = 1;

          go(0);
        });

        /* =========================================================
       Keyboard Navigation
    ========================================================= */

        document.addEventListener("keydown", function (e) {
          if (
            !$("#search-overlay").hidden ||
            !$("#lines-dialog").hidden ||
            !$("#station-sheet").hidden
          ) {
            return;
          }

          if (e.key === "ArrowLeft") {
            go(idx - 1);
          }

          if (e.key === "ArrowRight") {
            go(idx + 1);
          }
        });

        /* =========================================================
       Lines Dialog
    ========================================================= */

        var dlg = $("#lines-dialog");

        var toggle = $("#line-toggle");

        function openLines() {
          dlg.hidden = false;

          toggle.setAttribute("aria-expanded", "true");

          dlg.scrollTop = 0;

          $("#lines-back").focus();
        }

        function closeLines() {
          dlg.hidden = true;

          toggle.setAttribute("aria-expanded", "false");

          toggle.focus();
        }

        function markActiveRow() {
          document.querySelectorAll(".line-row").forEach(function (r) {
            r.classList.toggle(
              "active",
              Number(r.getAttribute("data-i")) === lineIdx,
            );
          });
        }

        function buildLinesDialog() {
          var groups = [];

          var byOp = {};

          data.lines.forEach(function (l, i) {
            var key = l.operatorId;

            if (!byOp[key]) {
              byOp[key] = {
                id: key,

                name: l.operator || "Other",

                items: [],
              };

              groups.push(byOp[key]);
            }

            byOp[key].items.push({
              l: l,
              i: i,
            });
          });

          groups.sort(function (a, b) {
            return a.id - b.id;
          });

          $("#lines-sub").textContent =
            data.lines.length +
            " routes — " +
            groups
              .map(function (g) {
                return g.name;
              })
              .join(", ");

          var host = $("#lines-groups");

          host.innerHTML = "";

          groups.forEach(function (g) {
            g.items.sort(function (a, b) {
              return a.l.id - b.l.id;
            });

            var sec = document.createElement("section");

            sec.className = "lines-group";

            var head = document.createElement("div");

            head.className = "lines-group-head";

            head.innerHTML = "<span></span><em></em>";

            head.firstChild.textContent = g.name;

            head.lastChild.textContent =
              g.items.length + (g.items.length === 1 ? " line" : " lines");

            sec.appendChild(head);

            g.items.forEach(function (it) {
              var row = document.createElement("button");

              row.type = "button";

              row.className = "line-row";

              row.setAttribute("data-i", it.i);

              row.innerHTML =
                '<span class="line-badge"></span>' +
                '<span class="line-text">' +
                "<b></b>" +
                "<small></small>" +
                "</span>" +
                '<svg class="line-chevron" viewBox="0 0 24 24">' +
                '<path d="M9 6l6 6-6 6"></path>' +
                "</svg>";

              var badge = row.querySelector(".line-badge");

              badge.textContent = it.l.code || "";

              badge.style.background = it.l.color;

              var name = row.querySelector("b");

              name.textContent = it.l.name;

              name.style.setProperty("--c", it.l.color);

              row.querySelector("small").textContent = it.l.description || "";

              row.addEventListener("click", function () {
                setLine(it.i);

                closeLines();
              });

              sec.appendChild(row);
            });

            host.appendChild(sec);
          });

          markActiveRow();
        }

        buildLinesDialog();

        toggle.addEventListener("click", openLines);

        $("#lines-back").addEventListener("click", closeLines);

        /* =========================================================
       Search
    ========================================================= */

        var overlay = $("#search-overlay");

        var input = $("#search-input");

        var results = $("#search-results");

        var searchHome = $("#search-home");

        var featuredSection = $("#featured-section");

        var featuredHost = $("#featured-stations");

        var recentSection = $("#recent-section");

        var recentHost = $("#recent-stations");

        var RECENT_SEARCH_KEY = "tokyo-recent-stations";

        var MAX_RECENT = 6;

        function esc(v) {
          return String(v == null ? "" : v).replace(/[&<>"']/g, function (c) {
            return {
              "&": "&amp;",
              "<": "&lt;",
              ">": "&gt;",
              '"': "&quot;",
              "'": "&#39;",
            }[c];
          });
        }

        function getRecentStations() {
          try {
            var raw = localStorage.getItem(RECENT_SEARCH_KEY);

            if (!raw) {
              return [];
            }

            var slugs = JSON.parse(raw);

            if (!Array.isArray(slugs)) {
              return [];
            }

            return slugs
              .map(function (slug) {
                return searchable.find(function (s) {
                  return s.slug === slug;
                });
              })
              .filter(Boolean)
              .slice(0, MAX_RECENT);
          } catch (e) {
            return [];
          }
        }

        function saveRecentStation(slug) {
          if (!slug) {
            return;
          }

          try {
            var recent = [];

            var raw = localStorage.getItem(RECENT_SEARCH_KEY);

            if (raw) {
              var parsed = JSON.parse(raw);

              if (Array.isArray(parsed)) {
                recent = parsed;
              }
            }

            recent = recent.filter(function (item) {
              return item !== slug;
            });

            recent.unshift(slug);

            localStorage.setItem(
              RECENT_SEARCH_KEY,
              JSON.stringify(recent.slice(0, MAX_RECENT)),
            );
          } catch (e) {}
        }

        function getStationCode(station) {
          if (!station.codes || !station.codes.length) {
            return "";
          }

          return station.codes[0];
        }

        /*
         * Kept for the station information button.
         *
         * Search items no longer use this.
         */

        function stationHref(slug) {
          return "/stations/" + encodeURIComponent(slug);
        }

        /* =========================================================
       Featured Stations
    ========================================================= */

        /*
         * Featured items come from a different table/query than
         * `searchable`, so their slug may differ (case, spacing,
         * field name). Resolve it against `searchable` by slug,
         * then English name, then Japanese name.
         */

        function resolveFeaturedSlug(f) {
          var norm = function (v) {
            return String(v || "")
              .trim()
              .toLowerCase();
          };

          var slug = norm(f.station_slug || f.slug);
          var name = norm(f.station_name || f.name);
          var jp = norm(f.station_name_japanese || f.jp);

          var hit = searchable.find(function (s) {
            return (
              (slug && norm(s.slug) === slug) ||
              (name && norm(s.name) === name) ||
              (jp && norm(s.jp) === jp)
            );
          });

          return hit ? hit.slug : null;
        }

        function renderFeaturedStations() {
          featuredHost.innerHTML = "";

          if (!featuredStations.length) {
            featuredSection.hidden = true;

            return;
          }

          featuredSection.hidden = false;

          featuredStations.forEach(function (station) {
            var a = document.createElement("a");

            a.className = "featured-station";
            a.href = "#";
            a.dataset.slug = station.station_slug || "";

            a.innerHTML =
              '<span class="featured-image-wrap">' +
              '<img src="' +
              esc(station.image_url) +
              '" alt="" loading="lazy">' +
              "</span>" +
              '<span class="featured-info">' +
              "<b>" +
              esc(station.station_name) +
              (station.station_name_japanese
                ? " " + esc(station.station_name_japanese)
                : "") +
              "</b>" +
              (station.description
                ? "<small>" + esc(station.description) + "</small>"
                : "") +
              "</span>";

            a.addEventListener("click", function (e) {
              e.preventDefault();

              var slug = resolveFeaturedSlug(station);

              if (!slug) {
                console.warn(
                  "[featured] station not found in searchable:",
                  station,
                );
                return;
              }

              /* selectStationOnMap also saves to Recent */
              selectStationOnMap(slug);
            });

            featuredHost.appendChild(a);
          });
        }

        /* =========================================================
       Recent Stations
    ========================================================= */

        function renderRecentStations() {
          var recent = getRecentStations();

          recentHost.innerHTML = "";

          if (!recent.length) {
            recentSection.hidden = true;

            return;
          }

          recentSection.hidden = false;

          recent.forEach(function (station) {
            var a = document.createElement("a");

            /*
             * Do NOT navigate to station detail.
             */

            a.href = "#";

            a.className = "recent-station";

            var code = getStationCode(station);

            var lineText = (station.lines || []).join(" · ");

            a.innerHTML =
              '<span class="recent-station-name">' +
              "<b>" +
              esc(station.name) +
              "</b>" +
              "<span>" +
              esc(
                station.jp
                  ? station.jp + (lineText ? " · " + lineText : "")
                  : lineText,
              ) +
              "</span>" +
              "</span>" +
              '<span class="recent-station-code">' +
              esc(code) +
              "</span>" +
              '<span class="recent-station-arrow" aria-hidden="true">→</span>';

            a.addEventListener("click", function (e) {
              e.preventDefault();

              selectStationOnMap(station.slug);
            });

            recentHost.appendChild(a);
          });
        }

        /* =========================================================
       Search Results
    ========================================================= */

        function showSearchHome() {
          searchHome.hidden = false;

          results.innerHTML = "";

          renderFeaturedStations();
          renderRecentStations();
        }

        function showSearchResults(matches) {
          searchHome.hidden = true;

          results.innerHTML = matches.length
            ? matches
                .map(function (s) {
                  return (
                    '<a class="result" href="#" data-slug="' +
                    esc(s.slug) +
                    '">' +
                    "<b>" +
                    esc(s.jp || "") +
                    "</b>" +
                    "<span>" +
                    esc(s.name) +
                    "</span>" +
                    "</a>"
                  );
                })
                .join("")
            : '<p class="empty">No stations found. Try the English or Japanese name.</p>';

          results.querySelectorAll("a.result").forEach(function (a) {
            a.addEventListener("click", function (e) {
              e.preventDefault();

              selectStationOnMap(a.getAttribute("data-slug"));
            });
          });
        }

        function openSearch() {
          overlay.hidden = false;

          input.value = "";

          showSearchHome();

          setTimeout(function () {
            input.focus();
          }, 30);
        }

        function closeSearch() {
          overlay.hidden = true;
        }

        /*
         * Automatic search.
         */

        input.addEventListener("input", function () {
          var q = input.value.trim().toLowerCase();

          if (!q) {
            showSearchHome();

            return;
          }

          var m = searchable
            .filter(function (s) {
              var codeMatch = (s.codes || []).some(function (code) {
                return code.toLowerCase().includes(q);
              });

              return (
                (s.name || "").toLowerCase().includes(q) ||
                (s.jp || "").toLowerCase().includes(q) ||
                (s.slug || "").toLowerCase().includes(q) ||
                codeMatch
              );
            })
            .slice(0, 10);

          showSearchResults(m);
        });

        /*
         * Enter on search result.
         */

        $("#search-form").addEventListener("submit", function (e) {
          e.preventDefault();

          var first = results.querySelector("a.result");

          if (!first) {
            return;
          }

          selectStationOnMap(first.getAttribute("data-slug"));
        });

        $("#open-search").addEventListener("click", openSearch);

        $("#close-search").addEventListener("click", closeSearch);

        $("#search-backdrop").addEventListener("click", closeSearch);

        /* =========================================================
       Escape
    ========================================================= */

        document.addEventListener("keydown", function (e) {
          if (e.key !== "Escape") {
            return;
          }

          if (!sheet.hidden) {
            closeSheet();
          } else if (!dlg.hidden) {
            closeLines();
          } else if (!overlay.hidden) {
            closeSearch();
          }
        });

        /* =========================================================
       Init
    ========================================================= */

        if (data.lines.length) {
          var start = 0;

          /*
           * Prefer loop line on initial load.
           */

          for (var k = 0; k < data.lines.length; k++) {
            if (data.lines[k].shape === "loop") {
              start = k;

              break;
            }
          }

          setLine(start);
        } else {
          $("#line-name").textContent = "No lines available";
        }
      })();
    </script>
  
</WebsiteLayout>
