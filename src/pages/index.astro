---
import { env } from "cloudflare:workers";
import WebsiteLayout from "../layouts/WebsiteLayout.astro";
import Topbar from "../components/website/Topbar.astro";
import TransitMap from "../components/website/TransitMap.astro";
import StationBoard from "../components/website/StationBoard.astro";
import StationSheet from "../components/website/StationSheet.astro";
import SearchOverlay from "../components/website/SearchOverlay.astro";
import HomeData from "../components/website/HomeData.astro";
import { getTransitMapData } from "../lib/db/transit-map.ts";
import { getFeaturedStations } from "../lib/db/featured-stations";

export const prerender = false;

const db = env.DB;

const siteName = "Tokyo Station Guide";
const description =
  "Explore Tokyo railway stations, train lines, station codes, exits, nearby attractions, restaurants, hotels, and useful travel information.";

/* ========================================
   Transit Map Data
======================================== */

const all = await getTransitMapData(db);

/* Published lines are browsable; the rest show as "Coming soon"
   (switched per line in Admin > Lines). */
const lines = all.lines.filter((line) => line.published);
const readyIds = new Set(lines.map((line) => String(line.id)));
const readyNames = new Set(lines.map((line) => line.name));

const comingSoon = all.lines
  .filter((line) => !readyIds.has(String(line.id)))
  .map((line) => ({
    id: line.id,
    name: line.name,
    jp: line.jp,
    color: line.color,
  }));

const stationsByLine = Object.fromEntries(
  Object.entries(all.stationsByLine).filter(([lineId]) => readyIds.has(lineId)),
);

const searchable = all.searchable.filter((station) =>
  station.lines.some((name) => readyNames.has(name)),
);

const featuredStations = await getFeaturedStations(db);

const transitData = {
  lines,
  stationsByLine,
  comingSoon,
};
---

<WebsiteLayout
  title={`${siteName} | Tokyo Railway & Station Guide`}
  description={description}
>
    <Topbar siteName={siteName} />

    <TransitMap />

    <StationBoard />

    <StationSheet />

    <SearchOverlay />

    <HomeData transitData={transitData} searchable={searchable} featuredStations={featuredStations} />

    <script>
      import "../scripts/website/home.js";
    </script>
  
</WebsiteLayout>
