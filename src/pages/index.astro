---
import { getTransitMapData } from "../lib/db/transit-map.ts";

import "../styles/website/global.css";
import "../styles/website/theme.css";
import "../styles/website/base.css";
import "../styles/website/header.css";
import "../styles/website/transit.css";
import "../styles/website/station-board.css";
import "../styles/website/lines-dialog.css";
import "../styles/website/search.css";
import "../styles/website/responsive.css";

export const prerender = false;

const { env } = await import("cloudflare:workers");
const db = env.DB;

const siteName = "Tokyo Station Guide";
const description =
  "Explore Tokyo railway stations, train lines, station codes, exits, nearby attractions, restaurants, hotels, and useful travel information.";

/* ========================================
   Transit Map Data
======================================== */

const { lines, stationsByLine, searchable } = await getTransitMapData(db);

const transitData = {
  lines,
  stationsByLine,
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1, viewport-fit=cover"
    />
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow" />
    <link rel="icon" href="/favicon.svg" />
    <title>{siteName} | Tokyo Railway & Station Guide</title>
  </head>

  <body>
    <header class="topbar">
      <a href="/" class="brand" aria-label={siteName}>
        <span class="brand-jp">東<i></i>京</span>
        <span class="brand-en">TOKYO</span>
      </a>
      <div class="top-actions">
        <button class="round" id="open-search" aria-label="Search stations">
          <svg viewBox="0 0 24 24"
            ><circle cx="11" cy="11" r="6.5"></circle><path d="m16 16 4.5 4.5"
            ></path></svg
          >
        </button>
        <button class="round" id="theme-toggle" aria-label="Toggle theme">
          <svg class="icon-sun" viewBox="0 0 24 24"
            ><circle cx="12" cy="12" r="4"></circle><path
              d="M12 2v2.5M12 19.5V22M2 12h2.5M19.5 12H22M4.9 4.9l1.8 1.8M17.3 17.3l1.8 1.8M4.9 19.1l1.8-1.8M17.3 6.7l1.8-1.8"
            ></path></svg
          >
          <svg class="icon-moon" viewBox="0 0 24 24"
            ><path d="M20.5 14.2A8.5 8.5 0 1 1 9.8 3.5a6.8 6.8 0 0 0 10.7 10.7z"
            ></path></svg
          >
        </button>
      </div>
    </header>

    <main class="stage" id="stage">
      <svg
        id="map"
        role="img"
        aria-label="Railway line map"
        preserveAspectRatio="xMidYMid meet"
      >
        <defs>
          <pattern
            id="grid"
            width="40"
            height="40"
            patternUnits="userSpaceOnUse"
          >
            <path d="M40 0H0V40" class="grid-lo" transform="translate(1 1)"
            ></path>
            <path d="M40 0H0V40" class="grid-hi"></path>
          </pattern>
          <linearGradient id="car-grad" x1="0" y1="0" x2="1" y2="0">
            <stop offset="0" stop-color="#c9d0d9"></stop>
            <stop offset="0.16" stop-color="#f6f8fa"></stop>
            <stop offset="0.5" stop-color="#ffffff"></stop>
            <stop offset="0.84" stop-color="#f0f3f6"></stop>
            <stop offset="1" stop-color="#c6cdd6"></stop>
          </linearGradient>
          <linearGradient id="ac-grad" x1="0" y1="0" x2="1" y2="0">
            <stop offset="0" stop-color="#aeb6c1"></stop>
            <stop offset="0.5" stop-color="#cfd5dd"></stop>
            <stop offset="1" stop-color="#aab2bd"></stop>
          </linearGradient>
          <linearGradient id="glass-grad" x1="0" y1="0" x2="1" y2="1">
            <stop offset="0" stop-color="#45596d"></stop>
            <stop offset="1" stop-color="#1c2835"></stop>
          </linearGradient>
          <linearGradient id="beam-grad" x1="0" y1="1" x2="0" y2="0">
            <stop offset="0" stop-color="#fff3c4" stop-opacity="0.75"></stop>
            <stop offset="1" stop-color="#fff3c4" stop-opacity="0"></stop>
          </linearGradient>
          <radialGradient id="glow-grad">
            <stop offset="0" stop-color="#f3ecb0" stop-opacity="0.7"></stop>
            <stop offset="0.5" stop-color="#f3ecb0" stop-opacity="0.28"></stop>
            <stop offset="1" stop-color="#fff0b0" stop-opacity="0"></stop>
          </radialGradient>
        </defs>
        <rect x="-3000" y="-3000" width="7000" height="7000" fill="url(#grid)"
        ></rect>
        <g id="track"></g>
        <g id="glow"></g>
        <g id="labels"></g>
        <g id="train"></g>
      </svg>

      <div class="rail-tools left">
        <button class="tool" id="zoom-in" aria-label="Zoom in">+</button>
        <button class="tool" id="zoom-out" aria-label="Zoom out">−</button>
        <button class="tool" id="zoom-reset" aria-label="Reset view">
          <svg viewBox="0 0 24 24"
            ><path d="M4 12a8 8 0 1 0 3-6.2M4 4v4.5h4.5"></path></svg
          >
        </button>
      </div>

      <div class="rail-tools right">
        <a class="tool" id="info-link" href="#" aria-label="Open station page">
          <svg viewBox="0 0 24 24"
            ><circle cx="12" cy="12" r="9"></circle><path
              d="M12 11v5.5M12 7.8v.1"></path></svg
          >
        </a>
      </div>
    </main>

    <section class="board" aria-live="polite">
      <div class="board-card">
        <button
          class="line-pill"
          id="line-toggle"
          aria-expanded="false"
          aria-haspopup="dialog"
          aria-controls="lines-dialog"
        >
          <i class="dot"></i>
          <span id="line-name">Select line</span>
          <svg viewBox="0 0 24 24"
            ><path d="M7 9l-3 3 3 3M17 9l3 3-3 3M4 12h16"></path></svg
          >
        </button>

        <div class="board-row">
          <button class="side prev" id="prev-btn">
            <span class="arrow">←</span>
            <span class="badge" id="prev-num"></span>
            <span class="side-text">
              <b id="prev-jp"></b>
              <small id="prev-en"></small>
            </span>
          </button>

          <div class="current">
            <span class="code" id="cur-code"></span>
            <strong id="cur-jp">—</strong>
            <span class="cur-en" id="cur-en"></span>
          </div>

          <button class="side next" id="next-btn">
            <span class="side-text">
              <b id="next-jp"></b>
              <small id="next-en"></small>
            </span>
            <span class="badge" id="next-num"></span>
            <span class="arrow">→</span>
          </button>
        </div>
      </div>
    </section>

    <div
      class="lines-dialog"
      id="lines-dialog"
      role="dialog"
      aria-modal="true"
      aria-labelledby="lines-title"
      hidden
    >
      <div class="lines-dialog-inner">
        <button
          class="round lines-back"
          id="lines-back"
          aria-label="Back to map"
        >
          <svg viewBox="0 0 24 24"><path d="M15 5l-7 7 7 7"></path></svg>
        </button>
        <h2 id="lines-title">Train Lines</h2>
        <p class="lines-sub" id="lines-sub"></p>
        <div id="lines-groups"></div>
      </div>
    </div>

    <div class="search-overlay" id="search-overlay" hidden>
      <div class="search-backdrop" id="search-backdrop"></div>
      <div class="search-panel">
        <div class="search-head">
          <h2>Where are you going?</h2>
          <button class="round" id="close-search" aria-label="Close search"
            >×</button
          >
        </div>
        <form id="search-form" autocomplete="off">
          <input
            type="search"
            id="search-input"
            placeholder="Station name or Japanese name"
            aria-label="Search stations"
          />
        </form>
        <div id="search-results" class="search-results"></div>
      </div>
    </div>

    <script
      type="application/json"
      id="transit-data"
      set:html={JSON.stringify(transitData)}
    />
    <script
      type="application/json"
      id="search-data"
      set:html={JSON.stringify(searchable)}
    />

    <script is:inline>
      (function () {
        var NS = "http://www.w3.org/2000/svg";
        var $ = function (s) {
          return document.querySelector(s);
        };
        var data = JSON.parse($("#transit-data").textContent);
        var searchable = JSON.parse($("#search-data").textContent);

        /* ---------- Theme ---------- */
        function applyTheme(t) {
          document.documentElement.setAttribute("data-theme", t);
          try {
            localStorage.setItem("tokyo-theme", t);
          } catch (e) {}
        }
        try {
          var saved = localStorage.getItem("tokyo-theme");
          if (saved) applyTheme(saved);
        } catch (e) {}
        $("#theme-toggle").addEventListener("click", function () {
          applyTheme(
            document.documentElement.getAttribute("data-theme") === "dark"
              ? "light"
              : "dark",
          );
        });

        /* ---------- Track shapes ---------- */
        // A track is a list of straight / arc segments. Stations sit at distances
        // along it, and every point carries a normal pointing to the RIGHT of travel.
        function segLine(x1, y1, x2, y2) {
          var len = Math.hypot(x2 - x1, y2 - y1),
            tx = (x2 - x1) / len,
            ty = (y2 - y1) / len;
          return {
            len: len,
            d: " L" + x2 + " " + y2,
            at: function (u) {
              return { x: x1 + tx * u, y: y1 + ty * u, tx: tx, ty: ty };
            },
          };
        }
        function segArc(cx, cy, r, a0, a1) {
          var dir = a1 >= a0 ? 1 : -1,
            len = Math.abs(a1 - a0) * r;
          var ex = cx + r * Math.cos(a1),
            ey = cy + r * Math.sin(a1);
          return {
            len: len,
            d:
              " A" +
              r +
              " " +
              r +
              " 0 " +
              (len > Math.PI * r + 0.01 ? 1 : 0) +
              " " +
              (dir > 0 ? 1 : 0) +
              " " +
              ex +
              " " +
              ey,
            at: function (u) {
              var a = a0 + (dir * u) / r;
              return {
                x: cx + r * Math.cos(a),
                y: cy + r * Math.sin(a),
                tx: -dir * Math.sin(a),
                ty: dir * Math.cos(a),
              };
            },
          };
        }
        function makeTrack(segs, start, closed) {
          var length = 0;
          segs.forEach(function (sg) {
            length += sg.len;
          });
          var d =
            "M" +
            start.x +
            " " +
            start.y +
            segs
              .map(function (sg) {
                return sg.d;
              })
              .join("") +
            (closed ? " Z" : "");
          function raw(s) {
            var acc = 0;
            for (var i = 0; i < segs.length; i++) {
              if (s <= acc + segs[i].len || i === segs.length - 1)
                return segs[i].at(Math.max(0, Math.min(s - acc, segs[i].len)));
              acc += segs[i].len;
            }
          }
          return {
            closed: closed,
            length: length,
            d: d,
            pointAt: function (s) {
              var p;
              if (closed) {
                s = ((s % length) + length) % length;
                p = raw(s);
              } else if (s < 0) {
                p = raw(0);
                p = {
                  x: p.x + p.tx * s,
                  y: p.y + p.ty * s,
                  tx: p.tx,
                  ty: p.ty,
                };
              } // train may hang past the ends
              else if (s > length) {
                p = raw(length);
                p = {
                  x: p.x + p.tx * (s - length),
                  y: p.y + p.ty * (s - length),
                  tx: p.tx,
                  ty: p.ty,
                };
              } else p = raw(s);
              p.nx = -p.ty;
              p.ny = p.tx;
              return p;
            },
          };
        }

        var CX = 400;
        function buildTrack(l, n) {
          var shape = l.shape || (n <= 8 ? "line" : "u");
          var t;
          if (shape === "loop") {
            // stadium loop (Yamanote)
            var R = 140,
              S = 440,
              rx = CX + R,
              lx = CX - R;
            t = makeTrack(
              [
                segLine(rx, S, rx, 0),
                segArc(CX, 0, R, 0, -Math.PI),
                segLine(lx, 0, lx, S),
                segArc(CX, S, R, Math.PI, 0),
              ],
              { x: rx, y: S },
              true,
            );
            t.sOf = function (i) {
              return S / 2 + (i / n) * t.length;
            };
          } else if (shape === "u") {
            // hairpin: down the left, round the bottom, up the right
            var Ru = 100,
              sp = n > 26 ? 50 : 64;
            var V = Math.max(80, (sp * (n - 1) - Math.PI * Ru) / 2);
            t = makeTrack(
              [
                segLine(CX - Ru, 0, CX - Ru, V),
                segArc(CX, V, Ru, Math.PI, 0),
                segLine(CX + Ru, V, CX + Ru, 0),
              ],
              { x: CX - Ru, y: 0 },
              false,
            );
            t.sOf = function (i) {
              return n > 1 ? (i * t.length) / (n - 1) : 0;
            };
          } else {
            // straight line, top to bottom
            var len = Math.max(90, 90 * (n - 1));
            t = makeTrack([segLine(CX, 0, CX, len)], { x: CX, y: 0 }, false);
            t.sOf = function (i) {
              return n > 1 ? (i * len) / (n - 1) : 0;
            };
          }
          t.shape = shape;
          return t;
        }

        /* ---------- State ---------- */
        var lineIdx = 0;
        var idx = 0;
        var zoom = 1;
        var svg = $("#map");
        var track = null;
        var VB = { x: 0, y: 0, w: 800, h: 960 }; // world rectangle shown at zoom 1

        function line() {
          return data.lines[lineIdx];
        }
        function list() {
          return data.stationsByLine[line().id] || [];
        }
        function pointAt(s) {
          return track.pointAt(s);
        }
        function sOf(i) {
          return track.sOf(i);
        }

        function el(name, attrs, parent) {
          var n = document.createElementNS(NS, name);
          for (var k in attrs) n.setAttribute(k, attrs[k]);
          if (parent) parent.appendChild(n);
          return n;
        }

        function num(code) {
          var m = String(code || "").match(/(\d+)\s*$/);
          return m ? m[1] : "";
        }

        /* ---------- Draw map ---------- */
        var LABEL_LENS = [24, 42, 60];

        function drawMap() {
          var st = list();
          track = buildTrack(line(), st.length);
          document.documentElement.style.setProperty("--line", line().color);

          var trackG = $("#track"),
            labels = $("#labels");
          trackG.innerHTML = "";
          labels.innerHTML = "";
          el("path", { d: track.d, class: "rail-bed" }, trackG);
          el("path", { d: track.d, class: "rail-base" }, trackG);

          // points along the track: labels must not cover them
          var samples = [];
          for (var q = 0; q <= track.length; q += 8)
            samples.push(track.pointAt(q));
          samples.push(track.pointAt(track.length));

          var rects = [];
          var box = {
            x0: Infinity,
            y0: Infinity,
            x1: -Infinity,
            y1: -Infinity,
          };
          function grow(x, y) {
            box.x0 = Math.min(box.x0, x);
            box.y0 = Math.min(box.y0, y);
            box.x1 = Math.max(box.x1, x);
            box.y1 = Math.max(box.y1, y);
          }
          samples.forEach(function (p) {
            grow(p.x - 10, p.y - 10);
            grow(p.x + 10, p.y + 10);
          });

          function hits(r) {
            var c = 0;
            rects.forEach(function (o) {
              if (
                r.x < o.x + o.w + 4 &&
                r.x + r.w + 4 > o.x &&
                r.y < o.y + o.h + 4 &&
                r.y + r.h + 4 > o.y
              )
                c++;
            });
            samples.forEach(function (p) {
              if (
                p.x > r.x - 9 &&
                p.x < r.x + r.w + 9 &&
                p.y > r.y - 9 &&
                p.y < r.y + r.h + 9
              )
                c++;
            });
            return c;
          }

          // a straight line puts labels on the right first; loops and hairpins go outside first
          var prefs = track.shape === "line" ? [-1, 1] : [1, -1];
          var probe = el("text", { x: 0, y: 0, class: "label" }, labels);

          st.forEach(function (stn, i) {
            var p = track.pointAt(track.sOf(i));
            probe.textContent = stn.name;
            var bb = probe.getBBox();
            var best = null;

            LABEL_LENS.some(function (len) {
              return prefs.some(function (sd) {
                var dx = p.nx * sd,
                  dy = p.ny * sd;
                var ex = p.x + dx * len,
                  ey = p.y + dy * len;
                var anchor =
                  dx > 0.35 ? "start" : dx < -0.35 ? "end" : "middle";
                var tx =
                  ex + (anchor === "start" ? 9 : anchor === "end" ? -9 : 0);
                var ty = ey + (anchor === "middle" ? (dy < 0 ? -9 : 13) : 3.8);
                var left =
                  tx +
                  (anchor === "end"
                    ? -bb.width
                    : anchor === "middle"
                      ? -bb.width / 2
                      : 0);
                var c = {
                  ex: ex,
                  ey: ey,
                  tx: tx,
                  ty: ty,
                  anchor: anchor,
                  rect: {
                    x: left - 8,
                    y: ty + bb.y - 3,
                    w: bb.width + 16,
                    h: bb.height + 6,
                  },
                };
                c.score = hits(c.rect);
                if (!best || c.score < best.score) best = c;
                return c.score === 0;
              });
            });

            rects.push(best.rect);
            grow(best.rect.x, best.rect.y);
            grow(best.rect.x + best.rect.w, best.rect.y + best.rect.h);

            var g = el(
              "g",
              {
                class: "stn",
                "data-i": i,
                tabindex: 0,
                role: "button",
                "aria-label": stn.name,
              },
              labels,
            );
            el(
              "line",
              { x1: p.x, y1: p.y, x2: best.ex, y2: best.ey, class: "leader" },
              g,
            );
            el("circle", { cx: p.x, cy: p.y, r: 12, class: "halo" }, g);
            el("circle", { cx: p.x, cy: p.y, r: 7, class: "stop-ring" }, g);
            el("circle", { cx: p.x, cy: p.y, r: 4.2, class: "stop" }, g);
            el(
              "rect",
              {
                x: best.rect.x,
                y: best.rect.y,
                width: best.rect.w,
                height: best.rect.h,
                rx: best.rect.h / 2,
                ry: best.rect.h / 2,
                class: "pill",
              },
              g,
            );
            var text = el(
              "text",
              {
                x: best.tx,
                y: best.ty,
                "text-anchor": best.anchor,
                class: "label",
              },
              g,
            );
            text.textContent = stn.name;

            g.addEventListener("click", function () {
              go(i);
            });
            g.addEventListener("keydown", function (e) {
              if (e.key === "Enter" || e.key === " ") {
                e.preventDefault();
                go(i);
              }
            });
          });
          labels.removeChild(probe);

          // zoom-1 view: fit the whole line (with padding), never tiny
          var pad = 100;
          var vx = box.x0 - pad,
            vy = box.y0 - pad,
            vw = box.x1 - box.x0 + pad * 2,
            vh = box.y1 - box.y0 + pad * 2;
          var mw = Math.max(vw, 600),
            mh = Math.max(vh, 760);
          VB = { x: vx - (mw - vw) / 2, y: vy - (mh - vh) / 2, w: mw, h: mh };
        }

        /* ---------- Train + highlight + viewBox ---------- */
        // The train is three articulated cars, so it bends with the curves.
        //   NEXT     -> outer lane (+1), heading forward
        //   PREVIOUS -> inner lane (-1), heading backward
        var LANE_OFFSET = 7.5;
        var LIGHT_REACH = 80; // headlight distance in map units (bigger = lights further ahead)
        var carEls = [],
          glowEl = null,
          carPitch = 30;
        var trainS = 0,
          trainLane = 1,
          trainDir = 1,
          anim = null;
        var reduceMotion =
          window.matchMedia &&
          window.matchMedia("(prefers-reduced-motion: reduce)").matches;

        // One car, drawn top-down; local -y is the direction of travel.
        // k: 0 = leading car, 1 = middle, 2 = last
        function buildCar(k, len) {
          var g = el("g", { class: "train-car" }, $("#train"));
          var h = len / 2;
          el(
            "rect",
            {
              x: -6.5,
              y: -h,
              width: 13,
              height: len,
              rx: 3.4,
              class: "car-body",
            },
            g,
          );
          el(
            "rect",
            {
              x: -5.9,
              y: -h + 5,
              width: 0.8,
              height: len - 10,
              class: "car-stripe-l",
            },
            g,
          );
          el(
            "rect",
            {
              x: 5.1,
              y: -h + 5,
              width: 0.8,
              height: len - 10,
              class: "car-stripe",
            },
            g,
          );

          // roof air-conditioning panels
          var spots =
            k === 0 ? [0.27, 0.58] : k === 1 ? [0.14, 0.54] : [0.12, 0.46];
          spots.forEach(function (f) {
            var y = -h + len * f,
              ph = len * 0.25;
            el(
              "rect",
              { x: -3.7, y: y, width: 7.4, height: ph, rx: 1.4, class: "ac" },
              g,
            );
            for (var i = 1; i <= 3; i++) {
              el(
                "rect",
                {
                  x: -3,
                  y: y + (ph * i) / 4 - 0.25,
                  width: 6,
                  height: 0.5,
                  class: "ac-line",
                },
                g,
              );
            }
          });

          // joints between cars
          if (k > 0)
            el(
              "rect",
              {
                x: -4.5,
                y: -h - 1.8,
                width: 9,
                height: 3.6,
                rx: 1.2,
                class: "joint",
              },
              g,
            );
          if (k < 2)
            el(
              "rect",
              {
                x: -4.5,
                y: h - 1.8,
                width: 9,
                height: 3.6,
                rx: 1.2,
                class: "joint",
              },
              g,
            );

          if (k === 0) {
            // front cab: black nose, windshield, headlamps
            el(
              "path",
              {
                d:
                  "M-6.5," +
                  (-h + 7.5) +
                  " L-6.5," +
                  (-h + 3.4) +
                  " Q-6.5," +
                  -h +
                  " -3.1," +
                  -h +
                  " L3.1," +
                  -h +
                  " Q6.5," +
                  -h +
                  " 6.5," +
                  (-h + 3.4) +
                  " L6.5," +
                  (-h + 7.5) +
                  " Z",
                class: "cab",
              },
              g,
            );
            el(
              "rect",
              {
                x: -4.8,
                y: -h + 1.9,
                width: 9.6,
                height: 3.6,
                rx: 1.6,
                class: "glass",
              },
              g,
            );
            el(
              "rect",
              {
                x: -3.8,
                y: -h + 2.5,
                width: 3.2,
                height: 0.7,
                rx: 0.35,
                class: "glint",
              },
              g,
            );
            el("circle", { cx: -5, cy: -h + 1.1, r: 1.15, class: "lamp" }, g);
            el("circle", { cx: 5, cy: -h + 1.1, r: 1.15, class: "lamp" }, g);
          }
          if (k === 2) {
            // rear cab: black end, tail lights
            el(
              "path",
              {
                d:
                  "M-6.5," +
                  (h - 7.5) +
                  " L-6.5," +
                  (h - 3.4) +
                  " Q-6.5," +
                  h +
                  " -3.1," +
                  h +
                  " L3.1," +
                  h +
                  " Q6.5," +
                  h +
                  " 6.5," +
                  (h - 3.4) +
                  " L6.5," +
                  (h - 7.5) +
                  " Z",
                class: "cab",
              },
              g,
            );
            el(
              "rect",
              {
                x: -4.8,
                y: h - 5.5,
                width: 9.6,
                height: 3.6,
                rx: 1.6,
                class: "glass",
              },
              g,
            );
            el("circle", { cx: -5, cy: h - 1.1, r: 1.15, class: "tail" }, g);
            el("circle", { cx: 5, cy: h - 1.1, r: 1.15, class: "tail" }, g);
          }
          return g;
        }

        function initTrain() {
          $("#train").innerHTML = "";
          $("#glow").innerHTML = "";

          // total length follows station spacing so it reads well on any line
          var spacing = list().length > 1 ? Math.abs(sOf(1) - sOf(0)) : 60;
          var total = Math.max(50, Math.min(spacing * 1.68, 150));
          var gap = 3;
          var carLen = (total - gap * 2) / 3;
          carPitch = carLen + gap;

          carEls = [
            buildCar(0, carLen),
            buildCar(1, carLen),
            buildCar(2, carLen),
          ];

          // headlight beam + glow (visible in dark theme only), sits under the labels
          glowEl = el("g", { class: "headlight" }, $("#glow"));
          var y0 = -carLen / 2;
          [-1, 1].forEach(function (sx) {
            // one thin beam per headlamp
            el(
              "polygon",
              {
                points:
                  sx * 5.8 +
                  "," +
                  y0 +
                  " " +
                  sx * 3.6 +
                  "," +
                  y0 +
                  " " +
                  sx * 9 +
                  "," +
                  (y0 - LIGHT_REACH) +
                  " " +
                  sx * 18 +
                  "," +
                  (y0 - LIGHT_REACH),
                fill: "url(#beam-grad)",
              },
              glowEl,
            );
          });
          el(
            "ellipse",
            {
              cx: 0,
              cy: y0 - LIGHT_REACH * 0.78,
              rx: 38,
              ry: LIGHT_REACH * 0.85,
              fill: "url(#glow-grad)",
            },
            glowEl,
          );

          if (anim) {
            cancelAnimationFrame(anim);
            anim = null;
          }
          trainS = sOf(idx);
          trainLane = 1;
          trainDir = 1;
          drawTrain(trainS, trainLane, trainDir);
        }

        // Each car is placed on the track on its own, so it follows the curve.
        function drawTrain(s, lane, dir) {
          for (var k = 0; k < 3; k++) {
            var p = pointAt(s + dir * (1 - k) * carPitch);
            var x = p.x + p.nx * lane * LANE_OFFSET;
            var y = p.y + p.ny * lane * LANE_OFFSET;
            var ang = (Math.atan2(dir * p.ny, dir * p.nx) * 180) / Math.PI;
            var t = "translate(" + x + " " + y + ") rotate(" + ang + ")";
            carEls[k].setAttribute("transform", t);
            if (k === 0) glowEl.setAttribute("transform", t);
          }
          return pointAt(s);
        }

        function moveTrain() {
          var target = sOf(idx);
          var from = trainS;
          if (anim) {
            cancelAnimationFrame(anim);
            anim = null;
          }

          if (from === target) {
            setView(drawTrain(trainS, trainLane, trainDir));
            return;
          }

          var fromLane = trainLane;
          var toDir = target > from ? 1 : -1;
          trainDir = toDir; // face the way we are going
          var dist = Math.abs(target - from);
          var dur = reduceMotion
            ? 0
            : Math.min(1600, Math.max(500, dist * 1.8));

          if (dur === 0) {
            trainS = target;
            trainLane = toDir;
            setView(drawTrain(trainS, trainLane, trainDir));
            return;
          }

          var t0 = performance.now();
          function step(now) {
            var k = Math.min(1, (now - t0) / dur);
            var e = k < 0.5 ? 2 * k * k : 1 - Math.pow(-2 * k + 2, 2) / 2; // ease in-out
            trainS = from + (target - from) * e;
            trainLane = fromLane + (toDir - fromLane) * Math.min(1, k * 3); // slide into the lane early
            setView(drawTrain(trainS, trainLane, trainDir));
            anim = k < 1 ? requestAnimationFrame(step) : null;
          }
          anim = requestAnimationFrame(step);
        }

        function refreshView() {
          if (list().length) setView(pointAt(trainS));
        }

        function updateMap() {
          document.querySelectorAll(".stn").forEach(function (g) {
            // use the station index, not the DOM position (DOM order changes when the current one is raised)
            g.classList.toggle(
              "current",
              Number(g.getAttribute("data-i")) === idx,
            );
          });
          // move current station to the top of the paint order
          var cur = document.querySelector('.stn[data-i="' + idx + '"]');
          if (cur) cur.parentNode.appendChild(cur);
          moveTrain();
        }

        function setView(p) {
          var vw = VB.w / zoom,
            vh = VB.h / zoom;
          var fx = VB.x + VB.w / 2,
            fy = VB.y + VB.h / 2;
          if (zoom > 1 && p) {
            fx = p.x;
            fy = p.y;
          }
          var x = Math.min(Math.max(fx - vw / 2, VB.x), VB.x + VB.w - vw);
          var y = Math.min(Math.max(fy - vh / 2, VB.y), VB.y + VB.h - vh);
          svg.setAttribute("viewBox", x + " " + y + " " + vw + " " + vh);
        }

        /* ---------- Board ---------- */
        function updateBoard() {
          var l = list();
          var cur = l[idx],
            prev = l[idx - 1],
            next = l[idx + 1];
          $("#line-name").textContent = line().name;
          var cw = document.querySelector(".current"); // little pop when the station changes
          cw.classList.remove("swap");
          void cw.offsetWidth;
          cw.classList.add("swap");
          $("#cur-jp").textContent = cur ? cur.jp || cur.name : "—";
          $("#cur-en").textContent = cur ? cur.name : "";
          $("#cur-code").textContent = cur ? cur.code || "" : "";
          $("#cur-code").hidden = !(cur && cur.code);

          function side(prefix, s) {
            var btn = $("#" + prefix + "-btn");
            btn.disabled = !s;
            $("#" + prefix + "-jp").textContent = s ? s.jp || s.name : "";
            $("#" + prefix + "-en").textContent = s ? s.name : "";
            $("#" + prefix + "-num").textContent = s ? num(s.code) : "";
            $("#" + prefix + "-num").hidden = !s;
          }
          side("prev", prev);
          side("next", next);

          var info = $("#info-link");
          if (cur && cur.slug)
            info.href = "/stations/" + encodeURIComponent(cur.slug);
        }

        function go(i) {
          var n = list().length;
          if (!n) return;
          idx = Math.max(0, Math.min(i, n - 1));
          updateBoard();
          updateMap();
        }

        function setLine(i) {
          lineIdx = i;
          idx = 0;
          zoom = 1;
          drawMap();
          initTrain();
          updateBoard();
          updateMap();
          markActiveRow();
        }

        /* ---------- Controls ---------- */

        $("#prev-btn").addEventListener("click", function () {
          go(idx - 1);
        });

        $("#next-btn").addEventListener("click", function () {
          go(idx + 1);
        });

        var MAX_ZOOM = 6;

        /* ---------- Zoom ---------- */

        $("#zoom-in").addEventListener("click", function () {
          zoom = Math.min(zoom * 1.5, MAX_ZOOM);
          refreshView();
        });

        $("#zoom-out").addEventListener("click", function () {
          zoom = Math.max(zoom / 1.5, 1);
          refreshView();
        });

        /* Mouse wheel zoom */
        $("#stage").addEventListener(
          "wheel",
          function (e) {
            e.preventDefault();

            var step = e.deltaMode === 1 ? 0.05 : 0.0015;

            zoom = Math.min(
              MAX_ZOOM,
              Math.max(1, zoom * Math.exp(-e.deltaY * step)),
            );

            refreshView();
          },
          { passive: false },
        );

        /* ---------- Pan / Drag ---------- */

        var pan = {
          active: false,
          startX: 0,
          startY: 0,
          startVBX: 0,
          startVBY: 0,
        };

        /*
         * Convert screen movement into SVG/world movement.
         * This keeps dragging correct at every zoom level.
         */
        function panBy(dx, dy) {
          var rect = svg.getBoundingClientRect();

          if (!rect.width || !rect.height) return;

          var vw = VB.w / zoom;
          var vh = VB.h / zoom;

          var worldDX = (dx / rect.width) * vw;
          var worldDY = (dy / rect.height) * vh;

          var x = pan.startVBX - worldDX;
          var y = pan.startVBY - worldDY;

          x = Math.min(Math.max(x, VB.x), VB.x + VB.w - vw);

          y = Math.min(Math.max(y, VB.y), VB.y + VB.h - vh);

          svg.setAttribute("viewBox", x + " " + y + " " + vw + " " + vh);
        }

        /* Desktop mouse drag */

        $("#stage").addEventListener("mousedown", function (e) {
          if (e.button !== 0) return;

          /*
           * At zoom 1 the whole map is already fitted,
           * so dragging is unnecessary.
           */
          if (zoom <= 1) return;

          pan.active = true;
          pan.startX = e.clientX;
          pan.startY = e.clientY;

          var viewBox = svg.getAttribute("viewBox").split(" ").map(Number);

          pan.startVBX = viewBox[0];
          pan.startVBY = viewBox[1];

          $("#stage").classList.add("is-panning");
        });

        window.addEventListener("mousemove", function (e) {
          if (!pan.active) return;

          panBy(e.clientX - pan.startX, e.clientY - pan.startY);
        });

        window.addEventListener("mouseup", function () {
          if (!pan.active) return;

          pan.active = false;
          $("#stage").classList.remove("is-panning");
        });

        /* ---------- Touch Pan + Pinch ---------- */

        var touches = {
          mode: null,
          startX: 0,
          startY: 0,
          startVBX: 0,
          startVBY: 0,
          distance: 0,
          zoomStart: 1,
        };

        function touchDistance(t) {
          return Math.hypot(
            t[0].clientX - t[1].clientX,
            t[0].clientY - t[1].clientY,
          );
        }

        /* One finger = pan */

        $("#stage").addEventListener(
          "touchstart",
          function (e) {
            if (e.touches.length === 1) {
              if (zoom <= 1) return;

              touches.mode = "pan";

              touches.startX = e.touches[0].clientX;
              touches.startY = e.touches[0].clientY;

              var viewBox = svg.getAttribute("viewBox").split(" ").map(Number);

              touches.startVBX = viewBox[0];
              touches.startVBY = viewBox[1];

              $("#stage").classList.add("is-panning");
            }

            /* Two fingers = pinch zoom */

            if (e.touches.length === 2) {
              touches.mode = "pinch";

              touches.distance = touchDistance(e.touches);
              touches.zoomStart = zoom;

              $("#stage").classList.remove("is-panning");
            }
          },
          { passive: true },
        );

        $("#stage").addEventListener(
          "touchmove",
          function (e) {
            /* ---------- Pinch ---------- */

            if (touches.mode === "pinch" && e.touches.length === 2) {
              e.preventDefault();

              var distance = touchDistance(e.touches);

              if (!touches.distance) return;

              zoom = Math.min(
                MAX_ZOOM,
                Math.max(1, touches.zoomStart * (distance / touches.distance)),
              );

              refreshView();
              return;
            }

            /* ---------- Pan ---------- */

            if (touches.mode === "pan" && e.touches.length === 1 && zoom > 1) {
              e.preventDefault();

              pan.startX = touches.startX;
              pan.startY = touches.startY;
              pan.startVBX = touches.startVBX;
              pan.startVBY = touches.startVBY;

              panBy(
                e.touches[0].clientX - touches.startX,
                e.touches[0].clientY - touches.startY,
              );
            }
          },
          { passive: false },
        );

        $("#stage").addEventListener(
          "touchend",
          function (e) {
            if (e.touches.length === 0) {
              touches.mode = null;
              $("#stage").classList.remove("is-panning");
              return;
            }

            /*
             * If pinch finishes with one finger remaining,
             * start a fresh pan from that position.
             */
            if (e.touches.length === 1) {
              if (zoom <= 1) {
                touches.mode = null;
                return;
              }

              touches.mode = "pan";

              touches.startX = e.touches[0].clientX;
              touches.startY = e.touches[0].clientY;

              var viewBox = svg.getAttribute("viewBox").split(" ").map(Number);

              touches.startVBX = viewBox[0];
              touches.startVBY = viewBox[1];

              $("#stage").classList.add("is-panning");
            }
          },
          { passive: true },
        );

        $("#stage").addEventListener(
          "touchcancel",
          function () {
            touches.mode = null;
            $("#stage").classList.remove("is-panning");
          },
          { passive: true },
        );

        /* ---------- Reset ---------- */

        $("#zoom-reset").addEventListener("click", function () {
          zoom = 1;
          go(0);
        });

        /* ---------- Keyboard Navigation ---------- */

        document.addEventListener("keydown", function (e) {
          if (!$("#search-overlay").hidden || !$("#lines-dialog").hidden)
            return;

          if (e.key === "ArrowLeft") go(idx - 1);
          if (e.key === "ArrowRight") go(idx + 1);
        });

        document.addEventListener("keydown", function (e) {
          if (!$("#search-overlay").hidden || !$("#lines-dialog").hidden)
            return;
          if (e.key === "ArrowLeft") go(idx - 1);
          if (e.key === "ArrowRight") go(idx + 1);
        });

        /* ---------- Lines dialog ---------- */
        var dlg = $("#lines-dialog");
        var toggle = $("#line-toggle");

        function openLines() {
          dlg.hidden = false;
          toggle.setAttribute("aria-expanded", "true");
          dlg.scrollTop = 0;
          $("#lines-back").focus();
        }
        function closeLines() {
          dlg.hidden = true;
          toggle.setAttribute("aria-expanded", "false");
          toggle.focus();
        }
        function markActiveRow() {
          document.querySelectorAll(".line-row").forEach(function (r) {
            r.classList.toggle(
              "active",
              Number(r.getAttribute("data-i")) === lineIdx,
            );
          });
        }
        function buildLinesDialog() {
          var groups = [],
            byOp = {};
          data.lines.forEach(function (l, i) {
            var key = l.operatorId;
            if (!byOp[key]) {
              byOp[key] = { id: key, name: l.operator || "Other", items: [] };
              groups.push(byOp[key]);
            }
            byOp[key].items.push({ l: l, i: i });
          });
          groups.sort(function (a, b) {
            return a.id - b.id;
          });
          $("#lines-sub").textContent =
            data.lines.length +
            " routes \u2014 " +
            groups
              .map(function (g) {
                return g.name;
              })
              .join(", ");

          var host = $("#lines-groups");
          host.innerHTML = "";
          groups.forEach(function (g) {
            g.items.sort(function (a, b) {
              return a.l.id - b.l.id;
            });
            var sec = document.createElement("section");
            sec.className = "lines-group";
            var head = document.createElement("div");
            head.className = "lines-group-head";
            head.innerHTML = "<span></span><em></em>";
            head.firstChild.textContent = g.name;
            head.lastChild.textContent =
              g.items.length + (g.items.length === 1 ? " line" : " lines");
            sec.appendChild(head);

            g.items.forEach(function (it) {
              var row = document.createElement("button");
              row.type = "button";
              row.className = "line-row";
              row.setAttribute("data-i", it.i);
              row.innerHTML =
                '<span class="line-badge"></span><span class="line-text"><b></b><small></small></span>' +
                '<svg class="line-chevron" viewBox="0 0 24 24"><path d="M9 6l6 6-6 6"></path></svg>';
              var badge = row.querySelector(".line-badge");
              badge.textContent = it.l.code || "";
              badge.style.background = it.l.color;
              var name = row.querySelector("b");
              name.textContent = it.l.name;
              name.style.setProperty("--c", it.l.color);
              row.querySelector("small").textContent = it.l.description || "";
              row.addEventListener("click", function () {
                setLine(it.i);
                closeLines();
              });
              sec.appendChild(row);
            });
            host.appendChild(sec);
          });
          markActiveRow();
        }
        buildLinesDialog();
        toggle.addEventListener("click", openLines);
        $("#lines-back").addEventListener("click", closeLines);

        /* ---------- Search ---------- */
        var overlay = $("#search-overlay");
        var input = $("#search-input");
        var results = $("#search-results");

        function esc(v) {
          return String(v == null ? "" : v).replace(/[&<>"']/g, function (c) {
            return {
              "&": "&amp;",
              "<": "&lt;",
              ">": "&gt;",
              '"': "&quot;",
              "'": "&#39;",
            }[c];
          });
        }
        function openSearch() {
          overlay.hidden = false;
          setTimeout(function () {
            input.focus();
          }, 30);
        }
        function closeSearch() {
          overlay.hidden = true;
        }

        input.addEventListener("input", function () {
          var q = input.value.trim().toLowerCase();
          if (!q) {
            results.innerHTML = "";
            return;
          }
          var m = searchable
            .filter(function (s) {
              return (
                (s.name || "").toLowerCase().includes(q) ||
                (s.jp || "").toLowerCase().includes(q) ||
                (s.slug || "").toLowerCase().includes(q)
              );
            })
            .slice(0, 10);
          results.innerHTML = m.length
            ? m
                .map(function (s) {
                  return (
                    '<a class="result" href="/stations/' +
                    encodeURIComponent(s.slug) +
                    '"><b>' +
                    esc(s.jp || "") +
                    "</b><span>" +
                    esc(s.name) +
                    "</span></a>"
                  );
                })
                .join("")
            : '<p class="empty">No stations found. Try the English or Japanese name.</p>';
        });
        $("#search-form").addEventListener("submit", function (e) {
          e.preventDefault();
          var first = results.querySelector("a");
          if (first) window.location.href = first.getAttribute("href");
        });
        $("#open-search").addEventListener("click", openSearch);
        $("#close-search").addEventListener("click", closeSearch);
        $("#search-backdrop").addEventListener("click", closeSearch);
        document.addEventListener("keydown", function (e) {
          if (e.key !== "Escape") return;
          if (!dlg.hidden) closeLines();
          else closeSearch();
        });

        /* ---------- Init ---------- */
        if (data.lines.length) {
          var start = 0;
          for (var k = 0; k < data.lines.length; k++) {
            if (data.lines[k].shape === "loop") {
              start = k;
              break;
            }
          }
          setLine(start);
        } else $("#line-name").textContent = "No lines available";
      })();
    </script>
  </body>
</html>
