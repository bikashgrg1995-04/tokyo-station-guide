---
import { env } from "cloudflare:workers";
import BaseLayout from "../../layouts/BaseLayout.astro";
import StationPageBody from "../../components/website/station-page/StationPageBody.astro";
import StationPageHeader from "../../components/website/station-page/StationPageHeader.astro";
import ComingSoonDialog from "../../components/website/ComingSoonDialog.astro";

import "@fontsource-variable/inter";
import "@fontsource-variable/noto-sans-jp";
import "../../styles/website/global.css";
import "../../styles/website/theme.css";
import "../../styles/website/header.css";
import "../../styles/website/lines-dialog.css";
import "../../styles/website/station-page.css";

export const prerender = false;

const lineParam = Number(Astro.url.searchParams.get("line"));
const lineId = Number.isInteger(lineParam) && lineParam > 0 ? lineParam : null;
// Cheap check first, so the page shell (and shimmer placeholders) can be sent straight away;
// the heavy station data is loaded and streamed in by StationPageBody.
const station = await env.DB
  .prepare("SELECT name, description, is_verified FROM stations WHERE slug = ?")
  .bind(Astro.params.slug ?? "")
  .first<{ name: string; description: string | null; is_verified: number }>();

// Only verified stations have a public page.
if (!station || Number(station.is_verified) !== 1) {
  return new Response("Station not found", {
    status: 404,
    headers: { "Cache-Control": "no-store" },
  });
}

const mediaBase =
  String((env as { MEDIA_BASE_URL?: string }).MEDIA_BASE_URL ?? "")
    .trim()
    .replace(/\/+$/, "") || "/media";

const title = `${station.name} Station Guide | Tokyo Station Guide`;
const description =
  station.description ??
  `Exits, platforms, facilities and nearby places at ${station.name} Station.`;
---

<BaseLayout
  title={title}
  description={description}
  robots="noindex, follow"
  viewport="width=device-width, initial-scale=1, viewport-fit=cover"
>
  <Fragment slot="head">
    <!-- Same theme as the map page, set before the first paint. -->
    <script is:inline>
      (function () {
        try {
          var t = localStorage.getItem("tokyo-theme");
          if (t) document.documentElement.setAttribute("data-theme", t);
          var l = localStorage.getItem("tokyo-lang");
          if (l === "jp" || l === "ja") document.documentElement.lang = "ja";
        } catch (e) {}
      })();
    </script>
  </Fragment>

  <div class="sp">
    <StationPageHeader />

    <main class="sp-main">
      <div class="sp-skel" id="sp-skel" aria-hidden="true">
        <div class="sk sk-chip"></div>
        <div class="sk sk-title"></div>
        <div class="sk sk-line"></div>
        <div class="sk sk-line sk-w80"></div>
        <div class="sk sk-line sk-w60"></div>
        <div class="sk sk-photo"></div>
        <div class="sk-row"><div class="sk sk-card"></div><div class="sk sk-card"></div><div class="sk sk-card"></div></div>
        <div class="sk sk-block"></div>
        <div class="sk sk-block"></div>
      </div>
      <StationPageBody slug={Astro.params.slug ?? ""} lineId={lineId} mediaBase={mediaBase} />
    </main>

    <ComingSoonDialog />

    <footer class="sp-footer">
      <div class="sp-footer-inner">
        <p class="sp-footer-copy">© {new Date().getFullYear()} TokyoGuide.jp</p>
        <p class="sp-footer-note" data-i18n="sp.disclosure">
          Disclosure: some links are affiliate links; we may earn a commission at no extra cost to you.
          Hours, prices and exits change; please check signage on arrival.
        </p>
      </div>
    </footer>

    <button type="button" class="sp-top" id="sp-top" aria-label="Back to top" data-i18n-attr="aria-label:sp.top" hidden>
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 19V5M5 12l7-7 7 7"></path></svg>
    </button>
  </div>

  <script>
    import "../../scripts/website/station-page.js";
  </script>
</BaseLayout>
