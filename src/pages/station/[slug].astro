---
import { env } from "cloudflare:workers";
import BaseLayout from "../../layouts/BaseLayout.astro";
import StationPageHeader from "../../components/website/station-page/StationPageHeader.astro";
import StationGlance from "../../components/website/station-page/StationGlance.astro";
import StationQuickNav from "../../components/website/station-page/StationQuickNav.astro";
import StationHero from "../../components/website/station-page/StationHero.astro";
import StationSection from "../../components/website/station-page/StationSection.astro";
import { getStationPage } from "../../lib/db/station-page";
import { SECTIONS } from "../../components/website/station-page/sections";

import "@fontsource-variable/inter";
import "@fontsource-variable/noto-sans-jp";
import "../../styles/website/global.css";
import "../../styles/website/theme.css";
import "../../styles/website/header.css";
import "../../styles/website/station-page.css";

export const prerender = false;

const station = await getStationPage(env.DB, Astro.params.slug ?? "");

// Only verified stations have a public page.
if (!station || Number(station.is_verified) !== 1) {
  return new Response("Station not found", {
    status: 404,
    headers: { "Cache-Control": "no-store" },
  });
}

// Photos come from the R2 custom domain when MEDIA_BASE_URL is set, else from /media.
const mediaBase =
  String((env as { MEDIA_BASE_URL?: string }).MEDIA_BASE_URL ?? "")
    .trim()
    .replace(/\/+$/, "") || "/media";
const mainImage = station.main_image;
const photoSrc = !mainImage
  ? ""
  : /^https?:\/\//i.test(mainImage)
    ? mainImage
    : `${mediaBase}/${mainImage}`;

const title = `${station.name} Station Guide | Tokyo Station Guide`;
const description =
  station.description ??
  `Exits, platforms, facilities and nearby places at ${station.name} Station.`;
---

<BaseLayout
  title={title}
  description={description}
  robots="noindex, follow"
  viewport="width=device-width, initial-scale=1, viewport-fit=cover"
>
  <Fragment slot="head">
    <!-- Same theme as the map page, set before the first paint. -->
    <script is:inline>
      (function () {
        try {
          var t = localStorage.getItem("tokyo-theme");
          if (t) document.documentElement.setAttribute("data-theme", t);
          var l = localStorage.getItem("tokyo-lang");
          if (l === "jp" || l === "ja") document.documentElement.lang = "ja";
        } catch (e) {}
      })();
    </script>
  </Fragment>

  <div class="sp">
    <StationPageHeader />

    <main class="sp-main">
      <StationHero station={station} />

      <!-- Main photo (uploaded in Admin > Stations > Edit) -->
      {
        photoSrc ? (
          <img class="sp-photo sp-photo-img" src={photoSrc} alt={`${station.name} Station`} fetchpriority="high" />
        ) : (
          <div class="sp-photo" role="img" aria-label="Main photo">
            <span data-i18n="sp.photo">Main photo coming soon</span>
          </div>
        )
      }

      <StationQuickNav />

      <StationGlance station={station} mediaBase={mediaBase} />

      <div class="sp-layout">
        <div class="sp-content">
          {SECTIONS.map((section) => (
            <StationSection section={section} station={station} mediaBase={mediaBase} />
          ))}
        </div>

        <aside class="sp-toc" aria-label="On this page" data-i18n-attr="aria-label:sp.toc">
          <p class="sp-toc-title" data-i18n="sp.toc">On this page</p>
          <nav>
            {SECTIONS.map((section) => (
              <a href={`#${section.id}`} data-toc-link={section.id}>
                <span data-i18n={`sp.s.${section.id}`}>{section.title}</span>
              </a>
            ))}
          </nav>
        </aside>
      </div>
    </main>

    <footer class="sp-footer">
      <div class="sp-footer-inner">
        <p class="sp-footer-copy">© {new Date().getFullYear()} TokyoGuide.jp</p>
        <p class="sp-footer-note" data-i18n="sp.disclosure">
          Disclosure: some links are affiliate links; we may earn a commission at no extra cost to you.
          Hours, prices and exits change; please check signage on arrival.
        </p>
      </div>
    </footer>

    <button type="button" class="sp-top" id="sp-top" aria-label="Back to top" data-i18n-attr="aria-label:sp.top" hidden>
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 19V5M5 12l7-7 7 7"></path></svg>
    </button>
  </div>

  <script>
    import "../../scripts/website/station-page.js";
  </script>
</BaseLayout>
