---
import AdminLayout from "../../../../layouts/AdminLayout.astro";
import "../../../../styles/admin/forms.css";
import "../../../../styles/admin/tables.css";
import "../../../../styles/admin/operators.css";

import Alert from "../../../../components/common/Alert.astro";
import Breadcrumbs from "../../../../components/common/Breadcrumbs.astro";
import Button from "../../../../components/common/Button.astro";
import EmptyState from "../../../../components/common/EmptyState.astro";

import { getTopPickById } from "../../../../lib/db/top-picks";
import { getTopPickStationAssignments } from "../../../../lib/db/top-pick-stations";
import { getStations } from "../../../../lib/db/stations";
import { getStationFloors } from "../../../../lib/db/station-floors";
import { getStationExits } from "../../../../lib/db/station-exits";
import { handleTopPickStationAssignment } from "../../../../lib/services/top-pick-stations";

export const prerender = false;

const { env } = await import("cloudflare:workers");
const db = env.DB;

const id = Number(Astro.params.id);

if (!Number.isInteger(id) || id <= 0) {
  return Astro.redirect("/admin/top-picks");
}

const topPick = await getTopPickById(db, id);

if (!topPick) {
  Astro.response.status = 404;
}

const formResult = topPick
  ? await handleTopPickStationAssignment(Astro.request, db, id)
  : { redirectTo: null, error: "" };

if (formResult.redirectTo) {
  return Astro.redirect(formResult.redirectTo);
}

const stations = topPick ? await getStations(db) : [];

const assignments = topPick
  ? await getTopPickStationAssignments(db, id)
  : [];

const stationDetails = await Promise.all(
  stations.map(async (station) => {
    const [floors, exits] = await Promise.all([
      getStationFloors(db, station.id),
      getStationExits(db, station.id),
    ]);

    return { station, floors, exits };
  }),
);

const assignedStationIds = new Set(
  assignments.map((assignment) => assignment.station_id),
);

const success = Astro.url.searchParams.get("success");

const successMessage =
  success === "save"
    ? "Station assignment saved successfully."
    : success === "remove"
      ? "Station assignment removed successfully."
      : "";

const locationTypes = [
  { value: "inside", label: "Inside station" },
  { value: "connected", label: "Connected to station" },
  { value: "outside", label: "Outside station" },
];
---

<AdminLayout title="Top Pick Stations" activePath="/admin/top-picks">
  <header class="admin-topbar">
    <Breadcrumbs
      backHref="/admin/top-picks"
      parentLabel="Top Picks"
      current="Station Assignments"
    />
  </header>

  <div class="admin-content">
    {topPick ? (
      <>
        <div class="admin-page-header">
          <div>
            <h2>Manage Top Pick Stations</h2>
            <p>
              Manage the stations associated with this Top Pick.
            </p>
          </div>
        </div>

        <section class="admin-panel">
          <div class="admin-panel-body">
            <h2>{topPick.name}</h2>

            {topPick.name_japanese && (
              <p>{topPick.name_japanese}</p>
            )}

            {successMessage && <Alert>{successMessage}</Alert>}
            {formResult.error && <Alert>{formResult.error}</Alert>}

            <hr />

            <!-- Search and Add button -->
            <div class="station-toolbar">
              <div class="station-search">
                <label for="station-search">Search stations</label>
                <input
                  id="station-search"
                  type="search"
                  placeholder="Search station name..."
                />
              </div>

              <button
                type="button"
                id="open-add-modal"
                class="station-add-button"
              >
                <span aria-hidden="true">+</span>
                Add Station
              </button>
            </div>

            <!-- Assigned stations table -->
            <div class="admin-operator-form-header">
              <h2>
                Assigned Stations
                <span class="station-count">{assignments.length}</span>
              </h2>
            </div>

            {assignments.length === 0 ? (
              <EmptyState
                icon="📍"
                title="No Stations Assigned"
                description="Click Add Station to assign this Top Pick to a station."
              />
            ) : (
              <div class="station-table-wrap">
                <table class="admin-table" id="assigned-stations-table">
                  <thead>
                    <tr>
                      <th>Station</th>
                      <th>Floor</th>
                      <th>Exit</th>
                      <th>Location</th>
                      <th>Walk</th>
                      <th>Order</th>
                      <th>Actions</th>
                    </tr>
                  </thead>

                  <tbody>
                    {assignments.map((assignment) => (
                      <tr
                        class="station-table-row"
                        data-search={`${assignment.station_name} ${assignment.station_name_japanese ?? ""} ${assignment.station_slug}`.toLowerCase()}
                      >
                        <td>
                          <strong>{assignment.station_name}</strong>

                          {assignment.station_name_japanese && (
                            <div class="station-secondary">
                              {assignment.station_name_japanese}
                            </div>
                          )}

                          <div class="station-secondary">
                            {assignment.station_slug}
                          </div>
                        </td>

                        <td>{assignment.floor_name ?? "—"}</td>

                        <td>
                          {assignment.exit_name ?? "—"}
                          {assignment.exit_code
                            ? ` (${assignment.exit_code})`
                            : ""}
                        </td>

                        <td>
                          {locationTypes.find(
                            (type) =>
                              type.value === assignment.location_type,
                          )?.label ?? assignment.location_type}
                        </td>

                        <td>
                          {assignment.walking_minutes != null
                            ? `${assignment.walking_minutes} min`
                            : "—"}
                        </td>

                        <td>{assignment.sort_order}</td>

                        <td>
                          <div class="station-row-actions">
                            <button
                              type="button"
                              class="admin-table-action js-edit-assignment"
                              data-station-id={assignment.station_id}
                              data-floor-id={assignment.floor_id ?? ""}
                              data-exit-id={assignment.exit_id ?? ""}
                              data-location-type={assignment.location_type}
                              data-walking-minutes={assignment.walking_minutes ?? ""}
                              data-sort-order={assignment.sort_order}
                              data-station-name={assignment.station_name}
                            >
                              Edit
                            </button>

                            <form
                              method="POST"
                              onsubmit="return confirm('Remove this station assignment?')"
                            >
                              <input
                                type="hidden"
                                name="action"
                                value="remove"
                              />

                              <input
                                type="hidden"
                                name="station_id"
                                value={assignment.station_id}
                              />

                              <button
                                type="submit"
                                class="admin-table-action admin-table-action-delete"
                              >
                                Remove
                              </button>
                            </form>
                          </div>
                        </td>
                      </tr>
                    ))}
                  </tbody>
                </table>

                <p id="station-search-empty" hidden>
                  No matching stations found.
                </p>
              </div>
            )}
          </div>
        </section>

        <!-- Add/Edit modal -->
        <div
          id="station-modal"
          class="station-modal"
          hidden
          aria-hidden="true"
        >
          <div class="station-modal-backdrop" data-close-modal></div>

          <section
            class="station-modal-dialog"
            role="dialog"
            aria-modal="true"
            aria-labelledby="station-modal-title"
          >
            <header class="station-modal-header">
              <div>
                <h2 id="station-modal-title">Add Station</h2>

                <p id="station-modal-description">
                  Assign this Top Pick to a station.
                </p>
              </div>

              <button
                type="button"
                class="station-modal-close"
                data-close-modal
                aria-label="Close dialog"
              >
                &times;
              </button>
            </header>

            <form
              id="station-assignment-form"
              method="POST"
              class="admin-form"
            >
              <input
                type="hidden"
                name="action"
                value="save"
              />

              <!-- Used only when editing an existing assignment -->
              <input
                type="hidden"
                id="modal-station-id-hidden"
                name="station_id"
                value=""
                disabled
              />

              <!-- Searchable station picker -->
              <div class="admin-form-group">
                <label for="station-picker-search">Station</label>

                <input
                  id="station-picker-search"
                  type="search"
                  placeholder="Search English or Japanese station name..."
                  autocomplete="off"
                  aria-label="Search stations"
                />

                <div
                  id="station-picker-list"
                  class="station-picker-list"
                  role="list"
                  aria-label="Available stations"
                >
                  {stations.map((station) => (
                    <button
                      type="button"
                      class="station-picker-option"
                      data-station-id={station.id}
                      data-station-name={station.name}
                      data-station-japanese={station.name_japanese ?? ""}
                      data-assigned={
                        assignedStationIds.has(station.id)
                          ? "true"
                          : "false"
                      }
                    >
                      <strong>{station.name}</strong>

                      {station.name_japanese && (
                        <span>{station.name_japanese}</span>
                      )}
                    </button>
                  ))}
                </div>

                <p id="station-picker-empty" hidden>
                  No available matching stations found.
                </p>

                <p
                  id="station-picker-selected"
                  aria-live="polite"
                >
                  No station selected.
                </p>

                <!-- This select supplies station_id to the existing POST handler -->
                <select id="modal-station" name="station_id" hidden>
                  <option value="">Select a station</option>

                  {stations.map((station) => (
                    <option
                      value={station.id}
                      data-assigned={
                        assignedStationIds.has(station.id)
                          ? "true"
                          : "false"
                      }
                    >
                      {station.name}
                      {station.name_japanese
                        ? ` (${station.name_japanese})`
                        : ""}
                    </option>
                  ))}
                </select>
              </div>

              <div class="admin-form-group">
                <label for="modal-floor">Floor</label>

                <select id="modal-floor" name="floor_id">
                  <option value="">No floor selected</option>

                  {stationDetails.flatMap(({ station, floors }) =>
                    floors.map((floor) => (
                      <option
                        value={floor.id}
                        data-station-id={station.id}
                      >
                        {station.name} — {floor.name}
                        {floor.name_japanese
                          ? ` (${floor.name_japanese})`
                          : ""}
                      </option>
                    )),
                  )}
                </select>
              </div>

              <div class="admin-form-group">
                <label for="modal-exit">Exit</label>

                <select id="modal-exit" name="exit_id">
                  <option value="">No exit selected</option>

                  {stationDetails.flatMap(({ station, exits }) =>
                    exits.map((exit) => (
                      <option
                        value={exit.id}
                        data-station-id={station.id}
                        data-floor-id={exit.floor_id}
                      >
                        {station.name} — {exit.name}
                        {exit.code ? ` (${exit.code})` : ""}
                      </option>
                    )),
                  )}
                </select>
              </div>

              <div class="admin-form-group">
                <label for="modal-location">Location Type</label>

                <select
                  id="modal-location"
                  name="location_type"
                  required
                >
                  {locationTypes.map((type) => (
                    <option
                      value={type.value}
                      selected={type.value === "outside"}
                    >
                      {type.label}
                    </option>
                  ))}
                </select>
              </div>

              <div class="admin-form-group">
                <label for="modal-walking">
                  Walking Time (minutes)
                </label>

                <input
                  id="modal-walking"
                  name="walking_minutes"
                  type="number"
                  min="0"
                  step="1"
                  placeholder="e.g. 5"
                />
              </div>

              <div class="admin-form-group">
                <label for="modal-order">Sort Order</label>

                <input
                  id="modal-order"
                  name="sort_order"
                  type="number"
                  step="1"
                  value="0"
                  required
                />
              </div>

              <footer class="station-modal-actions">
                <button
                  type="button"
                  class="station-cancel-button"
                  data-close-modal
                >
                  Cancel
                </button>

                <button
                  type="submit"
                  class="station-add-button"
                  id="station-modal-submit"
                >
                  Add Station
                </button>
              </footer>
            </form>
          </section>
        </div>
      </>
    ) : (
      <>
        <div class="admin-page-header">
          <div>
            <h2>Top Pick Not Found</h2>
            <p>The requested Top Pick does not exist.</p>
          </div>
        </div>

        <Button href="/admin/top-picks" variant="secondary">
          Back to Top Picks
        </Button>
      </>
    )}
  </div>

  <Fragment slot="after">
    <style>
      .station-toolbar {
        display: flex;
        align-items: end;
        justify-content: space-between;
        gap: 16px;
        margin: 24px 0;
      }

      .station-search {
        flex: 1;
        max-width: 460px;
      }

      .station-search label {
        display: block;
        margin-bottom: 7px;
        font-size: 0.875rem;
        font-weight: 600;
      }

      .station-search input {
        box-sizing: border-box;
        width: 100%;
        min-height: 42px;
        padding: 10px 12px;
        border: 1px solid var(--admin-border, #d1d5db);
        border-radius: 8px;
        background: var(--admin-surface, #fff);
        color: inherit;
      }

      .station-add-button {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        min-height: 42px;
        padding: 10px 16px;
        border: 0;
        border-radius: 8px;
        background: var(--admin-primary, #2563eb);
        color: #fff;
        font: inherit;
        font-weight: 600;
        cursor: pointer;
        white-space: nowrap;
      }

      .station-add-button:hover {
        filter: brightness(0.94);
      }

      .station-count {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-width: 26px;
        height: 26px;
        margin-left: 6px;
        border-radius: 999px;
        background: var(--admin-muted-bg, #f3f4f6);
        font-size: 0.8rem;
      }

      .station-table-wrap {
        width: 100%;
        overflow-x: auto;
      }

      .station-secondary {
        margin-top: 3px;
        color: var(--admin-muted, #6b7280);
        font-size: 0.8rem;
      }

      .station-row-actions {
        display: flex;
        align-items: center;
        flex-wrap: wrap;
        gap: 8px;
      }

      .station-row-actions form {
        margin: 0;
      }

      .station-modal[hidden] {
        display: none !important;
      }

      .station-modal {
        position: fixed;
        z-index: 9999;
        inset: 0;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 20px;
      }

      .station-modal-backdrop {
        position: absolute;
        inset: 0;
        background: rgb(15 23 42 / 58%);
      }

      .station-modal-dialog {
        position: relative;
        z-index: 1;
        box-sizing: border-box;
        width: min(100%, 620px);
        max-height: 90vh;
        overflow-y: auto;
        padding: 24px;
        border: 1px solid var(--admin-border, #e5e7eb);
        border-radius: 14px;
        background: var(--admin-surface, #fff);
        color: var(--admin-text, #111827);
        box-shadow: 0 24px 70px rgb(0 0 0 / 22%);
      }

      .station-modal-header {
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        gap: 16px;
        margin-bottom: 24px;
      }

      .station-modal-header h2 {
        margin: 0;
      }

      .station-modal-header p {
        margin: 7px 0 0;
        color: var(--admin-muted, #6b7280);
        font-size: 0.9rem;
      }

      .station-modal-close {
        width: 36px;
        height: 36px;
        border: 0;
        border-radius: 8px;
        background: var(--admin-muted-bg, #f3f4f6);
        color: inherit;
        font-size: 1.6rem;
        cursor: pointer;
      }

      .station-modal-dialog .admin-form {
        display: grid;
        gap: 16px;
      }

      .station-modal-dialog .admin-form-group select,
      .station-modal-dialog .admin-form-group input {
        box-sizing: border-box;
        width: 100%;
        min-height: 42px;
      }

      .station-picker-list {
        display: grid;
        gap: 6px;
        max-height: 220px;
        overflow-y: auto;
        margin-top: 8px;
        padding: 6px;
        border: 1px solid var(--admin-border, #d1d5db);
        border-radius: 8px;
      }

      .station-picker-option {
        display: grid;
        gap: 4px;
        width: 100%;
        padding: 10px 12px;
        border: 1px solid transparent;
        border-radius: 7px;
        background: transparent;
        color: inherit;
        text-align: left;
        font: inherit;
        cursor: pointer;
      }

      .station-picker-option span {
        color: var(--admin-muted, #6b7280);
        font-size: 0.85rem;
      }

      .station-picker-option:hover,
      .station-picker-option.is-selected {
        border-color: var(--admin-primary, #2563eb);
        background: var(--admin-muted-bg, #f3f4f6);
      }

      .station-picker-option[hidden],
      .station-picker-list[hidden],
      #modal-station[hidden] {
        display: none !important;
      }

      #station-picker-empty {
        margin: 8px 0;
        color: var(--admin-muted, #6b7280);
        font-size: 0.875rem;
      }

      #station-picker-selected {
        margin: 8px 0 0;
        color: var(--admin-muted, #6b7280);
        font-size: 0.875rem;
      }

      .station-modal-actions {
        display: flex;
        justify-content: flex-end;
        gap: 10px;
        margin-top: 8px;
        padding-top: 18px;
        border-top: 1px solid var(--admin-border, #e5e7eb);
      }

      .station-cancel-button {
        min-height: 42px;
        padding: 10px 16px;
        border: 1px solid var(--admin-border, #d1d5db);
        border-radius: 8px;
        background: transparent;
        color: inherit;
        font: inherit;
        cursor: pointer;
      }

      @media (max-width: 640px) {
        .station-toolbar {
          align-items: stretch;
          flex-direction: column;
        }

        .station-search {
          max-width: none;
        }

        .station-add-button {
          width: 100%;
        }

        .station-modal-dialog {
          padding: 18px;
        }

        .station-modal-actions {
          flex-direction: column-reverse;
        }

        .station-modal-actions button {
          width: 100%;
        }
      }
    </style>

    <script>
      const modal =
        document.querySelector("#station-modal") as HTMLElement | null;

      const openAddButton =
        document.querySelector("#open-add-modal") as HTMLButtonElement | null;

      const closeButtons = document.querySelectorAll("[data-close-modal]");

      const assignmentForm =
        document.querySelector("#station-assignment-form") as HTMLFormElement | null;

      const stationSelect =
        document.querySelector("#modal-station") as HTMLSelectElement | null;

      const hiddenStationId =
        document.querySelector("#modal-station-id-hidden") as HTMLInputElement | null;

      const floorSelect =
        document.querySelector("#modal-floor") as HTMLSelectElement | null;

      const exitSelect =
        document.querySelector("#modal-exit") as HTMLSelectElement | null;

      const locationSelect =
        document.querySelector("#modal-location") as HTMLSelectElement | null;

      const walkingInput =
        document.querySelector("#modal-walking") as HTMLInputElement | null;

      const orderInput =
        document.querySelector("#modal-order") as HTMLInputElement | null;

      const modalTitle =
        document.querySelector("#station-modal-title") as HTMLElement | null;

      const modalDescription =
        document.querySelector("#station-modal-description") as HTMLElement | null;

      const modalSubmit =
        document.querySelector("#station-modal-submit") as HTMLButtonElement | null;

      const searchInput =
        document.querySelector("#station-search") as HTMLInputElement | null;

      const searchEmpty =
        document.querySelector("#station-search-empty") as HTMLElement | null;

      const stationPickerSearch =
        document.querySelector("#station-picker-search") as HTMLInputElement | null;

      const stationPickerList =
        document.querySelector("#station-picker-list") as HTMLElement | null;

      const stationPickerEmpty =
        document.querySelector("#station-picker-empty") as HTMLElement | null;

      const stationPickerSelected =
        document.querySelector("#station-picker-selected") as HTMLElement | null;

      const stationPickerOptions = Array.from(
        document.querySelectorAll(".station-picker-option"),
      ) as HTMLButtonElement[];

      const filterFloorsAndExits = (resetFloor: boolean) => {
        if (!stationSelect || !floorSelect || !exitSelect) return;

        const stationId = stationSelect.value;

        Array.from(floorSelect.options).forEach((option) => {
          if (!option.value) {
            option.hidden = false;
            return;
          }

          option.hidden = option.dataset.stationId !== stationId;
        });

        if (resetFloor) {
          floorSelect.value = "";
        }

        const floorId = floorSelect.value;

        Array.from(exitSelect.options).forEach((option) => {
          if (!option.value) {
            option.hidden = false;
            return;
          }

          option.hidden =
            option.dataset.stationId !== stationId ||
            !floorId ||
            option.dataset.floorId !== floorId;
        });

        const selectedExit = exitSelect.selectedOptions[0];

        if (selectedExit?.value && selectedExit.hidden) {
          exitSelect.value = "";
        }
      };

      const filterStationPicker = () => {
        if (!stationPickerSearch || !stationSelect) return;

        const query = stationPickerSearch.value.trim().toLowerCase();
        let visibleCount = 0;

        stationPickerOptions.forEach((option) => {
          const stationId = option.dataset.stationId ?? "";

          const searchableText =
            `${option.dataset.stationName ?? ""} ${option.dataset.stationJapanese ?? ""}`
              .toLowerCase();

          const isSelected = stationSelect.value === stationId;

          const isAssigned =
            option.dataset.assigned === "true" &&
            !stationSelect.disabled &&
            !isSelected;

          const matches = searchableText.includes(query);

          option.hidden = !matches || isAssigned;

          option.classList.toggle("is-selected", isSelected);
          option.setAttribute("aria-pressed", String(isSelected));

          if (!option.hidden) {
            visibleCount++;
          }
        });

        if (stationPickerEmpty) {
          stationPickerEmpty.hidden = visibleCount > 0;
        }

        if (stationPickerList) {
          stationPickerList.hidden = false;
        }
      };

      const syncStationPicker = () => {
        if (!stationSelect) return;

        const selectedOption = stationSelect.selectedOptions[0];

        if (stationPickerSelected) {
          stationPickerSelected.textContent = selectedOption?.value
            ? `Selected: ${selectedOption.textContent?.trim() ?? ""}`
            : "No station selected.";
        }

        filterStationPicker();
      };

      const openModal = () => {
        if (!modal) return;

        modal.hidden = false;
        modal.setAttribute("aria-hidden", "false");
        document.body.style.overflow = "hidden";
      };

      const closeModal = () => {
        if (!modal) return;

        modal.hidden = true;
        modal.setAttribute("aria-hidden", "true");
        document.body.style.overflow = "";
      };

      const resetModalForAdd = () => {
        if (
          !assignmentForm ||
          !stationSelect ||
          !hiddenStationId ||
          !floorSelect ||
          !exitSelect ||
          !locationSelect ||
          !walkingInput ||
          !orderInput
        ) {
          return;
        }

        assignmentForm.reset();

        stationSelect.disabled = false;
        stationSelect.name = "station_id";

        hiddenStationId.disabled = true;
        hiddenStationId.value = "";

        Array.from(stationSelect.options).forEach((option) => {
          option.disabled =
            option.dataset.assigned === "true" && option.value !== "";
        });

        stationSelect.value = "";

        if (stationPickerSearch) {
          stationPickerSearch.value = "";
        }

        floorSelect.value = "";
        exitSelect.value = "";
        locationSelect.value = "outside";
        walkingInput.value = "";
        orderInput.value = "0";

        if (modalTitle) {
          modalTitle.textContent = "Add Station";
        }

        if (modalDescription) {
          modalDescription.textContent =
            "Assign this Top Pick to a station.";
        }

        if (modalSubmit) {
          modalSubmit.textContent = "Add Station";
        }

        filterFloorsAndExits(false);
        syncStationPicker();
      };

      // Search station names in English or Japanese.
      stationPickerSearch?.addEventListener(
        "input",
        filterStationPicker,
      );

      // Select a station by clicking its result.
      stationPickerOptions.forEach((option) => {
        option.addEventListener("click", () => {
          if (!stationSelect || stationSelect.disabled) return;

          const stationId = option.dataset.stationId ?? "";

          if (!stationId) return;

          const matchingOption = Array.from(stationSelect.options).find(
            (selectOption) => selectOption.value === stationId,
          );

          if (!matchingOption || matchingOption.disabled) return;

          stationSelect.value = stationId;

          syncStationPicker();
          filterFloorsAndExits(true);
        });
      });

      // Prevent submitting without a selected station.
      assignmentForm?.addEventListener("submit", (event) => {
        if (!stationSelect) return;

        const stationId = stationSelect.disabled
          ? hiddenStationId?.value
          : stationSelect.value;

        if (!stationId) {
          event.preventDefault();

          if (stationPickerSelected) {
            stationPickerSelected.textContent =
              "Please select a station before saving.";
          }

          stationPickerSearch?.focus();
        }
      });

      openAddButton?.addEventListener("click", () => {
        resetModalForAdd();
        openModal();
        stationPickerSearch?.focus();
      });

      closeButtons.forEach((button) => {
        button.addEventListener("click", closeModal);
      });

      document.addEventListener("keydown", (event) => {
        if (event.key === "Escape" && modal && !modal.hidden) {
          closeModal();
        }
      });

      stationSelect?.addEventListener("change", () => {
        filterFloorsAndExits(true);
        syncStationPicker();
      });

      floorSelect?.addEventListener("change", () => {
        filterFloorsAndExits(false);
      });

      // Edit an existing assignment without changing its station.
      document.querySelectorAll(".js-edit-assignment").forEach((element) => {
        const button = element as HTMLButtonElement;

        button.addEventListener("click", () => {
          if (
            !stationSelect ||
            !hiddenStationId ||
            !floorSelect ||
            !exitSelect ||
            !locationSelect ||
            !walkingInput ||
            !orderInput
          ) {
            return;
          }

          resetModalForAdd();

          const stationId = button.dataset.stationId ?? "";

          stationSelect.value = stationId;
          stationSelect.disabled = true;
          stationSelect.removeAttribute("name");

          hiddenStationId.value = stationId;
          hiddenStationId.disabled = false;

          // Editing an existing assignment must allow its current station.
          Array.from(stationSelect.options).forEach((option) => {
            option.disabled = false;
          });

          if (stationPickerSearch) {
            stationPickerSearch.value = "";
          }

          syncStationPicker();
          filterFloorsAndExits(false);

          floorSelect.value = button.dataset.floorId ?? "";
          filterFloorsAndExits(false);

          exitSelect.value = button.dataset.exitId ?? "";
          locationSelect.value = button.dataset.locationType ?? "outside";
          walkingInput.value = button.dataset.walkingMinutes ?? "";
          orderInput.value = button.dataset.sortOrder ?? "0";

          if (modalTitle) {
            modalTitle.textContent = "Edit Station Assignment";
          }

          if (modalDescription) {
            modalDescription.textContent =
              `Update the assignment for ${button.dataset.stationName ?? "this station"}.`;
          }

          if (modalSubmit) {
            modalSubmit.textContent = "Save Changes";
          }

          openModal();
        });
      });

      // Existing assigned-stations table search remains unchanged.
      searchInput?.addEventListener("input", () => {
        const query = searchInput.value.trim().toLowerCase();

        const rows = Array.from(
          document.querySelectorAll(".station-table-row"),
        ) as HTMLElement[];

        let visibleCount = 0;

        rows.forEach((row) => {
          const matches = (row.dataset.search ?? "").includes(query);

          row.hidden = !matches;

          if (matches) {
            visibleCount++;
          }
        });

        if (searchEmpty) {
          searchEmpty.hidden =
            rows.length === 0 || visibleCount > 0;
        }
      });
    </script>
  </Fragment>
</AdminLayout>