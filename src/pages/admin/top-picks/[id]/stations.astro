---
import AdminLayout from "../../../../layouts/AdminLayout.astro";
import "../../../../styles/admin/forms.css";
import "../../../../styles/admin/tables.css";
import "../../../../styles/admin/operators.css";
import "../../../../styles/admin/top-pick-stations.css";

import Alert from "../../../../components/common/Alert.astro";
import Breadcrumbs from "../../../../components/common/Breadcrumbs.astro";
import Button from "../../../../components/common/Button.astro";
import EmptyState from "../../../../components/common/EmptyState.astro";

import { loadTopPickStationsPage } from "../../../../lib/services/top-pick-stations";

export const prerender = false;

const { env } = await import("cloudflare:workers");

const id = Number(Astro.params.id);

if (!Number.isInteger(id) || id <= 0) {
  return Astro.redirect("/admin/top-picks");
}

const page = await loadTopPickStationsPage(
  Astro.request,
  Astro.url,
  env.DB,
  id,
);

if (page.redirectTo) {
  return Astro.redirect(page.redirectTo);
}

const {
  topPick,
  stations,
  assignments,
  stationDetails,
  assignedStationIds,
  successMessage,
  locationTypes,
} = page;

if (!topPick) {
  Astro.response.status = 404;
}

const formResult = { error: page.error };
---

<AdminLayout title="Top Pick Stations" activePath="/admin/top-picks">
  <header class="admin-topbar">
    <Breadcrumbs
      backHref="/admin/top-picks"
      parentLabel="Top Picks"
      current="Station Assignments"
    />
  </header>

  <div class="admin-content top-pick-stations">
    {topPick ? (
      <>
        <div class="admin-page-header">
          <div>
            <h2>Manage Top Pick Stations</h2>
            <p>
              Manage the stations associated with this Top Pick.
            </p>
          </div>
        </div>

        <section class="admin-panel">
          <div class="admin-panel-body">
            <h2>{topPick.name}</h2>

            {topPick.name_japanese && (
              <p>{topPick.name_japanese}</p>
            )}

            {successMessage && <Alert>{successMessage}</Alert>}
            {formResult.error && <Alert>{formResult.error}</Alert>}

            <hr />

            <!-- Search and Add button -->
            <div class="station-toolbar">
              <div class="station-search">
                <label for="station-search">Search stations</label>
                <input
                  id="station-search"
                  type="search"
                  placeholder="Search station name..."
                />
              </div>

              <button
                type="button"
                id="open-add-modal"
                class="station-add-button"
              >
                <span aria-hidden="true">+</span>
                Add Station
              </button>
            </div>

            <!-- Assigned stations table -->
            <div class="admin-operator-form-header">
              <h2>
                Assigned Stations
                <span class="station-count">{assignments.length}</span>
              </h2>
            </div>

            {assignments.length === 0 ? (
              <EmptyState
                icon="📍"
                title="No Stations Assigned"
                description="Click Add Station to assign this Top Pick to a station."
              />
            ) : (
              <div class="station-table-wrap">
                <table class="admin-table" id="assigned-stations-table">
                  <thead>
                    <tr>
                      <th>Station</th>
                      <th>Floor</th>
                      <th>Exit</th>
                      <th>Location</th>
                      <th>Walk</th>
                      <th>Order</th>
                      <th>Actions</th>
                    </tr>
                  </thead>

                  <tbody>
                    {assignments.map((assignment) => (
                      <tr
                        class="station-table-row"
                        data-search={`${assignment.station_name} ${assignment.station_name_japanese ?? ""} ${assignment.station_slug}`.toLowerCase()}
                      >
                        <td>
                          <strong>{assignment.station_name}</strong>

                          {assignment.station_name_japanese && (
                            <div class="station-secondary">
                              {assignment.station_name_japanese}
                            </div>
                          )}

                          <div class="station-secondary">
                            {assignment.station_slug}
                          </div>
                        </td>

                        <td>{assignment.floor_name ?? "—"}</td>

                        <td>
                          {assignment.exit_name ?? "—"}
                          {assignment.exit_code
                            ? ` (${assignment.exit_code})`
                            : ""}
                        </td>

                        <td>
                          {locationTypes.find(
                            (type) =>
                              type.value === assignment.location_type,
                          )?.label ?? assignment.location_type}
                        </td>

                        <td>
                          {assignment.walking_minutes != null
                            ? `${assignment.walking_minutes} min`
                            : "—"}
                        </td>

                        <td>{assignment.sort_order}</td>

                        <td>
                          <div class="station-row-actions">
                            <button
                              type="button"
                              class="admin-table-action js-edit-assignment"
                              data-station-id={assignment.station_id}
                              data-floor-id={assignment.floor_id ?? ""}
                              data-exit-id={assignment.exit_id ?? ""}
                              data-location-type={assignment.location_type}
                              data-walking-minutes={assignment.walking_minutes ?? ""}
                              data-sort-order={assignment.sort_order}
                              data-station-name={assignment.station_name}
                            >
                              Edit
                            </button>

                            <form
                              method="POST"
                              onsubmit="return confirm('Remove this station assignment?')"
                            >
                              <input
                                type="hidden"
                                name="action"
                                value="remove"
                              />

                              <input
                                type="hidden"
                                name="station_id"
                                value={assignment.station_id}
                              />

                              <button
                                type="submit"
                                class="admin-table-action admin-table-action-delete"
                              >
                                Remove
                              </button>
                            </form>
                          </div>
                        </td>
                      </tr>
                    ))}
                  </tbody>
                </table>

                <p id="station-search-empty" hidden>
                  No matching stations found.
                </p>
              </div>
            )}
          </div>
        </section>

        <!-- Add/Edit modal -->
        <div
          id="station-modal"
          class="station-modal"
          hidden
          aria-hidden="true"
        >
          <div class="station-modal-backdrop" data-close-modal></div>

          <section
            class="station-modal-dialog"
            role="dialog"
            aria-modal="true"
            aria-labelledby="station-modal-title"
          >
            <header class="station-modal-header">
              <div>
                <h2 id="station-modal-title">Add Station</h2>

                <p id="station-modal-description">
                  Assign this Top Pick to a station.
                </p>
              </div>

              <button
                type="button"
                class="station-modal-close"
                data-close-modal
                aria-label="Close dialog"
              >
                &times;
              </button>
            </header>

            <form
              id="station-assignment-form"
              method="POST"
              class="admin-form"
            >
              <input
                type="hidden"
                name="action"
                value="save"
              />

              <!-- Used only when editing an existing assignment -->
              <input
                type="hidden"
                id="modal-station-id-hidden"
                name="station_id"
                value=""
                disabled
              />

              <!-- Searchable station picker -->
              <div class="admin-form-group station-field">
                <div class="station-field-head">
                  <label for="station-picker-search">Station</label>
                  <span
                    id="station-picker-count"
                    class="station-picker-count"
                    aria-live="polite"
                  ></span>
                </div>

                <!-- Shown once a station is chosen -->
                <div id="station-chip" class="station-chip" hidden>
                  <span class="station-chip-text">
                    <strong id="station-chip-name"></strong>
                    <span id="station-chip-jp"></span>
                  </span>

                  <button
                    type="button"
                    id="station-chip-clear"
                    class="station-chip-clear"
                  >
                    Change
                  </button>
                </div>

                <!-- Search and results, hidden once a station is chosen -->
                <div id="station-picker-body" class="station-picker-body">
                  <div class="station-picker-input">
                    <svg
                      viewBox="0 0 16 16"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="1.6"
                      stroke-linecap="round"
                      aria-hidden="true"
                    >
                      <circle cx="7" cy="7" r="4.6"></circle>
                      <path d="M10.5 10.5 14 14"></path>
                    </svg>

                    <input
                      id="station-picker-search"
                      type="search"
                      placeholder="Search English or Japanese name"
                      autocomplete="off"
                      aria-label="Search stations"
                    />
                  </div>

                  <div
                    id="station-picker-list"
                    class="station-picker-list"
                    role="list"
                    aria-label="Available stations"
                  >
                    {stations.map((station) => (
                      <button
                        type="button"
                        class="station-picker-option"
                        data-station-id={station.id}
                        data-station-name={station.name}
                        data-station-japanese={station.name_japanese ?? ""}
                        data-assigned={
                          assignedStationIds.has(station.id)
                            ? "true"
                            : "false"
                        }
                      >
                        <strong>{station.name}</strong>

                        {station.name_japanese && (
                          <span>{station.name_japanese}</span>
                        )}
                      </button>
                    ))}
                  </div>

                  <p id="station-picker-empty" hidden>
                    No available matching stations found.
                  </p>
                </div>

                <p
                  id="station-picker-selected"
                  class="station-picker-hint"
                  aria-live="polite"
                ></p>

                <!-- This select supplies station_id to the existing POST handler -->
                <select id="modal-station" name="station_id" hidden>
                  <option value="">Select a station</option>

                  {stations.map((station) => (
                    <option
                      value={station.id}
                      data-assigned={
                        assignedStationIds.has(station.id)
                          ? "true"
                          : "false"
                      }
                    >
                      {station.name}
                      {station.name_japanese
                        ? ` (${station.name_japanese})`
                        : ""}
                    </option>
                  ))}
                </select>
              </div>

              <div class="admin-form-group">
                <label for="modal-floor">Floor</label>

                <select id="modal-floor" name="floor_id">
                  <option value="">No floor selected</option>

                  {stationDetails.flatMap(({ station, floors }) =>
                    floors.map((floor) => (
                      <option
                        value={floor.id}
                        data-station-id={station.id}
                      >
                        {station.name} — {floor.name}
                        {floor.name_japanese
                          ? ` (${floor.name_japanese})`
                          : ""}
                      </option>
                    )),
                  )}
                </select>
              </div>

              <div class="admin-form-group">
                <label for="modal-exit">Exit</label>

                <select id="modal-exit" name="exit_id">
                  <option value="">No exit selected</option>

                  {stationDetails.flatMap(({ station, exits }) =>
                    exits.map((exit) => (
                      <option
                        value={exit.id}
                        data-station-id={station.id}
                        data-floor-id={exit.floor_id}
                      >
                        {station.name} — {exit.name}
                        {exit.code ? ` (${exit.code})` : ""}
                      </option>
                    )),
                  )}
                </select>
              </div>

              <div class="admin-form-group">
                <label for="modal-location">Location Type</label>

                <select
                  id="modal-location"
                  name="location_type"
                  required
                >
                  {locationTypes.map((type) => (
                    <option
                      value={type.value}
                      selected={type.value === "outside"}
                    >
                      {type.label}
                    </option>
                  ))}
                </select>
              </div>

              <div class="admin-form-group">
                <label for="modal-walking">
                  Walking Time (minutes)
                </label>

                <input
                  id="modal-walking"
                  name="walking_minutes"
                  type="number"
                  min="0"
                  step="1"
                  placeholder="e.g. 5"
                />
              </div>

              <div class="admin-form-group">
                <label for="modal-order">Sort Order</label>

                <input
                  id="modal-order"
                  name="sort_order"
                  type="number"
                  step="1"
                  value="0"
                  required
                />
              </div>

              <footer class="station-modal-actions">
                <button
                  type="button"
                  class="station-cancel-button"
                  data-close-modal
                >
                  Cancel
                </button>

                <button
                  type="submit"
                  class="station-add-button"
                  id="station-modal-submit"
                >
                  Add Station
                </button>
              </footer>
            </form>
          </section>
        </div>
      </>
    ) : (
      <>
        <div class="admin-page-header">
          <div>
            <h2>Top Pick Not Found</h2>
            <p>The requested Top Pick does not exist.</p>
          </div>
        </div>

        <Button href="/admin/top-picks" variant="secondary">
          Back to Top Picks
        </Button>
      </>
    )}
  </div>

  <Fragment slot="after">
    <script>
      import "../../../../scripts/admin/top-pick-stations";
    </script>
  </Fragment>
</AdminLayout>