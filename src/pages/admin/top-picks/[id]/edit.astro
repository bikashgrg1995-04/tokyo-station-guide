
---
import AdminLayout from "../../../../layouts/AdminLayout.astro";
import "../../../../styles/admin/forms.css";
import "../../../../styles/admin/operators.css";

import EmptyState from "../../../../components/common/EmptyState.astro";
import Alert from "../../../../components/common/Alert.astro";
import Breadcrumbs from "../../../../components/common/Breadcrumbs.astro";
import Button from "../../../../components/common/Button.astro";
import ConfirmDialog from "../../../../components/common/ConfirmDialog.astro";

import { getTopPickById, TOP_PICK_CATEGORIES } from "../../../../lib/db/top-picks";
import { handleTopPickUpdate } from "../../../../lib/services/top-picks";

export const prerender = false;

const { env } = await import("cloudflare:workers");
const db = env.DB;

const id = Number(Astro.params.id);

if (!Number.isInteger(id) || id <= 0) {
  return Astro.redirect("/admin/top-picks");
}

const topPick = await getTopPickById(db, id);

if (!topPick) {
  Astro.response.status = 404;
}

const form = await handleTopPickUpdate(Astro.request, db, id, topPick);

if (form.redirectTo) {
  return Astro.redirect(form.redirectTo);
}

const {
  name,
  nameJapanese,
  slug,
  category,
  description,
  imageUrl,
  entryFee,
  notes,
  openingHours,
} = form.values;

const { errors, formError } = form;

const admin = await Astro.session?.get<{
  id: number;
  email: string;
  name: string;
}>("admin");

const DAYS = [
  { value: 0, label: "Sunday" },
  { value: 1, label: "Monday" },
  { value: 2, label: "Tuesday" },
  { value: 3, label: "Wednesday" },
  { value: 4, label: "Thursday" },
  { value: 5, label: "Friday" },
  { value: 6, label: "Saturday" },
];

function getDayHours(day: number) {
  return openingHours.find((hour) => hour.day_of_week === day) ?? {
    day_of_week: day,
    is_closed: false,
    opening_time: "09:00",
    closing_time: "17:00",
    last_entry_time: "",
  };
}
---

<AdminLayout title="Edit Top Pick" activePath="/admin/top-picks">
  <header class="admin-topbar">
    <Breadcrumbs
      backHref="/admin/top-picks"
      parentLabel="Top Picks"
      current="Edit Top Pick"
    />

    <div class="admin-user">
      <div class="admin-avatar">
        {
          admin?.name
            ? admin.name
                .split(" ")
                .map((part) => part.charAt(0))
                .join("")
                .slice(0, 2)
                .toUpperCase()
            : "AD"
        }
      </div>

      <div class="admin-user-info">
        <strong>{admin?.name ?? "Administrator"}</strong>
        <span>Tokyo Station Guide</span>
      </div>
    </div>
  </header>

  <div class="admin-content">
    {
      topPick ? (
        <>
          <div class="admin-page-header">
            <div>
              <h2>Edit Top Pick</h2>
              <p>
                Update the featured place information used throughout
                the Tokyo Station Guide.
              </p>
            </div>
          </div>

          <section class="admin-panel">
            <div class="admin-panel-body">
              <div class="admin-operator-form">
                <div class="admin-operator-form-header">
                  <h2>Top Pick Details</h2>
                  <p>Update the information for this featured place.</p>
                </div>

                {formError && <Alert>{formError}</Alert>}

                <form
                  method="POST"
                  class="admin-form"
                  id="edit-top-pick-form"
                >
                  <div class="admin-form-group">
                    <label for="name">Name</label>
                    <input
                      id="name"
                      name="name"
                      type="text"
                      required
                      maxlength="150"
                      value={name}
                      aria-invalid={errors.name ? "true" : "false"}
                      aria-describedby={errors.name ? "name-error" : undefined}
                    />
                    {errors.name && (
                      <small id="name-error" class="admin-form-error">{errors.name}</small>
                    )}
                  </div>

                  <div class="admin-form-group">
                    <label for="name_japanese">Japanese Name</label>
                    <input
                      id="name_japanese"
                      name="name_japanese"
                      type="text"
                      maxlength="150"
                      value={nameJapanese}
                      placeholder="東京タワー"
                      aria-invalid={errors.nameJapanese ? "true" : "false"}
                      aria-describedby={errors.nameJapanese ? "name-japanese-error" : undefined}
                    />
                    {errors.nameJapanese && (
                      <small id="name-japanese-error" class="admin-form-error">
                        {errors.nameJapanese}
                      </small>
                    )}
                  </div>

                  <div class="admin-form-group">
                    <label for="slug">Slug</label>
                    <input
                      id="slug"
                      name="slug"
                      type="text"
                      required
                      maxlength="150"
                      value={slug}
                      aria-invalid={errors.slug ? "true" : "false"}
                      aria-describedby={errors.slug ? "slug-error" : undefined}
                    />
                    {errors.slug ? (
                      <small id="slug-error" class="admin-form-error">{errors.slug}</small>
                    ) : (
                      <small>Use lowercase letters, numbers and hyphens.</small>
                    )}
                  </div>

                  <div class="admin-form-group">
                    <label for="category">Category</label>
                    <select
                      id="category"
                      name="category"
                      required
                      aria-invalid={errors.category ? "true" : "false"}
                      aria-describedby={errors.category ? "category-error" : undefined}
                    >
                      {TOP_PICK_CATEGORIES.map((item) => (
                        <option value={item} selected={category === item}>
                          {item.charAt(0).toUpperCase() + item.slice(1)}
                        </option>
                      ))}
                    </select>
                    {errors.category && (
                      <small id="category-error" class="admin-form-error">{errors.category}</small>
                    )}
                  </div>

                  <div class="admin-form-group">
                    <label for="description">Description</label>
                    <textarea
                      id="description"
                      name="description"
                      rows="5"
                      maxlength="2000"
                      placeholder="A famous Tokyo landmark..."
                      aria-invalid={errors.description ? "true" : "false"}
                      aria-describedby={errors.description ? "description-error" : undefined}
                    >{description}</textarea>
                    {errors.description ? (
                      <small id="description-error" class="admin-form-error">{errors.description}</small>
                    ) : (
                      <small>Optional. Maximum 2000 characters.</small>
                    )}
                  </div>

                  <div class="admin-form-group">
                    <label for="image_url">Image URL</label>
                    <input
                      id="image_url"
                      name="image_url"
                      type="url"
                      maxlength="2048"
                      value={imageUrl}
                      placeholder="https://example.com/tokyo-tower.jpg"
                      aria-invalid={errors.imageUrl ? "true" : "false"}
                      aria-describedby={errors.imageUrl ? "image-url-error" : undefined}
                    />
                    {errors.imageUrl ? (
                      <small id="image-url-error" class="admin-form-error">{errors.imageUrl}</small>
                    ) : (
                      <small>Optional. Provide an HTTP or HTTPS image URL.</small>
                    )}
                  </div>

                  <hr />

                  <div class="admin-operator-form-header">
                    <h2>Visitor Information</h2>
                    <p>These details belong to the place and are shared across assigned stations.</p>
                  </div>

                  <div class="admin-form-group">
                    <label for="entry_fee">Entry Fee</label>
                    <input
                      id="entry_fee"
                      name="entry_fee"
                      type="text"
                      maxlength="150"
                      value={entryFee}
                      placeholder="Free / Adults ¥1,200"
                      aria-invalid={errors.entryFee ? "true" : "false"}
                      aria-describedby={errors.entryFee ? "entry-fee-error" : undefined}
                    />
                    {errors.entryFee ? (
                      <small id="entry-fee-error" class="admin-form-error">{errors.entryFee}</small>
                    ) : (
                      <small>Optional. Include currency and different ticket prices if needed.</small>
                    )}
                  </div>

                  <div class="admin-form-group">
                    <label for="notes">Visitor Notes</label>
                    <textarea
                      id="notes"
                      name="notes"
                      rows="4"
                      maxlength="2000"
                      placeholder="Useful visitor information, ticket advice, or access notes..."
                      aria-invalid={errors.notes ? "true" : "false"}
                      aria-describedby={errors.notes ? "notes-error" : undefined}
                    >{notes}</textarea>
                    {errors.notes ? (
                      <small id="notes-error" class="admin-form-error">{errors.notes}</small>
                    ) : (
                      <small>Optional. Maximum 2000 characters.</small>
                    )}
                  </div>

                  <hr />

                  <div class="admin-operator-form-header">
                    <h2>Opening Hours</h2>
                    <p>Update the usual opening schedule. Mark a day as closed when the place does not open.</p>
                  </div>

                  {errors.openingHours && <Alert>{errors.openingHours}</Alert>}

                  {DAYS.map((day) => {
                    const hours = getDayHours(day.value);

                    return (
                      <fieldset
                        class="admin-form-group"
                        style="border: 1px solid var(--admin-border, #ddd); border-radius: 8px; padding: 16px; min-width: 0;"
                      >
                        <legend style="font-weight: 600; padding: 0 6px;">{day.label}</legend>

                        <div style="display: flex; align-items: center; gap: 8px; margin-bottom: 14px;">
                          <input
                            id={`closed_${day.value}`}
                            name={`closed_${day.value}`}
                            type="checkbox"
                            checked={hours.is_closed}
                          />
                          <label for={`closed_${day.value}`}>Closed</label>
                        </div>

                        <div class="admin-form-group">
                          <label for={`opening_time_${day.value}`}>Opening Time</label>
                          <input
                            id={`opening_time_${day.value}`}
                            name={`opening_time_${day.value}`}
                            type="time"
                            value={hours.opening_time ?? ""}
                          />
                        </div>

                        <div class="admin-form-group">
                          <label for={`closing_time_${day.value}`}>Closing Time</label>
                          <input
                            id={`closing_time_${day.value}`}
                            name={`closing_time_${day.value}`}
                            type="time"
                            value={hours.closing_time ?? ""}
                          />
                        </div>

                        <div class="admin-form-group">
                          <label for={`last_entry_time_${day.value}`}>Last Entry Time</label>
                          <input
                            id={`last_entry_time_${day.value}`}
                            name={`last_entry_time_${day.value}`}
                            type="time"
                            value={hours.last_entry_time ?? ""}
                          />
                          <small>Optional. Leave blank if not applicable.</small>
                        </div>
                      </fieldset>
                    );
                  })}

                  <div class="admin-form-actions">
                    <Button href="/admin/top-picks" variant="secondary">
                      Cancel
                    </Button>

                    <Button
                      type="submit"
                      variant="primary"
                      id="save-top-pick-button"
                    >
                      Save Changes
                    </Button>
                  </div>
                </form>
              </div>
            </div>
          </section>
        </>
      ) : (
        <>
          <div class="admin-page-header">
            <div>
              <h2>Edit Top Pick</h2>
              <p>The requested top pick could not be found.</p>
            </div>

            <Button href="/admin/top-picks" variant="secondary">
              ← Back to Top Picks
            </Button>
          </div>

          <section class="admin-panel">
            <div class="admin-panel-body">
              <EmptyState
                icon="⚠"
                title="Top Pick Not Found"
                description="The requested top pick does not exist or may have been removed."
              >
                <div class="admin-form-actions admin-not-found-actions">
                  <Button href="/admin/top-picks" variant="secondary">
                    Back to Top Picks
                  </Button>
                </div>
              </EmptyState>
            </div>
          </section>
        </>
      )
    }
  </div>

  <Fragment slot="after">
    {
      topPick && (
        <ConfirmDialog
          id="save-top-pick-dialog"
          title="Save Changes"
          description="Are you sure you want to save these changes to this top pick?"
          confirmText="Save Changes"
          cancelText="Cancel"
          variant="primary"
        />
      )
    }

    <script>
      import "../../../../scripts/admin/top-picks-edit.ts";
    </script>
  </Fragment>
</AdminLayout>
