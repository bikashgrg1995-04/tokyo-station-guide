
---
import AdminLayout from "../../../layouts/AdminLayout.astro";
import "../../../styles/admin/forms.css";
import "../../../styles/admin/operators.css";

import Alert from "../../../components/common/Alert.astro";
import Breadcrumbs from "../../../components/common/Breadcrumbs.astro";
import TopPickHoursTable from "../../../components/admin/TopPickHoursTable.astro";
import Button from "../../../components/common/Button.astro";

import { iconBucket } from "../../../lib/storage/facility-icons";
import TopPickImageField from "../../../components/admin/TopPickImageField.astro";
import { handleTopPickCreate } from "../../../lib/services/top-picks";
import { TOP_PICK_CATEGORIES } from "../../../lib/db/top-picks";

export const prerender = false;

const { env } = await import("cloudflare:workers");

const form = await handleTopPickCreate(Astro.request, env.DB, iconBucket(env));

if (form.redirectTo) {
  return Astro.redirect(form.redirectTo);
}

const {
  name,
  nameJapanese,
  slug,
  category,
  description,
  imageUrl,
  entryFee,
  notes,
  openingHours,
} = form.values;

const { errors, formError } = form;

---

<AdminLayout title="Add Top Pick" activePath="/admin/top-picks">
  <header class="admin-topbar">
    <Breadcrumbs
      backHref="/admin/top-picks"
      parentLabel="Top Picks"
      current="Add Top Pick"
    />
  </header>

  <div class="admin-content">
    <div class="admin-page-header">
      <div>
        <h2>Add Top Pick</h2>
        <p>
          Create a popular place that can be featured on relevant
          station pages throughout the Tokyo Station Guide.
        </p>
      </div>
    </div>

    <section class="admin-panel">
      <div class="admin-panel-body">
        <div class="admin-operator-form">
          <div class="admin-operator-form-header">
            <h2>Top Pick Details</h2>
            <p>Enter the information for this featured place.</p>
          </div>

          {formError && <Alert>{formError}</Alert>}

          <form method="POST" class="admin-form" enctype="multipart/form-data">
            <div class="admin-form-group">
              <label for="name">Name</label>
              <input
                id="name"
                name="name"
                type="text"
                required
                maxlength="150"
                value={name}
                placeholder="Tokyo Tower"
                aria-invalid={errors.name ? "true" : "false"}
                aria-describedby={errors.name ? "name-error" : undefined}
              />
              {errors.name && (
                <small id="name-error" class="admin-form-error">{errors.name}</small>
              )}
            </div>

            <div class="admin-form-group">
              <label for="name_japanese">Japanese Name</label>
              <input
                id="name_japanese"
                name="name_japanese"
                type="text"
                maxlength="150"
                value={nameJapanese}
                placeholder="東京タワー"
                aria-invalid={errors.nameJapanese ? "true" : "false"}
                aria-describedby={errors.nameJapanese ? "name-japanese-error" : undefined}
              />
              {errors.nameJapanese && (
                <small id="name-japanese-error" class="admin-form-error">
                  {errors.nameJapanese}
                </small>
              )}
            </div>

            <div class="admin-form-group">
              <label for="slug">Slug</label>
              <input
                id="slug"
                name="slug"
                type="text"
                required
                maxlength="150"
                value={slug}
                placeholder="tokyo-tower"
                aria-invalid={errors.slug ? "true" : "false"}
                aria-describedby={errors.slug ? "slug-error" : undefined}
              />
              {errors.slug ? (
                <small id="slug-error" class="admin-form-error">{errors.slug}</small>
              ) : (
                <small>Use lowercase letters, numbers and hyphens.</small>
              )}
            </div>

            <div class="admin-form-group">
              <label for="category">Category</label>
              <select
                id="category"
                name="category"
                required
                aria-invalid={errors.category ? "true" : "false"}
                aria-describedby={errors.category ? "category-error" : undefined}
              >
                {TOP_PICK_CATEGORIES.map((item) => (
                  <option value={item} selected={category === item}>
                    {item.charAt(0).toUpperCase() + item.slice(1)}
                  </option>
                ))}
              </select>
              {errors.category && (
                <small id="category-error" class="admin-form-error">{errors.category}</small>
              )}
            </div>

            <div class="admin-form-group">
              <label for="description">Description</label>
              <textarea
                id="description"
                name="description"
                rows="5"
                maxlength="1000"
                placeholder="A famous Tokyo landmark..."
                aria-invalid={errors.description ? "true" : "false"}
                aria-describedby={errors.description ? "description-error" : undefined}
              >{description}</textarea>
              {errors.description ? (
                <small id="description-error" class="admin-form-error">{errors.description}</small>
              ) : (
                <small>Optional. Maximum 1000 characters.</small>
              )}
            </div>

            <TopPickImageField saved={imageUrl} error={errors.imageUrl} />

            <hr />

            <div class="admin-operator-form-header">
              <h2>Visitor Information</h2>
              <p>These details belong to the place and are shared across assigned stations.</p>
            </div>

            <div class="admin-form-group full-width">
              <label for="entry_fee">Entry Fee</label>
              <input
                id="entry_fee"
                name="entry_fee"
                type="text"
                maxlength="150"
                value={entryFee}
                placeholder="Free / Adults ¥1,200"
                aria-invalid={errors.entryFee ? "true" : "false"}
                aria-describedby={errors.entryFee ? "entry-fee-error" : undefined}
              />
              {errors.entryFee ? (
                <small id="entry-fee-error" class="admin-form-error">{errors.entryFee}</small>
              ) : (
                <small>Optional. Include currency and different ticket prices if needed.</small>
              )}
            </div>

            <div class="admin-form-group">
              <label for="notes">Visitor Notes</label>
              <textarea
                id="notes"
                name="notes"
                rows="4"
                maxlength="150"
                placeholder="Useful visitor information, ticket advice, or access notes..."
                aria-invalid={errors.notes ? "true" : "false"}
                aria-describedby={errors.notes ? "notes-error" : undefined}
              >{notes}</textarea>
              {errors.notes ? (
                <small id="notes-error" class="admin-form-error">{errors.notes}</small>
              ) : (
                <small>Optional. Maximum 150 characters.</small>
              )}
            </div>

            <hr />

            <div class="admin-operator-form-header">
              <h2>Opening Hours</h2>
              <p>Set the usual opening schedule. Mark a day as closed when the place does not open.</p>
            </div>

            {errors.openingHours && (
              <Alert>{errors.openingHours}</Alert>
            )}

            <TopPickHoursTable openingHours={openingHours} />

            <div class="admin-form-actions">
              <Button href="/admin/top-picks" variant="secondary">
                Cancel
              </Button>
              <Button type="submit" variant="primary">
                Create Top Pick
              </Button>
            </div>
          </form>
        </div>
      </div>
    </section>
  </div>
</AdminLayout>
