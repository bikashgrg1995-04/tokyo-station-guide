---
import AdminLayout from "../../../../layouts/AdminLayout.astro";
import "../../../../styles/admin/forms.css";
import "../../../../styles/admin/stations.css";

import Alert from "../../../../components/common/Alert.astro";
import Breadcrumbs from "../../../../components/common/Breadcrumbs.astro";
import Button from "../../../../components/common/Button.astro";
import ConfirmDialog from "../../../../components/common/ConfirmDialog.astro";

import { getStations } from "../../../../lib/db/stations";
import { getFeaturedStationById } from "../../../../lib/db/featured-stations";
import { handleFeaturedStationUpdate } from "../../../../lib/services/featured-stations";

export const prerender = false;

const { env } = await import("cloudflare:workers");
const db = env.DB;

const id = Number(Astro.params.id);

if (!Number.isInteger(id) || id <= 0) {
  return Astro.redirect("/admin/featured-stations");
}

const featuredStation = await getFeaturedStationById(db, id);

if (!featuredStation) {
  return Astro.redirect("/admin/featured-stations");
}

const form = await handleFeaturedStationUpdate(
  Astro.request,
  db,
  id,
  featuredStation,
);

if (form.redirectTo) {
  return Astro.redirect(form.redirectTo);
}

const stations = await getStations(db);

const {
  stationId: stationIdValue,
  imageUrl,
  description,
  sortOrder: sortOrderValue,
  isActive,
} = form.values;
const { errors, formError } = form;

---

<AdminLayout
  title={`Edit ${featuredStation.station_name}`}
  activePath="/admin/featured-stations"
>
  <header class="admin-topbar">
    <Breadcrumbs backHref="/admin/featured-stations" parentLabel="Featured Stations" current="Edit Featured Station" />
  </header>

  <div class="admin-content">
    <h2>Edit Featured Station</h2>

    <p>Update how this station appears in the Popular Station Hubs section.</p>

    <section class="admin-panel">
      <div class="admin-panel-body">
        <div class="admin-station-form">
          <div class="admin-station-form-header">
            <h3>Featured Station Details</h3>

            <p>
              Update the featured information for
              <strong>{featuredStation.station_name}</strong>.
            </p>
          </div>

          {
            formError && (
              <Alert>{formError}</Alert>
            )
          }

          <form
            method="POST"
            class="admin-form"
            id="edit-featured-station-form"
          >
            <div class="admin-form-grid">
              <div class="admin-form-group full-width">
                <label for="station_id"> Station </label>

                <select
                  id="station_id"
                  name="station_id"
                  required
                  aria-invalid={errors.stationId ? "true" : "false"}
                  aria-describedby={errors.stationId
                    ? "station-id-error"
                    : undefined}
                >
                  {
                    stations.map((station) => (
                      <option
                        value={station.id}
                        selected={stationIdValue === String(station.id)}
                      >
                        {station.name}
                        {station.name_japanese
                          ? ` ${station.name_japanese}`
                          : ""}
                      </option>
                    ))
                  }
                </select>

                {
                  errors.stationId && (
                    <small id="station-id-error" class="admin-form-error">
                      {errors.stationId}
                    </small>
                  )
                }
              </div>

              <div class="admin-form-group full-width">
                <label for="image_url"> Image URL </label>

                <input
                  id="image_url"
                  name="image_url"
                  type="url"
                  required
                  placeholder="https://example.com/shibuya.jpg"
                  value={imageUrl}
                  aria-invalid={errors.imageUrl ? "true" : "false"}
                  aria-describedby={errors.imageUrl
                    ? "image-url-error"
                    : "image-url-help"}
                />

                {
                  errors.imageUrl ? (
                    <small id="image-url-error" class="admin-form-error">
                      {errors.imageUrl}
                    </small>
                  ) : (
                    <small id="image-url-help">
                      Use a publicly accessible image URL.
                    </small>
                  )
                }
              </div>

              <div class="admin-form-group full-width">
                <label for="description"> Featured Description </label>

                <textarea
                  id="description"
                  name="description"
                  rows="4"
                  placeholder="e.g. Scramble Crossing"
                  aria-invalid={errors.description ? "true" : "false"}
                  aria-describedby={errors.description
                    ? "description-error"
                    : "description-help"}>{description}</textarea
                >

                {
                  errors.description ? (
                    <small id="description-error" class="admin-form-error">
                      {errors.description}
                    </small>
                  ) : (
                    <small id="description-help">
                      Short text shown below the station name.
                    </small>
                  )
                }
              </div>

              <div class="admin-form-group">
                <label for="sort_order"> Sort Order </label>

                <input
                  id="sort_order"
                  name="sort_order"
                  type="number"
                  min="0"
                  step="1"
                  required
                  value={sortOrderValue}
                  aria-invalid={errors.sortOrder ? "true" : "false"}
                  aria-describedby={errors.sortOrder
                    ? "sort-order-error"
                    : "sort-order-help"}
                />

                {
                  errors.sortOrder ? (
                    <small id="sort-order-error" class="admin-form-error">
                      {errors.sortOrder}
                    </small>
                  ) : (
                    <small id="sort-order-help">
                      Lower numbers appear first.
                    </small>
                  )
                }
              </div>

              <div class="admin-form-group">
                <label>Status</label>

                <label class="admin-form-checkbox">
                  <input type="checkbox" name="is_active" checked={isActive} />

                  <span>Active</span>
                </label>

                <small>
                  Inactive stations are hidden from Popular Station Hubs.
                </small>
              </div>
            </div>

            <div class="admin-form-actions">
              <Button href="/admin/featured-stations" variant="secondary">
                Cancel
              </Button>

              <Button type="submit" variant="primary"> Save Changes </Button>
            </div>
          </form>
        </div>
      </div>
    </section>
  </div>
  
  <Fragment slot="after">
    <ConfirmDialog
      id="edit-featured-station-confirm-dialog"
      title="Save Changes"
      description="Are you sure you want to save these featured station changes?"
      confirmText="Save Changes"
      cancelText="Cancel"
      variant="primary"
    />

    <script>
      import "../../../../scripts/admin/featured-stations-edit.ts";
    </script>
  </Fragment>
</AdminLayout>
