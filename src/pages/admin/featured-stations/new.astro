---
import "../../../styles/admin/shared.css";
import "../../../styles/admin/forms.css";
import "../../../styles/admin/stations.css";

import AdminNavigation from "../../../common_components/AdminNavigation.astro";
import Button from "../../../common_components/Button.astro";

import { getStations } from "../../../lib/db/stations";
import { createFeaturedStation } from "../../../lib/db/featured-stations";

export const prerender = false;

const { env } = await import("cloudflare:workers");

const db = env.DB;

/* ========================================
   Form State
======================================== */

let error = "";

let stationIdValue = "";
let imageUrl = "";
let description = "";
let sortOrderValue = "0";
let isActive = true;

const errors = {
  stationId: "",
  imageUrl: "",
  description: "",
  sortOrder: "",
};

/* ========================================
   Existing Stations
======================================== */

const stations = await getStations(db);

/* ========================================
   Form Submission
======================================== */

if (Astro.request.method === "POST") {
  const formData = await Astro.request.formData();

  stationIdValue = String(
    formData.get("station_id") ?? "",
  ).trim();

  imageUrl = String(
    formData.get("image_url") ?? "",
  ).trim();

  description = String(
    formData.get("description") ?? "",
  ).trim();

  sortOrderValue = String(
    formData.get("sort_order") ?? "0",
  ).trim();

  isActive =
    formData.get("is_active") === "on";

  const stationId =
    stationIdValue === ""
      ? null
      : Number(stationIdValue);

  const sortOrder =
    sortOrderValue === ""
      ? null
      : Number(sortOrderValue);

  /* ========================================
     Validation
  ======================================== */

  if (
    stationId === null ||
    !Number.isInteger(stationId) ||
    stationId <= 0
  ) {
    errors.stationId =
      "Please select a station.";
  }

  if (!imageUrl) {
    errors.imageUrl =
      "Image URL is required.";
  } else if (imageUrl.length > 2000) {
    errors.imageUrl =
      "Image URL must be 2000 characters or less.";
  } else {
    try {
      const parsedUrl = new URL(imageUrl);

      if (
        parsedUrl.protocol !== "http:" &&
        parsedUrl.protocol !== "https:"
      ) {
        errors.imageUrl =
          "Image URL must use http or https.";
      }
    } catch {
      errors.imageUrl =
        "Please enter a valid image URL.";
    }
  }

  if (description.length > 200) {
    errors.description =
      "Description must be 200 characters or less.";
  }

  if (
    sortOrder === null ||
    !Number.isInteger(sortOrder) ||
    sortOrder < 0
  ) {
    errors.sortOrder =
      "Sort order must be a non-negative number.";
  }

  const hasErrors =
    Object.values(errors).some(
      (value) => value !== "",
    );

  /* ========================================
     Create
  ======================================== */

  if (!hasErrors) {
    try {
      await createFeaturedStation(db, {
        stationId: stationId as number,
        imageUrl,
        description,
        sortOrder: sortOrder as number,
        isActive,
      });

      return Astro.redirect(
        "/admin/featured-stations",
      );
    } catch (err) {
      console.error(err);

      error =
        "Unable to create featured station. The station may already be featured.";
    }
  }
}

/* ========================================
   Admin
======================================== */

const admin = await Astro.session?.get<{
  id: number;
  email: string;
  name: string;
}>("admin");
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />

    <meta
      name="viewport"
      content="width=device-width, initial-scale=1.0"
    />

    <meta
      name="robots"
      content="noindex, nofollow"
    />

    <title>
      Add Featured Station | Admin | Tokyo Station Guide
    </title>
  </head>

  <body>
    <div class="admin-shell">

      <AdminNavigation
        activePath="/admin/featured-stations"
      />

      <main class="admin-main">

        <header class="admin-topbar">

          <div class="admin-breadcrumb">

            <div class="admin-add-back">

              <Button
                href="/admin/featured-stations"
                variant="secondary"
                size="small"
              >
                ←
              </Button>

            </div>

            <a href="/admin/featured-stations">
              Featured Stations
            </a>

            <span>/</span>

            <strong>
              Add Featured Station
            </strong>

          </div>

        </header>

        <div class="admin-content">

          <!-- Page Header -->
          <div class="admin-page-header">

            <div>

              <h2>
                Add Featured Station
              </h2>

              <p>
                Add a station to the Popular Station Hubs
                section.
              </p>

            </div>

          </div>

          <!-- Form -->
          <section class="admin-panel admin-station-form-card">

            <div class="admin-panel-header">

              <div>

                <h3>
                  Featured Station Details
                </h3>

                <p>
                  Configure how this station should appear
                  in Popular Station Hubs.
                </p>

              </div>

            </div>

            <div class="admin-panel-body">

              {
                error && (
                  <div class="admin-alert admin-alert-error">
                    {error}
                  </div>
                )
              }

              <form
                method="POST"
                class="admin-form admin-station-form"
              >

                <div class="admin-form-grid">

                  <!-- Station -->
                  <div class="admin-form-group full-width">

                    <label for="station_id">
                      Station
                    </label>

                    <select
                      id="station_id"
                      name="station_id"
                      required
                      aria-invalid={
                        errors.stationId
                          ? "true"
                          : undefined
                      }
                      aria-describedby={
                        errors.stationId
                          ? "station-id-error"
                          : undefined
                      }
                    >

                      <option value="">
                        Select a station
                      </option>

                      {
                        stations.map((station) => (
                          <option
                            value={station.id}
                            selected={
                              stationIdValue ===
                              String(station.id)
                            }
                          >
                            {station.name}
                            {
                              station.name_japanese
                                ? ` ${station.name_japanese}`
                                : ""
                            }
                          </option>
                        ))
                      }

                    </select>

                    {
                      errors.stationId && (
                        <small
                          id="station-id-error"
                          class="admin-form-error"
                        >
                          {errors.stationId}
                        </small>
                      )
                    }

                    {
                      !errors.stationId && (
                        <small>
                          Select an existing station.
                        </small>
                      )
                    }

                  </div>

                  <!-- Image URL -->
                  <div class="admin-form-group full-width">

                    <label for="image_url">
                      Image URL
                    </label>

                    <input
                      id="image_url"
                      name="image_url"
                      type="url"
                      placeholder="https://example.com/shibuya.jpg"
                      value={imageUrl}
                      required
                      aria-invalid={
                        errors.imageUrl
                          ? "true"
                          : undefined
                      }
                      aria-describedby={
                        errors.imageUrl
                          ? "image-url-error"
                          : undefined
                      }
                    />

                    {
                      errors.imageUrl ? (
                        <small
                          id="image-url-error"
                          class="admin-form-error"
                        >
                          {errors.imageUrl}
                        </small>
                      ) : (
                        <small>
                          Use a publicly accessible image URL.
                        </small>
                      )
                    }

                  </div>

                  <!-- Description -->
                  <div class="admin-form-group full-width">

                    <label for="description">
                      Featured Description
                    </label>

                    <textarea
                      id="description"
                      name="description"
                      rows="4"
                      placeholder="e.g. Scramble Crossing"
                      aria-invalid={
                        errors.description
                          ? "true"
                          : undefined
                      }
                      aria-describedby={
                        errors.description
                          ? "description-error"
                          : undefined
                      }
                    >{description}</textarea>

                    {
                      errors.description && (
                        <small
                          id="description-error"
                          class="admin-form-error"
                        >
                          {errors.description}
                        </small>
                      )
                    }

                    {
                      !errors.description && (
                        <small>
                          Short text shown below the station name.
                        </small>
                      )
                    }

                  </div>

                  <!-- Sort Order -->
                  <div class="admin-form-group">

                    <label for="sort_order">
                      Sort Order
                    </label>

                    <input
                      id="sort_order"
                      name="sort_order"
                      type="number"
                      min="0"
                      step="1"
                      value={sortOrderValue}
                      required
                      aria-invalid={
                        errors.sortOrder
                          ? "true"
                          : undefined
                      }
                      aria-describedby={
                        errors.sortOrder
                          ? "sort-order-error"
                          : undefined
                      }
                    />

                    {
                      errors.sortOrder ? (
                        <small
                          id="sort-order-error"
                          class="admin-form-error"
                        >
                          {errors.sortOrder}
                        </small>
                      ) : (
                        <small>
                          Lower numbers appear first.
                        </small>
                      )
                    }

                  </div>

                  <!-- Active -->
                  <div class="admin-form-group">

                    <label>
                      Status
                    </label>

                    <label class="admin-form-checkbox">

                      <input
                        type="checkbox"
                        name="is_active"
                        checked={isActive}
                      />

                      <span>
                        Active
                      </span>

                    </label>

                    <small>
                      Inactive stations are hidden from
                      Popular Station Hubs.
                    </small>

                  </div>

                </div>

                <!-- Actions -->
                <div class="admin-form-actions">

                  <Button
                    href="/admin/featured-stations"
                    variant="secondary"
                  >
                    Cancel
                  </Button>

                  <Button
                    type="submit"
                    variant="primary"
                  >
                    Create Featured Station
                  </Button>

                </div>

              </form>

            </div>

          </section>

        </div>

      </main>

    </div>
  </body>
</html>