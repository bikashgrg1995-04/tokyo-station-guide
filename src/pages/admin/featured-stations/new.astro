---
import AdminLayout from "../../../layouts/AdminLayout.astro";
import "../../../styles/admin/forms.css";
import "../../../styles/admin/stations.css";

import Alert from "../../../components/common/Alert.astro";
import Button from "../../../components/common/Button.astro";

import { getStations } from "../../../lib/db/stations";
import { iconBucket } from "../../../lib/storage/facility-icons";
import FeaturedImageField from "../../../components/admin/FeaturedImageField.astro";
import { handleFeaturedStationCreate } from "../../../lib/services/featured-stations";

export const prerender = false;

const { env } = await import("cloudflare:workers");

const db = env.DB;

const form = await handleFeaturedStationCreate(Astro.request, db, iconBucket(env));

if (form.redirectTo) {
  return Astro.redirect(form.redirectTo);
}

const stations = await getStations(db);

const {
  stationId: stationIdValue,
  imageUrl,
  description,
  sortOrder: sortOrderValue,
  isActive,
} = form.values;
const { errors } = form;
const error = form.formError;

---

<AdminLayout title="Add Featured Station" activePath="/admin/featured-stations">

        <header class="admin-topbar">

          <div class="admin-breadcrumb">

            <div class="admin-add-back">

              <Button
                href="/admin/featured-stations"
                variant="secondary"
                size="small"
              >
                ←
              </Button>

            </div>

            <a href="/admin/featured-stations">
              Featured Stations
            </a>

            <span>/</span>

            <strong>
              Add Featured Station
            </strong>

          </div>

        </header>

        <div class="admin-content">

          <!-- Page Header -->
          <div class="admin-page-header">

            <div>

              <h2>
                Add Featured Station
              </h2>

              <p>
                Add a station to the Popular Station Hubs
                section.
              </p>

            </div>

          </div>

          <!-- Form -->
          <section class="admin-panel admin-station-form-card">

            <div class="admin-panel-header">

              <div>

                <h3>
                  Featured Station Details
                </h3>

                <p>
                  Configure how this station should appear
                  in Popular Station Hubs.
                </p>

              </div>

            </div>

            <div class="admin-panel-body">

              {
                error && (
                  <Alert>{error}</Alert>
                )
              }

              <form
                method="POST"
                enctype="multipart/form-data"
                class="admin-form admin-station-form"
              >

                <div class="admin-form-grid">

                  <!-- Station -->
                  <div class="admin-form-group full-width">

                    <label for="station_id">
                      Station
                    </label>

                    <select
                      id="station_id"
                      name="station_id"
                      required
                      aria-invalid={
                        errors.stationId
                          ? "true"
                          : undefined
                      }
                      aria-describedby={
                        errors.stationId
                          ? "station-id-error"
                          : undefined
                      }
                    >

                      <option value="">
                        Select a station
                      </option>

                      {
                        stations.map((station) => (
                          <option
                            value={station.id}
                            selected={
                              stationIdValue ===
                              String(station.id)
                            }
                          >
                            {station.name}
                            {
                              station.name_japanese
                                ? ` ${station.name_japanese}`
                                : ""
                            }
                          </option>
                        ))
                      }

                    </select>

                    {
                      errors.stationId && (
                        <small
                          id="station-id-error"
                          class="admin-form-error"
                        >
                          {errors.stationId}
                        </small>
                      )
                    }

                    {
                      !errors.stationId && (
                        <small>
                          Select an existing station.
                        </small>
                      )
                    }

                  </div>

                  <!-- Image URL -->
              <FeaturedImageField saved={imageUrl} error={errors.imageUrl} />

                  <!-- Description -->
                  <div class="admin-form-group full-width">

                    <label for="description">
                      Featured Description
                    </label>

                    <textarea
                      id="description"
                      name="description"
                      rows="4"
                      placeholder="e.g. Scramble Crossing"
                      aria-invalid={
                        errors.description
                          ? "true"
                          : undefined
                      }
                      aria-describedby={
                        errors.description
                          ? "description-error"
                          : undefined
                      }
                    >{description}</textarea>

                    {
                      errors.description && (
                        <small
                          id="description-error"
                          class="admin-form-error"
                        >
                          {errors.description}
                        </small>
                      )
                    }

                    {
                      !errors.description && (
                        <small>
                          Short text shown below the station name.
                        </small>
                      )
                    }

                  </div>

                  <!-- Sort Order -->
                  <div class="admin-form-group">

                    <label for="sort_order">
                      Sort Order
                    </label>

                    <input
                      id="sort_order"
                      name="sort_order"
                      type="number"
                      min="0"
                      step="1"
                      value={sortOrderValue}
                      required
                      aria-invalid={
                        errors.sortOrder
                          ? "true"
                          : undefined
                      }
                      aria-describedby={
                        errors.sortOrder
                          ? "sort-order-error"
                          : undefined
                      }
                    />

                    {
                      errors.sortOrder ? (
                        <small
                          id="sort-order-error"
                          class="admin-form-error"
                        >
                          {errors.sortOrder}
                        </small>
                      ) : (
                        <small>
                          Lower numbers appear first.
                        </small>
                      )
                    }

                  </div>

                  <!-- Active -->
                  <div class="admin-form-group">

                    <label>
                      Status
                    </label>

                    <label class="admin-form-checkbox">

                      <input
                        type="checkbox"
                        name="is_active"
                        checked={isActive}
                      />

                      <span>
                        Active
                      </span>

                    </label>

                    <small>
                      Inactive stations are hidden from
                      Popular Station Hubs.
                    </small>

                  </div>

                </div>

                <!-- Actions -->
                <div class="admin-form-actions">

                  <Button
                    href="/admin/featured-stations"
                    variant="secondary"
                  >
                    Cancel
                  </Button>

                  <Button
                    type="submit"
                    variant="primary"
                  >
                    Create Featured Station
                  </Button>

                </div>

              </form>

            </div>

          </section>

        </div>
</AdminLayout>
