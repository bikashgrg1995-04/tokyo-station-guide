---
import AdminLayout from "../../../layouts/AdminLayout.astro";
import "../../../styles/admin/forms.css";
import "../../../styles/admin/operators.css";

import Button from "../../../components/Button.astro";

import { handleOperatorCreate } from "../../../lib/services/operators";

export const prerender = false;

const { env } = await import("cloudflare:workers");

const form = await handleOperatorCreate(Astro.request, env.DB);

if (form.redirectTo) {
  return Astro.redirect(form.redirectTo);
}

const { name, slug, description, websiteUrl } = form.values;
const { errors, formError } = form;

const admin = await Astro.session?.get<{
  id: number;
  email: string;
  name: string;
}>("admin");
---

<AdminLayout title="Add Operator" activePath="/admin/operators">
        <!-- Topbar -->
        <header class="admin-topbar">
          <div class="admin-breadcrumb">
            <Button href="/admin/operators" variant="secondary">
              ← 
            </Button>
            <a href="/admin/operators"> Operators </a>

            <span> / </span>

            <strong> Add Operator </strong>
          </div>
        </header>

        <!-- Content -->
        <div class="admin-content">
          <!-- Page Header -->
          <div class="admin-page-header">
            <div>
              <h2>Add Operator</h2>

              <p>
                Create a new railway operator to use throughout the Tokyo
                Station Guide.
              </p>
            </div>
          </div>

          <!-- Form Panel -->
          <section class="admin-panel">
            <div class="admin-panel-body">
              <div class="admin-operator-form">
                <!-- Form Header -->
                <div class="admin-operator-form-header">
                  <h2>Operator Details</h2>

                  <p>Enter the basic information for this railway operator.</p>
                </div>

                <!-- General Error -->
                {
                  formError && (
                    <div class="admin-alert admin-alert-error">{formError}</div>
                  )
                }

                <!-- Operator Form -->
                <form method="POST" class="admin-form">
                  <!-- Name -->
                  <div class="admin-form-group">
                    <label for="name"> Name </label>

                    <input
                      id="name"
                      name="name"
                      type="text"
                      required
                      maxlength="150"
                      value={name}
                      placeholder="JR East"
                      aria-invalid={errors.name ? "true" : "false"}
                      aria-describedby={errors.name ? "name-error" : undefined}
                    />

                    {
                      errors.name && (
                        <small id="name-error" class="admin-form-error">
                          {errors.name}
                        </small>
                      )
                    }
                  </div>

                  <!-- Slug -->
                  <div class="admin-form-group">
                    <label for="slug"> Slug </label>

                    <input
                      id="slug"
                      name="slug"
                      type="text"
                      required
                      maxlength="150"
                      value={slug}
                      placeholder="jr-east"
                      aria-invalid={errors.slug ? "true" : "false"}
                      aria-describedby={errors.slug ? "slug-error" : undefined}
                    />

                    {
                      errors.slug ? (
                        <small id="slug-error" class="admin-form-error">
                          {errors.slug}
                        </small>
                      ) : (
                        <small>
                          Use lowercase letters, numbers and hyphens.
                        </small>
                      )
                    }
                  </div>

                  <!-- Description -->
                  <div class="admin-form-group">
                    <label for="description"> Description </label>

                    <textarea
                      id="description"
                      name="description"
                      rows="5"
                      maxlength="1000"
                      placeholder="Short description of the operator..."
                      aria-invalid={errors.description ? "true" : "false"}
                      aria-describedby={errors.description
                        ? "description-error"
                        : undefined}>{description}</textarea
                    >

                    {
                      errors.description && (
                        <small id="description-error" class="admin-form-error">
                          {errors.description}
                        </small>
                      )
                    }
                  </div>

                  <!-- Website -->
                  <div class="admin-form-group">
                    <label for="website_url"> Website URL </label>

                    <input
                      id="website_url"
                      name="website_url"
                      type="url"
                      value={websiteUrl}
                      placeholder="https://www.jreast.co.jp/"
                      aria-invalid={errors.websiteUrl ? "true" : "false"}
                      aria-describedby={errors.websiteUrl
                        ? "website-url-error"
                        : undefined}
                    />

                    {
                      errors.websiteUrl && (
                        <small id="website-url-error" class="admin-form-error">
                          {errors.websiteUrl}
                        </small>
                      )
                    }
                  </div>

                  <!-- Actions -->
                  <div class="admin-form-actions">
                    <Button href="/admin/operators" variant="secondary">
                      Cancel
                    </Button>

                    <Button type="submit" variant="primary">
                      Create Operator
                    </Button>
                  </div>
                </form>
              </div>
            </div>
          </section>
        </div>
</AdminLayout>
