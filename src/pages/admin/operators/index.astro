---
import AdminLayout from "../../../layouts/AdminLayout.astro";
import "../../../styles/admin/tables.css";
import "../../../styles/admin/operators.css";

import EmptyState from "../../../components/common/EmptyState.astro";
import Button from "../../../components/common/Button.astro";
import SearchInput from "../../../components/common/SearchInput.astro";
import ConfirmDialog from "../../../components/common/ConfirmDialog.astro";
import Pagination from "../../../components/common/Pagination.astro";

import { loadOperatorList } from "../../../lib/services/operators";

export const prerender = false;

const { env } = await import("cloudflare:workers");

const {
  operators,
  totalItems,
  currentPage: safeCurrentPage,
  totalPages,
  perPage,
  searchParam,
  paginationUrl,
} = await loadOperatorList(env.DB, Astro.url);

---

<AdminLayout title="Operators" activePath="/admin/operators">

        <div class="admin-content">

          <!-- Page Header -->
          <div class="admin-page-header">

            <div>
              <h2>Operators</h2>

              <p>
                Manage the railway operators used throughout
                the Tokyo Station Guide. Changes made here can
                affect how operators are displayed on railway
                lines, station information, and related
                navigation across the website.
              </p>
            </div>

          </div>

          <!-- Search / Action Bar -->
          <div class="admin-list-toolbar">

            <form
              id="operator-search-form"
              class="admin-search-form"
              method="GET"
              action="/admin/operators"
              role="search"
            >
              <SearchInput
                id="operator-search"
                name="search"
                value={searchParam}
                placeholder="Search operators..."
                ariaLabel="Search operators"
              />
            </form>

            <Button
              href="/admin/operators/new"
              variant="primary"
            >
              + Add Operator
            </Button>

          </div>

          <!-- Operators Table -->
          <section class="admin-panel">

            <div
              id="operators-table-content"
              class="admin-panel-body admin-table-panel-body"
            >

              <!-- Table Meta -->
              <div class="admin-table-meta">

                <span>
                  {totalItems} • Total Operators
                </span>

              </div>

              {
                operators.length > 0 ? (
                  <>

                    <!-- Table -->
                    <div class="admin-table-wrapper">

                      <table class="admin-table">

                        <thead>
                          <tr>
                            <th>ID</th>
                            <th>Operator</th>
                            <th>Slug</th>
                            <th>Website</th>
                            <th>Actions</th>
                          </tr>
                        </thead>

                        <tbody>

                          {
                            operators.map((operator) => (
                              <tr>

                                <td class="admin-table-id">
                                  {operator.id}
                                </td>

                                <td>
                                  <div class="admin-operator-name">
                                    {operator.name}
                                  </div>
                                </td>

                                <td class="admin-table-code">
                                  {operator.slug}
                                </td>

                                <td>

                                  {
                                    operator.website_url ? (
                                      <a
                                        href={operator.website_url}
                                        target="_blank"
                                        rel="noopener noreferrer"
                                        class="admin-operator-website"
                                      >
                                        Website
                                      </a>
                                    ) : (
                                      <span class="admin-table-muted">
                                        —
                                      </span>
                                    )
                                  }

                                </td>

                                <td>

                                  <div class="admin-table-actions">

                                    <a
                                      href={`/admin/operators/${operator.id}/edit`}
                                      class="admin-table-action admin-table-action-edit"
                                    >
                                      Edit
                                    </a>

                                    <button
                                      type="button"
                                      class="admin-table-action admin-table-action-delete js-delete-operator"
                                      data-operator-id={operator.id}
                                      data-operator-name={operator.name}
                                    >
                                      Delete
                                    </button>

                                  </div>

                                </td>

                              </tr>
                            ))
                          }

                        </tbody>

                      </table>

                    </div>

                    <!-- Table Footer -->
                    <div class="admin-table-footer">

                      <span>
                        {
                          totalItems > 0
                            ? `Page ${safeCurrentPage} of ${totalPages}`
                            : "No operators found"
                        }
                      </span>

                      <Pagination
                        currentPage={safeCurrentPage}
                        totalPages={totalPages}
                        baseUrl={`${paginationUrl.pathname}${paginationUrl.search}`}
                        totalItems={totalItems}
                        perPage={perPage}
                      />

                    </div>

                  </>
                ) : (
                  <EmptyState
                    icon="◉"
                    title={searchParam
                          ? "No operators found"
                          : "No operators yet"}
                    description={searchParam
                          ? "Try a different search term."
                          : "Add your first railway operator to get started."}
                  />
                )
              }

            </div>

          </section>

        </div>

  <Fragment slot="after">
    <!-- Delete Confirmation Dialog -->
    <ConfirmDialog
      id="delete-operator-dialog"
      title="Delete Operator"
      description="Are you sure you want to delete this operator?"
      confirmText="Delete Operator"
      cancelText="Cancel"
      variant="danger"
      warning="This action cannot be undone."
    />

    <!-- Delete Form -->
    <form
      method="POST"
      id="delete-operator-form"
      hidden
    ></form>

    <script>
      import "../../../scripts/admin/operators-list.ts";
    </script>

  
  </Fragment>
</AdminLayout>
