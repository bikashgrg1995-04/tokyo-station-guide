---
import AdminLayout from "../../../../layouts/AdminLayout.astro";
import "../../../../styles/admin/forms.css";
import "../../../../styles/admin/operators.css";

import EmptyState from "../../../../components/common/EmptyState.astro";
import Alert from "../../../../components/common/Alert.astro";
import Breadcrumbs from "../../../../components/common/Breadcrumbs.astro";
import Button from "../../../../components/common/Button.astro";
import ConfirmDialog from "../../../../components/common/ConfirmDialog.astro";

import { getOperatorById } from "../../../../lib/db/operators";
import { handleOperatorUpdate } from "../../../../lib/services/operators";

export const prerender = false;

const { env } = await import("cloudflare:workers");

const db = env.DB;

const id = Number(Astro.params.id);

if (!Number.isInteger(id) || id <= 0) {
  return Astro.redirect("/admin/operators");
}

const operator = await getOperatorById(db, id);

if (!operator) {
  Astro.response.status = 404;
}

const form = await handleOperatorUpdate(Astro.request, db, id, operator);

if (form.redirectTo) {
  return Astro.redirect(form.redirectTo);
}

const {
  name,
  slug,
  description,
  websiteUrl,
  nameJapanese,
  descriptionJapanese,
} = form.values;
const { errors, formError } = form;

const admin = await Astro.session?.get<{
  id: number;
  email: string;
  name: string;
}>("admin");
---

<AdminLayout title="Edit Operator" activePath="/admin/operators">

        <!-- Topbar -->
        <header class="admin-topbar">

          <Breadcrumbs backHref="/admin/operators" parentLabel="Operators" current="Edit Operator" />

          <div class="admin-user">

            <div class="admin-avatar">
              {
                admin?.name
                  ? admin.name
                      .split(" ")
                      .map(
                        (part) =>
                          part.charAt(0),
                      )
                      .join("")
                      .slice(0, 2)
                      .toUpperCase()
                  : "AD"
              }
            </div>

            <div class="admin-user-info">
              <strong>
                {admin?.name ?? "Administrator"}
              </strong>

              <span>
                Tokyo Station Guide
              </span>
            </div>

          </div>

        </header>


        <!-- Content -->
        <div class="admin-content">

          {
            operator ? (
              <>

                <!-- Page Header -->
                <div class="admin-page-header">

                  <div>
                    <h2>
                      Edit Operator
                    </h2>

                    <p>
                      Update railway operator
                      information for the Tokyo
                      Station Guide.
                    </p>
                  </div>

                  

                </div>


                <!-- Form Panel -->
                <section class="admin-panel">

                  <div class="admin-panel-body">

                    <div class="admin-operator-form">

                      <!-- Form Header -->
                      <div class="admin-operator-form-header">

                        <h2>
                          Operator Details
                        </h2>

                        <p>
                          Update the information for
                          this railway operator.
                        </p>

                      </div>


                      <!-- General Error -->
                      {
                        formError && (
                          <Alert>{formError}</Alert>
                        )
                      }


                      <!-- Operator Form -->
                      <form
                        method="POST"
                        class="admin-form"
                        id="edit-operator-form"
                      >

                        <!-- Name -->
                        <div class="admin-form-group">

                          <label for="name">
                            Name
                          </label>

                          <input
                            id="name"
                            name="name"
                            type="text"
                            required
                            maxlength="150"
                            value={name}
                            aria-invalid={
                              errors.name
                                ? "true"
                                : "false"
                            }
                            aria-describedby={
                              errors.name
                                ? "name-error"
                                : undefined
                            }
                          />

                          {
                            errors.name && (
                              <small
                                id="name-error"
                                class="admin-form-error"
                              >
                                {errors.name}
                              </small>
                            )
                          }

                        </div>


                        <!-- Japanese Name -->
                      <div class="admin-form-group">
                        <label for="name_japanese">Japanese Name</label>

                        <input
                          id="name_japanese"
                          name="name_japanese"
                          type="text"
                          lang="ja"
                          maxlength="150"
                          value={nameJapanese}
                          placeholder="JR東日本"
                          aria-invalid={errors.nameJapanese ? "true" : "false"}
                          aria-describedby={errors.nameJapanese ? "name_japanese-error" : undefined}
                        />

                        {
                          errors.nameJapanese && (
                            <small id="name_japanese-error" class="admin-form-error">
                              {errors.nameJapanese}
                            </small>
                          )
                        }
                      </div>

                      <!-- Slug -->
                        <div class="admin-form-group">

                          <label for="slug">
                            Slug
                          </label>

                          <input
                            id="slug"
                            name="slug"
                            type="text"
                            required
                            maxlength="150"
                            value={slug}
                            aria-invalid={
                              errors.slug
                                ? "true"
                                : "false"
                            }
                            aria-describedby={
                              errors.slug
                                ? "slug-error"
                                : undefined
                            }
                          />

                          {
                            errors.slug ? (
                              <small
                                id="slug-error"
                                class="admin-form-error"
                              >
                                {errors.slug}
                              </small>
                            ) : (
                              <small>
                                Use lowercase letters,
                                numbers and hyphens.
                              </small>
                            )
                          }

                        </div>


                        <!-- Description -->
                        <div class="admin-form-group">

                          <label for="description">
                            Description
                          </label>

                          <textarea
                            id="description"
                            name="description"
                            rows="5"
                            maxlength="1000"
                            placeholder="Short description of the operator..."
                            aria-invalid={
                              errors.description
                                ? "true"
                                : "false"
                            }
                            aria-describedby={
                              errors.description
                                ? "description-error"
                                : undefined
                            }
                          >{description}</textarea>

                          {
                            errors.description && (
                              <small
                                id="description-error"
                                class="admin-form-error"
                              >
                                {errors.description}
                              </small>
                            )
                          }

                        </div>


                        <!-- Japanese Description -->
                      <div class="admin-form-group">
                        <label for="description_japanese">Japanese Description</label>

                        <textarea
                          id="description_japanese"
                          name="description_japanese"
                          lang="ja"
                          rows="5"
                          maxlength="1000"
                          placeholder="事業者の簡単な説明…"
                          aria-invalid={errors.descriptionJapanese ? "true" : "false"}
                          aria-describedby={errors.descriptionJapanese ? "description_japanese-error" : undefined}>{descriptionJapanese}</textarea
                        >

                        {
                          errors.descriptionJapanese && (
                            <small id="description_japanese-error" class="admin-form-error">
                              {errors.descriptionJapanese}
                            </small>
                          )
                        }
                      </div>

                      <!-- Website -->
                        <div class="admin-form-group full-width">

                          <label for="website_url">
                            Website URL
                          </label>

                          <input
                            id="website_url"
                            name="website_url"
                            type="url"
                            value={websiteUrl}
                            placeholder="https://www.jreast.co.jp/"
                            aria-invalid={
                              errors.websiteUrl
                                ? "true"
                                : "false"
                            }
                            aria-describedby={
                              errors.websiteUrl
                                ? "website-url-error"
                                : undefined
                            }
                          />

                          {
                            errors.websiteUrl && (
                              <small
                                id="website-url-error"
                                class="admin-form-error"
                              >
                                {errors.websiteUrl}
                              </small>
                            )
                          }

                        </div>


                        <!-- Actions -->
                        <div class="admin-form-actions">

                          <Button
                            href="/admin/operators"
                            variant="secondary"
                          >
                            Cancel
                          </Button>

                          <Button
                            type="submit"
                            variant="primary"
                            id="save-operator-button"
                          >
                            Save Changes
                          </Button>

                        </div>

                      </form>

                    </div>

                  </div>

                </section>

              </>
            ) : (
              <>

                <!-- Not Found Header -->
                <div class="admin-page-header">

                  <div>
                    <h2>
                      Edit Operator
                    </h2>

                    <p>
                      The requested operator could
                      not be found.
                    </p>
                  </div>

                  <Button
                    href="/admin/operators"
                    variant="secondary"
                  >
                    ← Back to Operators
                  </Button>

                </div>


                <!-- Not Found Panel -->
                <section class="admin-panel">

                  <div class="admin-panel-body">

                    <EmptyState
                      icon="⚠"
                      title="Operator Not Found"
                      description="The requested operator does not exist or may have been removed."
                    >
                      <div class="admin-form-actions admin-not-found-actions">

                        <Button
                          href="/admin/operators"
                          variant="secondary"
                        >
                          Back to Operators
                        </Button>

                      </div>
                    </EmptyState>

                  </div>

                </section>

              </>
            )
          }

        </div>

  <Fragment slot="after">
    {
      operator && (
        <ConfirmDialog
          id="save-operator-dialog"
          title="Save Changes"
          description="Are you sure you want to save these changes to this operator?"
          confirmText="Save Changes"
          cancelText="Cancel"
          variant="primary"
        />
      )
    }


    <script>
      import "../../../../scripts/admin/operators-edit.ts";
    </script>

  
  </Fragment>
</AdminLayout>
