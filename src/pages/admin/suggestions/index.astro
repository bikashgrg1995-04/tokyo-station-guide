---
import AdminLayout from "../../../layouts/AdminLayout.astro";
import "../../../styles/admin/dashboard.css";
import "../../../styles/admin/suggestions.css";

import Pagination from "../../../components/common/Pagination.astro";

import { SUGGESTION_STATUS_LABELS } from "../../../lib/db/station-suggestions";
import {
  SUGGESTION_FILTERS as FILTERS,
  formatSuggestionDate as formatDate,
  loadSuggestionsPage,
  suggestionSnippet as snippet,
} from "../../../lib/services/station-suggestions";

export const prerender = false;

const { env } = await import("cloudflare:workers");

const {
  filter,
  suggestions,
  totalItems,
  totalPages,
  currentPage,
  perPage: PER_PAGE,
  dialogJson,
  filterCount,
  filterUrl,
  paginationBase,
} = await loadSuggestionsPage(env.DB, Astro.url);
---

<AdminLayout title="Suggestions" activePath="/admin/suggestions">
  <div class="admin-content">
    <div class="admin-page-header">
      <div>
        <h2>Suggestions</h2>
        <p>
          Messages from visitors about a station. Read the suggestion, update
          the station yourself, then mark it as resolved.
        </p>
      </div>
    </div>

    <nav class="admin-suggestion-filters" aria-label="Suggestion status">
      {
        FILTERS.map((item) => (
          <a
            href={filterUrl(item.value)}
            class:list={[{ "is-active": item.value === filter }]}
            aria-current={item.value === filter ? "page" : undefined}
          >
            {item.label}
            <span class="admin-suggestion-filter-count">
              {filterCount(item.value)}
            </span>
          </a>
        ))
      }
    </nav>

    <div class="admin-panel">
      {
        suggestions.length > 0 ? (
          <>
            <div class="admin-suggestions-table-wrap">
              <table class="admin-suggestions-table">
                <thead>
                  <tr>
                    <th>Station</th>
                    <th>Line</th>
                    <th>Suggestion</th>
                    <th>Submitted</th>
                    <th>Status</th>
                    <th>
                      <span class="admin-visually-hidden">Actions</span>
                    </th>
                  </tr>
                </thead>
                <tbody>
                  {suggestions.map((suggestion) => (
                    <tr data-suggestion-row={suggestion.id}>
                      <td>
                        <span class="admin-suggestion-station">
                          {suggestion.station_name}
                        </span>
                      </td>
                      <td>
                        {suggestion.line_name ? (
                          <span class="admin-suggestion-line">
                            <span
                              class="admin-suggestion-line-dot"
                              style={
                                suggestion.line_color
                                  ? `--c: ${suggestion.line_color}`
                                  : undefined
                              }
                            />
                            {suggestion.line_name}
                          </span>
                        ) : (
                          <span class="admin-suggestion-meta">—</span>
                        )}
                      </td>
                      <td class="admin-suggestion-text">
                        {snippet(suggestion.message) || "—"}
                      </td>
                      <td class="admin-suggestion-date">
                        {formatDate(suggestion.created_at)}
                      </td>
                      <td>
                        <span
                          class={`admin-suggestion-status is-${suggestion.status}`}
                        >
                          {SUGGESTION_STATUS_LABELS[suggestion.status]}
                        </span>
                      </td>
                      <td>
                        <div class="admin-suggestion-actions">
                          <button
                            type="button"
                            data-suggestion-open={suggestion.id}
                          >
                            View
                          </button>
                        </div>
                      </td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>

            <Pagination
              currentPage={currentPage}
              totalPages={totalPages}
              baseUrl={paginationBase}
              totalItems={totalItems}
              perPage={PER_PAGE}
            />
          </>
        ) : (
          <div class="admin-empty">
            <div class="admin-empty-icon">✓</div>
            <h3>
              {filter === "pending"
                ? "No new suggestions"
                : "Nothing here yet"}
            </h3>
            <p>Suggestions from visitors will appear here.</p>
          </div>
        )
      }
    </div>
  </div>

  <dialog id="suggestion-modal" class="suggestion-modal">
    <div class="suggestion-modal-header">
      <div>
        <p class="suggestion-eyebrow">SUGGESTION</p>
        <h2 id="suggestion-modal-title"></h2>
        <p id="suggestion-modal-subtitle" class="suggestion-subtitle"></p>
      </div>
      <button
        type="button"
        id="suggestion-close"
        class="suggestion-close"
        aria-label="Close dialog"
      >
        &times;
      </button>
    </div>

    <div id="suggestion-modal-body" class="suggestion-modal-body"></div>

    <p id="suggestion-feedback" class="suggestion-feedback" role="status"></p>

    <div class="suggestion-modal-footer">
      <button
        type="button"
        id="suggestion-delete"
        class="suggestion-btn suggestion-btn-danger"
      >
        Delete
      </button>

      <div class="suggestion-review-actions">
        <a
          id="suggestion-edit-station"
          class="suggestion-btn suggestion-btn-secondary"
          href="/admin/stations"
        >
          Edit station
        </a>
        <button
          type="button"
          id="suggestion-dismiss"
          class="suggestion-btn suggestion-btn-secondary"
        >
          Dismiss
        </button>
        <button
          type="button"
          id="suggestion-resolve"
          class="suggestion-btn suggestion-btn-primary"
        >
          Mark as resolved
        </button>
        <button
          type="button"
          id="suggestion-reopen"
          class="suggestion-btn suggestion-btn-secondary"
          hidden
        >
          Reopen
        </button>
      </div>
    </div>
  </dialog>

  <script type="application/json" id="suggestions-data" set:html={dialogJson} />

  <script>
    import "../../../scripts/admin/suggestions";
  </script>
</AdminLayout>
