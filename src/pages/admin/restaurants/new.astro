---
import AdminLayout from "../../../layouts/AdminLayout.astro";
import Breadcrumbs from "../../../components/common/Breadcrumbs.astro";
import PlaceFormView from "../../../components/admin/PlaceFormView.astro";
import { PLACE_KINDS } from "../../../lib/db/places";
import { handlePlaceForm } from "../../../lib/services/places";

export const prerender = false;

const { env } = await import("cloudflare:workers");
const info = PLACE_KINDS.restaurant;
const form = await handlePlaceForm(Astro.request, env.DB, info, undefined, env);
if (form.redirectTo) return Astro.redirect(form.redirectTo);
---

<AdminLayout title="Add Restaurant" activePath="/admin/restaurants">
  <header class="admin-topbar">
    <Breadcrumbs backHref="/admin/restaurants" parentLabel="Restaurants" current="Add Restaurant" />
  </header>
  <PlaceFormView info={info} form={form} />
</AdminLayout>
