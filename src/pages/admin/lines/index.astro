---
import AdminLayout from "../../../layouts/AdminLayout.astro";
import "../../../styles/admin/tables.css";
import "../../../styles/admin/lines.css";

import EmptyState from "../../../components/common/EmptyState.astro";
import Button from "../../../components/common/Button.astro";
import SearchInput from "../../../components/common/SearchInput.astro";
import ConfirmDialog from "../../../components/common/ConfirmDialog.astro";
import Pagination from "../../../components/common/Pagination.astro";

import { loadLineList } from "../../../lib/services/lines";

export const prerender = false;

const { env } = await import("cloudflare:workers");

const {
  lines,
  totalItems,
  currentPage: safeCurrentPage,
  totalPages,
  perPage,
  searchParam,
  paginationUrl,
} = await loadLineList(env.DB, Astro.url);

---

<AdminLayout title="Lines" activePath="/admin/lines">

        <div class="admin-content">

          <!-- Page Header -->
          <div class="admin-page-header">

            <div>
              <h2>Lines</h2>

              <p>
                Manage the railway lines used throughout
                the Tokyo Station Guide. Changes made here
                can affect station information, line
                navigation, and related content across
                the website.
              </p>
            </div>

          </div>

          <!-- Search / Action Bar -->
          <div class="admin-list-toolbar">

            <form
              id="line-search-form"
              class="admin-search-form"
              method="GET"
              action="/admin/lines"
              role="search"
            >
              <SearchInput
                id="line-search"
                name="search"
                value={searchParam}
                placeholder="Search lines..."
                ariaLabel="Search lines"
              />
            </form>

            <Button
              href="/admin/lines/new"
              variant="primary"
            >
              + Add Line
            </Button>

          </div>

          <!-- Lines Table -->
          <section class="admin-panel">

            <div
              id="lines-table-content"
              class="admin-panel-body admin-table-panel-body"
            >

              <!-- Table Meta -->
              <div class="admin-table-meta">
                <span>
                  {totalItems} • Total Lines
                </span>
              </div>

              {
                lines.length > 0 ? (
                  <>

                    <!-- Table -->
                    <div class="admin-table-wrapper">

                      <table class="admin-table">

                        <thead>
                          <tr>
                            <th>ID</th>
                            <th>Line</th>
                            <th>Operator</th>
                            <th>Code</th>
                            <th>Color</th>
                            <th>Website</th>
                            <th>Actions</th>
                          </tr>
                        </thead>

                        <tbody>
                          {
                            lines.map((line) => (
                              <tr>

                                <td class="admin-table-id">
                                  {line.id}
                                </td>

                                <td>
                                  <div class="admin-line-name">
                                    {line.name}
                                  </div>

                                  <div class="admin-line-slug">
                                    {line.slug}
                                  </div>
                                </td>

                                <td>
                                  <span class="admin-line-operator">
                                    {line.operator_name}
                                  </span>
                                </td>

                                <td>
                                  {
                                    line.code ? (
                                      <span class="admin-line-code">
                                        {line.code}
                                      </span>
                                    ) : (
                                      <span class="admin-table-muted">
                                        —
                                      </span>
                                    )
                                  }
                                </td>

                                <td>
                                  {
                                    line.color ? (
                                      <span class="admin-line-color">

                                        <span
                                          class="admin-line-color-swatch"
                                          style={`background-color: ${line.color};`}
                                          aria-hidden="true"
                                        />

                                        {line.color}

                                      </span>
                                    ) : (
                                      <span class="admin-table-muted">
                                        —
                                      </span>
                                    )
                                  }
                                </td>

                                <td>
                                  <form
                                    method="POST"
                                    action={`/admin/lines/${line.id}/visibility`}
                                    class="admin-line-visibility-form"
                                  >
                                    <input
                                      type="hidden"
                                      name="redirect"
                                      value={`${paginationUrl.pathname}${paginationUrl.search}`}
                                    />
                                    <input
                                      type="hidden"
                                      name="published"
                                      value={line.is_published ? "0" : "1"}
                                    />

                                    <label class="admin-switch" title={line.is_published ? "Live on the website — click to set Coming soon" : "Coming soon — click to show on the website"}>
                                      <input
                                        type="checkbox"
                                        class="js-line-visibility"
                                        checked={Boolean(line.is_published)}
                                        aria-label={`Show ${line.name} on the website`}
                                      />
                                      <span class="admin-switch-slider"></span>
                                    </label>

                                    <span
                                      class:list={[
                                        "admin-line-status",
                                        line.is_published ? "is-live" : "is-soon",
                                      ]}
                                    >
                                      {line.is_published ? "Live" : "Coming soon"}
                                    </span>
                                  </form>
                                </td>

                                <td>
                                  <div class="admin-table-actions">

                                    <a
                                      href={`/admin/lines/${line.id}/stations`}
                                      class="admin-table-action"
                                    >
                                      Stations
                                    </a>

                                    <a
                                      href={`/admin/lines/${line.id}/edit`}
                                      class="admin-table-action admin-table-action-edit"
                                    >
                                      Edit
                                    </a>

                                    <button
                                      type="button"
                                      class="admin-table-action admin-table-action-delete js-delete-line"
                                      data-line-id={line.id}
                                      data-line-name={line.name}
                                    >
                                      Delete
                                    </button>

                                  </div>
                                </td>

                              </tr>
                            ))
                          }
                        </tbody>

                      </table>

                    </div>

                    <!-- Table Footer -->
                    <div class="admin-table-footer">

                      <span>
                        {
                          totalItems > 0
                            ? `Page ${safeCurrentPage} of ${totalPages}`
                            : "No lines found"
                        }
                      </span>

                      <Pagination
                        currentPage={safeCurrentPage}
                        totalPages={totalPages}
                        baseUrl={`${paginationUrl.pathname}${paginationUrl.search}`}
                        totalItems={totalItems}
                        perPage={perPage}
                      />

                    </div>

                  </>
                ) : (
                  <EmptyState
                    icon="↔"
                    title={searchParam
                          ? "No lines found"
                          : "No lines yet"}
                    description={searchParam
                          ? "Try a different search term."
                          : "Add your first railway line to get started."}
                  >
                    {
                      searchParam && (
                        <div class="admin-empty-action">

                          <Button
                            href="/admin/lines"
                            variant="secondary"
                            size="small"
                          >
                            Clear Search
                          </Button>

                        </div>
                      )
                    }
                  </EmptyState>
                )
              }

            </div>

          </section>

        </div>

  <Fragment slot="after">
    <!-- Delete Confirmation Dialog -->
    <ConfirmDialog
      id="delete-line-dialog"
      title="Delete Line"
      description="Are you sure you want to delete this line?"
      confirmText="Delete Line"
      cancelText="Cancel"
      variant="danger"
      warning="This action cannot be undone."
    />

    <!-- Delete Form -->
    <form
      method="POST"
      id="delete-line-form"
      hidden
    ></form>

    <script>
      import "../../../scripts/admin/lines-list.ts";
    </script>

  
  </Fragment>
</AdminLayout>
