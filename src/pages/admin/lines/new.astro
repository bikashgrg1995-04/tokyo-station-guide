---
import AdminLayout from "../../../layouts/AdminLayout.astro";
import "../../../styles/admin/forms.css";
import "../../../styles/admin/lines.css";

import Button from "../../../components/Button.astro";

import { getOperators } from "../../../lib/db/operators";
import { handleLineCreate } from "../../../lib/services/lines";

export const prerender = false;

const { env } = await import("cloudflare:workers");

const db = env.DB;

const operators = await getOperators(db);

const form = await handleLineCreate(Astro.request, db, operators);

if (form.redirectTo) {
  return Astro.redirect(form.redirectTo);
}

const { operatorId, name, slug, code, color, description } = form.values;
const { errors, formError } = form;
---

<AdminLayout title="Add Line" activePath="/admin/lines">

        <!-- Topbar -->

        <header class="admin-topbar">

          <div class="admin-breadcrumb">

            <Button
              href="/admin/lines"
              variant="secondary"
            >
              ←
            </Button>

            <a href="/admin/lines">
              Lines
            </a>

            <span> / </span>

            <strong>
              Add Line
            </strong>

          </div>

        </header>


        <!-- Content -->

        <div class="admin-content">

          <!-- Page Header -->

          <div class="admin-page-header">

            <div>

              <h2>
                Add Line
              </h2>

              <p>
                Create a new railway line to use
                throughout the Tokyo Station Guide.
              </p>

            </div>

          </div>


          <!-- Form Panel -->

          <section class="admin-panel">

            <div class="admin-panel-body">

              <div class="admin-line-form">

                <!-- Form Header -->

                <div class="admin-line-form-header">

                  <h2>
                    Line Details
                  </h2>

                  <p>
                    Enter the basic information
                    for this railway line.
                  </p>

                </div>


                <!-- General Error -->

                {
                  formError && (
                    <div
                      class="admin-alert admin-alert-error"
                    >
                      {formError}
                    </div>
                  )
                }


                <!-- Line Form -->

                <form
                  method="POST"
                  class="admin-form"
                >

                  <!-- Operator -->

                  <div class="admin-form-group">

                    <label for="operator_id">
                      Operator
                    </label>

                    <select
                      id="operator_id"
                      name="operator_id"
                      required
                      aria-invalid={
                        errors.operatorId
                          ? "true"
                          : "false"
                      }
                      aria-describedby={
                        errors.operatorId
                          ? "operator-error"
                          : undefined
                      }
                    >

                      <option value="">
                        Select an operator
                      </option>

                      {
                        operators.map(
                          (operator) => (
                            <option
                              value={operator.id}
                              selected={
                                operatorId ===
                                String(
                                  operator.id,
                                )
                              }
                            >
                              {operator.name}
                            </option>
                          ),
                        )
                      }

                    </select>


                    {
                      errors.operatorId && (
                        <small
                          id="operator-error"
                          class="admin-form-error"
                        >
                          {errors.operatorId}
                        </small>
                      )
                    }

                  </div>


                  <!-- Name -->

                  <div class="admin-form-group">

                    <label for="name">
                      Name
                    </label>

                    <input
                      id="name"
                      name="name"
                      type="text"
                      required
                      maxlength="150"
                      value={name}
                      placeholder="Yamanote Line"
                      aria-invalid={
                        errors.name
                          ? "true"
                          : "false"
                      }
                      aria-describedby={
                        errors.name
                          ? "name-error"
                          : undefined
                      }
                    />


                    {
                      errors.name && (
                        <small
                          id="name-error"
                          class="admin-form-error"
                        >
                          {errors.name}
                        </small>
                      )
                    }

                  </div>


                  <!-- Slug -->

                  <div class="admin-form-group">

                    <label for="slug">
                      Slug
                    </label>

                    <input
                      id="slug"
                      name="slug"
                      type="text"
                      required
                      maxlength="150"
                      value={slug}
                      placeholder="yamanote-line"
                      aria-invalid={
                        errors.slug
                          ? "true"
                          : "false"
                      }
                      aria-describedby={
                        errors.slug
                          ? "slug-error"
                          : undefined
                      }
                    />


                    {
                      errors.slug ? (
                        <small
                          id="slug-error"
                          class="admin-form-error"
                        >
                          {errors.slug}
                        </small>
                      ) : (
                        <small>
                          Use lowercase letters,
                          numbers and hyphens.
                        </small>
                      )
                    }

                  </div>


                  <!-- Code -->

                  <div class="admin-form-group">

                    <label for="code">
                      Code
                    </label>

                    <input
                      id="code"
                      name="code"
                      type="text"
                      maxlength="50"
                      value={code}
                      placeholder="JY"
                      aria-invalid={
                        errors.code
                          ? "true"
                          : "false"
                      }
                      aria-describedby={
                        errors.code
                          ? "code-error"
                          : undefined
                      }
                    />


                    {
                      errors.code && (
                        <small
                          id="code-error"
                          class="admin-form-error"
                        >
                          {errors.code}
                        </small>
                      )
                    }

                  </div>


                  <!-- Color -->

                  <div class="admin-form-group">

                    <label for="color">
                      Line Color
                    </label>

                    <input
                      id="color"
                      name="color"
                      type="text"
                      maxlength="7"
                      value={color}
                      placeholder="#00A650"
                      aria-invalid={
                        errors.color
                          ? "true"
                          : "false"
                      }
                      aria-describedby={
                        errors.color
                          ? "color-error"
                          : undefined
                      }
                    />


                    {
                      errors.color ? (
                        <small
                          id="color-error"
                          class="admin-form-error"
                        >
                          {errors.color}
                        </small>
                      ) : (
                        <small>
                          Use a 6-digit hexadecimal
                          color, such as #00A650.
                        </small>
                      )
                    }

                  </div>


                  <!-- Description -->

                  <div class="admin-form-group">

                    <label for="description">
                      Description
                    </label>

                    <textarea
                      id="description"
                      name="description"
                      rows="5"
                      maxlength="1000"
                      placeholder="Short description of the railway line..."
                      aria-invalid={
                        errors.description
                          ? "true"
                          : "false"
                      }
                      aria-describedby={
                        errors.description
                          ? "description-error"
                          : undefined
                      }
                    >{description}</textarea>


                    {
                      errors.description && (
                        <small
                          id="description-error"
                          class="admin-form-error"
                        >
                          {errors.description}
                        </small>
                      )
                    }

                  </div>


                  <!-- Actions -->

                  <div class="admin-form-actions">

                    <Button
                      href="/admin/lines"
                      variant="secondary"
                    >
                      Cancel
                    </Button>


                    <Button
                      type="submit"
                      variant="primary"
                    >
                      Create Line
                    </Button>

                  </div>

                </form>

              </div>

            </div>

          </section>

        </div>
</AdminLayout>
