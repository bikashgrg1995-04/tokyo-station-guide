---
import "../../../../styles/admin/shared.css";
import "../../../../styles/admin/forms.css";
import "../../../../styles/admin/lines.css";

import AdminNavigation from "../../../../common_components/AdminNavigation.astro";
import Button from "../../../../common_components/Button.astro";
import ConfirmDialog from "../../../../common_components/ConfirmDialog.astro";

import {
  getLineById,
  updateLine,
} from "../../../../lib/db/lines";

import { getOperators } from "../../../../lib/db/operators";

export const prerender = false;

const { env } = await import("cloudflare:workers");

const db = env.DB;

const id = Number(Astro.params.id);

if (!Number.isInteger(id) || id <= 0) {
  return Astro.redirect("/admin/lines");
}

const line = await getLineById(db, id);

if (!line) {
  Astro.response.status = 404;
}

const operators = await getOperators(db);

let formError = "";

let operatorId = line?.operator_id
  ? String(line.operator_id)
  : "";

let name = line?.name ?? "";
let slug = line?.slug ?? "";
let code = line?.code ?? "";
let color = line?.color ?? "";
let description = line?.description ?? "";

const errors = {
  operatorId: "",
  name: "",
  slug: "",
  code: "",
  color: "",
  description: "",
};

const admin = await Astro.session?.get<{
  id: number;
  email: string;
  name: string;
}>("admin");

/* ========================================
   Form Submission
======================================== */

if (line && Astro.request.method === "POST") {
  const formData =
    await Astro.request.formData();

  operatorId = String(
    formData.get("operator_id") ?? "",
  ).trim();

  name = String(
    formData.get("name") ?? "",
  ).trim();

  slug = String(
    formData.get("slug") ?? "",
  ).trim();

  code = String(
    formData.get("code") ?? "",
  ).trim();

  color = String(
    formData.get("color") ?? "",
  ).trim();

  description = String(
    formData.get("description") ?? "",
  ).trim();


  /* ========================================
     Operator Validation
  ======================================== */

  const parsedOperatorId =
    Number(operatorId);

  if (!operatorId) {
    errors.operatorId =
      "Operator is required.";
  } else if (
    !Number.isInteger(parsedOperatorId) ||
    parsedOperatorId <= 0
  ) {
    errors.operatorId =
      "Please select a valid operator.";
  } else if (
    !operators.some(
      (operator) =>
        operator.id === parsedOperatorId,
    )
  ) {
    errors.operatorId =
      "Selected operator does not exist.";
  }


  /* ========================================
     Name Validation
  ======================================== */

  if (!name) {
    errors.name = "Name is required.";
  } else if (name.length > 150) {
    errors.name =
      "Name must be 150 characters or less.";
  }


  /* ========================================
     Slug Validation
  ======================================== */

  if (!slug) {
    errors.slug = "Slug is required.";
  } else if (
    !/^[a-z0-9]+(?:-[a-z0-9]+)*$/.test(slug)
  ) {
    errors.slug =
      "Slug can only contain lowercase letters, numbers, and hyphens.";
  } else if (slug.length > 150) {
    errors.slug =
      "Slug must be 150 characters or less.";
  }


  /* ========================================
     Code Validation
  ======================================== */

  if (code.length > 50) {
    errors.code =
      "Code must be 50 characters or less.";
  }


  /* ========================================
     Color Validation
  ======================================== */

  if (
    color &&
    !/^#[0-9a-fA-F]{6}$/.test(color)
  ) {
    errors.color =
      "Color must be a valid hexadecimal color such as #00A650.";
  }


  /* ========================================
     Description Validation
  ======================================== */

  if (description.length > 1000) {
    errors.description =
      "Description must be 1000 characters or less.";
  }


  /* ========================================
     Update Line
  ======================================== */

  const hasValidationErrors =
    Object.values(errors).some(
      (message) => message.length > 0,
    );

  if (!hasValidationErrors) {
    try {
      await updateLine(db, id, {
        operatorId: parsedOperatorId,
        name,
        slug,
        code: code || null,
        color: color || null,
        description: description || null,
      });

      return Astro.redirect(
        "/admin/lines",
      );
    } catch (err) {
      console.error(err);

      const message =
        err instanceof Error
          ? err.message.toLowerCase()
          : "";


      /* ========================================
         Duplicate Slug
      ======================================== */

      if (
        message.includes(
          "unique constraint failed",
        ) &&
        message.includes(
          "lines.slug",
        )
      ) {
        errors.slug =
          "A line with this slug already exists.";
      }


      /* ========================================
         Duplicate Code
      ======================================== */

      else if (
        message.includes(
          "unique constraint failed",
        ) &&
        message.includes(
          "lines.code",
        )
      ) {
        errors.code =
          "A line with this code already exists.";
      }


      /* ========================================
         Unexpected Database Error
      ======================================== */

      else {
        formError =
          "Unable to update line because of an unexpected database error.";
      }
    }
  }
}
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />

    <meta
      name="viewport"
      content="width=device-width, initial-scale=1.0"
    />

    <meta
      name="robots"
      content="noindex, nofollow"
    />

    <title>
      Edit Line | Admin | Tokyo Station Guide
    </title>
  </head>

  <body>
    <div class="admin-shell">

      <AdminNavigation
        activePath="/admin/lines"
      />

      <main class="admin-main">

        <!-- Topbar -->
        <header class="admin-topbar">

          <div class="admin-breadcrumb">

            <Button
              href="/admin/lines"
              variant="secondary"
            >
              ←
            </Button>

            <a href="/admin/lines">
              Lines
            </a>

            <span>/</span>

            <strong>
              Edit Line
            </strong>

          </div>

          <div class="admin-user">

            <div class="admin-avatar">
              {
                admin?.name
                  ? admin.name
                      .split(" ")
                      .map(
                        (part) =>
                          part.charAt(0),
                      )
                      .join("")
                      .slice(0, 2)
                      .toUpperCase()
                  : "AD"
              }
            </div>

            <div class="admin-user-info">

              <strong>
                {admin?.name ?? "Administrator"}
              </strong>

              <span>
                Tokyo Station Guide
              </span>

            </div>

          </div>

        </header>


        <!-- Content -->
        <div class="admin-content">

          {
            line ? (
              <>

                <!-- Page Header -->
                <div class="admin-page-header">

                  <div>

                    <h2>
                      Edit Line
                    </h2>

                    <p>
                      Update railway line
                      information for the Tokyo
                      Station Guide.
                    </p>

                  </div>

                </div>


                <!-- Form Panel -->
                <section class="admin-panel">

                  <div class="admin-panel-body">

                    <div class="admin-line-form">

                      <!-- Form Header -->
                      <div class="admin-line-form-header">

                        <h2>
                          Line Details
                        </h2>

                        <p>
                          Update the information for
                          this railway line.
                        </p>

                      </div>


                      <!-- General Error -->
                      {
                        formError && (
                          <div class="admin-alert admin-alert-error">
                            {formError}
                          </div>
                        )
                      }


                      <!-- Line Form -->
                      <form
                        method="POST"
                        class="admin-form"
                        id="edit-line-form"
                      >

                        <!-- Operator -->
                        <div class="admin-form-group">

                          <label for="operator_id">
                            Operator
                          </label>

                          <select
                            id="operator_id"
                            name="operator_id"
                            required
                            aria-invalid={
                              errors.operatorId
                                ? "true"
                                : "false"
                            }
                            aria-describedby={
                              errors.operatorId
                                ? "operator-id-error"
                                : undefined
                            }
                          >

                            <option value="">
                              Select operator
                            </option>

                            {
                              operators.map(
                                (operator) => (
                                  <option
                                    value={operator.id}
                                    selected={
                                      String(
                                        operator.id,
                                      ) === operatorId
                                    }
                                  >
                                    {operator.name}
                                  </option>
                                ),
                              )
                            }

                          </select>

                          {
                            errors.operatorId && (
                              <small
                                id="operator-id-error"
                                class="admin-form-error"
                              >
                                {errors.operatorId}
                              </small>
                            )
                          }

                        </div>


                        <!-- Name -->
                        <div class="admin-form-group">

                          <label for="name">
                            Name
                          </label>

                          <input
                            id="name"
                            name="name"
                            type="text"
                            required
                            maxlength="150"
                            value={name}
                            aria-invalid={
                              errors.name
                                ? "true"
                                : "false"
                            }
                            aria-describedby={
                              errors.name
                                ? "name-error"
                                : undefined
                            }
                          />

                          {
                            errors.name && (
                              <small
                                id="name-error"
                                class="admin-form-error"
                              >
                                {errors.name}
                              </small>
                            )
                          }

                        </div>


                        <!-- Slug -->
                        <div class="admin-form-group">

                          <label for="slug">
                            Slug
                          </label>

                          <input
                            id="slug"
                            name="slug"
                            type="text"
                            required
                            maxlength="150"
                            value={slug}
                            aria-invalid={
                              errors.slug
                                ? "true"
                                : "false"
                            }
                            aria-describedby={
                              errors.slug
                                ? "slug-error"
                                : undefined
                            }
                          />

                          {
                            errors.slug ? (
                              <small
                                id="slug-error"
                                class="admin-form-error"
                              >
                                {errors.slug}
                              </small>
                            ) : (
                              <small>
                                Use lowercase letters,
                                numbers and hyphens.
                              </small>
                            )
                          }

                        </div>


                        <!-- Code -->
                        <div class="admin-form-group">

                          <label for="code">
                            Code
                          </label>

                          <input
                            id="code"
                            name="code"
                            type="text"
                            maxlength="50"
                            value={code}
                            placeholder="JY"
                            aria-invalid={
                              errors.code
                                ? "true"
                                : "false"
                            }
                            aria-describedby={
                              errors.code
                                ? "code-error"
                                : undefined
                            }
                          />

                          {
                            errors.code && (
                              <small
                                id="code-error"
                                class="admin-form-error"
                              >
                                {errors.code}
                              </small>
                            )
                          }

                        </div>


                        <!-- Color -->
                        <div class="admin-form-group">

                          <label for="color">
                            Line Color
                          </label>

                          <input
                            id="color"
                            name="color"
                            type="text"
                            maxlength="7"
                            value={color}
                            placeholder="#00A650"
                            aria-invalid={
                              errors.color
                                ? "true"
                                : "false"
                            }
                            aria-describedby={
                              errors.color
                                ? "color-error"
                                : undefined
                            }
                          />

                          {
                            errors.color ? (
                              <small
                                id="color-error"
                                class="admin-form-error"
                              >
                                {errors.color}
                              </small>
                            ) : (
                              <small>
                                Use a hexadecimal color
                                such as #00A650.
                              </small>
                            )
                          }

                        </div>


                        <!-- Description -->
                        <div class="admin-form-group">

                          <label for="description">
                            Description
                          </label>

                          <textarea
                            id="description"
                            name="description"
                            rows="5"
                            maxlength="1000"
                            placeholder="Short description of the railway line..."
                            aria-invalid={
                              errors.description
                                ? "true"
                                : "false"
                            }
                            aria-describedby={
                              errors.description
                                ? "description-error"
                                : undefined
                            }
                          >{description}</textarea>

                          {
                            errors.description && (
                              <small
                                id="description-error"
                                class="admin-form-error"
                              >
                                {errors.description}
                              </small>
                            )
                          }

                        </div>


                        <!-- Actions -->
                        <div class="admin-form-actions">

                          <Button
                            href="/admin/lines"
                            variant="secondary"
                          >
                            Cancel
                          </Button>

                          <Button
                            type="submit"
                            variant="primary"
                            id="save-line-button"
                          >
                            Save Changes
                          </Button>

                        </div>

                      </form>

                    </div>

                  </div>

                </section>

              </>
            ) : (
              <>

                <!-- Not Found Header -->
                <div class="admin-page-header">

                  <div>

                    <h2>
                      Edit Line
                    </h2>

                    <p>
                      The requested line could
                      not be found.
                    </p>

                  </div>

                  <Button
                    href="/admin/lines"
                    variant="secondary"
                  >
                    ← Back to Lines
                  </Button>

                </div>


                <!-- Not Found Panel -->
                <section class="admin-panel">

                  <div class="admin-panel-body">

                    <div class="admin-empty">

                      <div class="admin-empty-icon">
                        ⚠
                      </div>

                      <h3>
                        Line Not Found
                      </h3>

                      <p>
                        The requested line does not
                        exist or may have been removed.
                      </p>

                      <div class="admin-form-actions admin-not-found-actions">

                        <Button
                          href="/admin/lines"
                          variant="secondary"
                        >
                          Back to Lines
                        </Button>

                      </div>

                    </div>

                  </div>

                </section>

              </>
            )
          }

        </div>

      </main>

    </div>


    {
      line && (
        <ConfirmDialog
          id="save-line-dialog"
          title="Save Changes"
          description="Are you sure you want to save these changes to this line?"
          confirmText="Save Changes"
          cancelText="Cancel"
          variant="primary"
        />
      )
    }


    <script>
      const editForm =
        document.getElementById(
          "edit-line-form",
        );

      const saveDialog =
        document.getElementById(
          "save-line-dialog",
        );

      const saveButton =
        document.getElementById(
          "save-line-button",
        );

      if (
        editForm instanceof HTMLFormElement &&
        saveDialog instanceof HTMLDivElement &&
        saveButton instanceof HTMLButtonElement
      ) {
        let confirmed = false;

        editForm.addEventListener(
          "submit",
          (event) => {
            if (confirmed) {
              return;
            }

            if (!editForm.checkValidity()) {
              return;
            }

            event.preventDefault();

            const nameInput =
              document.getElementById("name");

            const nameElement =
              saveDialog.querySelector(
                ".common-dialog-name",
              );

            if (
              nameInput instanceof HTMLInputElement &&
              nameElement instanceof HTMLElement
            ) {
              nameElement.textContent =
                nameInput.value.trim();
            }

            saveDialog.dispatchEvent(
              new CustomEvent("dialog:open"),
            );
          },
        );

        saveDialog.addEventListener(
          "confirm",
          () => {
            confirmed = true;

            editForm.submit();
          },
        );
      }
    </script>

  </body>
</html>