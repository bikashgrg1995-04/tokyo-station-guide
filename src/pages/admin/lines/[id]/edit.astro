---
import AdminLayout from "../../../../layouts/AdminLayout.astro";
import "../../../../styles/admin/forms.css";
import "../../../../styles/admin/lines.css";

import EmptyState from "../../../../components/common/EmptyState.astro";
import Alert from "../../../../components/common/Alert.astro";
import Breadcrumbs from "../../../../components/common/Breadcrumbs.astro";
import Button from "../../../../components/common/Button.astro";
import ConfirmDialog from "../../../../components/common/ConfirmDialog.astro";

import { getLineById } from "../../../../lib/db/lines";
import { getOperators } from "../../../../lib/db/operators";
import { handleLineUpdate } from "../../../../lib/services/lines";

export const prerender = false;

const { env } = await import("cloudflare:workers");

const db = env.DB;

const id = Number(Astro.params.id);

if (!Number.isInteger(id) || id <= 0) {
  return Astro.redirect("/admin/lines");
}

const line = await getLineById(db, id);

if (!line) {
  Astro.response.status = 404;
}

const operators = await getOperators(db);

const form = await handleLineUpdate(Astro.request, db, id, line, operators);

if (form.redirectTo) {
  return Astro.redirect(form.redirectTo);
}

const {
  operatorId,
  name,
  slug,
  code,
  color,
  description,
  nameJapanese,
  descriptionJapanese,
} = form.values;
const { errors, formError } = form;

const admin = await Astro.session?.get<{
  id: number;
  email: string;
  name: string;
}>("admin");
---

<AdminLayout title="Edit Line" activePath="/admin/lines">

        <!-- Topbar -->
        <header class="admin-topbar">

          <Breadcrumbs backHref="/admin/lines" parentLabel="Lines" current="Edit Line" />

          <div class="admin-user">

            <div class="admin-avatar">
              {
                admin?.name
                  ? admin.name
                      .split(" ")
                      .map(
                        (part) =>
                          part.charAt(0),
                      )
                      .join("")
                      .slice(0, 2)
                      .toUpperCase()
                  : "AD"
              }
            </div>

            <div class="admin-user-info">

              <strong>
                {admin?.name ?? "Administrator"}
              </strong>

              <span>
                Tokyo Station Guide
              </span>

            </div>

          </div>

        </header>


        <!-- Content -->
        <div class="admin-content">

          {
            line ? (
              <>

                <!-- Page Header -->
                <div class="admin-page-header">

                  <div>

                    <h2>
                      Edit Line
                    </h2>

                    <p>
                      Update railway line
                      information for the Tokyo
                      Station Guide.
                    </p>

                  </div>

                </div>


                <!-- Form Panel -->
                <section class="admin-panel">

                  <div class="admin-panel-body">

                    <div class="admin-line-form">

                      <!-- Form Header -->
                      <div class="admin-line-form-header">

                        <h2>
                          Line Details
                        </h2>

                        <p>
                          Update the information for
                          this railway line.
                        </p>

                      </div>


                      <!-- General Error -->
                      {
                        formError && (
                          <Alert>{formError}</Alert>
                        )
                      }


                      <!-- Line Form -->
                      <form
                        method="POST"
                        class="admin-form"
                        id="edit-line-form"
                      >

                        <!-- Operator -->
                        <div class="admin-form-group full-width">

                          <label for="operator_id">
                            Operator
                          </label>

                          <select
                            id="operator_id"
                            name="operator_id"
                            required
                            aria-invalid={
                              errors.operatorId
                                ? "true"
                                : "false"
                            }
                            aria-describedby={
                              errors.operatorId
                                ? "operator-id-error"
                                : undefined
                            }
                          >

                            <option value="">
                              Select operator
                            </option>

                            {
                              operators.map(
                                (operator) => (
                                  <option
                                    value={operator.id}
                                    selected={
                                      String(
                                        operator.id,
                                      ) === operatorId
                                    }
                                  >
                                    {operator.name}
                                  </option>
                                ),
                              )
                            }

                          </select>

                          {
                            errors.operatorId && (
                              <small
                                id="operator-id-error"
                                class="admin-form-error"
                              >
                                {errors.operatorId}
                              </small>
                            )
                          }

                        </div>


                        <!-- Name -->
                        <div class="admin-form-group">

                          <label for="name">
                            Name
                          </label>

                          <input
                            id="name"
                            name="name"
                            type="text"
                            required
                            maxlength="150"
                            value={name}
                            aria-invalid={
                              errors.name
                                ? "true"
                                : "false"
                            }
                            aria-describedby={
                              errors.name
                                ? "name-error"
                                : undefined
                            }
                          />

                          {
                            errors.name && (
                              <small
                                id="name-error"
                                class="admin-form-error"
                              >
                                {errors.name}
                              </small>
                            )
                          }

                        </div>


                        <!-- Japanese Name -->
                        <div class="admin-form-group">
                          <label for="name_japanese">Japanese Name</label>

                          <input
                            id="name_japanese"
                            name="name_japanese"
                            type="text"
                            lang="ja"
                            maxlength="150"
                            value={nameJapanese}
                            placeholder="山手線"
                            aria-invalid={errors.nameJapanese ? "true" : "false"}
                            aria-describedby={errors.nameJapanese ? "name_japanese-error" : undefined}
                          />

                          {
                            errors.nameJapanese && (
                              <small id="name_japanese-error" class="admin-form-error">
                                {errors.nameJapanese}
                              </small>
                            )
                          }
                        </div>

                        <!-- Slug -->
                        <div class="admin-form-group">

                          <label for="slug">
                            Slug
                          </label>

                          <input
                            id="slug"
                            name="slug"
                            type="text"
                            required
                            maxlength="150"
                            value={slug}
                            aria-invalid={
                              errors.slug
                                ? "true"
                                : "false"
                            }
                            aria-describedby={
                              errors.slug
                                ? "slug-error"
                                : undefined
                            }
                          />

                          {
                            errors.slug ? (
                              <small
                                id="slug-error"
                                class="admin-form-error"
                              >
                                {errors.slug}
                              </small>
                            ) : (
                              <small>
                                Use lowercase letters,
                                numbers and hyphens.
                              </small>
                            )
                          }

                        </div>


                        <!-- Code -->
                        <div class="admin-form-group">

                          <label for="code">
                            Code
                          </label>

                          <input
                            id="code"
                            name="code"
                            type="text"
                            maxlength="50"
                            value={code}
                            placeholder="JY"
                            aria-invalid={
                              errors.code
                                ? "true"
                                : "false"
                            }
                            aria-describedby={
                              errors.code
                                ? "code-error"
                                : undefined
                            }
                          />

                          {
                            errors.code && (
                              <small
                                id="code-error"
                                class="admin-form-error"
                              >
                                {errors.code}
                              </small>
                            )
                          }

                        </div>


                        <!-- Color -->
                        <div class="admin-form-group">

                          <label for="color">
                            Line Color
                          </label>

                          <input
                            id="color"
                            name="color"
                            type="text"
                            maxlength="7"
                            value={color}
                            placeholder="#00A650"
                            aria-invalid={
                              errors.color
                                ? "true"
                                : "false"
                            }
                            aria-describedby={
                              errors.color
                                ? "color-error"
                                : undefined
                            }
                          />

                          {
                            errors.color ? (
                              <small
                                id="color-error"
                                class="admin-form-error"
                              >
                                {errors.color}
                              </small>
                            ) : (
                              <small>
                                Use a hexadecimal color
                                such as #00A650.
                              </small>
                            )
                          }

                        </div>


                        <!-- Description -->
                        <div class="admin-form-group">

                          <label for="description">
                            Description
                          </label>

                          <textarea
                            id="description"
                            name="description"
                            rows="5"
                            maxlength="1000"
                            placeholder="Short description of the railway line..."
                            aria-invalid={
                              errors.description
                                ? "true"
                                : "false"
                            }
                            aria-describedby={
                              errors.description
                                ? "description-error"
                                : undefined
                            }
                          >{description}</textarea>

                          {
                            errors.description && (
                              <small
                                id="description-error"
                                class="admin-form-error"
                              >
                                {errors.description}
                              </small>
                            )
                          }

                        </div>


                        <!-- Japanese Description -->
                        <div class="admin-form-group">
                          <label for="description_japanese">Japanese Description</label>

                          <textarea
                            id="description_japanese"
                            name="description_japanese"
                            lang="ja"
                            rows="5"
                            maxlength="1000"
                            placeholder="路線の簡単な説明…"
                            aria-invalid={errors.descriptionJapanese ? "true" : "false"}
                            aria-describedby={errors.descriptionJapanese ? "description_japanese-error" : undefined}>{descriptionJapanese}</textarea
                          >

                          {
                            errors.descriptionJapanese && (
                              <small id="description_japanese-error" class="admin-form-error">
                                {errors.descriptionJapanese}
                              </small>
                            )
                          }
                        </div>

                        <!-- Actions -->
                        <div class="admin-form-actions">

                          <Button
                            href="/admin/lines"
                            variant="secondary"
                          >
                            Cancel
                          </Button>

                          <Button
                            type="submit"
                            variant="primary"
                            id="save-line-button"
                          >
                            Save Changes
                          </Button>

                        </div>

                      </form>

                    </div>

                  </div>

                </section>

              </>
            ) : (
              <>

                <!-- Not Found Header -->
                <div class="admin-page-header">

                  <div>

                    <h2>
                      Edit Line
                    </h2>

                    <p>
                      The requested line could
                      not be found.
                    </p>

                  </div>

                  <Button
                    href="/admin/lines"
                    variant="secondary"
                  >
                    ← Back to Lines
                  </Button>

                </div>


                <!-- Not Found Panel -->
                <section class="admin-panel">

                  <div class="admin-panel-body">

                    <EmptyState
                      icon="⚠"
                      title="Line Not Found"
                      description="The requested line does not exist or may have been removed."
                    >
                      <div class="admin-form-actions admin-not-found-actions">

                        <Button
                          href="/admin/lines"
                          variant="secondary"
                        >
                          Back to Lines
                        </Button>

                      </div>
                    </EmptyState>

                  </div>

                </section>

              </>
            )
          }

        </div>

  <Fragment slot="after">
    {
      line && (
        <ConfirmDialog
          id="save-line-dialog"
          title="Save Changes"
          description="Are you sure you want to save these changes to this line?"
          confirmText="Save Changes"
          cancelText="Cancel"
          variant="primary"
        />
      )
    }


    <script>
      import "../../../../scripts/admin/lines-edit.ts";
    </script>

  
  </Fragment>
</AdminLayout>
