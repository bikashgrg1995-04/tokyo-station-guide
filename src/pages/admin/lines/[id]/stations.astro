---
import "../../../../styles/admin/shared.css";
import "../../../../styles/admin/forms.css";
import "../../../../styles/admin/lines.css";
import "../../../../styles/admin/tables.css";

import AdminNavigation from "../../../../common_components/AdminNavigation.astro";
import Button from "../../../../common_components/Button.astro";
import ConfirmDialog from "../../../../common_components/ConfirmDialog.astro";

import { getLineById } from "../../../../lib/db/lines";

import {
  getStationsForLine,
  getAvailableStationsForLine,
  addStationToLine,
  updateLineStation,
  removeStationFromLine,
} from "../../../../lib/db/line-stations";

export const prerender = false;

const { env } = await import("cloudflare:workers");

const db = env.DB;

const lineId = Number(Astro.params.id);

if (!Number.isInteger(lineId) || lineId <= 0) {
  return Astro.redirect("/admin/lines");
}

const line = await getLineById(db, lineId);

if (!line) {
  return Astro.redirect("/admin/lines");
}

let error = "";

/* ========================================
   Form Submission
======================================== */

if (Astro.request.method === "POST") {
  const formData =
    await Astro.request.formData();

  const action =
    String(formData.get("action") ?? "");

  try {
    /* ========================================
       Add Station
    ======================================== */

    if (action === "add") {
      const stationId = Number(
        formData.get("station_id") ?? 0,
      );

      const stationOrder = Number(
        formData.get("station_order") ?? 0,
      );

      const stationCode = String(
        formData.get("station_code") ?? "",
      ).trim();

      if (!Number.isInteger(stationId) || stationId <= 0) {
        error = "Please select a station.";
      } else if (
        !Number.isInteger(stationOrder) ||
        stationOrder <= 0
      ) {
        error =
          "Station order must be a positive whole number.";
      } else if (stationCode.length > 50) {
        error =
          "Station code must be 50 characters or less.";
      } else {
        await addStationToLine(
          db,
          lineId,
          stationId,
          stationOrder,
          stationCode || null,
        );

        return Astro.redirect(
          `/admin/lines/${lineId}/stations`,
        );
      }
    }


    /* ========================================
       Update Station
    ======================================== */

    else if (action === "update") {
      const id = Number(
        formData.get("id") ?? 0,
      );

      const stationOrder = Number(
        formData.get("station_order") ?? 0,
      );

      const stationCode = String(
        formData.get("station_code") ?? "",
      ).trim();

      if (!Number.isInteger(id) || id <= 0) {
        error = "Invalid line station.";
      } else if (
        !Number.isInteger(stationOrder) ||
        stationOrder <= 0
      ) {
        error =
          "Station order must be a positive whole number.";
      } else if (stationCode.length > 50) {
        error =
          "Station code must be 50 characters or less.";
      } else {
        await updateLineStation(
          db,
          id,
          stationOrder,
          stationCode || null,
        );

        return Astro.redirect(
          `/admin/lines/${lineId}/stations`,
        );
      }
    }


    /* ========================================
       Remove Station
    ======================================== */

    else if (action === "remove") {
      const id = Number(
        formData.get("id") ?? 0,
      );

      if (!Number.isInteger(id) || id <= 0) {
        error = "Invalid station.";
      } else {
        await removeStationFromLine(
          db,
          id,
        );

        return Astro.redirect(
          `/admin/lines/${lineId}/stations`,
        );
      }
    }
  } catch (err) {
    console.error(err);

    const message =
      err instanceof Error
        ? err.message.toLowerCase()
        : "";

    if (
      message.includes("unique") ||
      message.includes("constraint")
    ) {
      error =
        "Unable to update this line's stations. The station order may already be in use, or the station may already be connected to this line.";
    } else {
      error =
        "Unable to update this line's stations because of an unexpected database error.";
    }
  }
}

const stations =
  await getStationsForLine(
    db,
    lineId,
  );

const availableStations =
  await getAvailableStationsForLine(
    db,
    lineId,
  );

const admin = await Astro.session?.get<{
  id: number;
  email: string;
  name: string;
}>("admin");
---

<!doctype html>
<html lang="en">

  <head>
    <meta charset="UTF-8" />

    <meta
      name="viewport"
      content="width=device-width, initial-scale=1.0"
    />

    <meta
      name="robots"
      content="noindex, nofollow"
    />

    <title>
      {line.name} Stations | Admin | Tokyo Station Guide
    </title>
  </head>


  <body>

    <div class="admin-shell">

      <!-- Sidebar -->
      <AdminNavigation
        activePath="/admin/lines"
      />


      <!-- Main -->
      <main class="admin-main">

        <!-- Topbar -->
        <header class="admin-topbar">

          <div class="admin-breadcrumb">

            <Button
              href="/admin/lines"
              variant="secondary"
            >
              ←
            </Button>

            <a href="/admin/lines">
              Lines
            </a>

            <span>/</span>

            <strong>
              {line.name}
            </strong>

          </div>


          <div class="admin-user">

            <div class="admin-avatar">
              {
                admin?.name
                  ? admin.name
                      .split(" ")
                      .map(
                        (part) =>
                          part.charAt(0),
                      )
                      .join("")
                      .slice(0, 2)
                      .toUpperCase()
                  : "AD"
              }
            </div>

            <div class="admin-user-info">

              <strong>
                {admin?.name ?? "Administrator"}
              </strong>

              <span>
                Tokyo Station Guide
              </span>

            </div>

          </div>

        </header>


        <!-- Content -->
        <div class="admin-content">

          <section class="admin-lines-page">


            <!-- Page Header -->
            <div class="admin-page-header">

              <div>

                <h2>
                  {line.name} Stations
                </h2>

                <p>
                  Manage the stations and their
                  order on this railway line.
                </p>

              </div>

              <Button
                href="/admin/lines"
                variant="secondary"
              >
                ← Back to Lines
              </Button>

            </div>


            <!-- Error -->
            {
              error && (
                <div class="admin-alert admin-alert-error">
                  {error}
                </div>
              )
            }


            <!-- Add Station -->
            <section class="admin-panel">

              <div class="admin-panel-body">

                <div class="admin-line-form">

                  <div class="admin-line-form-header">

                    <h2>
                      Add Station
                    </h2>

                    <p>
                      Add an existing station to
                      {line.name}.
                    </p>

                  </div>


                  {
                    availableStations.length > 0 ? (
                      <form
                        method="POST"
                        class="admin-form"
                        id="add-station-form"
                      >

                        <input
                          type="hidden"
                          name="action"
                          value="add"
                        />


                        <!-- Station -->
                        <div class="admin-form-group">

                          <label for="station_id">
                            Station
                          </label>

                          <select
                            id="station_id"
                            name="station_id"
                            required
                          >

                            <option value="">
                              Select station
                            </option>

                            {
                              availableStations.map(
                                (station) => (
                                  <option
                                    value={station.id}
                                  >
                                    {station.name}

                                    {
                                      station.name_japanese
                                        ? ` — ${station.name_japanese}`
                                        : ""
                                    }
                                  </option>
                                ),
                              )
                            }

                          </select>

                        </div>


                        <!-- Station Order -->
                        <div class="admin-form-group">

                          <label for="station_order">
                            Station Order
                          </label>

                          <input
                            id="station_order"
                            name="station_order"
                            type="number"
                            min="1"
                            step="1"
                            value={
                              stations.length + 1
                            }
                            required
                          />

                          <small>
                            Determines the station
                            order on this line.
                          </small>

                        </div>


                        <!-- Station Code -->
                        <div class="admin-form-group">

                          <label for="station_code">
                            Station Code
                          </label>

                          <input
                            id="station_code"
                            name="station_code"
                            type="text"
                            maxlength="50"
                            placeholder="e.g. JY01"
                          />

                          <small>
                            Optional line-specific
                            station code.
                          </small>

                        </div>


                        <!-- Actions -->
                        <div class="admin-form-actions">

                          <Button
                            href="/admin/lines"
                            variant="secondary"
                          >
                            Cancel
                          </Button>

                          <Button
                            type="submit"
                            variant="primary"
                            id="add-station-button"
                          >
                            Add Station
                          </Button>

                        </div>

                      </form>
                    ) : (
                      <div class="admin-empty">

                        <div class="admin-empty-icon">
                          ◎
                        </div>

                        <h3>
                          No Available Stations
                        </h3>

                        <p>
                          Create a station first, or
                          all existing stations are
                          already connected to this line.
                        </p>

                        <div class="admin-form-actions admin-not-found-actions">

                          <Button
                            href="/admin/stations/new"
                            variant="secondary"
                          >
                            Create Station
                          </Button>

                        </div>

                      </div>
                    )
                  }

                </div>

              </div>

            </section>


            <!-- Current Stations -->
            <section class="admin-panel">

              <div class="admin-panel-header">

                <div>

                  <h3>
                    Stations on {line.name}
                  </h3>

                  <p>
                    {stations.length} station
                    {stations.length === 1
                      ? ""
                      : "s"}
                  </p>

                </div>

              </div>


              {
                stations.length > 0 ? (
                  <div class="admin-table-panel-body">

                    <div class="admin-table-wrapper">

                      <table class="admin-table">

                        <thead>

                          <tr>
                            <th>Order</th>
                            <th>Station</th>
                            <th>Japanese</th>
                            <th>Code</th>
                            <th>Actions</th>
                          </tr>

                        </thead>


                        <tbody>

                          {
                            stations.map(
                              (station) => {
                                const formId =
                                  `station-edit-${station.id}`;

                                return (
                                  <tr>

                                    <!-- Order -->
                                    <td>

                                      <input
                                        type="number"
                                        name="station_order"
                                        form={formId}
                                        min="1"
                                        step="1"
                                        value={
                                          station.station_order
                                        }
                                        class="admin-line-station-order-input"
                                        required
                                      />

                                    </td>


                                    <!-- Station -->
                                    <td>

                                      <div class="admin-line-name">
                                        {station.station_name}
                                      </div>

                                      <div class="admin-line-slug">
                                        {station.station_slug}
                                      </div>

                                    </td>


                                    <!-- Japanese -->
                                    <td>

                                      {
                                        station.station_name_japanese ??
                                        "—"
                                      }

                                    </td>


                                    <!-- Code -->
                                    <td>

                                      <input
                                        type="text"
                                        name="station_code"
                                        form={formId}
                                        maxlength="50"
                                        value={
                                          station.station_code ??
                                          ""
                                        }
                                        class="admin-line-station-code-input"
                                        placeholder="e.g. JY01"
                                      />

                                    </td>


                                    <!-- Actions -->
                                    <td>

                                      <div class="admin-table-actions">

                                        <form
                                          id={formId}
                                          method="POST"
                                          data-station-action="save"
                                          data-station-name={
                                            station.station_name
                                          }
                                        >

                                          <input
                                            type="hidden"
                                            name="action"
                                            value="update"
                                          />

                                          <input
                                            type="hidden"
                                            name="id"
                                            value={station.id}
                                          />

                                          <Button
                                            type="submit"
                                            variant="primary"
                                            size="small"
                                          >
                                            Save
                                          </Button>

                                        </form>


                                        <form
                                          method="POST"
                                          data-station-action="remove"
                                          data-station-name={
                                            station.station_name
                                          }
                                        >

                                          <input
                                            type="hidden"
                                            name="action"
                                            value="remove"
                                          />

                                          <input
                                            type="hidden"
                                            name="id"
                                            value={station.id}
                                          />

                                          <Button
                                            type="submit"
                                            variant="danger"
                                            size="small"
                                          >
                                            Remove
                                          </Button>

                                        </form>

                                      </div>

                                    </td>

                                  </tr>
                                );
                              },
                            )
                          }

                        </tbody>

                      </table>

                    </div>

                  </div>
                ) : (
                  <div class="admin-empty">

                    <div class="admin-empty-icon">
                      ◎
                    </div>

                    <h3>
                      No Stations on This Line
                    </h3>

                    <p>
                      Add the first station using
                      the form above.
                    </p>

                  </div>
                )
              }

            </section>

          </section>

        </div>

      </main>

    </div>


    <!-- Add Confirmation -->
    {
      availableStations.length > 0 && (
        <ConfirmDialog
          id="add-station-dialog"
          title="Add Station"
          description="Are you sure you want to add this station to the line?"
          confirmText="Add Station"
          cancelText="Cancel"
          variant="primary"
        />
      )
    }


    <!-- Save Confirmation -->
    {
      stations.length > 0 && (
        <ConfirmDialog
          id="save-station-dialog"
          title="Save Changes"
          description="Are you sure you want to save these changes to this station?"
          confirmText="Save Changes"
          cancelText="Cancel"
          variant="primary"
        />
      )
    }


    <!-- Remove Confirmation -->
    {
      stations.length > 0 && (
        <ConfirmDialog
          id="remove-station-dialog"
          title="Remove Station"
          description="Are you sure you want to remove this station from the line?"
          confirmText="Remove Station"
          cancelText="Cancel"
          variant="danger"
        />
      )
    }


    <script>
      const addForm =
        document.getElementById(
          "add-station-form",
        );

      const addDialog =
        document.getElementById(
          "add-station-dialog",
        );

      const addButton =
        document.getElementById(
          "add-station-button",
        );


      if (
        addForm instanceof HTMLFormElement &&
        addDialog instanceof HTMLDivElement &&
        addButton instanceof HTMLButtonElement
      ) {
        let confirmed = false;

        addForm.addEventListener(
          "submit",
          (event) => {
            if (confirmed) {
              return;
            }

            if (!addForm.checkValidity()) {
              return;
            }

            event.preventDefault();

            addDialog.dispatchEvent(
              new CustomEvent("dialog:open"),
            );
          },
        );

        addDialog.addEventListener(
          "confirm",
          () => {
            confirmed = true;

            addForm.submit();
          },
        );
      }


      /* ========================================
         Station Save / Remove Confirmation
      ======================================== */

      const saveDialog =
        document.getElementById(
          "save-station-dialog",
        );

      const removeDialog =
        document.getElementById(
          "remove-station-dialog",
        );

      let pendingForm:
        | HTMLFormElement
        | null = null;

      let pendingAction:
        | "save"
        | "remove"
        | null = null;


      const openStationDialog = (
        form: HTMLFormElement,
        action: "save" | "remove",
      ) => {
        pendingForm = form;
        pendingAction = action;

        const stationName =
          form.dataset.stationName ??
          "this station";

        const dialog =
          action === "save"
            ? saveDialog
            : removeDialog;

        if (!(dialog instanceof HTMLDivElement)) {
          return;
        }

        const nameElement =
          dialog.querySelector(
            ".common-dialog-name",
          );

        if (
          nameElement instanceof HTMLElement
        ) {
          nameElement.textContent =
            stationName;
        }

        dialog.dispatchEvent(
          new CustomEvent("dialog:open"),
        );
      };


      document
        .querySelectorAll<HTMLFormElement>(
          'form[data-station-action="save"]',
        )
        .forEach((form) => {
          form.addEventListener(
            "submit",
            (event) => {
              event.preventDefault();

              if (!form.checkValidity()) {
                return;
              }

              openStationDialog(
                form,
                "save",
              );
            },
          );
        });


      document
        .querySelectorAll<HTMLFormElement>(
          'form[data-station-action="remove"]',
        )
        .forEach((form) => {
          form.addEventListener(
            "submit",
            (event) => {
              event.preventDefault();

              openStationDialog(
                form,
                "remove",
              );
            },
          );
        });


      if (
        saveDialog instanceof HTMLDivElement
      ) {
        saveDialog.addEventListener(
          "confirm",
          () => {
            if (
              pendingAction !== "save" ||
              !pendingForm
            ) {
              return;
            }

            const form = pendingForm;

            pendingForm = null;
            pendingAction = null;

            form.submit();
          },
        );
      }


      if (
        removeDialog instanceof HTMLDivElement
      ) {
        removeDialog.addEventListener(
          "confirm",
          () => {
            if (
              pendingAction !== "remove" ||
              !pendingForm
            ) {
              return;
            }

            const form = pendingForm;

            pendingForm = null;
            pendingAction = null;

            form.submit();
          },
        );
      }
    </script>

  </body>

</html>