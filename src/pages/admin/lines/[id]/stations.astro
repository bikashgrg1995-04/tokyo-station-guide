---
import "../../../../styles/admin/shared.css";
import "../../../../styles/admin/forms.css";
import "../../../../styles/admin/lines.css";
import "../../../../styles/admin/tables.css";

import AdminNavigation from "../../../../common_components/AdminNavigation.astro";
import Button from "../../../../common_components/Button.astro";
import SearchInput from "../../../../common_components/SearchInput.astro";
import ConfirmDialog from "../../../../common_components/ConfirmDialog.astro";

import { getLineById } from "../../../../lib/db/lines";

import {
  getStationsForLine,
  getAvailableStationsForLine,
  addStationToLine,
  updateLineStation,
  removeStationFromLine,
} from "../../../../lib/db/line-stations";

export const prerender = false;

const { env } = await import("cloudflare:workers");
const db = env.DB;

const lineId = Number(Astro.params.id);

if (!Number.isInteger(lineId) || lineId <= 0) {
  return Astro.redirect("/admin/lines");
}

const line = await getLineById(db, lineId);

if (!line) {
  return Astro.redirect("/admin/lines");
}

let error = "";

const searchParam =
  String(Astro.url.searchParams.get("search") ?? "").trim();

/* ========================================
   Form Submission
======================================== */

if (Astro.request.method === "POST") {
  const formData = await Astro.request.formData();

  const action = String(
    formData.get("action") ?? "",
  );

  try {
    /* ========================================
       Add Station
    ======================================== */

    if (action === "add") {
      const stationId = Number(
        formData.get("station_id") ?? 0,
      );

      const stationOrder = Number(
        formData.get("station_order") ?? 0,
      );

      const stationCode = String(
        formData.get("station_code") ?? "",
      ).trim();

      if (
        !Number.isInteger(stationId) ||
        stationId <= 0
      ) {
        error = "Please select a station.";
      } else if (
        !Number.isInteger(stationOrder) ||
        stationOrder <= 0
      ) {
        error =
          "Station order must be a positive whole number.";
      } else if (stationCode.length > 50) {
        error =
          "Station code must be 50 characters or less.";
      } else {
        await addStationToLine(
          db,
          lineId,
          stationId,
          stationOrder,
          stationCode || null,
        );

        return Astro.redirect(
          `/admin/lines/${lineId}/stations`,
        );
      }
    }

    /* ========================================
       Update Station
    ======================================== */

    else if (action === "update") {
      const id = Number(
        formData.get("id") ?? 0,
      );

      const stationOrder = Number(
        formData.get("station_order") ?? 0,
      );

      const stationCode = String(
        formData.get("station_code") ?? "",
      ).trim();

      if (!Number.isInteger(id) || id <= 0) {
        error = "Invalid line station.";
      } else if (
        !Number.isInteger(stationOrder) ||
        stationOrder <= 0
      ) {
        error =
          "Station order must be a positive whole number.";
      } else if (stationCode.length > 50) {
        error =
          "Station code must be 50 characters or less.";
      } else {
        await updateLineStation(
          db,
          id,
          stationOrder,
          stationCode || null,
        );

        return Astro.redirect(
          `/admin/lines/${lineId}/stations`,
        );
      }
    }

    /* ========================================
       Remove Station
    ======================================== */

    else if (action === "remove") {
      const id = Number(
        formData.get("id") ?? 0,
      );

      if (!Number.isInteger(id) || id <= 0) {
        error = "Invalid station.";
      } else {
        await removeStationFromLine(
          db,
          id,
        );

        return Astro.redirect(
          `/admin/lines/${lineId}/stations`,
        );
      }
    }
  } catch (err) {
    console.error(err);

    const message =
      err instanceof Error
        ? err.message.toLowerCase()
        : "";

    if (
      message.includes("unique") ||
      message.includes("constraint")
    ) {
      error =
        "Unable to update this line's stations. The station order may already be in use, or the station may already be connected to this line.";
    } else {
      error =
        "Unable to update this line's stations because of an unexpected database error.";
    }
  }
}

/* ========================================
   Data
======================================== */

const stations = await getStationsForLine(
  db,
  lineId,
  searchParam,
);

const availableStations =
  await getAvailableStationsForLine(
    db,
    lineId,
  );

const admin = await Astro.session?.get<{
  id: number;
  email: string;
  name: string;
}>("admin");
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />

    <meta
      name="viewport"
      content="width=device-width, initial-scale=1.0"
    />

    <meta
      name="robots"
      content="noindex, nofollow"
    />

    <title>
      {line.name} Stations | Admin | Tokyo Station Guide
    </title>
  </head>

  <body>
    <div class="admin-shell">

      <!-- ========================================
           Sidebar
      ========================================= -->

      <AdminNavigation
        activePath="/admin/lines"
      />


      <!-- ========================================
           Main
      ========================================= -->

      <main class="admin-main">

        <!-- ======================================
             Topbar
        ======================================= -->

        <header class="admin-topbar">

          <div class="admin-breadcrumb">

            <Button
              href="/admin/lines"
              variant="secondary"
              ariaLabel="Back to lines"
            >
              ←
            </Button>

            <a href="/admin/lines">
              Lines
            </a>

            <span>/</span>

            <strong>
              {line.name}
            </strong>

          </div>

        </header>


        <!-- ======================================
             Content
        ======================================= -->

        <div class="admin-content">

          <section class="admin-lines-page">


            <!-- ==================================
                 Page Header
            =================================== -->

            <div class="admin-page-header">

              <div>

                <h2>
                  {line.name}
                </h2>

                <p>
                  Manage the stations connected to
                  this railway line and control their
                  display order.
                </p>

              </div>

            </div>


            <!-- ==================================
                 Error
            =================================== -->

            {
              error && (
                <div class="admin-alert admin-alert-error">
                  {error}
                </div>
              )
            }


            <!-- ==================================
                 Toolbar
            =================================== -->

            <div class="admin-list-toolbar">

              <form
                method="GET"
                id="line-station-search-form"
                class="admin-search-form"
                action={`/admin/lines/${lineId}/stations`}
                role="search"
              >

                <SearchInput
                  id="line-station-search"
                  name="search"
                  value={searchParam}
                  placeholder="Search stations..."
                  ariaLabel="Search stations"
                  form="line-station-search-form"
                />

              </form>


              <Button
                type="button"
                variant="primary"
                id="open-add-station-button"
              >
                + Add Station
              </Button>

            </div>


            <!-- ==================================
                 Stations Content

                 IMPORTANT:
                 Search replaces only this section.
                 Toolbar stays outside.
            =================================== -->

            <section
              id="line-stations-content"
              aria-busy="false"
            >

              <section class="admin-panel">


                <!-- ==================================
                     Panel Header
                =================================== -->

                <div class="admin-panel-header">

                  <div>

                    <h3>
                      Stations on {line.name}
                    </h3>

                    <p>
                      {stations.length}
                      {searchParam
                        ? " matching "
                        : " "}
                      station
                      {stations.length === 1
                        ? ""
                        : "s"}
                    </p>

                  </div>

                </div>


                <!-- ==================================
                     Table
                =================================== -->

                <div class="admin-table-panel-body">

                  {
                    stations.length > 0 ? (
                      <div class="admin-table-wrapper">

                        <table class="admin-table">

                          <thead>

                            <tr>
                              <th>#</th>
                              <th>Station</th>
                              <th>Japanese</th>
                              <th>Code</th>
                              <th>Actions</th>
                            </tr>

                          </thead>


                          <tbody>

                            {
                              stations.map(
                                (station) => (
                                  <tr>

                                    <!-- Order -->

                                    <td>

                                      <span
                                        class="admin-line-code"
                                        aria-label={`Station order ${station.station_order}`}
                                      >
                                        {String(
                                          station.station_order,
                                        ).padStart(2, "0")}
                                      </span>

                                    </td>


                                    <!-- Station -->

                                    <td>

                                      <div class="admin-line-name">
                                        {station.station_name}
                                      </div>

                                      <div class="admin-line-slug">
                                        {station.station_slug}
                                      </div>

                                    </td>


                                    <!-- Japanese -->

                                    <td>

                                      <span>
                                        {
                                          station.station_name_japanese ??
                                          "—"
                                        }
                                      </span>

                                    </td>


                                    <!-- Code -->

                                    <td>

                                      {
                                        station.station_code ? (
                                          <span class="admin-line-operator">
                                            {station.station_code}
                                          </span>
                                        ) : (
                                          <span>
                                            —
                                          </span>
                                        )
                                      }

                                    </td>


                                    <!-- Actions -->

                                    <td>

                                      <div class="admin-table-actions">

                                        <!--
                                          Native button intentionally used
                                          here because Button.astro does not
                                          forward arbitrary data-* attributes.
                                        -->

                                        <button
                                          type="button"
                                          class="admin-table-action admin-table-action-edit"
                                          data-edit-station
                                          data-id={station.id}
                                          data-station-name={
                                            station.station_name
                                          }
                                          data-station-order={
                                            station.station_order
                                          }
                                          data-station-code={
                                            station.station_code ?? ""
                                          }
                                        >
                                          Edit
                                        </button>


                                        <form
                                          method="POST"
                                          data-station-remove
                                          data-station-name={
                                            station.station_name
                                          }
                                        >

                                          <input
                                            type="hidden"
                                            name="action"
                                            value="remove"
                                          />

                                          <input
                                            type="hidden"
                                            name="id"
                                            value={station.id}
                                          />

                                          <button
                                            type="submit"
                                            class="admin-table-action admin-table-action-delete"
                                          >
                                            Remove
                                          </button>

                                        </form>

                                      </div>

                                    </td>

                                  </tr>
                                ),
                              )
                            }

                          </tbody>

                        </table>

                      </div>
                    ) : (
                      <div class="admin-empty">

                        <div class="admin-empty-icon">
                          ◎
                        </div>

                        <h3>
                          {
                            searchParam
                              ? "No Matching Stations"
                              : "No Stations on This Line"
                          }
                        </h3>

                        <p>
                          {
                            searchParam
                              ? "Try another station name, Japanese name, slug, or station code."
                              : "There are currently no stations connected to this railway line."
                          }
                        </p>

                        {
                          !searchParam &&
                          availableStations.length > 0 && (
                            <div class="admin-not-found-actions">

                              <Button
                                type="button"
                                variant="primary"
                                id="open-add-station-button-empty"
                              >
                                + Add Station
                              </Button>

                            </div>
                          )
                        }

                      </div>
                    )
                  }

                </div>

              </section>

            </section>

          </section>

        </div>

      </main>

    </div>


    <!-- ========================================
         Add Station Modal
    ========================================= -->

    <div
      id="add-station-modal"
      class="admin-line-station-modal"
      hidden
      aria-hidden="true"
    >

      <div
        class="admin-line-station-modal-backdrop"
        data-close-add-modal
      ></div>


      <div
        class="admin-line-station-modal-dialog"
        role="dialog"
        aria-modal="true"
        aria-labelledby="add-station-modal-title"
        aria-describedby="add-station-modal-description"
      >

        <div class="admin-line-station-modal-header">

          <div>

            <h2 id="add-station-modal-title">
              Add Station
            </h2>

            <p id="add-station-modal-description">
              Add an existing station to
              {line.name}.
            </p>

          </div>


          <button
            type="button"
            class="admin-line-station-modal-close"
            id="close-add-station-modal"
            aria-label="Close add station dialog"
          >
            ×
          </button>

        </div>


        {
          availableStations.length > 0 ? (
            <form
              method="POST"
              class="admin-form"
              id="add-station-form"
            >

              <input
                type="hidden"
                name="action"
                value="add"
              />


              <!-- Station -->

              <div class="admin-form-group">

                <label for="add-station-id">
                  Station
                </label>

                <select
                  id="add-station-id"
                  name="station_id"
                  required
                >

                  <option value="">
                    Select station
                  </option>

                  {
                    availableStations.map(
                      (station) => (
                        <option value={station.id}>
                          {station.name}
                          {
                            station.name_japanese
                              ? ` — ${station.name_japanese}`
                              : ""
                          }
                        </option>
                      ),
                    )
                  }

                </select>

              </div>


              <!-- Station Order -->

              <div class="admin-form-group">

                <label for="add-station-order">
                  Station Order
                </label>

                <input
                  id="add-station-order"
                  name="station_order"
                  type="number"
                  min="1"
                  step="1"
                  value={stations.length + 1}
                  required
                />

                <small>
                  The position of this station on
                  the line.
                </small>

              </div>


              <!-- Station Code -->

              <div class="admin-form-group">

                <label for="add-station-code">
                  Station Code
                </label>

                <input
                  id="add-station-code"
                  name="station_code"
                  type="text"
                  maxlength="50"
                  placeholder="e.g. JY01"
                />

                <small>
                  Optional line-specific station code.
                </small>

              </div>


              <!-- Actions -->

              <div class="admin-form-actions">

                <Button
                  type="button"
                  variant="secondary"
                  id="cancel-add-station"
                >
                  Cancel
                </Button>

                <Button
                  type="submit"
                  variant="primary"
                >
                  Add Station
                </Button>

              </div>

            </form>
          ) : (
            <div class="admin-empty">

              <div class="admin-empty-icon">
                ◎
              </div>

              <h3>
                No Available Stations
              </h3>

              <p>
                All existing stations are already
                connected to this line, or no
                stations have been created yet.
              </p>

              <div class="admin-not-found-actions">

                <Button
                  href="/admin/stations/new"
                  variant="secondary"
                >
                  Create Station
                </Button>

              </div>

            </div>
          )
        }

      </div>

    </div>


    <!-- ========================================
         Edit Station Modal
    ========================================= -->

    <div
      id="edit-station-modal"
      class="admin-line-station-modal"
      hidden
      aria-hidden="true"
    >

      <div
        class="admin-line-station-modal-backdrop"
        data-close-edit-modal
      ></div>


      <div
        class="admin-line-station-modal-dialog"
        role="dialog"
        aria-modal="true"
        aria-labelledby="edit-station-modal-title"
        aria-describedby="edit-station-modal-description"
      >

        <div class="admin-line-station-modal-header">

          <div>

            <h2 id="edit-station-modal-title">
              Edit Station
            </h2>

            <p id="edit-station-modal-description">
              Update the station order and
              line-specific code.
            </p>

          </div>


          <button
            type="button"
            class="admin-line-station-modal-close"
            id="close-edit-station-modal"
            aria-label="Close edit station dialog"
          >
            ×
          </button>

        </div>


        <form
          method="POST"
          class="admin-form"
          id="edit-station-form"
        >

          <input
            type="hidden"
            name="action"
            value="update"
          />

          <input
            type="hidden"
            name="id"
            id="edit-station-id"
          />


          <!-- Station -->

          <div class="admin-form-group">

            <label>
              Station
            </label>

            <div
              class="admin-line-station-modal-station-name"
              id="edit-station-name"
            >
              —
            </div>

          </div>


          <!-- Station Order -->

          <div class="admin-form-group">

            <label for="edit-station-order">
              Station Order
            </label>

            <input
              id="edit-station-order"
              name="station_order"
              type="number"
              min="1"
              step="1"
              required
            />

            <small>
              Changing this may affect the station's
              position on the line.
            </small>

          </div>


          <!-- Station Code -->

          <div class="admin-form-group">

            <label for="edit-station-code">
              Station Code
            </label>

            <input
              id="edit-station-code"
              name="station_code"
              type="text"
              maxlength="50"
              placeholder="e.g. JY01"
            />

            <small>
              Optional line-specific station code.
            </small>

          </div>


          <!-- Actions -->

          <div class="admin-form-actions">

            <Button
              type="button"
              variant="secondary"
              id="cancel-edit-station"
            >
              Cancel
            </Button>

            <Button
              type="submit"
              variant="primary"
            >
              Save Changes
            </Button>

          </div>

        </form>

      </div>

    </div>


    <!-- ========================================
         Remove Confirmation
    ========================================= -->

    <ConfirmDialog
      id="remove-station-dialog"
      title="Remove Station"
      description="Are you sure you want to remove this station from the line?"
      confirmText="Remove Station"
      cancelText="Cancel"
      variant="danger"
    />


    <!-- ========================================
         Scripts
    ========================================= -->

    <script>
      import { initializeAutoSearch } from "../../../../scripts/auto-search";


      /* ========================================
         Auto Search
      ======================================== */

      initializeAutoSearch({
        inputId: "line-station-search",
        formId: "line-station-search-form",
        contentId: "line-stations-content",
        debounceMs: 350,
      });


      /* ========================================
         Add Station Modal
      ======================================== */

      const addModal =
        document.getElementById(
          "add-station-modal",
        );

      const openAddModal = () => {
        if (!(addModal instanceof HTMLElement)) {
          return;
        }

        addModal.hidden = false;

        addModal.setAttribute(
          "aria-hidden",
          "false",
        );

        document.body.classList.add(
          "admin-modal-open",
        );

        requestAnimationFrame(() => {
          addModal.classList.add("is-open");

          const stationSelect =
            document.getElementById(
              "add-station-id",
            );

          if (
            stationSelect instanceof HTMLSelectElement
          ) {
            stationSelect.focus();
          }
        });
      };


      const closeAddModal = () => {
        if (!(addModal instanceof HTMLElement)) {
          return;
        }

        addModal.classList.remove("is-open");

        addModal.setAttribute(
          "aria-hidden",
          "true",
        );

        document.body.classList.remove(
          "admin-modal-open",
        );

        window.setTimeout(() => {
          addModal.hidden = true;
        }, 150);
      };


      document.addEventListener(
        "click",
        (event) => {
          const target = event.target;

          if (!(target instanceof Element)) {
            return;
          }

          if (
            target.closest(
              "#open-add-station-button",
            ) ||
            target.closest(
              "#open-add-station-button-empty",
            )
          ) {
            openAddModal();
            return;
          }

          if (
            target.closest(
              "#close-add-station-modal",
            ) ||
            target.closest(
              "#cancel-add-station",
            ) ||
            target.closest(
              "[data-close-add-modal]",
            )
          ) {
            closeAddModal();
          }
        },
      );


      /* ========================================
         Edit Station Modal
      ======================================== */

      const editModal =
        document.getElementById(
          "edit-station-modal",
        );

      const editStationId =
        document.getElementById(
          "edit-station-id",
        );

      const editStationName =
        document.getElementById(
          "edit-station-name",
        );

      const editStationOrder =
        document.getElementById(
          "edit-station-order",
        );

      const editStationCode =
        document.getElementById(
          "edit-station-code",
        );


      const openEditModal = (
        button: HTMLElement,
      ) => {
        if (
          !(editModal instanceof HTMLElement) ||
          !(editStationId instanceof HTMLInputElement) ||
          !(editStationName instanceof HTMLElement) ||
          !(editStationOrder instanceof HTMLInputElement) ||
          !(editStationCode instanceof HTMLInputElement)
        ) {
          return;
        }

        editStationId.value =
          button.dataset.id ?? "";

        editStationName.textContent =
          button.dataset.stationName ??
          "Station";

        editStationOrder.value =
          button.dataset.stationOrder ??
          "";

        editStationCode.value =
          button.dataset.stationCode ??
          "";

        editModal.hidden = false;

        editModal.setAttribute(
          "aria-hidden",
          "false",
        );

        document.body.classList.add(
          "admin-modal-open",
        );

        requestAnimationFrame(() => {
          editModal.classList.add("is-open");

          editStationOrder.focus();
        });
      };


      const closeEditModal = () => {
        if (!(editModal instanceof HTMLElement)) {
          return;
        }

        editModal.classList.remove("is-open");

        editModal.setAttribute(
          "aria-hidden",
          "true",
        );

        document.body.classList.remove(
          "admin-modal-open",
        );

        window.setTimeout(() => {
          editModal.hidden = true;
        }, 150);
      };


      /*
       * Event delegation is intentional.
       * Auto-search replaces the table DOM,
       * so direct listeners would disappear.
       */

      document.addEventListener(
        "click",
        (event) => {
          const target = event.target;

          if (!(target instanceof Element)) {
            return;
          }

          const editButton =
            target.closest<HTMLElement>(
              "[data-edit-station]",
            );

          if (editButton) {
            openEditModal(editButton);
            return;
          }

          if (
            target.closest(
              "#close-edit-station-modal",
            ) ||
            target.closest(
              "#cancel-edit-station",
            ) ||
            target.closest(
              "[data-close-edit-modal]",
            )
          ) {
            closeEditModal();
          }
        },
      );


      /* ========================================
         Remove Confirmation
      ======================================== */

      const removeDialog =
        document.getElementById(
          "remove-station-dialog",
        );

      let pendingRemoveForm:
        | HTMLFormElement
        | null = null;


      document.addEventListener(
        "submit",
        (event) => {
          const form =
            event.target;

          if (
            !(form instanceof HTMLFormElement)
          ) {
            return;
          }

          if (
            !form.matches(
              "form[data-station-remove]",
            )
          ) {
            return;
          }

          event.preventDefault();

          pendingRemoveForm = form;

          if (
            removeDialog instanceof HTMLDivElement
          ) {
            removeDialog.dispatchEvent(
              new CustomEvent(
                "dialog:open",
              ),
            );
          }
        },
      );


      if (
        removeDialog instanceof HTMLDivElement
      ) {
        removeDialog.addEventListener(
          "confirm",
          () => {
            if (!pendingRemoveForm) {
              return;
            }

            const form =
              pendingRemoveForm;

            pendingRemoveForm = null;

            form.submit();
          },
        );
      }


      /* ========================================
         Keyboard
      ======================================== */

      document.addEventListener(
        "keydown",
        (event) => {
          if (event.key !== "Escape") {
            return;
          }

          if (
            addModal instanceof HTMLElement &&
            !addModal.hidden
          ) {
            closeAddModal();
            return;
          }

          if (
            editModal instanceof HTMLElement &&
            !editModal.hidden
          ) {
            closeEditModal();
          }
        },
      );
    </script>

  </body>
</html>

