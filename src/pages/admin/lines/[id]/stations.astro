---
import AdminLayout from "../../../../layouts/AdminLayout.astro";
import "../../../../styles/admin/forms.css";
import "../../../../styles/admin/lines.css";
import "../../../../styles/admin/tables.css";

import Button from "../../../../components/Button.astro";
import SearchInput from "../../../../components/SearchInput.astro";
import ConfirmDialog from "../../../../components/ConfirmDialog.astro";

import { getLineById } from "../../../../lib/db/lines";
import {
  handleLineStationsAction,
  loadLineStations,
} from "../../../../lib/services/lines";

export const prerender = false;

const { env } = await import("cloudflare:workers");

const db = env.DB;

const lineId = Number(Astro.params.id);

if (!Number.isInteger(lineId) || lineId <= 0) {
  return Astro.redirect("/admin/lines");
}

const line = await getLineById(db, lineId);

if (!line) {
  return Astro.redirect("/admin/lines");
}

const searchParam = String(Astro.url.searchParams.get("search") ?? "").trim();

const result = await handleLineStationsAction(Astro.request, db, lineId);

if (result.redirectTo) {
  return Astro.redirect(result.redirectTo);
}

const { error } = result;

const { stations, availableStations } = await loadLineStations(
  db,
  lineId,
  searchParam,
);

const admin = await Astro.session?.get<{
  id: number;
  email: string;
  name: string;
}>("admin");
---

<AdminLayout title={`${line.name} Stations`} activePath="/admin/lines">

        <!-- ======================================
             Topbar
        ======================================= -->

        <header class="admin-topbar">

          <div class="admin-breadcrumb">

            <Button
              href="/admin/lines"
              variant="secondary"
              ariaLabel="Back to lines"
            >
              ←
            </Button>

            <a href="/admin/lines">
              Lines
            </a>

            <span>/</span>

            <strong>
              {line.name}
            </strong>

          </div>

        </header>


        <!-- ======================================
             Content
        ======================================= -->

        <div class="admin-content">

          <section class="admin-lines-page">


            <!-- ==================================
                 Page Header
            =================================== -->

            <div class="admin-page-header">

              <div>

                <h2>
                  {line.name}
                </h2>

                <p>
                  Manage the stations connected to
                  this railway line and control their
                  display order.
                </p>

              </div>

            </div>


            <!-- ==================================
                 Error
            =================================== -->

            {
              error && (
                <div class="admin-alert admin-alert-error">
                  {error}
                </div>
              )
            }


            <!-- ==================================
                 Toolbar
            =================================== -->

            <div class="admin-list-toolbar">

              <form
                method="GET"
                id="line-station-search-form"
                class="admin-search-form"
                action={`/admin/lines/${lineId}/stations`}
                role="search"
              >

                <SearchInput
                  id="line-station-search"
                  name="search"
                  value={searchParam}
                  placeholder="Search stations..."
                  ariaLabel="Search stations"
                  form="line-station-search-form"
                />

              </form>


              <Button
                type="button"
                variant="primary"
                id="open-add-station-button"
              >
                + Add Station
              </Button>

            </div>


            <!-- ==================================
                 Stations Content

                 IMPORTANT:
                 Search replaces only this section.
                 Toolbar stays outside.
            =================================== -->

            <section
              id="line-stations-content"
              aria-busy="false"
            >

              <section class="admin-panel">


                <!-- ==================================
                     Panel Header
                =================================== -->

                <div class="admin-panel-header">

                  <div>

                    <h3>
                      Stations on {line.name}
                    </h3>

                    <p>
                      {stations.length}
                      {searchParam
                        ? " matching "
                        : " "}
                      station
                      {stations.length === 1
                        ? ""
                        : "s"}
                    </p>

                  </div>

                </div>


                <!-- ==================================
                     Table
                =================================== -->

                <div class="admin-table-panel-body">

                  {
                    stations.length > 0 ? (
                      <div class="admin-table-wrapper">

                        <table class="admin-table">

                          <thead>

                            <tr>
                              <th>#</th>
                              <th>Station</th>
                              <th>Japanese</th>
                              <th>Code</th>
                              <th>Actions</th>
                            </tr>

                          </thead>


                          <tbody>

                            {
                              stations.map(
                                (station) => (
                                  <tr>

                                    <!-- Order -->

                                    <td>

                                      <span
                                        class="admin-line-code"
                                        aria-label={`Station order ${station.station_order}`}
                                      >
                                        {String(
                                          station.station_order,
                                        ).padStart(2, "0")}
                                      </span>

                                    </td>


                                    <!-- Station -->

                                    <td>

                                      <div class="admin-line-name">
                                        {station.station_name}
                                      </div>

                                      <div class="admin-line-slug">
                                        {station.station_slug}
                                      </div>

                                    </td>


                                    <!-- Japanese -->

                                    <td>

                                      <span>
                                        {
                                          station.station_name_japanese ??
                                          "—"
                                        }
                                      </span>

                                    </td>


                                    <!-- Code -->

                                    <td>

                                      {
                                        station.station_code ? (
                                          <span class="admin-line-operator">
                                            {station.station_code}
                                          </span>
                                        ) : (
                                          <span>
                                            —
                                          </span>
                                        )
                                      }

                                    </td>


                                    <!-- Actions -->

                                    <td>

                                      <div class="admin-table-actions">

                                        <!--
                                          Native button intentionally used
                                          here because Button.astro does not
                                          forward arbitrary data-* attributes.
                                        -->

                                        <button
                                          type="button"
                                          class="admin-table-action admin-table-action-edit"
                                          data-edit-station
                                          data-id={station.id}
                                          data-station-name={
                                            station.station_name
                                          }
                                          data-station-order={
                                            station.station_order
                                          }
                                          data-station-code={
                                            station.station_code ?? ""
                                          }
                                        >
                                          Edit
                                        </button>


                                        <form
                                          method="POST"
                                          data-station-remove
                                          data-station-name={
                                            station.station_name
                                          }
                                        >

                                          <input
                                            type="hidden"
                                            name="action"
                                            value="remove"
                                          />

                                          <input
                                            type="hidden"
                                            name="id"
                                            value={station.id}
                                          />

                                          <button
                                            type="submit"
                                            class="admin-table-action admin-table-action-delete"
                                          >
                                            Remove
                                          </button>

                                        </form>

                                      </div>

                                    </td>

                                  </tr>
                                ),
                              )
                            }

                          </tbody>

                        </table>

                      </div>
                    ) : (
                      <div class="admin-empty">

                        <div class="admin-empty-icon">
                          ◎
                        </div>

                        <h3>
                          {
                            searchParam
                              ? "No Matching Stations"
                              : "No Stations on This Line"
                          }
                        </h3>

                        <p>
                          {
                            searchParam
                              ? "Try another station name, Japanese name, slug, or station code."
                              : "There are currently no stations connected to this railway line."
                          }
                        </p>

                        {
                          !searchParam &&
                          availableStations.length > 0 && (
                            <div class="admin-not-found-actions">

                              <Button
                                type="button"
                                variant="primary"
                                id="open-add-station-button-empty"
                              >
                                + Add Station
                              </Button>

                            </div>
                          )
                        }

                      </div>
                    )
                  }

                </div>

              </section>

            </section>

          </section>

        </div>

  <Fragment slot="after">
    <!-- ========================================
         Add Station Modal
    ========================================= -->

    <div
      id="add-station-modal"
      class="admin-line-station-modal"
      hidden
      aria-hidden="true"
    >

      <div
        class="admin-line-station-modal-backdrop"
        data-close-add-modal
      ></div>


      <div
        class="admin-line-station-modal-dialog"
        role="dialog"
        aria-modal="true"
        aria-labelledby="add-station-modal-title"
        aria-describedby="add-station-modal-description"
      >

        <div class="admin-line-station-modal-header">

          <div>

            <h2 id="add-station-modal-title">
              Add Station
            </h2>

            <p id="add-station-modal-description">
              Add an existing station to
              {line.name}.
            </p>

          </div>


          <button
            type="button"
            class="admin-line-station-modal-close"
            id="close-add-station-modal"
            aria-label="Close add station dialog"
          >
            ×
          </button>

        </div>


        {
          availableStations.length > 0 ? (
            <form
              method="POST"
              class="admin-form"
              id="add-station-form"
            >

              <input
                type="hidden"
                name="action"
                value="add"
              />


              <!-- Station -->

              <div class="admin-form-group">

                <label for="add-station-id">
                  Station
                </label>

                <select
                  id="add-station-id"
                  name="station_id"
                  required
                >

                  <option value="">
                    Select station
                  </option>

                  {
                    availableStations.map(
                      (station) => (
                        <option value={station.id}>
                          {station.name}
                          {
                            station.name_japanese
                              ? ` — ${station.name_japanese}`
                              : ""
                          }
                        </option>
                      ),
                    )
                  }

                </select>

              </div>


              <!-- Station Order -->

              <div class="admin-form-group">

                <label for="add-station-order">
                  Station Order
                </label>

                <input
                  id="add-station-order"
                  name="station_order"
                  type="number"
                  min="1"
                  step="1"
                  value={stations.length + 1}
                  required
                />

                <small>
                  The position of this station on
                  the line.
                </small>

              </div>


              <!-- Station Code -->

              <div class="admin-form-group">

                <label for="add-station-code">
                  Station Code
                </label>

                <input
                  id="add-station-code"
                  name="station_code"
                  type="text"
                  maxlength="50"
                  placeholder="e.g. JY01"
                />

                <small>
                  Optional line-specific station code.
                </small>

              </div>


              <!-- Actions -->

              <div class="admin-form-actions">

                <Button
                  type="button"
                  variant="secondary"
                  id="cancel-add-station"
                >
                  Cancel
                </Button>

                <Button
                  type="submit"
                  variant="primary"
                >
                  Add Station
                </Button>

              </div>

            </form>
          ) : (
            <div class="admin-empty">

              <div class="admin-empty-icon">
                ◎
              </div>

              <h3>
                No Available Stations
              </h3>

              <p>
                All existing stations are already
                connected to this line, or no
                stations have been created yet.
              </p>

              <div class="admin-not-found-actions">

                <Button
                  href="/admin/stations/new"
                  variant="secondary"
                >
                  Create Station
                </Button>

              </div>

            </div>
          )
        }

      </div>

    </div>


    <!-- ========================================
         Edit Station Modal
    ========================================= -->

    <div
      id="edit-station-modal"
      class="admin-line-station-modal"
      hidden
      aria-hidden="true"
    >

      <div
        class="admin-line-station-modal-backdrop"
        data-close-edit-modal
      ></div>


      <div
        class="admin-line-station-modal-dialog"
        role="dialog"
        aria-modal="true"
        aria-labelledby="edit-station-modal-title"
        aria-describedby="edit-station-modal-description"
      >

        <div class="admin-line-station-modal-header">

          <div>

            <h2 id="edit-station-modal-title">
              Edit Station
            </h2>

            <p id="edit-station-modal-description">
              Update the station order and
              line-specific code.
            </p>

          </div>


          <button
            type="button"
            class="admin-line-station-modal-close"
            id="close-edit-station-modal"
            aria-label="Close edit station dialog"
          >
            ×
          </button>

        </div>


        <form
          method="POST"
          class="admin-form"
          id="edit-station-form"
        >

          <input
            type="hidden"
            name="action"
            value="update"
          />

          <input
            type="hidden"
            name="id"
            id="edit-station-id"
          />


          <!-- Station -->

          <div class="admin-form-group">

            <label>
              Station
            </label>

            <div
              class="admin-line-station-modal-station-name"
              id="edit-station-name"
            >
              —
            </div>

          </div>


          <!-- Station Order -->

          <div class="admin-form-group">

            <label for="edit-station-order">
              Station Order
            </label>

            <input
              id="edit-station-order"
              name="station_order"
              type="number"
              min="1"
              step="1"
              required
            />

            <small>
              Changing this may affect the station's
              position on the line.
            </small>

          </div>


          <!-- Station Code -->

          <div class="admin-form-group">

            <label for="edit-station-code">
              Station Code
            </label>

            <input
              id="edit-station-code"
              name="station_code"
              type="text"
              maxlength="50"
              placeholder="e.g. JY01"
            />

            <small>
              Optional line-specific station code.
            </small>

          </div>


          <!-- Actions -->

          <div class="admin-form-actions">

            <Button
              type="button"
              variant="secondary"
              id="cancel-edit-station"
            >
              Cancel
            </Button>

            <Button
              type="submit"
              variant="primary"
            >
              Save Changes
            </Button>

          </div>

        </form>

      </div>

    </div>


    <!-- ========================================
         Remove Confirmation
    ========================================= -->

    <ConfirmDialog
      id="remove-station-dialog"
      title="Remove Station"
      description="Are you sure you want to remove this station from the line?"
      confirmText="Remove Station"
      cancelText="Cancel"
      variant="danger"
    />


    <!-- ========================================
         Scripts
    ========================================= -->

    <script>
      import "../../../../scripts/admin/lines-stations.ts";
    </script>

  
  </Fragment>
</AdminLayout>
