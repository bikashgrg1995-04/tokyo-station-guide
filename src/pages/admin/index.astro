---
import AdminLayout from "../../layouts/AdminLayout.astro";
import "../../styles/admin/dashboard.css";
import "../../styles/admin/suggestions.css";
import {
  SUGGESTION_STATUS_LABELS,
  countStationSuggestions,
  listStationSuggestions,
} from "../../lib/db/station-suggestions";

import { getDashboardCounts } from "../../lib/db/dashboard";

export const prerender = false;

const title = "Dashboard";

const { env } = await import("cloudflare:workers");
const db = env.DB;

const [counts, latestSuggestions, suggestionCounts] = await Promise.all([
  getDashboardCounts(db),
  listStationSuggestions(db, { status: "pending", limit: 5, offset: 0 }),
  countStationSuggestions(db),
]);

const pendingSuggestions = suggestionCounts.pending;

function snippet(value: string | null, max = 90): string {
  const text = (value ?? "").replace(/\s+/g, " ").trim();
  return text.length > max ? `${text.slice(0, max).trimEnd()}…` : text;
}

function formatDate(value: string): string {
  const date = new Date(value.replace(" ", "T") + "Z");

  if (Number.isNaN(date.getTime())) return value;

  return date.toLocaleDateString("en", {
    month: "short",
    day: "numeric",
    year: "numeric",
  });
}
---

<AdminLayout title={title} activePath="/admin">
  <div class="admin-content">
    <div class="admin-page-header">
      <div>
        <h2>Dashboard</h2>
        <p>Manage stations, railway lines and operators.</p>
      </div>
    </div>

    <section class="admin-stats">
      <div class="admin-stat-card">
        <span class="admin-stat-label">Operators</span>
        <strong class="admin-stat-value">{counts.operators}</strong>
      </div>
      <div class="admin-stat-card">
        <span class="admin-stat-label">Railway Lines</span>
        <strong class="admin-stat-value">{counts.lines}</strong>
      </div>
      <div class="admin-stat-card">
        <span class="admin-stat-label">Stations</span>
        <strong class="admin-stat-value">{counts.stations}</strong>
      </div>
      <div class="admin-stat-card">
        <span class="admin-stat-label">Facilities</span>
        <strong class="admin-stat-value">{counts.facilities}</strong>
      </div>
      <div class="admin-stat-card">
        <span class="admin-stat-label">Top Picks</span>
        <strong class="admin-stat-value">{counts.top_picks}</strong>
      </div>
      <div class="admin-stat-card">
        <span class="admin-stat-label">Line Connections</span>
        <strong class="admin-stat-value">{counts.line_stations}</strong>
      </div>
    </section>

    <section class="admin-dashboard-grid">
      <div class="admin-panel">
        <div class="admin-panel-header">
          <div>
            <h3>Suggestions</h3>
            <p>
              {pendingSuggestions} new
            </p>
          </div>
        </div>

        {
          latestSuggestions.length > 0 ? (
            <>
              <ul class="admin-suggestion-recent">
                {latestSuggestions.map((suggestion) => (
                  <li>
                    <a
                      href={`/admin/suggestions?open=${suggestion.id}`}
                    >
                      <span class="admin-suggestion-recent-head">
                        <span>
                          <strong class="admin-suggestion-station">
                            {suggestion.station_name}
                          </strong>
                          {suggestion.line_name && (
                            <span class="admin-suggestion-meta">
                              {" · "}
                              {suggestion.line_name}
                            </span>
                          )}
                        </span>
                        <span class="admin-suggestion-date">
                          {formatDate(suggestion.created_at)}
                        </span>
                      </span>
                      <span class="admin-suggestion-recent-text">
                        {snippet(suggestion.message) || "Open to read"}
                      </span>
                    </a>
                  </li>
                ))}
              </ul>
              <a class="admin-suggestion-recent-more" href="/admin/suggestions">
                View all suggestions ({suggestionCounts.total}) →
              </a>
            </>
          ) : (
            <div class="admin-empty">
              <div class="admin-empty-icon">✓</div>
              <h3>No new suggestions</h3>
              <p>
                Suggestions from visitors will appear here.
                <a href="/admin/suggestions">
                  View {SUGGESTION_STATUS_LABELS.approved.toLowerCase()} ones
                </a>
              </p>
            </div>
          )
        }
      </div>

      <div class="admin-panel">
        <div class="admin-panel-header">
          <div>
            <h3>Content Management</h3>
            <p>Manage the core railway data.</p>
          </div>
        </div>
        <div class="admin-panel-body">
          <div class="admin-dashboard-links">
            <a href="/admin/stations">
              <strong>Stations</strong>
              <span
                >Manage station information, coordinates and descriptions.</span
              >
            </a>
            <a href="/admin/lines">
              <strong>Railway Lines</strong>
              <span>Manage railway lines and their station order.</span>
            </a>
            <a href="/admin/operators">
              <strong>Operators</strong>
              <span>Manage railway operators and websites.</span>
            </a>
            <a href="/admin/facilities">
              <strong>Facilities</strong>
              <span>Manage station facilities, icons and display order.</span>
            </a>
            <a href="/admin/top-picks">
              <strong>Top Picks</strong>
              <span
                >Manage featured places, food, shopping and attractions.</span
              >
            </a>
          </div>
        </div>
      </div>
    </section>
  </div>

</AdminLayout>
