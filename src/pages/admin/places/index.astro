
---
import { topPickImageSrc } from "../../../lib/storage/top-pick-images";
import AdminLayout from "../../../layouts/AdminLayout.astro";
import "../../../styles/admin/tables.css";
import "../../../styles/admin/operators.css";

import EmptyState from "../../../components/common/EmptyState.astro";
import Button from "../../../components/common/Button.astro";
import SearchInput from "../../../components/common/SearchInput.astro";
import ConfirmDialog from "../../../components/common/ConfirmDialog.astro";
import Pagination from "../../../components/common/Pagination.astro";

import { loadTopPickList } from "../../../lib/services/top-picks";
import { TOP_PICK_CATEGORIES } from "../../../lib/db/top-picks";

export const prerender = false;

const { env } = await import("cloudflare:workers");

const {
  topPicks,
  totalItems,
  currentPage: safeCurrentPage,
  totalPages,
  perPage,
  searchParam,
  category,
  paginationUrl,
} = await loadTopPickList(env.DB, Astro.url);

const deleteError = Astro.url.searchParams.get("error");
const filterHref = (c: string) => {
  const u = new URL("/admin/places", Astro.url);
  if (searchParam) u.searchParams.set("search", searchParam);
  if (c) u.searchParams.set("category", c);
  return `${u.pathname}${u.search}`;
};
---

<AdminLayout title="Places" activePath="/admin/places">
  <div class="admin-content">
    <!-- Page Header -->
    <div class="admin-page-header">
      <div>
        <h2>Places</h2>

        <p>
          Manage popular places, landmarks, food spots, shopping areas,
          museums, parks, and temples that can be featured on station pages.
        </p>
      </div>
    </div>

    <!-- Delete Error -->
    {
      deleteError === "assigned" ? (
        <div class="admin-form-error" role="alert">
          This place is assigned to one or more stations.
          Remove its station assignments before deleting it.
        </div>
      ) : deleteError === "delete" ? (
        <div class="admin-form-error" role="alert">
          Unable to delete this place. Please try again.
        </div>
      ) : null
    }

    <!-- Search / Action Bar -->
    <div class="admin-list-toolbar">
      <form
        id="top-pick-search-form"
        class="admin-search-form"
        method="GET"
        action="/admin/places"
        role="search"
      >
        {category && <input type="hidden" name="category" value={category} />}
        <SearchInput
          id="top-pick-search"
          name="search"
          value={searchParam}
          placeholder="Search places..."
          ariaLabel="Search places"
        />
      </form>

      <Button href="/admin/places/new" variant="primary">
        + Add Place
      </Button>
    </div>

    <!-- Category filter -->
    <nav class="admin-filter-pills" aria-label="Filter places by category">
      <a href={filterHref("")} class:list={["admin-filter-pill", { "is-active": category === "" }]}>All</a>
      {TOP_PICK_CATEGORIES.map((c) => (
        <a href={filterHref(c)} class:list={["admin-filter-pill", { "is-active": category === c }]}>{c}</a>
      ))}
    </nav>

    <!-- Places Table -->
    <section class="admin-panel">
      <div
        id="top-picks-table-content"
        class="admin-panel-body admin-table-panel-body"
      >
        <!-- Table Meta -->
        <div class="admin-table-meta">
          <span>{totalItems} • Total Places</span>
        </div>

        {
          topPicks.length > 0 ? (
            <>
              <!-- Table -->
              <div class="admin-table-wrapper">
                <table class="admin-table">
                  <thead>
                    <tr>
                      <th>ID</th>
                      <th>Place</th>
                      <th>Japanese Name</th>
                      <th>Slug</th>
                      <th>Category</th>
                      <th>Image</th>
                      <th>Actions</th>
                    </tr>
                  </thead>

                  <tbody>
                    {topPicks.map((topPick) => (
                      <tr>
                        <td class="admin-table-id">
                          {topPick.id}
                        </td>

                        <td>
                          <div class="admin-operator-name">
                            {topPick.name}
                          </div>
                        </td>

                        <td>
                          {topPick.name_japanese ? (
                            <span>{topPick.name_japanese}</span>
                          ) : (
                            <span class="admin-table-muted">—</span>
                          )}
                        </td>

                        <td class="admin-table-code">
                          {topPick.slug}
                        </td>

                        <td>
                          {topPick.category}
                        </td>

                        <td>
                          {topPick.image_url ? (
                            <a
                              href={topPickImageSrc(topPick.image_url)}
                              target="_blank"
                              rel="noopener noreferrer"
                              class="admin-photo-thumb-link"
                            >
                              <img
                                class="admin-photo-thumb"
                                src={topPickImageSrc(topPick.image_url)}
                                alt={`Photo of ${topPick.name}`}
                                loading="lazy"
                              />
                            </a>
                          ) : (
                            <span class="admin-table-muted">—</span>
                          )}
                        </td>

                        <td>
                          <div class="admin-table-actions">
                            <a
                              href={`/admin/places/${topPick.id}/edit`}
                              class="admin-table-action admin-table-action-edit"
                            >
                              Edit
                            </a>

                            <button
                              type="button"
                              class="admin-table-action admin-table-action-delete js-delete-top-pick"
                              data-top-pick-id={topPick.id}
                              data-top-pick-name={topPick.name}
                            >
                              Delete
                            </button>
                          </div>
                        </td>
                      </tr>
                    ))}
                  </tbody>
                </table>
              </div>

              <!-- Table Footer -->
              <div class="admin-table-footer">
                <span>
                  {`Page ${safeCurrentPage} of ${totalPages}`}
                </span>

                <Pagination
                  currentPage={safeCurrentPage}
                  totalPages={totalPages}
                  baseUrl={`${paginationUrl.pathname}${paginationUrl.search}`}
                  totalItems={totalItems}
                  perPage={perPage}
                />
              </div>
            </>
          ) : (
            <EmptyState
              icon="◉"
              title={searchParam ? "No places found" : "No places yet"}
              description={
                searchParam
                  ? "Try a different search term."
                  : "Add your first place to get started."
              }
            />
          )
        }
      </div>
    </section>
  </div>

  <Fragment slot="after">
    <!-- Delete Confirmation Dialog -->
    <ConfirmDialog
      id="delete-top-pick-dialog"
      title="Delete Place"
      description="Are you sure you want to delete this place?"
      confirmText="Delete Place"
      cancelText="Cancel"
      variant="danger"
      warning="A place assigned to a station cannot be deleted."
    />

    <!-- Delete Form -->
    <form
      method="POST"
      id="delete-top-pick-form"
      hidden
    ></form>

    <script>
      import "../../../scripts/admin/top-picks-list.ts";
    </script>
  </Fragment>
</AdminLayout>
