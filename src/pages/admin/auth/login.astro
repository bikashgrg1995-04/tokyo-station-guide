---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { SITE_NAME } from "../../../config/site";
import "../../../styles/admin/shared.css";
import "../../../styles/admin/auth.css";
import "../../../styles/admin/forms.css";
import { verifyPassword } from "../../../lib/auth/password";
import Button from "../../../components/Button.astro";

export const prerender = false;

const title = "Admin Login";

let error = "";

if (Astro.request.method === "POST") {
  const formData = await Astro.request.formData();

  const email = String(formData.get("email") ?? "")
    .trim()
    .toLowerCase();

  const password = String(formData.get("password") ?? "");

  if (!email || !password) {
    error = "Email and password are required.";
  } else {
    const { env } = await import("cloudflare:workers");

    const db = env.DB;

    const admin = await db
      .prepare(
        `
          SELECT
            id,
            email,
            name,
            password_hash,
            is_active
          FROM admin_users
          WHERE email = ?
          LIMIT 1
        `,
      )
      .bind(email)
      .first<{
        id: number;
        email: string;
        name: string;
        password_hash: string;
        is_active: number;
      }>();

    if (!admin || admin.is_active !== 1) {
      error = "Invalid email or password.";
    } else {
      const passwordValid = await verifyPassword(password, admin.password_hash);

      if (!passwordValid) {
        error = "Invalid email or password.";
      } else {
        await Astro.session?.set("admin", {
          id: admin.id,
          email: admin.email,
          name: admin.name,
        });

        return Astro.redirect("/admin");
      }
    }
  }
}
---

<BaseLayout title={`${title} | ${SITE_NAME}`} robots="noindex, nofollow">
    <main class="admin-login-page">
      <section class="admin-login-card">
        <div class="admin-login-logo">T</div>

        <div class="admin-login-heading">
          <h1>Welcome back</h1>
          <p>Sign in to manage Tokyo Station Guide.</p>
        </div>

        {error && <div class="admin-login-error">{error}</div>}

        <form method="POST" class="admin-form">
          <div class="admin-form-group">
            <label for="email">Email</label>

            <input
              id="email"
              name="email"
              type="email"
              placeholder="admin@example.com"
              autocomplete="email"
              required
            />
          </div>

          <div class="admin-form-group">
            <label for="password">Password</label>

            <input
              id="password"
              name="password"
              type="password"
              placeholder="Enter your password"
              autocomplete="current-password"
              required
            />
          </div>

          <Button type="submit" variant="primary" size="large" fullWidth>
            Sign in
          </Button>
        </form>

        <a href="/" class="admin-login-back"> ← Back to website </a>
      </section>
    </main>
  
</BaseLayout>
