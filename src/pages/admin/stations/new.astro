---
import AdminLayout from "../../../layouts/AdminLayout.astro";
import "../../../styles/admin/forms.css";
import "../../../styles/admin/stations.css";
import "../../../styles/admin/tables.css";

import Alert from "../../../components/common/Alert.astro";
import Breadcrumbs from "../../../components/common/Breadcrumbs.astro";
import Button from "../../../components/common/Button.astro";
import ConfirmDialog from "../../../components/common/ConfirmDialog.astro";

import StationFormFields from "../../../components/admin/StationFormFields.astro";
import StationTopPicks from "../../../components/admin/StationTopPicks.astro";

import { handleStationCreate } from "../../../lib/services/stations";

export const prerender = false;

const { env } = await import("cloudflare:workers");

const form = await handleStationCreate(Astro.request, env.DB);

if (form.redirectTo) {
  return Astro.redirect(form.redirectTo);
}

const { name } = form.values;
const { errors, topPicks } = form;
const error = form.formError;
---

<AdminLayout title="Add Station" activePath="/admin/stations">
  <header class="admin-topbar">
    <Breadcrumbs
      backHref="/admin/stations"
      parentLabel="Stations"
      current="Add Station"
    />
  </header>

  <div class="admin-content">
    <h2>Add Station</h2>

    <p>Add a railway or subway station to the Tokyo Station Guide.</p>

    <form method="POST" class="admin-form" id="add-station-form">
      <!-- Station Details -->
      <section class="admin-panel">
        <div class="admin-panel-body">
          <div class="admin-station-form">
            <div class="admin-station-form-header">
              <h3>Station Details</h3>
              <p>Enter the basic information for this station.</p>
            </div>

            {error && <Alert>{error}</Alert>}

            <StationFormFields values={form.values} errors={errors} />
          </div>
        </div>
      </section>

      <!-- Station Verification + Facilities -->
      <div class="admin-station-setup-grid">
        <section class="admin-panel admin-station-verification-panel">
          <div class="admin-panel-body">
            <div class="admin-station-feature-header">
              <div>
                <h3>Station Verification</h3>
                <p>Manage this station's verification status.</p>
              </div>
            </div>

            <div class="admin-verification-toggle">
              <div class="admin-verification-copy">
                <span class="admin-verification-title"> Verified station </span>

                <small> Mark this station as verified. </small>
              </div>

              <label class="admin-switch" for="is_verified">
                <input
                  id="is_verified"
                  name="is_verified"
                  type="checkbox"
                  checked={form.values.isVerified}
                />
                <span class="admin-switch-slider"></span>
              </label>
            </div>
          </div>
        </section>

        <section class="admin-card">
          <h2>Facilities</h2>
          <p>
            Create the station first, then add its floors and assign facilities
            from the Edit Station page.
          </p>
        </section>
      </div>

      <!-- Top Picks -->
      <section class="admin-station-top-picks-section">
        <StationTopPicks
          stationName={name || "this station"}
          assignedTopPicks={[]}
          availableTopPicks={topPicks}
        />
      </section>

      <!-- Form Actions -->
      <div class="admin-form-actions">
        <Button href="/admin/stations" variant="secondary"> Cancel </Button>

        <Button type="submit" variant="primary" id="create-station-button">
          Create Station
        </Button>
      </div>
    </form>
  </div>

  <Fragment slot="after">
    <!-- Remove Facility Confirmation -->
    <ConfirmDialog
      id="remove-facility-confirm-dialog"
      title="Remove Facility"
      description="Are you sure you want to remove this facility entry from the station?"
      confirmText="Remove"
      cancelText="Cancel"
      variant="danger"
    />

    <!-- Create Station Confirmation -->
    <ConfirmDialog
      id="create-station-confirm-dialog"
      title="Create Station"
      description="Are you sure you want to create this station?"
      confirmText="Create Station"
      cancelText="Cancel"
      variant="primary"
    />

    <script>
      import "../../../scripts/admin/stations-new.ts";
    </script>
  </Fragment>
</AdminLayout>
