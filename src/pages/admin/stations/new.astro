---
import AdminLayout from "../../../layouts/AdminLayout.astro";
import "../../../styles/admin/forms.css";
import "../../../styles/admin/stations.css";
import "../../../styles/admin/tables.css";

import EmptyState from "../../../components/common/EmptyState.astro";
import Alert from "../../../components/common/Alert.astro";
import Breadcrumbs from "../../../components/common/Breadcrumbs.astro";
import Button from "../../../components/common/Button.astro";
import ConfirmDialog from "../../../components/common/ConfirmDialog.astro";
import StationTopPicks from "../../../components/admin/StationTopPicks.astro";

import { handleStationCreate } from "../../../lib/services/stations";

export const prerender = false;

const { env } = await import("cloudflare:workers");

const form = await handleStationCreate(Astro.request, env.DB);

if (form.redirectTo) {
  return Astro.redirect(form.redirectTo);
}

const {
  name,
  nameJapanese,
  slug,
  latitude: latitudeValue,
  longitude: longitudeValue,
  description,
  about,
} = form.values;
const { errors, facilities, topPicks } = form;
const error = form.formError;

---

<AdminLayout title="Add Station" activePath="/admin/stations">
        <!-- ========================================
             Topbar
        ========================================= -->

        <header class="admin-topbar">
          <Breadcrumbs backHref="/admin/stations" parentLabel="Stations" current="Add Station" />
        </header>

        <!-- ========================================
             Content
        ========================================= -->

        <div class="admin-content">
          <h2>Add Station</h2>

          <p>
            Add a railway or subway station to the
            Tokyo Station Guide.
          </p>

          <!-- ======================================
               Main Add Form
          ======================================= -->

          <form
            method="POST"
            class="admin-form"
            id="add-station-form"
          >
            <!-- ======================================
                 Station Details
            ======================================= -->

            <section class="admin-panel">
              <div class="admin-panel-body">
                <div class="admin-station-form">
                  <div
                    class="admin-station-form-header"
                  >
                    <h3>
                      Station Details
                    </h3>

                    <p>
                      Enter the basic information
                      for this station.
                    </p>
                  </div>

                  {
                    error && (
                      <Alert>{error}</Alert>
                    )
                  }

                  <div class="admin-form-grid">
                    <!-- Station Name -->

                    <div class="admin-form-group">
                      <label for="name">
                        Station Name
                      </label>

                      <input
                        id="name"
                        name="name"
                        type="text"
                        placeholder="e.g. Tokyo Station"
                        value={name}
                        required
                        aria-invalid={
                          errors.name
                            ? "true"
                            : "false"
                        }
                        aria-describedby={
                          errors.name
                            ? "name-error"
                            : undefined
                        }
                      />

                      {
                        errors.name && (
                          <small
                            id="name-error"
                            class="admin-form-error"
                          >
                            {errors.name}
                          </small>
                        )
                      }
                    </div>

                    <!-- Japanese Name -->

                    <div class="admin-form-group">
                      <label for="name_japanese">
                        Japanese Name
                      </label>

                      <input
                        id="name_japanese"
                        name="name_japanese"
                        type="text"
                        class="admin-station-japanese-input"
                        placeholder="e.g. 東京駅"
                        value={nameJapanese}
                        aria-invalid={
                          errors.nameJapanese
                            ? "true"
                            : "false"
                        }
                        aria-describedby={
                          errors.nameJapanese
                            ? "name-japanese-error"
                            : undefined
                        }
                      />

                      {
                        errors.nameJapanese && (
                          <small
                            id="name-japanese-error"
                            class="admin-form-error"
                          >
                            {errors.nameJapanese}
                          </small>
                        )
                      }
                    </div>

                    <!-- Slug -->

                    <div class="admin-form-group full-width">
                      <label for="slug">
                        Slug
                      </label>

                      <input
                        id="slug"
                        name="slug"
                        type="text"
                        placeholder="e.g. tokyo-station"
                        value={slug}
                        required
                        aria-invalid={
                          errors.slug
                            ? "true"
                            : "false"
                        }
                        aria-describedby={
                          errors.slug
                            ? "slug-error"
                            : "slug-help"
                        }
                      />

                      {
                        errors.slug ? (
                          <small
                            id="slug-error"
                            class="admin-form-error"
                          >
                            {errors.slug}
                          </small>
                        ) : (
                          <small id="slug-help">
                            Used in the station URL.
                            Use lowercase letters,
                            numbers, and hyphens.
                          </small>
                        )
                      }
                    </div>

                    <!-- Latitude -->

                    <div class="admin-form-group">
                      <label for="latitude">
                        Latitude
                      </label>

                      <input
                        id="latitude"
                        name="latitude"
                        type="number"
                        step="any"
                        placeholder="e.g. 35.681236"
                        value={latitudeValue}
                        aria-invalid={
                          errors.latitude
                            ? "true"
                            : "false"
                        }
                        aria-describedby={
                          errors.latitude
                            ? "latitude-error"
                            : "latitude-help"
                        }
                      />

                      {
                        errors.latitude ? (
                          <small
                            id="latitude-error"
                            class="admin-form-error"
                          >
                            {errors.latitude}
                          </small>
                        ) : (
                          <small id="latitude-help">
                            Optional. Range:
                            -90 to 90.
                          </small>
                        )
                      }
                    </div>

                    <!-- Longitude -->

                    <div class="admin-form-group">
                      <label for="longitude">
                        Longitude
                      </label>

                      <input
                        id="longitude"
                        name="longitude"
                        type="number"
                        step="any"
                        placeholder="e.g. 139.767125"
                        value={longitudeValue}
                        aria-invalid={
                          errors.longitude
                            ? "true"
                            : "false"
                        }
                        aria-describedby={
                          errors.longitude
                            ? "longitude-error"
                            : "longitude-help"
                        }
                      />

                      {
                        errors.longitude ? (
                          <small
                            id="longitude-error"
                            class="admin-form-error"
                          >
                            {errors.longitude}
                          </small>
                        ) : (
                          <small id="longitude-help">
                            Optional. Range:
                            -180 to 180.
                          </small>
                        )
                      }
                    </div>

                    <!-- Description -->

                    <div class="admin-form-group full-width">
                      <label for="description">
                        Description
                      </label>

                      <textarea
                        id="description"
                        name="description"
                        rows="5"
                        class="admin-station-description"
                        placeholder="Brief description of this station..."
                        aria-invalid={
                          errors.description
                            ? "true"
                            : "false"
                        }
                        aria-describedby={
                          errors.description
                            ? "description-error"
                            : undefined
                        }>{description}</textarea>

                      {
                        errors.description && (
                          <small
                            id="description-error"
                            class="admin-form-error"
                          >
                            {errors.description}
                          </small>
                        )
                      }
                    </div>

                    <!-- About -->

                    <div class="admin-form-group full-width">
                      <label for="about">
                        About (station popup)
                      </label>

                      <textarea
                        id="about"
                        name="about"
                        rows="4"
                        class="admin-station-description"
                        placeholder="Short text shown in the About section of the station popup..."
                        aria-invalid={
                          errors.about
                            ? "true"
                            : "false"
                        }
                        aria-describedby={
                          errors.about
                            ? "about-error"
                            : undefined
                        }>{about}</textarea>

                      {
                        errors.about ? (
                          <small
                            id="about-error"
                            class="admin-form-error"
                          >
                            {errors.about}
                          </small>
                        ) : (
                          <small>
                            Optional. Up to 1000
                            characters.
                          </small>
                        )
                      }
                    </div>
                  </div>
                </div>
              </div>
            </section>

            <!-- ======================================
                 Facilities + Top Picks
            ======================================= -->

            <div class="admin-station-features-grid">
              <!-- ====================================
                   Facilities
              ===================================== -->

              <section
                class="admin-panel admin-station-feature-panel"
              >
                <div class="admin-panel-body">
                  <div
                    class="admin-station-feature-header"
                  >
                    <div>
                      <h3>
                        Facilities
                      </h3>

                      <p>
                        Select facilities available
                        at this station.
                      </p>
                    </div>

                    {
                      facilities.length > 0 && (
                        <Button
                          type="button"
                          variant="primary"
                          id="open-add-facility-button"
                        >
                          + Add
                        </Button>
                      )
                    }
                  </div>

                  {
                    errors.facilities && (
                      <Alert>{errors.facilities}</Alert>
                    )
                  }

                  <!-- Temporary Facility Inputs -->

                  <div
                    id="station-facility-inputs"
                  ></div>

                  <!-- Facility Table -->

                  <div class="admin-table-wrapper">
                    <table
                      class="admin-table admin-compact-table"
                      id="station-facilities-table"
                    >
                      <thead>
                        <tr>
                          <th>
                            Facility
                          </th>

                          <th>
                            Actions
                          </th>
                        </tr>
                      </thead>

                      <tbody
                        id="station-facilities-body"
                      >
                        <tr
                          id="station-facilities-empty-row"
                        >
                          <td colspan="2">
                            <div class="admin-feature-empty">
                              No facilities assigned.
                            </div>
                          </td>
                        </tr>
                      </tbody>
                    </table>
                  </div>

                  <p
                    id="all-facilities-message"
                    class="admin-feature-message"
                    hidden
                  >
                    All available facilities are
                    already selected.
                  </p>
                </div>
              </section>

              <!-- ====================================
                   Top Picks
              ===================================== -->

              <StationTopPicks
                stationName={name || "this station"}
                assignedTopPicks={[]}
                availableTopPicks={topPicks}
              />
            </div>

            <!-- ======================================
                 Form Actions
            ======================================= -->

            <div class="admin-form-actions">
              <Button
                href="/admin/stations"
                variant="secondary"
              >
                Cancel
              </Button>

              <Button
                type="submit"
                variant="primary"
                id="create-station-button"
              >
                Create Station
              </Button>
            </div>
          </form>
        </div>

  <Fragment slot="after">
    <!-- ========================================
         Add Facilities Modal
    ========================================= -->

    <div
      id="add-facility-modal"
      class="admin-line-station-modal"
      hidden
      aria-hidden="true"
    >
      <div
        class="admin-line-station-modal-backdrop"
        data-close-add-facility-modal
      ></div>

      <div
        class="admin-line-station-modal-dialog"
        role="dialog"
        aria-modal="true"
        aria-labelledby="add-facility-modal-title"
        aria-describedby="add-facility-modal-description"
      >
        <div
          class="admin-line-station-modal-header"
        >
          <div>
            <h2 id="add-facility-modal-title">
              Add Facilities
            </h2>

            <p
              id="add-facility-modal-description"
            >
              Select one or more facilities to add
              to this station.
            </p>
          </div>

          <button
            type="button"
            class="admin-line-station-modal-close"
            id="close-add-facility-modal"
            aria-label="Close add facilities dialog"
          >
            ×
          </button>
        </div>

        {
          facilities.length > 0 ? (
            <div
              class="admin-form"
              id="add-facilities-form"
            >
              <div class="admin-facility-checkbox-grid">
                {facilities.map(
                  (facility) => (
                    <label
                      class="admin-facility-checkbox-item"
                      data-facility-option
                      data-facility-option-id={
                        facility.id
                      }
                    >
                      <input
                        type="checkbox"
                        value={facility.id}
                        class="add-facility-checkbox"
                        data-facility-id={
                          facility.id
                        }
                        data-facility-name={
                          facility.name
                        }
                        data-facility-slug={
                          facility.slug
                        }
                      />

                      <span>
                        {facility.name}
                      </span>
                    </label>
                  ),
                )}
              </div>

              <p
                id="selected-facility-count"
                class="admin-feature-message"
              >
                0 facilities selected
              </p>

              <div class="admin-form-actions">
                <Button
                  type="button"
                  variant="secondary"
                  id="cancel-add-facilities"
                >
                  Cancel
                </Button>

                <Button
                  type="button"
                  variant="primary"
                  id="add-selected-facilities"
                  disabled
                >
                  Add Selected
                </Button>
              </div>
            </div>
          ) : (
            <EmptyState
              title="No Facilities Available"
              description="Add facilities to the master facility list first."
            />
          )
        }
      </div>
    </div>

    <!-- ========================================
         Remove Facility Confirmation
    ========================================= -->

    <ConfirmDialog
      id="remove-facility-confirm-dialog"
      title="Remove Facility"
      description="Are you sure you want to remove this facility from the station?"
      confirmText="Remove"
      cancelText="Cancel"
      variant="danger"
    />

    <!-- ========================================
         Create Station Confirmation
    ========================================= -->

    <ConfirmDialog
      id="create-station-confirm-dialog"
      title="Create Station"
      description="Are you sure you want to create this station?"
      confirmText="Create Station"
      cancelText="Cancel"
      variant="primary"
    />

    <script>
      import "../../../scripts/admin/stations-new.ts";
    </script>
  
  </Fragment>
</AdminLayout>
