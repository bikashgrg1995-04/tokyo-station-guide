---
import AdminLayout from "../../../../layouts/AdminLayout.astro";
import "../../../../styles/admin/forms.css";
import "../../../../styles/admin/stations.css";
import "../../../../styles/admin/station-sides.css";

import Breadcrumbs from "../../../../components/common/Breadcrumbs.astro";

import { getStationById } from "../../../../lib/db/stations";
import { handleStationFaqs } from "../../../../lib/services/station-faqs";

export const prerender = false;

const { env } = await import("cloudflare:workers");
const db = env.DB;
const id = Number(Astro.params.id);

if (!Number.isInteger(id) || id <= 0) return Astro.redirect("/admin/stations");
const station = await getStationById(db, id);
if (!station) return Astro.redirect("/admin/stations");

const form = await handleStationFaqs(Astro.request, db, id);
if (form.redirectTo) return Astro.redirect(form.redirectTo);

const nextOrder = form.faqs.reduce((max, f) => Math.max(max, f.sort_order), 0) + 1;
---

<AdminLayout title={`FAQs - ${station.name}`} activePath="/admin/stations">
  <header class="admin-topbar">
    <Breadcrumbs backHref="/admin/stations" parentLabel="Stations" current="FAQs" />
  </header>

  <div class="admin-content">
    <div class="admin-page-header">
      <div>
        <h2>FAQs</h2>
        <p>For <strong>{station.name}</strong>: the question and answer list under "FAQ" on the public page.</p>
      </div>
    </div>

    {
      form.faqs.map((faq) => (
        <section class="admin-panel sides-panel">
          <form method="POST" class="admin-panel-body">
            <input type="hidden" name="item_id" value={faq.id} />
            {form.errorFor === `faq-${faq.id}` && <div class="admin-form-error" role="alert">{form.formError}</div>}
            <div class="admin-form-grid">
              <div class="admin-form-group full-width">
                <label>Question</label>
                <input name="question" required maxlength="300" value={faq.question} />
              </div>
              <div class="admin-form-group full-width">
                <label>Question (Japanese)</label>
                <input name="question_japanese" lang="ja" maxlength="300" value={faq.question_japanese ?? ""} />
              </div>
              <div class="admin-form-group full-width">
                <label>Answer</label>
                <textarea name="answer" required rows="3" maxlength="1500">{faq.answer}</textarea>
              </div>
              <div class="admin-form-group full-width">
                <label>Answer (Japanese)</label>
                <textarea name="answer_japanese" lang="ja" rows="3" maxlength="1500">{faq.answer_japanese ?? ""}</textarea>
              </div>
              <div class="admin-form-group">
                <label>Order</label>
                <input name="sort_order" type="number" min="0" value={faq.sort_order} />
              </div>
            </div>
            <div class="admin-form-actions">
              <button type="submit" name="faq_action" value="faq_update" class="common-button common-button-primary">Save</button>
              <button type="submit" name="faq_action" value="faq_delete" class="common-button common-button-danger" formnovalidate onclick="return confirm('Delete this FAQ?')">Delete</button>
            </div>
          </form>
        </section>
      ))
    }

    <section class="admin-panel sides-panel">
      <form method="POST" class="admin-panel-body">
        <h3 class="sides-title">Add a FAQ</h3>
        {form.errorFor === "faq-new" && <div class="admin-form-error" role="alert">{form.formError}</div>}
        <div class="admin-form-grid">
          <div class="admin-form-group full-width">
            <label>Question</label>
            <input name="question" required maxlength="300" />
          </div>
          <div class="admin-form-group full-width">
            <label>Question (Japanese)</label>
            <input name="question_japanese" lang="ja" maxlength="300" />
          </div>
          <div class="admin-form-group full-width">
            <label>Answer</label>
            <textarea name="answer" required rows="3" maxlength="1500"></textarea>
          </div>
          <div class="admin-form-group full-width">
            <label>Answer (Japanese)</label>
            <textarea name="answer_japanese" lang="ja" rows="3" maxlength="1500"></textarea>
          </div>
          <div class="admin-form-group">
            <label>Order</label>
            <input name="sort_order" type="number" min="0" value={nextOrder} />
          </div>
        </div>
        <div class="admin-form-actions">
          <button type="submit" name="faq_action" value="faq_create" class="common-button common-button-primary">Add FAQ</button>
        </div>
      </form>
    </section>
  </div>
</AdminLayout>
