---
import AdminLayout from "../../../../layouts/AdminLayout.astro";
import Breadcrumbs from "../../../../components/common/Breadcrumbs.astro";
import StationPlacesView from "../../../../components/admin/StationPlacesView.astro";
import { getStationById } from "../../../../lib/db/stations";
import { PLACE_KINDS } from "../../../../lib/db/places";
import { handleStationPlaces } from "../../../../lib/services/places";

export const prerender = false;

const { env } = await import("cloudflare:workers");
const info = PLACE_KINDS.restaurant;
const id = Number(Astro.params.id);

if (!Number.isInteger(id) || id <= 0) return Astro.redirect("/admin/stations");
const station = await getStationById(env.DB, id);
if (!station) return Astro.redirect("/admin/stations");

const form = await handleStationPlaces(Astro.request, env.DB, info, id);
if (form.redirectTo) return Astro.redirect(form.redirectTo);
---

<AdminLayout title={`Restaurants - ${station.name}`} activePath="/admin/stations">
  <header class="admin-topbar">
    <Breadcrumbs backHref="/admin/stations" parentLabel="Stations" current="Restaurants" />
  </header>
  <StationPlacesView info={info} stationName={station.name} form={form} />
</AdminLayout>
