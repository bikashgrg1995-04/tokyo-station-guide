---
import AdminLayout from "../../../../layouts/AdminLayout.astro";
import StationSectionNav from "../../../../components/admin/StationSectionNav.astro";
import "../../../../styles/admin/forms.css";
import "../../../../styles/admin/stations.css";
import "../../../../styles/admin/station-sides.css";

import Breadcrumbs from "../../../../components/common/Breadcrumbs.astro";

import { getStationById } from "../../../../lib/db/stations";
import { handleTransport } from "../../../../lib/services/station-transport";

export const prerender = false;

const { env } = await import("cloudflare:workers");
const db = env.DB;
const id = Number(Astro.params.id);

if (!Number.isInteger(id) || id <= 0) return Astro.redirect("/admin/stations");
const station = await getStationById(db, id);
if (!station) return Astro.redirect("/admin/stations");

const form = await handleTransport(Astro.request, db, id, station.slug);
if (form.redirectTo) return Astro.redirect(form.redirectTo);

const mediaBase =
  String((env as { MEDIA_BASE_URL?: string }).MEDIA_BASE_URL ?? "")
    .trim()
    .replace(/\/+$/, "") || "/media";
const src = (k: string) => (/^https?:\/\//i.test(k) ? k : `${mediaBase}/${k}`);
const nextOrder = form.items.reduce((max, t) => Math.max(max, t.sort_order), 0) + 1;

const blank = {
  id: 0, place: "", place_japanese: "", service: "", service_japanese: "", notes: "", notes_japanese: "",
  photo: null as string | null, photo_title: "", photo_title_japanese: "", photo_caption: "", photo_caption_japanese: "",
  sort_order: nextOrder,
};
const forms = [...form.items.map((t) => ({ t, scope: `item-${t.id}`, isNew: false })), { t: blank, scope: "item-new", isNew: true }];
---

<AdminLayout title={`Buses & taxis - ${station.name}`} activePath="/admin/stations">
  <header class="admin-topbar">
    <Breadcrumbs backHref="/admin/stations" parentLabel="Stations" current="Buses & taxis" />
  </header>

  <div class="station-admin-frame">
    <StationSectionNav stationId={id} stationName={station.name} active="buses-taxis" />
  <div class="admin-content">
    <div class="admin-page-header">
      <div>
        <h2>Buses & taxis</h2>
        <p>
          For <strong>{station.name}</strong>: the "Buses &amp; taxis" section on the public page. A row with a service or
          notes is listed in the table (Where / Service / Notes); a row with a photo also gets a photo card (photo
          title + caption). Leave service and notes empty to show only the photo card.
        </p>
      </div>
    </div>

    {
      forms.map(({ t, scope, isNew }) => (
        <section class="admin-panel sides-panel">
          <form method="POST" enctype="multipart/form-data" class="admin-panel-body">
            <h3 class="sides-title">{isNew ? "Add a row" : t.place}</h3>
            {!isNew && <input type="hidden" name="item_id" value={t.id} />}
            {form.errorFor === scope && <div class="admin-form-error" role="alert">{form.formError}</div>}
            <div class="admin-form-grid">
              <div class="admin-form-group">
                <label>Where</label>
                <input name="place" required maxlength="150" value={t.place} placeholder="Marunouchi North Exit" />
              </div>
              <div class="admin-form-group">
                <label>Where (Japanese)</label>
                <input name="place_japanese" lang="ja" maxlength="150" value={t.place_japanese ?? ""} />
              </div>
              <div class="admin-form-group">
                <label>Service</label>
                <textarea name="service" rows="2" maxlength="400">{t.service ?? ""}</textarea>
              </div>
              <div class="admin-form-group">
                <label>Service (Japanese)</label>
                <textarea name="service_japanese" lang="ja" rows="2" maxlength="400">{t.service_japanese ?? ""}</textarea>
              </div>
              <div class="admin-form-group">
                <label>Notes</label>
                <textarea name="notes" rows="3" maxlength="800">{t.notes ?? ""}</textarea>
              </div>
              <div class="admin-form-group">
                <label>Notes (Japanese)</label>
                <textarea name="notes_japanese" lang="ja" rows="3" maxlength="800">{t.notes_japanese ?? ""}</textarea>
              </div>
              <div class="admin-form-group">
                <label>Photo title</label>
                <input name="photo_title" maxlength="150" value={t.photo_title ?? ""} placeholder="Airport Limousine stop" />
              </div>
              <div class="admin-form-group">
                <label>Photo title (Japanese)</label>
                <input name="photo_title_japanese" lang="ja" maxlength="150" value={t.photo_title_japanese ?? ""} />
              </div>
              <div class="admin-form-group">
                <label>Photo caption</label>
                <textarea name="photo_caption" rows="2" maxlength="400">{t.photo_caption ?? ""}</textarea>
              </div>
              <div class="admin-form-group">
                <label>Photo caption (Japanese)</label>
                <textarea name="photo_caption_japanese" lang="ja" rows="2" maxlength="400">{t.photo_caption_japanese ?? ""}</textarea>
              </div>
              <div class="admin-form-group">
                <label>Order</label>
                <input name="sort_order" type="number" min="0" value={t.sort_order} />
              </div>
              <div class="admin-form-group full-width">
                <label>Photo (optional, PNG, JPEG or WebP up to 2 MB)</label>
                {t.photo && (
                  <div>
                    <img src={src(t.photo)} alt="" style="display:block;width:160px;max-width:100%;margin-bottom:8px;border-radius:8px" />
                    <label><input type="checkbox" name="remove_photo" /> Remove the current photo</label>
                  </div>
                )}
                <input name="photo_file" type="file" accept="image/png,image/jpeg,image/webp" />
              </div>
            </div>
            <div class="admin-form-actions">
              {isNew ? (
                <button type="submit" name="guide_action" value="guide_create" class="common-button common-button-primary">Add row</button>
              ) : (
                <>
                  <button type="submit" name="guide_action" value="guide_update" class="common-button common-button-primary">Save</button>
                  <button type="submit" name="guide_action" value="guide_delete" class="common-button common-button-danger" formnovalidate onclick="return confirm('Delete this row?')">Delete</button>
                </>
              )}
            </div>
          </form>
        </section>
      ))
    }
  </div>
  </div>
</AdminLayout>
