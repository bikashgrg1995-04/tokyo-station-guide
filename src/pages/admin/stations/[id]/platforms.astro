---
import AdminLayout from "../../../../layouts/AdminLayout.astro";
import StationSectionNav from "../../../../components/admin/StationSectionNav.astro";
import "../../../../styles/admin/forms.css";
import "../../../../styles/admin/stations.css";
import "../../../../styles/admin/tables.css";
import "../../../../styles/admin/lines.css";

import Breadcrumbs from "../../../../components/common/Breadcrumbs.astro";
import StationPlatformsPanel from "../../../../components/admin/StationPlatformsPanel.astro";

import { getStationById } from "../../../../lib/db/stations";
import { handleStationPlatforms } from "../../../../lib/services/station-platforms";

export const prerender = false;

const { env } = await import("cloudflare:workers");
const db = env.DB;

const id = Number(Astro.params.id);

if (!Number.isInteger(id) || id <= 0) {
  return Astro.redirect("/admin/stations");
}

const station = await getStationById(db, id);

if (!station) {
  return Astro.redirect("/admin/stations");
}

const platformForm = await handleStationPlatforms(
  Astro.request,
  db,
  id,
);

if (platformForm.redirectTo) {
  return Astro.redirect(platformForm.redirectTo);
}
---

<AdminLayout
  title={`Manage Platforms - ${station.name}`}
  activePath="/admin/stations"
>
  <header class="admin-topbar">
    <Breadcrumbs
      backHref="/admin/stations"
      parentLabel="Stations"
      current="Manage Platforms"
    />
  </header>

  <div class="station-admin-frame">
    <StationSectionNav stationId={id} stationName={station.name} active="platforms" />
  <div class="admin-content">
    <div class="admin-page-header">
      <div>
        <h2>Manage Platforms</h2>
        <p>
          Manage platform numbers, destinations, railway lines, and walking
          guidance for <strong>{station.name}</strong>.
        </p>
      </div>

    
    </div>

    <StationPlatformsPanel
      stationName={station.name}
      stationId={station.id}
      platforms={platformForm.platforms}
      lines={platformForm.lines}
      values={platformForm.values}
      errors={platformForm.errors}
      formError={platformForm.formError}
      editingId={platformForm.editingId}
    />
  </div>
  </div>
</AdminLayout>