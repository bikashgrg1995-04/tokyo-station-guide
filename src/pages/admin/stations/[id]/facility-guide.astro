---
import AdminLayout from "../../../../layouts/AdminLayout.astro";
import "../../../../styles/admin/forms.css";
import "../../../../styles/admin/stations.css";
import "../../../../styles/admin/station-sides.css";

import Breadcrumbs from "../../../../components/common/Breadcrumbs.astro";

import { getStationById } from "../../../../lib/db/stations";
import { handleFacilityGuide } from "../../../../lib/services/station-facility-guide";

export const prerender = false;

const { env } = await import("cloudflare:workers");
const db = env.DB;
const id = Number(Astro.params.id);

if (!Number.isInteger(id) || id <= 0) return Astro.redirect("/admin/stations");
const station = await getStationById(db, id);
if (!station) return Astro.redirect("/admin/stations");

const form = await handleFacilityGuide(Astro.request, db, id, station.slug);
if (form.redirectTo) return Astro.redirect(form.redirectTo);

const mediaBase =
  String((env as { MEDIA_BASE_URL?: string }).MEDIA_BASE_URL ?? "")
    .trim()
    .replace(/\/+$/, "") || "/media";
const src = (k: string) => (/^https?:\/\//i.test(k) ? k : `${mediaBase}/${k}`);
const nextOrder = form.items.reduce((max, t) => Math.max(max, t.sort_order), 0) + 1;

const blank = {
  id: 0, name: "", name_japanese: "", description: "", description_japanese: "", photo: null as string | null,
  photo_caption: "", photo_caption_japanese: "", sort_order: nextOrder,
};
const forms = [...form.items.map((t) => ({ t, scope: `item-${t.id}`, isNew: false })), { t: blank, scope: "item-new", isNew: true }];
---

<AdminLayout title={`Facilities guide - ${station.name}`} activePath="/admin/stations">
  <header class="admin-topbar">
    <Breadcrumbs backHref="/admin/stations" parentLabel="Stations" current="Facilities guide" />
  </header>

  <div class="admin-content">
    <div class="admin-page-header">
      <div>
        <h2>Facilities guide</h2>
        <p>
          For <strong>{station.name}</strong>: the "Facilities" section on the public page. A facility with a description
          is listed in the table; a facility with a photo also gets a photo card (name + photo caption). Leave the
          description empty to show only the photo card.
        </p>
      </div>
    </div>

    {
      forms.map(({ t, scope, isNew }) => (
        <section class="admin-panel sides-panel">
          <form method="POST" enctype="multipart/form-data" class="admin-panel-body">
            <h3 class="sides-title">{isNew ? "Add a facility" : t.name}</h3>
            {!isNew && <input type="hidden" name="item_id" value={t.id} />}
            {form.errorFor === scope && <div class="admin-form-error" role="alert">{form.formError}</div>}
            <div class="admin-form-grid">
              <div class="admin-form-group">
                <label>Name</label>
                <input name="name" required maxlength="150" value={t.name} placeholder="Coin lockers" />
              </div>
              <div class="admin-form-group">
                <label>Name (Japanese)</label>
                <input name="name_japanese" lang="ja" maxlength="150" value={t.name_japanese ?? ""} />
              </div>
              <div class="admin-form-group full-width">
                <label>What to know</label>
                <textarea name="description" rows="4" maxlength="1500">{t.description ?? ""}</textarea>
              </div>
              <div class="admin-form-group full-width">
                <label>What to know (Japanese)</label>
                <textarea name="description_japanese" lang="ja" rows="4" maxlength="1500">{t.description_japanese ?? ""}</textarea>
              </div>
              <div class="admin-form-group">
                <label>Photo caption</label>
                <textarea name="photo_caption" rows="2" maxlength="400">{t.photo_caption ?? ""}</textarea>
              </div>
              <div class="admin-form-group">
                <label>Photo caption (Japanese)</label>
                <textarea name="photo_caption_japanese" lang="ja" rows="2" maxlength="400">{t.photo_caption_japanese ?? ""}</textarea>
              </div>
              <div class="admin-form-group">
                <label>Order</label>
                <input name="sort_order" type="number" min="0" value={t.sort_order} />
              </div>
              <div class="admin-form-group full-width">
                <label>Photo (optional, PNG, JPEG or WebP up to 2 MB)</label>
                {t.photo && (
                  <div>
                    <img src={src(t.photo)} alt="" style="display:block;width:160px;max-width:100%;margin-bottom:8px;border-radius:8px" />
                    <label><input type="checkbox" name="remove_photo" /> Remove the current photo</label>
                  </div>
                )}
                <input name="photo_file" type="file" accept="image/png,image/jpeg,image/webp" />
              </div>
            </div>
            <div class="admin-form-actions">
              {isNew ? (
                <button type="submit" name="guide_action" value="guide_create" class="common-button common-button-primary">Add facility</button>
              ) : (
                <>
                  <button type="submit" name="guide_action" value="guide_update" class="common-button common-button-primary">Save</button>
                  <button type="submit" name="guide_action" value="guide_delete" class="common-button common-button-danger" formnovalidate onclick="return confirm('Delete this facility?')">Delete</button>
                </>
              )}
            </div>
          </form>
        </section>
      ))
    }
  </div>
</AdminLayout>
