---
import "../../../../styles/admin/shared.css";
import "../../../../styles/admin/forms.css";
import "../../../../styles/admin/stations.css";

import AdminNavigation from "../../../../common_components/AdminNavigation.astro";
import Button from "../../../../common_components/Button.astro";
import ConfirmDialog from "../../../../common_components/ConfirmDialog.astro";

import {
  getStationById,
  updateStation,
  linesToJson,
  jsonToLines,
  connectionsToJson,
  jsonToConnections,
  validateLineList,
} from "../../../../lib/db/stations";

export const prerender = false;

const { env } = await import("cloudflare:workers");
const db = env.DB;

const id = Number(Astro.params.id);

if (!Number.isInteger(id) || id <= 0) {
  return Astro.redirect("/admin/stations");
}

const station = await getStationById(db, id);

if (!station) {
  return Astro.redirect("/admin/stations");
}

let formError = "";

let name = station.name;
let nameJapanese = station.name_japanese ?? "";
let slug = station.slug;
let latitudeValue = station.latitude !== null ? String(station.latitude) : "";
let longitudeValue =
  station.longitude !== null ? String(station.longitude) : "";
let description = station.description ?? "";
let about = station.about ?? "";
let facilitiesText = jsonToLines(station.facilities);
let topPicksText = jsonToLines(station.top_picks);
let connectionsText = jsonToConnections(station.connections);

const errors = {
  name: "",
  nameJapanese: "",
  slug: "",
  latitude: "",
  longitude: "",
  description: "",
  about: "",
  facilities: "",
  topPicks: "",
  connections: "",
};

if (Astro.request.method === "POST") {
  const formData = await Astro.request.formData();

  name = String(formData.get("name") ?? "").trim();

  nameJapanese = String(formData.get("name_japanese") ?? "").trim();

  slug = String(formData.get("slug") ?? "")
    .trim()
    .toLowerCase();

  latitudeValue = String(formData.get("latitude") ?? "").trim();

  longitudeValue = String(formData.get("longitude") ?? "").trim();

  description = String(formData.get("description") ?? "").trim();

  about = String(formData.get("about") ?? "").trim();

  facilitiesText = String(formData.get("facilities") ?? "");

  topPicksText = String(formData.get("top_picks") ?? "");

  connectionsText = String(formData.get("connections") ?? "");

  const latitude = latitudeValue === "" ? null : Number(latitudeValue);

  const longitude = longitudeValue === "" ? null : Number(longitudeValue);

  if (!name) {
    errors.name = "Station name is required.";
  } else if (name.length > 150) {
    errors.name = "Station name must be 150 characters or less.";
  }

  if (nameJapanese.length > 150) {
    errors.nameJapanese = "Japanese name must be 150 characters or less.";
  }

  if (!slug) {
    errors.slug = "Slug is required.";
  } else if (!/^[a-z0-9]+(?:-[a-z0-9]+)*$/.test(slug)) {
    errors.slug =
      "Slug can only contain lowercase letters, numbers, and hyphens.";
  } else if (slug.length > 150) {
    errors.slug = "Slug must be 150 characters or less.";
  }

  if (latitude !== null && !Number.isFinite(latitude)) {
    errors.latitude = "Latitude must be a valid number.";
  } else if (latitude !== null && (latitude < -90 || latitude > 90)) {
    errors.latitude = "Latitude must be between -90 and 90.";
  }

  if (longitude !== null && !Number.isFinite(longitude)) {
    errors.longitude = "Longitude must be a valid number.";
  } else if (longitude !== null && (longitude < -180 || longitude > 180)) {
    errors.longitude = "Longitude must be between -180 and 180.";
  }

  if (description.length > 1000) {
    errors.description = "Description must be 1000 characters or less.";
  }

  if (about.length > 1000) {
    errors.about = "About must be 1000 characters or less.";
  }

  errors.facilities = validateLineList(facilitiesText, "Facilities");

  errors.topPicks = validateLineList(topPicksText, "Top picks");

  const connectionsResult = connectionsToJson(connectionsText);

  errors.connections = connectionsResult.error;

  const hasValidationErrors = Object.values(errors).some(
    (message) => message.length > 0,
  );

  if (!hasValidationErrors) {
    try {
      await updateStation(db, id, {
        name,
        nameJapanese: nameJapanese || null,
        slug,
        latitude,
        longitude,
        description: description || null,
        about: about || null,
        facilities: linesToJson(facilitiesText),
        topPicks: linesToJson(topPicksText),
        connections: connectionsResult.json,
      });

      return Astro.redirect("/admin/stations");
    } catch (err) {
      console.error(err);

      formError =
        "Unable to update station. The name or slug may already exist.";
    }
  }
}

const admin = await Astro.session?.get<{
  id: number;
  email: string;
  name: string;
}>("admin");
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />

    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <meta name="robots" content="noindex, nofollow" />

    <title>
      Edit {station.name} | Admin | Tokyo Station Guide
    </title>
  </head>

  <body>
    <div class="admin-shell">
      <AdminNavigation activePath="/admin/stations" />

      <main class="admin-main">
        <header class="admin-topbar">
          <div class="admin-breadcrumb">
            <Button href="/admin/stations" variant="secondary"> ← </Button>

            <a href="/admin/stations"> Stations </a>

            <span>/</span>

            <strong>Edit Station</strong>
          </div>
        </header>

        <div class="admin-content">
          <h2>Edit Station</h2>

          <p>
            Update the railway station information for the Tokyo Station Guide.
          </p>

          <section class="admin-panel">
            <div class="admin-panel-body">
              <div class="admin-station-form">
                <div class="admin-station-form-header">
                  <h3>Station Details</h3>

                  <p>
                    Update the information for
                    <strong>{station.name}</strong>.
                  </p>
                </div>

                {
                  formError && (
                    <div class="admin-alert admin-alert-error">{formError}</div>
                  )
                }

                <form method="POST" class="admin-form" id="edit-station-form">
                  <div class="admin-form-grid">
                    <div class="admin-form-group">
                      <label for="name"> Station Name </label>

                      <input
                        id="name"
                        name="name"
                        type="text"
                        required
                        value={name}
                        aria-invalid={errors.name ? "true" : "false"}
                        aria-describedby={errors.name
                          ? "name-error"
                          : undefined}
                      />

                      {
                        errors.name && (
                          <small id="name-error" class="admin-form-error">
                            {errors.name}
                          </small>
                        )
                      }
                    </div>

                    <div class="admin-form-group">
                      <label for="name_japanese"> Japanese Name </label>

                      <input
                        id="name_japanese"
                        name="name_japanese"
                        type="text"
                        class="admin-station-japanese-input"
                        value={nameJapanese}
                        aria-invalid={errors.nameJapanese ? "true" : "false"}
                        aria-describedby={errors.nameJapanese
                          ? "name-japanese-error"
                          : undefined}
                      />

                      {
                        errors.nameJapanese && (
                          <small
                            id="name-japanese-error"
                            class="admin-form-error"
                          >
                            {errors.nameJapanese}
                          </small>
                        )
                      }
                    </div>

                    <div class="admin-form-group full-width">
                      <label for="slug"> Slug </label>

                      <input
                        id="slug"
                        name="slug"
                        type="text"
                        required
                        value={slug}
                        aria-invalid={errors.slug ? "true" : "false"}
                        aria-describedby={errors.slug
                          ? "slug-error"
                          : "slug-help"}
                      />

                      {
                        errors.slug ? (
                          <small id="slug-error" class="admin-form-error">
                            {errors.slug}
                          </small>
                        ) : (
                          <small id="slug-help">
                            Use lowercase letters, numbers and hyphens.
                          </small>
                        )
                      }
                    </div>

                    <div class="admin-form-group">
                      <label for="latitude"> Latitude </label>

                      <input
                        id="latitude"
                        name="latitude"
                        type="number"
                        step="any"
                        value={latitudeValue}
                        aria-invalid={errors.latitude ? "true" : "false"}
                        aria-describedby="latitude-help"
                      />

                      {
                        errors.latitude ? (
                          <small class="admin-form-error">
                            {errors.latitude}
                          </small>
                        ) : (
                          <small id="latitude-help">
                            Optional. Range: -90 to 90.
                          </small>
                        )
                      }
                    </div>

                    <div class="admin-form-group">
                      <label for="longitude"> Longitude </label>

                      <input
                        id="longitude"
                        name="longitude"
                        type="number"
                        step="any"
                        value={longitudeValue}
                        aria-invalid={errors.longitude ? "true" : "false"}
                        aria-describedby="longitude-help"
                      />

                      {
                        errors.longitude ? (
                          <small class="admin-form-error">
                            {errors.longitude}
                          </small>
                        ) : (
                          <small id="longitude-help">
                            Optional. Range: -180 to 180.
                          </small>
                        )
                      }
                    </div>

                    <div class="admin-form-group full-width">
                      <label for="description"> Description </label>

                      <textarea
                        id="description"
                        name="description"
                        rows="5"
                        class="admin-station-description"
                        aria-invalid={errors.description ? "true" : "false"}
                        aria-describedby={errors.description
                          ? "description-error"
                          : undefined}>{description}</textarea
                      >

                      {
                        errors.description && (
                          <small
                            id="description-error"
                            class="admin-form-error"
                          >
                            {errors.description}
                          </small>
                        )
                      }
                    </div>

                    <div class="admin-form-group full-width">
                      <label for="about"> About (station popup) </label>

                      <textarea
                        id="about"
                        name="about"
                        rows="4"
                        class="admin-station-description"
                        placeholder="Short text shown in the About section of the station popup..."
                        aria-invalid={errors.about ? "true" : "false"}
                        aria-describedby={errors.about
                          ? "about-error"
                          : undefined}>{about}</textarea
                      >

                      {
                        errors.about ? (
                          <small id="about-error" class="admin-form-error">
                            {errors.about}
                          </small>
                        ) : (
                          <small>Optional. Up to 1000 characters.</small>
                        )
                      }
                    </div>

                    <div class="admin-form-group">
                      <label for="facilities"> Facilities </label>

                      <textarea
                        id="facilities"
                        name="facilities"
                        rows="5"
                        placeholder={"Coin Lockers\nTicket Office\nWi-Fi"}
                        aria-invalid={errors.facilities ? "true" : "false"}
                        aria-describedby={errors.facilities
                          ? "facilities-error"
                          : undefined}>{facilitiesText}</textarea
                      >

                      {
                        errors.facilities ? (
                          <small
                            id="facilities-error"
                            class="admin-form-error"
                          >
                            {errors.facilities}
                          </small>
                        ) : (
                          <small>One item per line.</small>
                        )
                      }
                    </div>

                    <div class="admin-form-group">
                      <label for="top_picks"> Top Picks </label>

                      <textarea
                        id="top_picks"
                        name="top_picks"
                        rows="5"
                        placeholder={"Imperial Palace\nRamen Street"}
                        aria-invalid={errors.topPicks ? "true" : "false"}
                        aria-describedby={errors.topPicks
                          ? "top-picks-error"
                          : undefined}>{topPicksText}</textarea
                      >

                      {
                        errors.topPicks ? (
                          <small id="top-picks-error" class="admin-form-error">
                            {errors.topPicks}
                          </small>
                        ) : (
                          <small>One item per line.</small>
                        )
                      }
                    </div>

                    <div class="admin-form-group full-width">
                      <label for="connections"> Connections </label>

                      <textarea
                        id="connections"
                        name="connections"
                        rows="6"
                        placeholder={"Chuo Line | #f15a22\nNarita Express (N'EX)"}
                        aria-invalid={errors.connections ? "true" : "false"}
                        aria-describedby={errors.connections
                          ? "connections-error"
                          : "connections-help"}>{connectionsText}</textarea
                      >

                      {
                        errors.connections ? (
                          <small
                            id="connections-error"
                            class="admin-form-error"
                          >
                            {errors.connections}
                          </small>
                        ) : (
                          <small id="connections-help">
                            One per line: Name | #color (color is optional).
                            Leave empty to show other lines from the database.
                          </small>
                        )
                      }
                    </div>
                  </div>

                  <div class="admin-form-actions">
                    <Button href="/admin/stations" variant="secondary">
                      Cancel
                    </Button>

                    <Button type="submit" variant="primary">
                      Save Changes
                    </Button>
                  </div>
                </form>
              </div>
            </div>
          </section>
        </div>
      </main>
    </div>
  </body>
</html>

<ConfirmDialog
  id="edit-station-confirm-dialog"
  title="Save Changes"
  description="Are you sure you want to save these station changes?"
  confirmText="Save Changes"
  cancelText="Cancel"
  variant="primary"
/>

<script>
  const editStationForm = document.getElementById("edit-station-form");

  const editStationDialog = document.getElementById(
    "edit-station-confirm-dialog",
  );

  if (
    editStationForm instanceof HTMLFormElement &&
    editStationDialog instanceof HTMLDivElement
  ) {
    let confirmed = false;

    editStationForm.addEventListener("submit", (event) => {
      if (confirmed) {
        return;
      }

      event.preventDefault();

      editStationDialog.dispatchEvent(new CustomEvent("dialog:open"));
    });

    editStationDialog.addEventListener("confirm", () => {
      confirmed = true;
      editStationForm.submit();
    });
  }
</script>