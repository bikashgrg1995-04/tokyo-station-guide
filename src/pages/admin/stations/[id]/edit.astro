---
import AdminLayout from "../../../../layouts/AdminLayout.astro";
import StationSectionNav from "../../../../components/admin/StationSectionNav.astro";
import "../../../../styles/admin/forms.css";
import "../../../../styles/admin/stations.css";
import "../../../../styles/admin/tables.css";

import Alert from "../../../../components/common/Alert.astro";
import Breadcrumbs from "../../../../components/common/Breadcrumbs.astro";
import Button from "../../../../components/common/Button.astro";
import ConfirmDialog from "../../../../components/common/ConfirmDialog.astro";

import StationFormFields from "../../../../components/admin/StationFormFields.astro";
import StationFacilitiesPanel from "../../../../components/admin/StationFacilitiesPanel.astro";
import FacilityModal from "../../../../components/admin/FacilityModal.astro";
import FacilityExitPickerModal from "../../../../components/admin/FacilityExitPickerModal.astro";

import { getStationFloors } from "../../../../lib/db/station-floors";
import { getStationById } from "../../../../lib/db/stations";
import { handleStationUpdate } from "../../../../lib/services/stations";
import { getRestaurantsNote } from "../../../../lib/db/places";

export const prerender = false;

const { env } = await import("cloudflare:workers");
const db = env.DB;

const id = Number(Astro.params.id);

if (!Number.isInteger(id) || id <= 0) {
  return Astro.redirect("/admin/stations");
}

const station = await getStationById(db, id);

if (!station) {
  return Astro.redirect("/admin/stations");
}

const stationFloors = await getStationFloors(db, id);

const form = await handleStationUpdate(Astro.request, db, id, station);

if (form.redirectTo) {
  return Astro.redirect(form.redirectTo);
}

const {
  errors,
  formError,
  stationFacilities,
  availableFacilities,
  stationExits,
} = form;

const facilityError = errors.facilities;
const savedNote = await getRestaurantsNote(db, id);
const noteValue = form.restaurantsNote ?? savedNote.note;
const noteJaValue = form.restaurantsNoteJapanese ?? savedNote.noteJapanese;
---

<AdminLayout title={`Edit ${station.name}`} activePath="/admin/stations">
  <header class="admin-topbar">
    <Breadcrumbs
      backHref="/admin/stations"
      parentLabel="Stations"
      current="Edit Station"
    />
  </header>

  <div class="station-admin-frame">
    <StationSectionNav stationId={id} stationName={station.name} active="details" />
  <div class="admin-content admin-station-page">
    <h2>Edit Station</h2>

    <form method="POST" enctype="multipart/form-data" class="admin-form" id="edit-station-form">
      <input type="hidden" name="action" value="update" />

      <!-- Station Details -->
      <section class="admin-panel">
        <div class="admin-panel-body">
          <div class="admin-station-form-header">
            <h3>Station Details</h3>
          </div>

          {formError && <Alert>{formError}</Alert>}

          <StationFormFields values={form.values} errors={errors} mainImage={station.main_image} />

          <div class="admin-form-grid" id="restaurants-note" style="margin-top:1rem">
            <div class="admin-form-group full-width">
              <label for="restaurants_note">
                Restaurants note <span class="admin-label-hint">shown above the restaurants list, use **text** for bold</span>
              </label>
              <textarea id="restaurants_note" name="restaurants_note" rows="2" maxlength="1000">{noteValue}</textarea>
            </div>
            <div class="admin-form-group full-width">
              <label for="restaurants_note_japanese">Restaurants note (Japanese)</label>
              <textarea id="restaurants_note_japanese" name="restaurants_note_japanese" lang="ja" rows="2" maxlength="1000">{noteJaValue}</textarea>
            </div>
          </div>
        </div>
      </section>

      <!-- Facilities -->
      <div id="facilities"></div>
      <StationFacilitiesPanel
        assigned={stationFacilities}
        canAdd={stationFloors.length > 0 && availableFacilities.length > 0}
        error={facilityError}
        allAddedMessage="No facilities are available in the master list."
      >
        Floor, quantity, nearby exits and an optional note for each facility at
        <strong>{station.name}</strong>.
      </StationFacilitiesPanel>

      <!-- Form Actions -->
      <div class="admin-form-actions">
        <Button href="/admin/stations" variant="secondary"> Cancel </Button>

        <Button type="submit" variant="primary" id="save-station-button">
          Save Changes
        </Button>
      </div>
    </form>
  </div>

  </div>
  <Fragment slot="after">
    <!-- Add Facilities Modal -->
    <FacilityModal
      facilities={availableFacilities}
      floors={stationFloors}
      description={`Select facilities to add floor entries for ${station.name}.`}
      emptyDescription="No facilities are available in the master facility list."
    />

    <!-- Select Nearby Exits for Facility Assignments -->
    <FacilityExitPickerModal
      exits={stationExits}
      floors={stationFloors}
      manageExitsHref={`/admin/stations/${id}/exits`}
    />

    <!-- Remove Facility Confirmation -->
    <ConfirmDialog
      id="remove-facility-confirm-dialog"
      title="Remove Facility Entry"
      description="Are you sure you want to remove this floor entry?"
      confirmText="Remove"
      cancelText="Cancel"
      variant="danger"
    />

    <!-- Delete the ticked facility entries -->
    <ConfirmDialog
      id="delete-selected-facilities-dialog"
      title="Delete Facility Entries"
      description="Are you sure you want to remove the selected facility entries?"
      confirmText="Delete"
      cancelText="Cancel"
      variant="danger"
    />

    <!-- Save Station Confirmation -->
    <ConfirmDialog
      id="edit-station-confirm-dialog"
      title="Save Changes"
      description="Are you sure you want to save these station changes?"
      confirmText="Save Changes"
      cancelText="Cancel"
      variant="primary"
    />

    <script>
      import "../../../../scripts/admin/stations-edit.ts";
      import "../../../../scripts/admin/facility-exit-picker.ts";
    </script>
  </Fragment>
</AdminLayout>
