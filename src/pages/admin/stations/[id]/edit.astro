---
import AdminLayout from "../../../../layouts/AdminLayout.astro";
import "../../../../styles/admin/forms.css";
import "../../../../styles/admin/stations.css";
import "../../../../styles/admin/tables.css";

import Button from "../../../../components/Button.astro";
import ConfirmDialog from "../../../../components/ConfirmDialog.astro";
import StationTopPicks from "../../../../components/StationTopPicks.astro";

import {
  getStationById,
  updateStation,
} from "../../../../lib/db/stations";

import {
  getFacilities,
  getStationFacilities,
  getAvailableFacilitiesForStation,
} from "../../../../lib/db/facilities";

import {
  getTopPicks,
  getStationTopPicks,
  getAvailableTopPicksForStation,
} from "../../../../lib/db/top-picks";

export const prerender = false;

const { env } = await import("cloudflare:workers");
const db = env.DB;

const id = Number(Astro.params.id);

if (!Number.isInteger(id) || id <= 0) {
  return Astro.redirect("/admin/stations");
}

const station = await getStationById(db, id);

if (!station) {
  return Astro.redirect("/admin/stations");
}

let formError = "";
let facilityError = "";
let topPickError = "";

let stationFacilities =
  await getStationFacilities(db, id);

let availableFacilities =
  await getAvailableFacilitiesForStation(db, id);

let stationTopPicks =
  await getStationTopPicks(db, id);

let availableTopPicks =
  await getAvailableTopPicksForStation(db, id);

let name = station.name;
let nameJapanese = station.name_japanese ?? "";
let slug = station.slug;

let latitudeValue =
  station.latitude !== null
    ? String(station.latitude)
    : "";

let longitudeValue =
  station.longitude !== null
    ? String(station.longitude)
    : "";

let description = station.description ?? "";
let about = station.about ?? "";

const errors = {
  name: "",
  nameJapanese: "",
  slug: "",
  latitude: "",
  longitude: "",
  description: "",
  about: "",
};

/* ========================================
   POST Actions
======================================== */

if (Astro.request.method === "POST") {
  const formData =
    await Astro.request.formData();

  const action = String(
    formData.get("action") ?? "",
  );

  /* ========================================
     Update Station
  ======================================== */

  if (action === "update") {
    name = String(
      formData.get("name") ?? "",
    ).trim();

    nameJapanese = String(
      formData.get("name_japanese") ?? "",
    ).trim();

    slug = String(
      formData.get("slug") ?? "",
    )
      .trim()
      .toLowerCase();

    latitudeValue = String(
      formData.get("latitude") ?? "",
    ).trim();

    longitudeValue = String(
      formData.get("longitude") ?? "",
    ).trim();

    description = String(
      formData.get("description") ?? "",
    ).trim();

    about = String(
      formData.get("about") ?? "",
    ).trim();

    const latitude =
      latitudeValue === ""
        ? null
        : Number(latitudeValue);

    const longitude =
      longitudeValue === ""
        ? null
        : Number(longitudeValue);

    /* ========================================
       Station Validation
    ======================================== */

    if (!name) {
      errors.name =
        "Station name is required.";
    } else if (name.length > 150) {
      errors.name =
        "Station name must be 150 characters or less.";
    }

    if (nameJapanese.length > 150) {
      errors.nameJapanese =
        "Japanese name must be 150 characters or less.";
    }

    if (!slug) {
      errors.slug =
        "Slug is required.";
    } else if (
      !/^[a-z0-9]+(?:-[a-z0-9]+)*$/.test(
        slug,
      )
    ) {
      errors.slug =
        "Slug can only contain lowercase letters, numbers, and hyphens.";
    } else if (slug.length > 150) {
      errors.slug =
        "Slug must be 150 characters or less.";
    }

    if (
      latitude !== null &&
      !Number.isFinite(latitude)
    ) {
      errors.latitude =
        "Latitude must be a valid number.";
    } else if (
      latitude !== null &&
      (latitude < -90 ||
        latitude > 90)
    ) {
      errors.latitude =
        "Latitude must be between -90 and 90.";
    }

    if (
      longitude !== null &&
      !Number.isFinite(longitude)
    ) {
      errors.longitude =
        "Longitude must be a valid number.";
    } else if (
      longitude !== null &&
      (longitude < -180 ||
        longitude > 180)
    ) {
      errors.longitude =
        "Longitude must be between -180 and 180.";
    }

    if (description.length > 1000) {
      errors.description =
        "Description must be 1000 characters or less.";
    }

    if (about.length > 1000) {
      errors.about =
        "About must be 1000 characters or less.";
    }

    /* ========================================
       Facility IDs
    ======================================== */

    const selectedFacilityIds = [
      ...new Set(
        formData
          .getAll("facility_ids")
          .map((value) => Number(value))
          .filter(
            (facilityId) =>
              Number.isInteger(
                facilityId,
              ) &&
              facilityId > 0,
          ),
      ),
    ];

    const allFacilities =
      await getFacilities(db);

    const validFacilityIds =
      new Set(
        allFacilities.map(
          (facility) =>
            facility.id,
        ),
      );

    const invalidFacilityIds =
      selectedFacilityIds.filter(
        (facilityId) =>
          !validFacilityIds.has(
            facilityId,
          ),
      );

    if (
      invalidFacilityIds.length > 0
    ) {
      facilityError =
        "One or more selected facilities are invalid.";
    }

    /* ========================================
       Top Pick IDs
    ======================================== */

    const selectedTopPickIds = [
      ...new Set(
        formData
          .getAll("top_pick_ids")
          .map((value) => Number(value))
          .filter(
            (topPickId) =>
              Number.isInteger(
                topPickId,
              ) &&
              topPickId > 0,
          ),
      ),
    ];

    const allTopPicks =
      await getTopPicks(db);

    const validTopPickIds =
      new Set(
        allTopPicks.map(
          (topPick) =>
            topPick.id,
        ),
      );

    const invalidTopPickIds =
      selectedTopPickIds.filter(
        (topPickId) =>
          !validTopPickIds.has(
            topPickId,
          ),
      );

    if (
      invalidTopPickIds.length > 0
    ) {
      topPickError =
        "One or more selected top picks are invalid.";
    }

    /* ========================================
       Validation Result
    ======================================== */

    const hasValidationErrors =
      Object.values(errors).some(
        (message) =>
          message.length > 0,
      ) ||
      facilityError.length > 0 ||
      topPickError.length > 0;

    /* ========================================
       Save
    ======================================== */

    if (!hasValidationErrors) {
      try {
        await updateStation(
          db,
          id,
          {
            name,
            nameJapanese:
              nameJapanese || null,
            slug,
            latitude,
            longitude,
            description:
              description || null,
            about:
              about || null,
          },
        );

        /* ========================================
           Save Facilities
        ======================================== */

        await db
          .prepare(
            `
              DELETE FROM station_facilities
              WHERE station_id = ?
            `,
          )
          .bind(id)
          .run();

        if (
          selectedFacilityIds.length > 0
        ) {
          const facilityStatements =
            selectedFacilityIds.map(
              (facilityId) =>
                db
                  .prepare(
                    `
                      INSERT INTO station_facilities (
                        station_id,
                        facility_id
                      )
                      VALUES (?, ?)
                    `,
                  )
                  .bind(
                    id,
                    facilityId,
                  ),
            );

          await db.batch(
            facilityStatements,
          );
        }

        /* ========================================
           Save Top Picks
        ======================================== */

        await db
          .prepare(
            `
              DELETE FROM station_top_picks
              WHERE station_id = ?
            `,
          )
          .bind(id)
          .run();

        if (
          selectedTopPickIds.length > 0
        ) {
          const topPickStatements =
            selectedTopPickIds.map(
              (
                topPickId,
                index,
              ) =>
                db
                  .prepare(
                    `
                      INSERT INTO station_top_picks (
                        station_id,
                        top_pick_id,
                        sort_order,
                        walking_minutes
                      )
                      VALUES (?, ?, ?, ?)
                    `,
                  )
                  .bind(
                    id,
                    topPickId,
                    index + 1,
                    null,
                  ),
            );

          await db.batch(
            topPickStatements,
          );
        }

        return Astro.redirect(
          "/admin/stations",
        );
      } catch (err) {
        console.error(err);

        formError =
          "Unable to update station. The name or slug may already exist.";
      }
    }

    /* ========================================
       Rebuild Facility State
       when validation fails
    ======================================== */

    stationFacilities =
      selectedFacilityIds
        .map(
          (facilityId) =>
            allFacilities.find(
              (facility) =>
                facility.id ===
                facilityId,
            ),
        )
        .filter(
          (
            facility,
          ): facility is (typeof allFacilities)[number] =>
            Boolean(facility),
        )
        .map(
          (facility) => ({
            ...facility,
            note: null,
          }),
        );

    availableFacilities =
      allFacilities.filter(
        (facility) =>
          !selectedFacilityIds.includes(
            facility.id,
          ),
      );

    /* ========================================
       Rebuild Top Pick State
       when validation fails
    ======================================== */

    stationTopPicks =
      selectedTopPickIds
        .map(
          (
            topPickId,
            index,
          ) => {
            const topPick =
              allTopPicks.find(
                (item) =>
                  item.id ===
                  topPickId,
              );

            if (!topPick) {
              return null;
            }

            return {
              ...topPick,
              sort_order:
                index + 1,
              walking_minutes:
                null,
            };
          },
        )
        .filter(
          (
            topPick,
          ): topPick is NonNullable<
            typeof topPick
          > =>
            Boolean(topPick),
        );

    availableTopPicks =
      allTopPicks.filter(
        (topPick) =>
          !selectedTopPickIds.includes(
            topPick.id,
          ),
      );
  }
}

const admin =
  await Astro.session?.get<{
    id: number;
    email: string;
    name: string;
  }>("admin");
---

<AdminLayout title={`Edit ${station.name}`} activePath="/admin/stations">

        <!-- ========================================
             Topbar
        ========================================= -->

        <header class="admin-topbar">

          <div class="admin-breadcrumb">

            <Button
              href="/admin/stations"
              variant="secondary"
            >
              ←
            </Button>

            <a href="/admin/stations">
              Stations
            </a>

            <span>/</span>

            <strong>
              Edit Station
            </strong>

          </div>

        </header>


        <!-- ========================================
             Content
        ========================================= -->

        <div class="admin-content">

          <h2>
            Edit Station
          </h2>

          <p>
            Update the railway station information for the Tokyo
            Station Guide.
          </p>


          <!-- ======================================
               Main Edit Form
          ======================================= -->

          <form
            method="POST"
            class="admin-form"
            id="edit-station-form"
          >

            <input
              type="hidden"
              name="action"
              value="update"
            />


            <!-- ======================================
                 Station Details
            ======================================= -->

            <section class="admin-panel">

              <div class="admin-panel-body">

                <div class="admin-station-form">

                  <div class="admin-station-form-header">

                    <h3>
                      Station Details
                    </h3>

                    <p>
                      Update the information for
                      <strong>{station.name}</strong>.
                    </p>

                  </div>


                  {
                    formError && (
                      <div class="admin-alert admin-alert-error">
                        {formError}
                      </div>
                    )
                  }


                  <div class="admin-form-grid">

                    <!-- Station Name -->

                    <div class="admin-form-group">

                      <label for="name">
                        Station Name
                      </label>

                      <input
                        id="name"
                        name="name"
                        type="text"
                        required
                        value={name}
                        aria-invalid={
                          errors.name
                            ? "true"
                            : "false"
                        }
                        aria-describedby={
                          errors.name
                            ? "name-error"
                            : undefined
                        }
                      />

                      {
                        errors.name && (
                          <small
                            id="name-error"
                            class="admin-form-error"
                          >
                            {errors.name}
                          </small>
                        )
                      }

                    </div>


                    <!-- Japanese Name -->

                    <div class="admin-form-group">

                      <label for="name_japanese">
                        Japanese Name
                      </label>

                      <input
                        id="name_japanese"
                        name="name_japanese"
                        type="text"
                        class="admin-station-japanese-input"
                        value={nameJapanese}
                        aria-invalid={
                          errors.nameJapanese
                            ? "true"
                            : "false"
                        }
                        aria-describedby={
                          errors.nameJapanese
                            ? "name-japanese-error"
                            : undefined
                        }
                      />

                      {
                        errors.nameJapanese && (
                          <small
                            id="name-japanese-error"
                            class="admin-form-error"
                          >
                            {errors.nameJapanese}
                          </small>
                        )
                      }

                    </div>


                    <!-- Slug -->

                    <div class="admin-form-group full-width">

                      <label for="slug">
                        Slug
                      </label>

                      <input
                        id="slug"
                        name="slug"
                        type="text"
                        required
                        value={slug}
                        aria-invalid={
                          errors.slug
                            ? "true"
                            : "false"
                        }
                        aria-describedby={
                          errors.slug
                            ? "slug-error"
                            : "slug-help"
                        }
                      />

                      {
                        errors.slug ? (
                          <small
                            id="slug-error"
                            class="admin-form-error"
                          >
                            {errors.slug}
                          </small>
                        ) : (
                          <small id="slug-help">
                            Use lowercase letters, numbers and
                            hyphens.
                          </small>
                        )
                      }

                    </div>


                    <!-- Latitude -->

                    <div class="admin-form-group">

                      <label for="latitude">
                        Latitude
                      </label>

                      <input
                        id="latitude"
                        name="latitude"
                        type="number"
                        step="any"
                        value={latitudeValue}
                        aria-invalid={
                          errors.latitude
                            ? "true"
                            : "false"
                        }
                        aria-describedby="latitude-help"
                      />

                      {
                        errors.latitude ? (
                          <small class="admin-form-error">
                            {errors.latitude}
                          </small>
                        ) : (
                          <small id="latitude-help">
                            Optional. Range: -90 to 90.
                          </small>
                        )
                      }

                    </div>


                    <!-- Longitude -->

                    <div class="admin-form-group">

                      <label for="longitude">
                        Longitude
                      </label>

                      <input
                        id="longitude"
                        name="longitude"
                        type="number"
                        step="any"
                        value={longitudeValue}
                        aria-invalid={
                          errors.longitude
                            ? "true"
                            : "false"
                        }
                        aria-describedby="longitude-help"
                      />

                      {
                        errors.longitude ? (
                          <small class="admin-form-error">
                            {errors.longitude}
                          </small>
                        ) : (
                          <small id="longitude-help">
                            Optional. Range: -180 to 180.
                          </small>
                        )
                      }

                    </div>


                    <!-- Description -->

                    <div class="admin-form-group full-width">

                      <label for="description">
                        Description
                      </label>

                      <textarea
                        id="description"
                        name="description"
                        rows="5"
                        class="admin-station-description"
                        aria-invalid={
                          errors.description
                            ? "true"
                            : "false"
                        }
                        aria-describedby={
                          errors.description
                            ? "description-error"
                            : undefined
                        }>{description}</textarea>

                      {
                        errors.description && (
                          <small
                            id="description-error"
                            class="admin-form-error"
                          >
                            {errors.description}
                          </small>
                        )
                      }

                    </div>


                    <!-- About -->

                    <div class="admin-form-group full-width">

                      <label for="about">
                        About (station popup)
                      </label>

                      <textarea
                        id="about"
                        name="about"
                        rows="4"
                        class="admin-station-description"
                        placeholder="Short text shown in the About section of the station popup..."
                        aria-invalid={
                          errors.about
                            ? "true"
                            : "false"
                        }
                        aria-describedby={
                          errors.about
                            ? "about-error"
                            : undefined
                        }>{about}</textarea>

                      {
                        errors.about ? (
                          <small
                            id="about-error"
                            class="admin-form-error"
                          >
                            {errors.about}
                          </small>
                        ) : (
                          <small>
                            Optional. Up to 1000 characters.
                          </small>
                        )
                      }

                    </div>

                  </div>

                </div>

              </div>

            </section>


            <!-- ======================================
                 Facilities + Top Picks
            ======================================= -->

            <div class="admin-station-features-grid">

              <!-- ======================================
                   Facilities
              ======================================= -->

              <section class="admin-panel admin-station-feature-panel">

                <div class="admin-panel-body">

                  <div class="admin-station-feature-header">

                    <div>

                      <h3>
                        Facilities
                      </h3>

                      <p>
                        Facilities available at
                        <strong>{station.name}</strong>.
                      </p>

                    </div>


                    {
                      availableFacilities.length > 0 && (
                        <Button
                          type="button"
                          variant="primary"
                          id="open-add-facility-button"
                        >
                          + Add
                        </Button>
                      )
                    }

                  </div>


                  {
                    facilityError && (
                      <div class="admin-alert admin-alert-error">
                        {facilityError}
                      </div>
                    )
                  }


                  <!-- Temporary Facility Inputs -->

                  <div id="station-facility-inputs">

                    {
                      stationFacilities.map(
                        (facility) => (
                          <input
                            type="hidden"
                            name="facility_ids"
                            value={facility.id}
                            data-facility-input={facility.id}
                          />
                        ),
                      )
                    }

                  </div>


                  <!-- Facility Table -->

                  <div class="admin-table-wrapper">

                    <table
                      class="admin-table admin-compact-table"
                      id="station-facilities-table"
                    >

                      <thead>

                        <tr>

                          <th>
                            Facility
                          </th>

                          <th>
                            Actions
                          </th>

                        </tr>

                      </thead>


                      <tbody id="station-facilities-body">

                        {
                          stationFacilities.length > 0 ? (

                            stationFacilities.map(
                              (facility) => (

                                <tr
                                  data-facility-row
                                  data-facility-id={
                                    facility.id
                                  }
                                >

                                  <td>

                                    <div class="admin-line-name">
                                      {facility.name}
                                    </div>

                                  </td>


                                  <td>

                                    <div class="admin-table-actions">

                                      <button
                                        type="button"
                                        class="admin-table-action admin-table-action-delete"
                                        data-remove-facility={
                                          facility.id
                                        }
                                        data-facility-name={
                                          facility.name
                                        }
                                      >
                                        Remove
                                      </button>

                                    </div>

                                  </td>

                                </tr>

                              ),
                            )

                          ) : (

                            <tr id="station-facilities-empty-row">

                              <td colspan="2">

                                <div class="admin-feature-empty">
                                  No facilities assigned.
                                </div>

                              </td>

                            </tr>

                          )
                        }

                      </tbody>

                    </table>

                  </div>


                  <!-- All Facilities Assigned -->

                  <p
                    id="all-facilities-message"
                    class="admin-feature-message"
                    hidden
                  >
                    All available facilities are already assigned.
                  </p>

                </div>

              </section>


              <!-- ======================================
                   Top Picks
              ======================================= -->

              <section class="admin-panel admin-station-feature-panel">

                <div class="admin-panel-body">

                  <StationTopPicks
                    stationName={station.name}
                    assignedTopPicks={stationTopPicks}
                    availableTopPicks={availableTopPicks}
                  />

                </div>

              </section>

            </div>


            <!-- ======================================
                 Form Actions
            ======================================= -->

            <div class="admin-form-actions">

              <Button
                href="/admin/stations"
                variant="secondary"
              >
                Cancel
              </Button>

              <Button
                type="submit"
                variant="primary"
                id="save-station-button"
              >
                Save Changes
              </Button>

            </div>

          </form>

        </div>

  <Fragment slot="after">
    <!-- ========================================
         Add Facilities Modal
    ========================================= -->

    <div
      id="add-facility-modal"
      class="admin-line-station-modal"
      hidden
      aria-hidden="true"
    >

      <div
        class="admin-line-station-modal-backdrop"
        data-close-add-facility-modal
      ></div>


      <div
        class="admin-line-station-modal-dialog"
        role="dialog"
        aria-modal="true"
        aria-labelledby="add-facility-modal-title"
        aria-describedby="add-facility-modal-description"
      >

        <div class="admin-line-station-modal-header">

          <div>

            <h2 id="add-facility-modal-title">
              Add Facilities
            </h2>

            <p id="add-facility-modal-description">
              Select one or more facilities to add to
              {station.name}.
            </p>

          </div>


          <button
            type="button"
            class="admin-line-station-modal-close"
            id="close-add-facility-modal"
            aria-label="Close add facilities dialog"
          >
            ×
          </button>

        </div>


        {
          availableFacilities.length > 0 ? (

            <div
              class="admin-form"
              id="add-facilities-form"
            >

              <div class="admin-facility-checkbox-grid">

                {
                  availableFacilities.map(
                    (facility) => (

                      <label
                        class="admin-facility-checkbox-item"
                        data-facility-option
                        data-facility-option-id={
                          facility.id
                        }
                      >

                        <input
                          type="checkbox"
                          value={facility.id}
                          class="add-facility-checkbox"
                          data-facility-id={
                            facility.id
                          }
                          data-facility-name={
                            facility.name
                          }
                          data-facility-slug={
                            facility.slug
                          }
                        />

                        <span>
                          {facility.name}
                        </span>

                      </label>

                    ),
                  )
                }

              </div>


              <p
                id="selected-facility-count"
                style="
                  margin-top:14px;
                  opacity:0.7;
                "
              >
                0 facilities selected
              </p>


              <div class="admin-form-actions">

                <Button
                  type="button"
                  variant="secondary"
                  id="cancel-add-facilities"
                >
                  Cancel
                </Button>

                <Button
                  type="button"
                  variant="primary"
                  id="add-selected-facilities"
                  disabled
                >
                  Add Selected
                </Button>

              </div>

            </div>

          ) : (

            <div class="admin-empty">

              <h3>
                No Facilities Available
              </h3>

              <p>
                All facilities from the master list are already
                assigned to this station.
              </p>

            </div>

          )
        }

      </div>

    </div>


    <!-- ========================================
         Remove Facility Confirmation
    ========================================= -->

    <ConfirmDialog
      id="remove-facility-confirm-dialog"
      title="Remove Facility"
      description="Are you sure you want to remove this facility from the station?"
      confirmText="Remove"
      cancelText="Cancel"
      variant="danger"
    />


    <!-- ========================================
         Save Station Confirmation
    ========================================= -->

    <ConfirmDialog
      id="edit-station-confirm-dialog"
      title="Save Changes"
      description="Are you sure you want to save these station changes?"
      confirmText="Save Changes"
      cancelText="Cancel"
      variant="primary"
    />


