---
import AdminLayout from "../../../../layouts/AdminLayout.astro";
import StationSectionNav from "../../../../components/admin/StationSectionNav.astro";
import "../../../../styles/admin/forms.css";
import "../../../../styles/admin/stations.css";
import "../../../../styles/admin/tables.css";

import Alert from "../../../../components/common/Alert.astro";
import Breadcrumbs from "../../../../components/common/Breadcrumbs.astro";
import Button from "../../../../components/common/Button.astro";
import ConfirmDialog from "../../../../components/common/ConfirmDialog.astro";

import StationFormFields from "../../../../components/admin/StationFormFields.astro";

import { getStationById } from "../../../../lib/db/stations";
import { handleStationUpdate } from "../../../../lib/services/stations";
import { getRestaurantsNote, saveRestaurantsNote } from "../../../../lib/db/places";


import StationFacilitiesSection from "../../../../components/admin/sections/StationFacilitiesSection.astro";
import { handleFacilityEntries } from "../../../../lib/services/station-facility-entries";
import StationPlatformsSection from "../../../../components/admin/sections/StationPlatformsSection.astro";
import StationFloorsSection from "../../../../components/admin/sections/StationFloorsSection.astro";
import StationSidesSection from "../../../../components/admin/sections/StationSidesSection.astro";
import StationRoutesSection from "../../../../components/admin/sections/StationRoutesSection.astro";
import StationExitsSection from "../../../../components/admin/sections/StationExitsSection.astro";
import StationBusesSection from "../../../../components/admin/sections/StationBusesSection.astro";
import StationSightsSection from "../../../../components/admin/sections/StationSightsSection.astro";
import StationSeasonsSection from "../../../../components/admin/sections/StationSeasonsSection.astro";
import StationPracticalSection from "../../../../components/admin/sections/StationPracticalSection.astro";
import StationFaqSection from "../../../../components/admin/sections/StationFaqSection.astro";
import { handleStationPlatforms } from "../../../../lib/services/station-platforms";
import { handleStationFloors } from "../../../../lib/services/station-floors";
import { handleStationSides } from "../../../../lib/services/station-sides";
import { handleStationRoutes } from "../../../../lib/services/station-routes";
import { handleStationExits } from "../../../../lib/services/station-exits";
import { handleStationTips } from "../../../../lib/services/station-tips";
import { handleTransport } from "../../../../lib/services/station-transport";
import { PLACE_KINDS } from "../../../../lib/db/places";
import { handleStationPlaces } from "../../../../lib/services/station-places";
import StationPlacesSection from "../../../../components/admin/sections/StationPlacesSection.astro";
import { handleSights } from "../../../../lib/services/station-sights";
import { handleStationSeasons } from "../../../../lib/services/station-seasons";
import { handlePracticalTips } from "../../../../lib/services/station-practical-tips";
import { handleStationFaqs } from "../../../../lib/services/station-faqs";

export const prerender = false;

const { env } = await import("cloudflare:workers");
const db = env.DB;

const id = Number(Astro.params.id);

if (!Number.isInteger(id) || id <= 0) {
  return Astro.redirect("/admin/stations");
}

const station = await getStationById(db, id);

if (!station) {
  return Astro.redirect("/admin/stations");
}

// Five menus, one page load each: only the open menu's data is read and rendered.
const GROUPS: { key: string; label: string; items: { key: string; label: string }[] }[] = [
  ["details", "Station details"], ["platforms", "Platforms"], ["floors", "Floors"], ["sides", "Sides of the station"],
  ["exits", "Exits & station tips"], ["facilities", "Facilities"], ["buses-taxis", "Buses & taxis"], ["routes", "Getting there"],
  ["places", "Places"], ["restaurants", "Restaurants"],
  ["hotels", "Hotels"], ["seasons", "When to visit"], ["practical-tips", "Practical tips"], ["faqs", "FAQ"],
].map(([key, label]) => ({ key, label, items: [{ key, label }] }));
// "stats" is part of the details form; the note belongs to the restaurants page.
// Old section names (Top picks, Things to do, Which exit?, Day trips) now live in one "places" page.
const LEGACY: Record<string, string> = { stats: "details", "restaurants-note": "restaurants", "top-picks": "places", "things-to-do": "places", exit: "places", "day-trips": "places" };
const groupOf = (k: string) => LEGACY[k] ?? GROUPS.find((g) => g.key === k)?.key;

// Every section posts here with ?s=<section>; only that section's handler gets the POST.
const posted = Astro.request.method === "POST";
const part = Astro.url.searchParams.get("s");
const active =
  (posted ? (part ? groupOf(part) : "details") : GROUPS.find((g) => g.key === Astro.url.searchParams.get("g"))?.key) ?? "details";
const on = (key: string) => groupOf(key) === active;
const getReq = (): Request => new Request(Astro.url, { method: "GET" });
const reqFor = (key: string): Request => (!posted ? Astro.request : part === key ? Astro.request.clone() : getReq()) as Request;

type Handled<T> = T | null;
const run = async <T,>(key: string, fn: () => Promise<T>): Promise<Handled<T>> => (on(key) ? fn() : null);

const form = (await run("details", () =>
  handleStationUpdate((!posted || part ? (posted ? getReq() : Astro.request) : Astro.request.clone()) as Request, db, id, station),
))!;
if (form?.redirectTo) {
  return Astro.redirect(form.redirectTo);
}

const platformForm = await run("platforms", () => handleStationPlatforms(reqFor("platforms"), db, id));
const floorForm = await run("floors", () => handleStationFloors(reqFor("floors"), db, id));
const sidesForm = await run("sides", () => handleStationSides(reqFor("sides"), db, id));
const routesForm = await run("routes", () => handleStationRoutes(reqFor("routes"), db, id));
const exitForm = await run("exits", () => handleStationExits(reqFor("exits"), db, id, station.slug));
const tipsForm = await run("exits", () => handleStationTips(reqFor("exits"), db, id));
const facilitiesForm = await run("facilities", () => handleFacilityEntries(reqFor("facilities"), db, id, station.slug));
const busesForm = await run("buses-taxis", () => handleTransport(reqFor("buses-taxis"), db, id, station.slug));
const placesForm = await run("places", () => handleSights(reqFor("places"), db, id));
const hotelsForm = await run("hotels", () => handleStationPlaces(reqFor("hotels"), db, id, PLACE_KINDS.hotel));
const restaurantsForm = await run("restaurants", () => handleStationPlaces(reqFor("restaurants"), db, id, PLACE_KINDS.restaurant));
const seasonsForm = await run("seasons", () => handleStationSeasons(reqFor("seasons"), db, id));
const practicalForm = await run("practical-tips", () => handlePracticalTips(reqFor("practical-tips"), db, id));
const faqForm = await run("faqs", () => handleStationFaqs(reqFor("faqs"), db, id));

// The note above the restaurants list has its own little form.
let noteError = "";
if (posted && part === "restaurants-note") {
  const fd = await Astro.request.clone().formData();
  const en = String(fd.get("restaurants_note") ?? "").trim();
  const ja = String(fd.get("restaurants_note_japanese") ?? "").trim();
  if (en.length > 1000 || ja.length > 1000) noteError = "The restaurants note must be 1000 characters or less.";
  else {
    await saveRestaurantsNote(db, id, en || null, ja || null);
    return Astro.redirect(`/admin/stations/${id}/edit?g=restaurants#restaurants-note`);
  }
}

const done: [string, string | null | undefined][] = [
  ["platforms", platformForm?.redirectTo],
  ["floors", floorForm?.redirectTo],
  ["sides", sidesForm?.redirectTo],
  ["routes", routesForm?.redirectTo],
  ["exits", exitForm?.redirectTo ?? tipsForm?.redirectTo],
  ["facilities", facilitiesForm?.redirectTo],
  ["buses-taxis", busesForm?.redirectTo],
  ["places", placesForm?.redirectTo],
  ["hotels", hotelsForm?.redirectTo],
  ["restaurants", restaurantsForm?.redirectTo],
  ["seasons", seasonsForm?.redirectTo],
  ["practical-tips", practicalForm?.redirectTo],
  ["faqs", faqForm?.redirectTo],
];
for (const [anchor, target] of done) {
  if (target) return Astro.redirect(`/admin/stations/${id}/edit?g=${groupOf(anchor)}#${anchor}`);
}

const mediaBase =
  String((env as { MEDIA_BASE_URL?: string }).MEDIA_BASE_URL ?? "").trim().replace(/\/+$/, "") || "/media";
const mediaSrc = (k: string) => (/^https?:\/\//i.test(k) ? k : `${mediaBase}/${k}`);

const errors = form?.errors ?? {};
const formError = form?.formError ?? "";

const savedNote = active === "restaurants" ? await getRestaurantsNote(db, id) : { note: "", noteJapanese: "" };
const noteValue = savedNote.note;
const noteJaValue = savedNote.noteJapanese;
const shared = { station, id, mediaBase };
---

<AdminLayout title={`Edit ${station.name}`} activePath="/admin/stations">
  <header class="admin-topbar">
    <Breadcrumbs backHref="/admin/stations" parentLabel="Stations" current="Edit Station" />
  </header>

  <div class="station-admin-frame">
    <StationSectionNav stationName={station.name} stationId={id} groups={GROUPS} active={active} />

    <div class="admin-content admin-station-page">
      <div class="station-sections">
        {active === "details" && (
          <form method="POST" enctype="multipart/form-data" class="admin-form station-main-form" id="edit-station-form">
            <input type="hidden" name="action" value="update" />

            <section class="station-section admin-panel" id="details" data-nav="details">
              <div class="admin-panel-body">
                <div class="admin-station-form-header">
                  <h3>Station Details</h3>
                </div>

                {formError && <Alert>{formError}</Alert>}
                {Astro.url.searchParams.get("saved") === "1" && !formError && <p class="admin-saved-note" role="status">✓ Station saved.</p>}

                <StationFormFields values={form!.values} errors={errors} mainImage={station.main_image} />
              </div>
            </section>

            <div class="station-save-bar">
              <Button href="/admin/stations" variant="secondary"> Cancel </Button>
              <Button type="submit" variant="primary" id="save-station-button">Save Station</Button>
            </div>
          </form>
        )}

        {active === "platforms" && <StationPlatformsSection {...shared} form={platformForm!} />}
        {active === "floors" && <StationFloorsSection {...shared} form={floorForm!} />}
        {active === "sides" && <StationSidesSection {...shared} form={sidesForm!} />}
        {active === "exits" && <StationExitsSection {...shared} form={exitForm!} tipsForm={tipsForm!} />}
        {active === "facilities" && <StationFacilitiesSection {...shared} form={facilitiesForm!} />}
        {active === "buses-taxis" && <StationBusesSection {...shared} form={busesForm!} />}
        {active === "routes" && <StationRoutesSection {...shared} form={routesForm!} />}
        {active === "places" && <StationSightsSection {...shared} form={placesForm!} />}
        {active === "restaurants" && (
          <>
            <StationPlacesSection form={restaurantsForm!} anchor="restaurants" title="Restaurants" noun="restaurant" />
            <section class="station-section" id="restaurants-note" data-nav="restaurants-note">
              <form method="POST" action="?s=restaurants-note" class="sim-note admin-form">
                <h3>Restaurants note</h3>
                {noteError && <div class="admin-form-error" role="alert">{noteError}</div>}
                <div class="sim-grid2">
                  <div class="admin-form-group">
                    <label for="restaurants_note">Note <span class="admin-label-hint">shown above the restaurants list, **text** = bold</span></label>
                    <textarea id="restaurants_note" name="restaurants_note" rows="2" maxlength="1000">{noteValue}</textarea>
                  </div>
                  <div class="admin-form-group">
                    <label for="restaurants_note_japanese">Note (Japanese)</label>
                    <textarea id="restaurants_note_japanese" name="restaurants_note_japanese" lang="ja" rows="2" maxlength="1000">{noteJaValue}</textarea>
                  </div>
                </div>
                <button type="submit" class="common-button common-button-primary">Save note</button>
              </form>
            </section>
          </>
        )}
        {active === "hotels" && <StationPlacesSection form={hotelsForm!} anchor="hotels" title="Hotels" noun="hotel" />}
        {active === "seasons" && <StationSeasonsSection {...shared} form={seasonsForm!} />}
        {active === "practical-tips" && <StationPracticalSection {...shared} form={practicalForm!} />}
        {active === "faqs" && <StationFaqSection {...shared} form={faqForm!} />}
      </div>
    </div>
  </div>

  <Fragment slot="after">
    <!-- Save Station Confirmation -->
    <ConfirmDialog
      id="edit-station-confirm-dialog"
      title="Save Changes"
      description="Are you sure you want to save these station changes?"
      confirmText="Save Changes"
      cancelText="Cancel"
      variant="primary"
    />

    <script>
      import "../../../../scripts/admin/stations-edit.ts";
    </script>
  </Fragment>
</AdminLayout>
