---
import AdminLayout from "../../../../layouts/AdminLayout.astro";
import "../../../../styles/admin/forms.css";
import "../../../../styles/admin/stations.css";
import "../../../../styles/admin/tables.css";

import Alert from "../../../../components/common/Alert.astro";
import Breadcrumbs from "../../../../components/common/Breadcrumbs.astro";
import Button from "../../../../components/common/Button.astro";
import ConfirmDialog from "../../../../components/common/ConfirmDialog.astro";
import StationFormFields from "../../../../components/admin/StationFormFields.astro";
import FacilityModal from "../../../../components/admin/FacilityModal.astro";
import StationTopPicks from "../../../../components/admin/StationTopPicks.astro";

import { getStationById } from "../../../../lib/db/stations";
import { handleStationUpdate } from "../../../../lib/services/stations";

export const prerender = false;

const { env } = await import("cloudflare:workers");
const db = env.DB;

const id = Number(Astro.params.id);

if (!Number.isInteger(id) || id <= 0) {
  return Astro.redirect("/admin/stations");
}

const station = await getStationById(db, id);

if (!station) {
  return Astro.redirect("/admin/stations");
}

const form = await handleStationUpdate(Astro.request, db, id, station);

if (form.redirectTo) {
  return Astro.redirect(form.redirectTo);
}

const {
  errors,
  formError,
  stationFacilities,
  availableFacilities,
  stationTopPicks,
  availableTopPicks,
} = form;
const facilityError = errors.facilities;

---

<AdminLayout title={`Edit ${station.name}`} activePath="/admin/stations">

        <!-- ========================================
             Topbar
        ========================================= -->

        <header class="admin-topbar">

          <Breadcrumbs backHref="/admin/stations" parentLabel="Stations" current="Edit Station" />

        </header>


        <!-- ========================================
             Content
        ========================================= -->

        <div class="admin-content">

          <h2>
            Edit Station
          </h2>

          <p>
            Update the railway station information for the Tokyo
            Station Guide.
          </p>


          <!-- ======================================
               Main Edit Form
          ======================================= -->

          <form
            method="POST"
            class="admin-form"
            id="edit-station-form"
          >

            <input
              type="hidden"
              name="action"
              value="update"
            />


            <!-- ======================================
                 Station Details
            ======================================= -->

            <section class="admin-panel">

              <div class="admin-panel-body">

                <div class="admin-station-form">

                  <div class="admin-station-form-header">

                    <h3>
                      Station Details
                    </h3>

                    <p>
                      Update the information for
                      <strong>{station.name}</strong>.
                    </p>

                  </div>


                  {
                    formError && (
                      <Alert>{formError}</Alert>
                    )
                  }


                  <StationFormFields values={form.values} errors={errors} />

                </div>

              </div>

            </section>


            <!-- ======================================
                 Facilities + Top Picks
            ======================================= -->

            <div class="admin-station-features-grid">

              <!-- ======================================
                   Facilities
              ======================================= -->

              <section class="admin-panel admin-station-feature-panel">

                <div class="admin-panel-body">

                  <div class="admin-station-feature-header">

                    <div>

                      <h3>
                        Facilities
                      </h3>

                      <p>
                        Facilities available at
                        <strong>{station.name}</strong>.
                      </p>

                    </div>


                    {
                      availableFacilities.length > 0 && (
                        <Button
                          type="button"
                          variant="primary"
                          id="open-add-facility-button"
                        >
                          + Add
                        </Button>
                      )
                    }

                  </div>


                  {
                    facilityError && (
                      <Alert>{facilityError}</Alert>
                    )
                  }


                  <!-- Temporary Facility Inputs -->

                  <div id="station-facility-inputs">

                    {
                      stationFacilities.map(
                        (facility) => (
                          <input
                            type="hidden"
                            name="facility_ids"
                            value={facility.id}
                            data-facility-input={facility.id}
                          />
                        ),
                      )
                    }

                  </div>


                  <!-- Facility Table -->

                  <div class="admin-table-wrapper">

                    <table
                      class="admin-table admin-compact-table"
                      id="station-facilities-table"
                    >

                      <thead>

                        <tr>

                          <th>
                            Facility
                          </th>

                          <th>
                            Actions
                          </th>

                        </tr>

                      </thead>


                      <tbody id="station-facilities-body">

                        {
                          stationFacilities.length > 0 ? (

                            stationFacilities.map(
                              (facility) => (

                                <tr
                                  data-facility-row
                                  data-facility-id={
                                    facility.id
                                  }
                                >

                                  <td>

                                    <div class="admin-line-name">
                                      {facility.name}
                                    </div>

                                  </td>


                                  <td>

                                    <div class="admin-table-actions">

                                      <button
                                        type="button"
                                        class="admin-table-action admin-table-action-delete"
                                        data-remove-facility={
                                          facility.id
                                        }
                                        data-facility-name={
                                          facility.name
                                        }
                                      >
                                        Remove
                                      </button>

                                    </div>

                                  </td>

                                </tr>

                              ),
                            )

                          ) : (

                            <tr id="station-facilities-empty-row">

                              <td colspan="2">

                                <div class="admin-feature-empty">
                                  No facilities assigned.
                                </div>

                              </td>

                            </tr>

                          )
                        }

                      </tbody>

                    </table>

                  </div>


                  <!-- All Facilities Assigned -->

                  <p
                    id="all-facilities-message"
                    class="admin-feature-message"
                    hidden
                  >
                    All available facilities are already assigned.
                  </p>

                </div>

              </section>


              <!-- ======================================
                   Top Picks
              ======================================= -->

              <section class="admin-panel admin-station-feature-panel">

                <div class="admin-panel-body">

                  <StationTopPicks
                    stationName={station.name}
                    assignedTopPicks={stationTopPicks}
                    availableTopPicks={availableTopPicks}
                  />

                </div>

              </section>

            </div>


            <!-- ======================================
                 Form Actions
            ======================================= -->

            <div class="admin-form-actions">

              <Button
                href="/admin/stations"
                variant="secondary"
              >
                Cancel
              </Button>

              <Button
                type="submit"
                variant="primary"
                id="save-station-button"
              >
                Save Changes
              </Button>

            </div>

          </form>

        </div>

  <Fragment slot="after">
    <!-- ========================================
         Add Facilities Modal
    ========================================= -->

    <FacilityModal
      facilities={availableFacilities}
      description={`Select one or more facilities to add to ${station.name}.`}
      emptyDescription="All facilities from the master list are already assigned to this station."
    />


    <!-- ========================================
         Remove Facility Confirmation
    ========================================= -->

    <ConfirmDialog
      id="remove-facility-confirm-dialog"
      title="Remove Facility"
      description="Are you sure you want to remove this facility from the station?"
      confirmText="Remove"
      cancelText="Cancel"
      variant="danger"
    />


    <!-- ========================================
         Save Station Confirmation
    ========================================= -->

    <ConfirmDialog
      id="edit-station-confirm-dialog"
      title="Save Changes"
      description="Are you sure you want to save these station changes?"
      confirmText="Save Changes"
      cancelText="Cancel"
      variant="primary"
    />


    <script>
      import "../../../../scripts/admin/stations-edit.ts";
    </script>

  
  </Fragment>
</AdminLayout>
