
---
import AdminLayout from "../../../../layouts/AdminLayout.astro";
import "../../../../styles/admin/forms.css";
import "../../../../styles/admin/stations.css";
import "../../../../styles/admin/tables.css";

import Alert from "../../../../components/common/Alert.astro";
import Breadcrumbs from "../../../../components/common/Breadcrumbs.astro";
import Button from "../../../../components/common/Button.astro";
import ConfirmDialog from "../../../../components/common/ConfirmDialog.astro";

import StationFormFields from "../../../../components/admin/StationFormFields.astro";
import StationFacilitiesPanel from "../../../../components/admin/StationFacilitiesPanel.astro";
import FacilityModal from "../../../../components/admin/FacilityModal.astro";
import StationExitsPanel from "../../../../components/admin/StationExitsPanel.astro";
import ExitModal from "../../../../components/admin/ExitModal.astro";
import FacilityExitPickerModal from "../../../../components/admin/FacilityExitPickerModal.astro";
import StationTopPicks from "../../../../components/admin/StationTopPicks.astro";

import { getStationFloors } from "../../../../lib/db/station-floors";
import { getStationById } from "../../../../lib/db/stations";
import { handleStationUpdate } from "../../../../lib/services/stations";

export const prerender = false;

const { env } = await import("cloudflare:workers");
const db = env.DB;

const id = Number(Astro.params.id);

if (!Number.isInteger(id) || id <= 0) {
  return Astro.redirect("/admin/stations");
}

const station = await getStationById(db, id);

if (!station) {
  return Astro.redirect("/admin/stations");
}

const stationFloors = await getStationFloors(db, id);

const form = await handleStationUpdate(Astro.request, db, id, station);

if (form.redirectTo) {
  return Astro.redirect(form.redirectTo);
}

const {
  errors,
  formError,
  stationFacilities,
  availableFacilities,
  stationTopPicks,
  availableTopPicks,
  stationExits,
} = form;

const facilityError = errors.facilities;
---

<AdminLayout title={`Edit ${station.name}`} activePath="/admin/stations">
  <header class="admin-topbar">
    <Breadcrumbs
      backHref="/admin/stations"
      parentLabel="Stations"
      current="Edit Station"
    />

    <div class="admin-topbar-actions">
      <Button
        href={`/admin/stations/${id}/platforms`}
        variant="secondary"
      >
        Manage Platforms
      </Button>

      <Button
        href={`/admin/stations/${id}/floors`}
        variant="secondary"
      >
        Manage Floors
      </Button>
    </div>
  </header>

  <div class="admin-content">
    <h2>Edit Station</h2>

    <p>
      Update the railway station information, facilities, exits, and top picks
      for the Tokyo Station Guide.
    </p>

    <form method="POST" class="admin-form" id="edit-station-form">
      <input type="hidden" name="action" value="update" />

      <!-- Station Details -->
      <section class="admin-panel">
        <div class="admin-panel-body">
          <div class="admin-station-form">
            <div class="admin-station-form-header">
              <h3>Station Details</h3>

              <p>
                Update the information for
                <strong>{station.name}</strong>.
              </p>
            </div>

            {formError && <Alert>{formError}</Alert>}

            <StationFormFields values={form.values} errors={errors} />
          </div>
        </div>
      </section>

      <!-- Verification and Facilities -->
      <div class="admin-station-setup-grid">
        <section class="admin-panel admin-station-verification-panel">
          <div class="admin-panel-body">
            <div class="admin-station-feature-header">
              <div>
                <h3>Station Verification</h3>
                <p>Manage the verification status of this station.</p>
              </div>
            </div>

            <div class="admin-verification-toggle">
              <div class="admin-verification-copy">
                <span class="admin-verification-title">
                  Verified station
                </span>

                <small>Mark this station as verified.</small>
              </div>

              <label class="admin-switch" for="is_verified">
                <input
                  id="is_verified"
                  name="is_verified"
                  type="checkbox"
                  checked={form.values.isVerified}
                />
                <span class="admin-switch-slider"></span>
              </label>
            </div>
          </div>
        </section>

        <StationFacilitiesPanel
          assigned={stationFacilities}
          canAdd={stationFloors.length > 0 && availableFacilities.length > 0}
          error={facilityError}
          allAddedMessage="No facilities are available in the master list."
        >
          Manage facilities for <strong>{station.name}</strong>, including
          floor, quantity, nearby exits, and optional notes.
        </StationFacilitiesPanel>
      </div>

      <!-- Floor-wise Exits -->
      <section class="admin-station-exits-section">
        <section class="admin-panel admin-station-feature-panel">
          <div class="admin-panel-body">
            <StationExitsPanel
              assigned={stationExits}
              floors={stationFloors}
              canAdd={stationFloors.length > 0}
            />
          </div>
        </section>
      </section>

      <!-- Top Picks -->
      <section class="admin-station-top-picks-section">
        <section class="admin-panel admin-station-feature-panel">
          <div class="admin-panel-body">
            <StationTopPicks
              stationName={station.name}
              assignedTopPicks={stationTopPicks}
              availableTopPicks={availableTopPicks}
            />
          </div>
        </section>
      </section>

      <!-- Form Actions -->
      <div class="admin-form-actions">
        <Button href="/admin/stations" variant="secondary">
          Cancel
        </Button>

        <Button
          type="submit"
          variant="primary"
          id="save-station-button"
        >
          Save Changes
        </Button>
      </div>
    </form>
  </div>

  <Fragment slot="after">
    <!-- Add Facilities Modal -->
    <FacilityModal
      facilities={availableFacilities}
      floors={stationFloors}
      description={`Select facilities to add floor entries for ${station.name}.`}
      emptyDescription="No facilities are available in the master facility list."
    />

    <!-- Add Station Exits Modal -->
    <ExitModal floors={stationFloors} />

    <!-- Select Nearby Exits for Facility Assignments -->
    <FacilityExitPickerModal
      exits={stationExits}
      floors={stationFloors}
    />

    <!-- Remove Facility Confirmation -->
    <ConfirmDialog
      id="remove-facility-confirm-dialog"
      title="Remove Facility Entry"
      description="Are you sure you want to remove this floor entry?"
      confirmText="Remove"
      cancelText="Cancel"
      variant="danger"
    />

    <!-- Save Station Confirmation -->
    <ConfirmDialog
      id="edit-station-confirm-dialog"
      title="Save Changes"
      description="Are you sure you want to save these station changes?"
      confirmText="Save Changes"
      cancelText="Cancel"
      variant="primary"
    />

    <script>
      import "../../../../scripts/admin/stations-edit.ts";
      import "../../../../scripts/admin/station-exit-picker.ts";
      import "../../../../scripts/admin/facility-exit-picker.ts";
    </script>
  </Fragment>
</AdminLayout>
