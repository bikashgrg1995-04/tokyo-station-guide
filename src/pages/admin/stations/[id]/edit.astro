---
import AdminLayout from "../../../../layouts/AdminLayout.astro";
import StationSectionNav from "../../../../components/admin/StationSectionNav.astro";
import "../../../../styles/admin/forms.css";
import "../../../../styles/admin/stations.css";
import "../../../../styles/admin/tables.css";

import Alert from "../../../../components/common/Alert.astro";
import Breadcrumbs from "../../../../components/common/Breadcrumbs.astro";
import Button from "../../../../components/common/Button.astro";
import ConfirmDialog from "../../../../components/common/ConfirmDialog.astro";

import StationFormFields from "../../../../components/admin/StationFormFields.astro";

import { getStationFloors } from "../../../../lib/db/station-floors";
import { getStationById } from "../../../../lib/db/stations";
import { handleStationUpdate } from "../../../../lib/services/stations";
import { getRestaurantsNote } from "../../../../lib/db/places";


import StationFacilitiesSection from "../../../../components/admin/sections/StationFacilitiesSection.astro";
import { handleFacilityEntries } from "../../../../lib/services/station-facility-entries";
import StationPlatformsSection from "../../../../components/admin/sections/StationPlatformsSection.astro";
import StationFloorsSection from "../../../../components/admin/sections/StationFloorsSection.astro";
import StationSidesSection from "../../../../components/admin/sections/StationSidesSection.astro";
import StationRoutesSection from "../../../../components/admin/sections/StationRoutesSection.astro";
import StationExitsSection from "../../../../components/admin/sections/StationExitsSection.astro";
import StationBusesSection from "../../../../components/admin/sections/StationBusesSection.astro";
import StationThingsSection from "../../../../components/admin/sections/StationThingsSection.astro";
import StationDayTripsSection from "../../../../components/admin/sections/StationDayTripsSection.astro";
import StationSeasonsSection from "../../../../components/admin/sections/StationSeasonsSection.astro";
import StationPracticalSection from "../../../../components/admin/sections/StationPracticalSection.astro";
import StationExitPlacesSection from "../../../../components/admin/sections/StationExitPlacesSection.astro";
import StationFaqSection from "../../../../components/admin/sections/StationFaqSection.astro";
import { handleStationPlatforms } from "../../../../lib/services/station-platforms";
import { handleStationFloors } from "../../../../lib/services/station-floors";
import { handleStationSides } from "../../../../lib/services/station-sides";
import { handleStationRoutes } from "../../../../lib/services/station-routes";
import { handleStationExits } from "../../../../lib/services/station-exits";
import { handleStationTips } from "../../../../lib/services/station-tips";
import { handleTransport } from "../../../../lib/services/station-transport";
import { PLACE_KINDS } from "../../../../lib/db/places";
import { handleStationPlaces } from "../../../../lib/services/station-places";
import StationPlacesSection from "../../../../components/admin/sections/StationPlacesSection.astro";
import { handleSights } from "../../../../lib/services/station-sights";
import { handleDayTrips } from "../../../../lib/services/station-day-trips";
import { handleStationSeasons } from "../../../../lib/services/station-seasons";
import { handlePracticalTips } from "../../../../lib/services/station-practical-tips";
import { handleStationExitPlaces } from "../../../../lib/services/station-exit-places";
import { handleStationFaqs } from "../../../../lib/services/station-faqs";

export const prerender = false;

const { env } = await import("cloudflare:workers");
const db = env.DB;

const id = Number(Astro.params.id);

if (!Number.isInteger(id) || id <= 0) {
  return Astro.redirect("/admin/stations");
}

const station = await getStationById(db, id);

if (!station) {
  return Astro.redirect("/admin/stations");
}

const stationFloors = await getStationFloors(db, id);

// Every section posts here with ?s=<section>; only that section's handler gets the POST.
const posted = Astro.request.method === "POST";
const part = Astro.url.searchParams.get("s");
const getReq = (): Request => new Request(Astro.url, { method: "GET" });
const reqFor = (key: string): Request => (!posted ? Astro.request : part === key ? Astro.request.clone() : getReq()) as Request;

const form = await handleStationUpdate((!posted || part ? (posted ? getReq() : Astro.request) : Astro.request.clone()) as Request, db, id, station);
if (form.redirectTo) {
  return Astro.redirect(form.redirectTo);
}

const platformForm = await handleStationPlatforms(reqFor("platforms"), db, id);
const floorForm = await handleStationFloors(reqFor("floors"), db, id);
const sidesForm = await handleStationSides(reqFor("sides"), db, id);
const routesForm = await handleStationRoutes(reqFor("routes"), db, id);
const exitForm = await handleStationExits(reqFor("exits"), db, id, station.slug);
const tipsForm = await handleStationTips(reqFor("exits"), db, id);
const facilitiesForm = await handleFacilityEntries(reqFor("facilities"), db, id, station.slug);
const busesForm = await handleTransport(reqFor("buses-taxis"), db, id, station.slug);
const thingsForm = await handleSights(reqFor("things-to-do"), db, id, station.slug);
const hotelsForm = await handleStationPlaces(reqFor("hotels"), db, id, PLACE_KINDS.hotel);
const restaurantsForm = await handleStationPlaces(reqFor("restaurants"), db, id, PLACE_KINDS.restaurant);
const tripsForm = await handleDayTrips(reqFor("day-trips"), db, id, station.slug);
const seasonsForm = await handleStationSeasons(reqFor("seasons"), db, id);
const practicalForm = await handlePracticalTips(reqFor("practical-tips"), db, id);
const faqForm = await handleStationFaqs(reqFor("faqs"), db, id);
const exitPlacesForm = await handleStationExitPlaces(reqFor("exit"), db, id);

const done: [string, string | null][] = [
  ["platforms", platformForm.redirectTo],
  ["floors", floorForm.redirectTo],
  ["sides", sidesForm.redirectTo],
  ["routes", routesForm.redirectTo],
  ["exits", exitForm.redirectTo ?? tipsForm.redirectTo],
  ["facilities", facilitiesForm.redirectTo],
  ["buses-taxis", busesForm.redirectTo],
  ["things-to-do", thingsForm.redirectTo],
  ["hotels", hotelsForm.redirectTo],
  ["restaurants", restaurantsForm.redirectTo],
  ["day-trips", tripsForm.redirectTo],
  ["seasons", seasonsForm.redirectTo],
  ["practical-tips", practicalForm.redirectTo],
  ["faqs", faqForm.redirectTo],
  ["exit", exitPlacesForm.redirectTo],
];
for (const [anchor, target] of done) {
  if (target) return Astro.redirect(`/admin/stations/${id}/edit#${anchor}`);
}

const mediaBase =
  String((env as { MEDIA_BASE_URL?: string }).MEDIA_BASE_URL ?? "").trim().replace(/\/+$/, "") || "/media";
const mediaSrc = (k: string) => (/^https?:\/\//i.test(k) ? k : `${mediaBase}/${k}`);

const {
  errors,
  formError,
} = form;

const savedNote = await getRestaurantsNote(db, id);
const noteValue = form.restaurantsNote ?? savedNote.note;
const noteJaValue = form.restaurantsNoteJapanese ?? savedNote.noteJapanese;
const shared = { station, id, mediaBase };
---

<AdminLayout title={`Edit ${station.name}`} activePath="/admin/stations">
  <header class="admin-topbar">
    <Breadcrumbs backHref="/admin/stations" parentLabel="Stations" current="Edit Station" />
  </header>

  <div class="station-admin-frame">
    <StationSectionNav stationName={station.name} />

    <div class="admin-content admin-station-page">
      <div class="station-sections">
        <form method="POST" enctype="multipart/form-data" class="admin-form station-main-form" id="edit-station-form">
          <input type="hidden" name="action" value="update" />

          <section class="station-section admin-panel" id="details" data-nav="details" style="order:10">
            <div class="admin-panel-body">
              <div class="admin-station-form-header">
                <h3>Station Details</h3>
              </div>

              {formError && <Alert>{formError}</Alert>}

              <StationFormFields values={form.values} errors={errors} mainImage={station.main_image} />
            </div>
          </section>

          <section class="station-section admin-panel" id="restaurants-note" data-nav="restaurants-note" style="order:100">
            <div class="admin-panel-body">
              <h3 style="margin:0 0 8px">Restaurants note</h3>
              <div class="admin-form-grid">
                <div class="admin-form-group full-width">
                  <label for="restaurants_note">
                    Note <span class="admin-label-hint">shown above the restaurants list, use **text** for bold</span>
                  </label>
                  <textarea id="restaurants_note" name="restaurants_note" rows="2" maxlength="1000">{noteValue}</textarea>
                </div>
                <div class="admin-form-group full-width">
                  <label for="restaurants_note_japanese">Note (Japanese)</label>
                  <textarea id="restaurants_note_japanese" name="restaurants_note_japanese" lang="ja" rows="2" maxlength="1000">{noteJaValue}</textarea>
                </div>
              </div>
            </div>
          </section>

          <div class="station-save-bar">
            <Button href="/admin/stations" variant="secondary"> Cancel </Button>
            <Button type="submit" variant="primary" id="save-station-button">Save Station</Button>
          </div>
        </form>

        <div style="order:25"><StationExitPlacesSection {...shared} form={exitPlacesForm} /></div>
        <div style="order:20"><StationPlatformsSection {...shared} form={platformForm} /></div>
        <div style="order:30"><StationFloorsSection {...shared} form={floorForm} /></div>
        <div style="order:40"><StationSidesSection {...shared} form={sidesForm} /></div>
        <div style="order:50"><StationRoutesSection {...shared} form={routesForm} /></div>
        <div style="order:60"><StationExitsSection {...shared} form={exitForm} tipsForm={tipsForm} /></div>
        <div style="order:70"><StationFacilitiesSection {...shared} form={facilitiesForm} /></div>
        <div style="order:80"><StationBusesSection {...shared} form={busesForm} /></div>
        <div style="order:90"><StationThingsSection {...shared} form={thingsForm} /></div>
        <div style="order:95"><StationPlacesSection form={restaurantsForm} anchor="restaurants" title="Restaurants" noun="restaurant" /></div>
        <div style="order:105"><StationPlacesSection form={hotelsForm} anchor="hotels" title="Hotels" noun="hotel" /></div>
        <div style="order:110"><StationDayTripsSection {...shared} form={tripsForm} /></div>
        <div style="order:120"><StationSeasonsSection {...shared} form={seasonsForm} /></div>
        <div style="order:130"><StationPracticalSection {...shared} form={practicalForm} /></div>
        <div style="order:140"><StationFaqSection {...shared} form={faqForm} /></div>
      </div>
    </div>
  </div>

  <Fragment slot="after">
    <!-- Save Station Confirmation -->
    <ConfirmDialog
      id="edit-station-confirm-dialog"
      title="Save Changes"
      description="Are you sure you want to save these station changes?"
      confirmText="Save Changes"
      cancelText="Cancel"
      variant="primary"
    />

    <script>
      import "../../../../scripts/admin/stations-edit.ts";
    </script>
  </Fragment>
</AdminLayout>
