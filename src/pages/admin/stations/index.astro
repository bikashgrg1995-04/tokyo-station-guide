---
import AdminLayout from "../../../layouts/AdminLayout.astro";
import "../../../styles/admin/tables.css";
import "../../../styles/admin/stations.css";

import EmptyState from "../../../components/common/EmptyState.astro";
import Button from "../../../components/common/Button.astro";
import SearchInput from "../../../components/common/SearchInput.astro";
import ConfirmDialog from "../../../components/common/ConfirmDialog.astro";
import Pagination from "../../../components/common/Pagination.astro";

import { loadStationList } from "../../../lib/services/stations";
export const prerender = false;

const { env } = await import("cloudflare:workers");

const {
  stations,
  totalItems,
  currentPage: safeCurrentPage,
  totalPages,
  perPage,
  searchParam,
  paginationUrl,
} = await loadStationList(env.DB, Astro.url);

---

<AdminLayout title="Stations" activePath="/admin/stations">

        <div class="admin-content">

          <!-- Page Header -->
          <div class="admin-page-header">

            <div>
              <h2>Stations</h2>

              <p>
                Manage the railway and subway stations used
                throughout the Tokyo Station Guide.
              </p>
            </div>

          </div>

          <!-- Search / Action Bar -->
          <div class="admin-list-toolbar">

            <form
              id="station-search-form"
              class="admin-search-form"
              method="GET"
              action="/admin/stations"
              role="search"
            >
              <SearchInput
                id="station-search"
                name="search"
                value={searchParam}
                placeholder="Search stations..."
                ariaLabel="Search stations"
              />
            </form>

            <Button
              href="/admin/stations/new"
              variant="primary"
            >
              + Add Station
            </Button>

          </div>

          <!-- Stations Table -->
          <section class="admin-panel">

            <div
              id="stations-table-content"
              class="admin-panel-body admin-table-panel-body"
            >

              <!-- Table Meta -->
              <div class="admin-table-meta">

                <span>
                  {totalItems} • Total Stations
                </span>

              </div>

              {
                stations.length > 0 ? (
                  <>

                    <!-- Table -->
                    <div class="admin-table-wrapper">

                      <table class="admin-table">

                        <thead>
                          <tr>
                            <th>ID</th>
                            <th>Station</th>
                            <th>Slug</th>
                            <th>Verification</th>
                            <th>Coordinates</th>
                            <th>Actions</th>
                          </tr>
                        </thead>

                        <tbody>
                          {
                            stations.map((station) => (
                              <tr>

                                <td class="admin-table-id">
                                  {station.id}
                                </td>

                                <td>
                                  <div class="admin-station-name">
                                    {station.name}
                                  </div>

                                  {
                                    station.name_japanese && (
                                      <div class="admin-station-japanese">
                                        {station.name_japanese}
                                      </div>
                                    )
                                  }
                                </td>

                                <td class="admin-table-code">
                                  <span class="admin-station-slug">
                                    {station.slug}
                                  </span>
                                </td>
                                <td>
                                  {
                                    station.is_verified === 1 ? (
                                      <div class="admin-station-verification">
                                        <span
                                          class="admin-station-verified-icon"
                                          aria-label="Verified"
                                          title="Verified"
                                        >
                                          ✓
                                        </span>
                                        <span class="admin-station-verified-label">
                                          Verified
                                        </span>
                                        {
                                          station.verified_at && (
                                            <small class="admin-station-verified-date">
                                              {station.verified_at}
                                            </small>
                                          )
                                        }
                                      </div>
                                    ) : (
                                      <span class="admin-table-muted">
                                        Unverified
                                      </span>
                                    )
                                  }
                                </td>


                                <td>
                                  {
                                    station.latitude !== null &&
                                    station.longitude !== null ? (
                                      <div class="admin-station-coordinates">

                                        <div>
                                          {station.latitude}
                                        </div>

                                        <div>
                                          {station.longitude}
                                        </div>

                                      </div>
                                    ) : (
                                      <span class="admin-table-muted">
                                        —
                                      </span>
                                    )
                                  }
                                </td>

                                <td>
                                  <div class="admin-table-actions">

                                    <a
                                      href={`/admin/stations/${station.id}/platforms`}
                                      class="admin-table-action"
                                    >
                                      Platforms
                                    </a>

                                    <a
                                      href={`/admin/stations/${station.id}/edit`}
                                      class="admin-table-action admin-table-action-edit"
                                    >
                                      Edit
                                    </a>

                                    <button
                                      type="button"
                                      class="admin-table-action admin-table-action-delete js-delete-station"
                                      data-station-id={station.id}
                                      data-station-name={station.name}
                                    >
                                      Delete
                                    </button>

                                  </div>
                                </td>

                              </tr>
                            ))
                          }
                        </tbody>

                      </table>

                    </div>

                    <!-- Table Footer -->
                    <div class="admin-table-footer">

                      <span>
                        {
                          totalItems > 0
                            ? `Page ${safeCurrentPage} of ${totalPages}`
                            : "No stations found"
                        }
                      </span>

                      <Pagination
                        currentPage={safeCurrentPage}
                        totalPages={totalPages}
                        baseUrl={`${paginationUrl.pathname}${paginationUrl.search}`}
                        totalItems={totalItems}
                        perPage={perPage}
                      />

                    </div>

                  </>
                ) : (
                  <EmptyState
                    icon="◎"
                    title={searchParam
                          ? "No stations found"
                          : "No stations yet"}
                    description={searchParam
                          ? "Try a different search term."
                          : "Add your first railway station to get started."}
                  >
                    {
                      searchParam && (
                        <div class="admin-empty-action">

                          <Button
                            href="/admin/stations"
                            variant="secondary"
                            size="small"
                          >
                            Clear Search
                          </Button>

                        </div>
                      )
                    }
                  </EmptyState>
                )
              }

            </div>

          </section>

        </div>

  <Fragment slot="after">
    <!-- Delete Confirmation Dialog -->
    <ConfirmDialog
      id="delete-station-dialog"
      title="Delete Station"
      description="Are you sure you want to delete this station?"
      confirmText="Delete Station"
      cancelText="Cancel"
      variant="danger"
      warning="This action cannot be undone."
    />

    <!-- Delete Form -->
    <form
      method="POST"
      id="delete-station-form"
      hidden
    ></form>

    <script>
      import "../../../scripts/admin/stations-list.ts";
    </script>


  </Fragment>
</AdminLayout>
