---
import "../../../styles/admin/shared.css";
import "../../../styles/admin/tables.css";
import "../../../styles/admin/stations.css";

import AdminNavigation from "../../../common_components/AdminNavigation.astro";
import Button from "../../../common_components/Button.astro";
import SearchInput from "../../../common_components/SearchInput.astro";
import ConfirmDialog from "../../../common_components/ConfirmDialog.astro";
import Pagination from "../../../common_components/Pagination.astro";

import { getAdminStationsPaginated } from "../../../lib/db/stations";

export const prerender = false;

const { env } = await import("cloudflare:workers");

const db = env.DB;

/* ========================================
   Query Parameters
======================================== */

const searchParam =
  Astro.url.searchParams.get("search")?.trim() ?? "";

const pageParam =
  Astro.url.searchParams.get("page");

const parsedPage = Number(pageParam);

const currentPage =
  Number.isInteger(parsedPage) && parsedPage > 0
    ? parsedPage
    : 1;

/* ========================================
   Pagination
======================================== */

const perPage = 10;

const {
  items: stations,
  totalItems,
  currentPage: safeCurrentPage,
  totalPages,
} = await getAdminStationsPaginated(db, {
  page: currentPage,
  perPage,
  search: searchParam,
});

/* ========================================
   Pagination URL
======================================== */

const paginationUrl = new URL(
  "/admin/stations",
  Astro.url,
);

if (searchParam) {
  paginationUrl.searchParams.set(
    "search",
    searchParam,
  );
}

/* ========================================
   Admin
======================================== */

const admin = await Astro.session?.get<{
  id: number;
  email: string;
  name: string;
}>("admin");
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />

    <meta
      name="viewport"
      content="width=device-width, initial-scale=1.0"
    />

    <meta
      name="robots"
      content="noindex, nofollow"
    />

    <title>
      Stations | Admin | Tokyo Station Guide
    </title>
  </head>

  <body>
    <div class="admin-shell">

      <!-- Admin Navigation -->
      <AdminNavigation
        activePath="/admin/stations"
      />

      <!-- Main -->
      <main class="admin-main">

        <div class="admin-content">

          <!-- Page Header -->
          <div class="admin-page-header">

            <div>
              <h2>Stations</h2>

              <p>
                Manage the railway and subway stations used
                throughout the Tokyo Station Guide.
              </p>
            </div>

          </div>

          <!-- Search / Action Bar -->
          <div class="admin-list-toolbar">

            <form
              id="station-search-form"
              class="admin-search-form"
              method="GET"
              action="/admin/stations"
              role="search"
            >
              <SearchInput
                id="station-search"
                name="search"
                value={searchParam}
                placeholder="Search stations..."
                ariaLabel="Search stations"
              />
            </form>

            <Button
              href="/admin/stations/new"
              variant="primary"
            >
              + Add Station
            </Button>

          </div>

          <!-- Stations Table -->
          <section class="admin-panel">

            <div
              id="stations-table-content"
              class="admin-panel-body admin-table-panel-body"
            >

              <!-- Table Meta -->
              <div class="admin-table-meta">

                <span>
                  {totalItems} • Total Stations
                </span>

              </div>

              {
                stations.length > 0 ? (
                  <>

                    <!-- Table -->
                    <div class="admin-table-wrapper">

                      <table class="admin-table">

                        <thead>
                          <tr>
                            <th>ID</th>
                            <th>Station</th>
                            <th>Slug</th>
                            <th>Coordinates</th>
                            <th>Actions</th>
                          </tr>
                        </thead>

                        <tbody>
                          {
                            stations.map((station) => (
                              <tr>

                                <td class="admin-table-id">
                                  {station.id}
                                </td>

                                <td>
                                  <div class="admin-station-name">
                                    {station.name}
                                  </div>

                                  {
                                    station.name_japanese && (
                                      <div class="admin-station-japanese">
                                        {station.name_japanese}
                                      </div>
                                    )
                                  }
                                </td>

                                <td class="admin-table-code">
                                  <span class="admin-station-slug">
                                    {station.slug}
                                  </span>
                                </td>

                                <td>
                                  {
                                    station.latitude !== null &&
                                    station.longitude !== null ? (
                                      <div class="admin-station-coordinates">

                                        <div>
                                          {station.latitude}
                                        </div>

                                        <div>
                                          {station.longitude}
                                        </div>

                                      </div>
                                    ) : (
                                      <span class="admin-table-muted">
                                        —
                                      </span>
                                    )
                                  }
                                </td>

                                <td>
                                  <div class="admin-table-actions">

                                    <a
                                      href={`/admin/stations/${station.id}/edit`}
                                      class="admin-table-action admin-table-action-edit"
                                    >
                                      Edit
                                    </a>

                                    <button
                                      type="button"
                                      class="admin-table-action admin-table-action-delete js-delete-station"
                                      data-station-id={station.id}
                                      data-station-name={station.name}
                                    >
                                      Delete
                                    </button>

                                  </div>
                                </td>

                              </tr>
                            ))
                          }
                        </tbody>

                      </table>

                    </div>

                    <!-- Table Footer -->
                    <div class="admin-table-footer">

                      <span>
                        {
                          totalItems > 0
                            ? `Page ${safeCurrentPage} of ${totalPages}`
                            : "No stations found"
                        }
                      </span>

                      <Pagination
                        currentPage={safeCurrentPage}
                        totalPages={totalPages}
                        baseUrl={`${paginationUrl.pathname}${paginationUrl.search}`}
                        totalItems={totalItems}
                        perPage={perPage}
                      />

                    </div>

                  </>
                ) : (
                  <div class="admin-empty">

                    <div class="admin-empty-icon">
                      ◎
                    </div>

                    <h3>
                      {
                        searchParam
                          ? "No stations found"
                          : "No stations yet"
                      }
                    </h3>

                    <p>
                      {
                        searchParam
                          ? "Try a different search term."
                          : "Add your first railway station to get started."
                      }
                    </p>

                    {
                      searchParam && (
                        <div class="admin-empty-action">

                          <Button
                            href="/admin/stations"
                            variant="secondary"
                            size="small"
                          >
                            Clear Search
                          </Button>

                        </div>
                      )
                    }

                  </div>
                )
              }

            </div>

          </section>

        </div>

      </main>

    </div>

    <!-- Delete Confirmation Dialog -->
    <ConfirmDialog
      id="delete-station-dialog"
      title="Delete Station"
      description="Are you sure you want to delete this station?"
      confirmText="Delete Station"
      cancelText="Cancel"
      variant="danger"
      warning="This action cannot be undone."
    />

    <!-- Delete Form -->
    <form
      method="POST"
      id="delete-station-form"
      hidden
    ></form>

    <script>
      import { initializeAutoSearch } from "../../../scripts/auto-search";

      /* ========================================
         Delete Confirmation
      ======================================== */

      const deleteDialog =
        document.getElementById(
          "delete-station-dialog",
        );

      const deleteForm =
        document.getElementById(
          "delete-station-form",
        );

      let selectedStationId:
        string | null = null;

      const initializeDeleteButtons = () => {
        if (
          !(deleteDialog instanceof HTMLDivElement) ||
          !(deleteForm instanceof HTMLFormElement)
        ) {
          return;
        }

        const deleteButtons =
          document.querySelectorAll(
            ".js-delete-station",
          );

        deleteButtons.forEach(
          (button) => {
            if (
              !(button instanceof HTMLButtonElement)
            ) {
              return;
            }

            if (
              button.dataset
                .deleteInitialized === "true"
            ) {
              return;
            }

            button.dataset.deleteInitialized =
              "true";

            button.addEventListener(
              "click",
              () => {
                const stationId =
                  button.dataset.stationId;

                const stationName =
                  button.dataset.stationName;

                if (
                  !stationId ||
                  !stationName
                ) {
                  return;
                }

                selectedStationId =
                  stationId;

                const nameElement =
                  deleteDialog.querySelector(
                    ".common-dialog-name",
                  );

                if (
                  nameElement instanceof HTMLElement
                ) {
                  nameElement.textContent =
                    stationName;
                }

                deleteDialog.dispatchEvent(
                  new CustomEvent(
                    "dialog:open",
                  ),
                );
              },
            );
          },
        );
      };

      if (
        deleteDialog instanceof HTMLDivElement &&
        deleteForm instanceof HTMLFormElement
      ) {
        deleteDialog.addEventListener(
          "confirm",
          () => {
            if (!selectedStationId) {
              return;
            }

            deleteForm.action =
              `/admin/stations/${selectedStationId}/delete`;

            deleteForm.submit();

            selectedStationId = null;
          },
        );
      }

      initializeDeleteButtons();

      /* ========================================
         Auto Search
      ======================================== */

      initializeAutoSearch({
        inputId: "station-search",
        formId: "station-search-form",
        contentId: "stations-table-content",
        debounceMs: 350,
        onContentUpdated:
          initializeDeleteButtons,
      });
    </script>

  </body>
</html>