---
import { iconBucket } from "../../../../lib/storage/facility-icons";
import AdminLayout from "../../../../layouts/AdminLayout.astro";
import "../../../../styles/admin/forms.css";
import "../../../../styles/admin/operators.css";

import EmptyState from "../../../../components/common/EmptyState.astro";
import Alert from "../../../../components/common/Alert.astro";
import Breadcrumbs from "../../../../components/common/Breadcrumbs.astro";
import Button from "../../../../components/common/Button.astro";
import FacilityIconField from "../../../../components/admin/FacilityIconField.astro";
import ConfirmDialog from "../../../../components/common/ConfirmDialog.astro";

import { getFacilityById } from "../../../../lib/db/facilities";
import { handleFacilityUpdate } from "../../../../lib/services/facilities";

export const prerender = false;

const { env } = await import("cloudflare:workers");
const db = env.DB;

const id = Number(Astro.params.id);

if (!Number.isInteger(id) || id <= 0) {
  return Astro.redirect("/admin/facilities");
}

const facility = await getFacilityById(db, id);

if (!facility) {
  Astro.response.status = 404;
}

const form = await handleFacilityUpdate(
  Astro.request,
  db,
  id,
  facility,
  iconBucket(env),
);

if (form.redirectTo) {
  return Astro.redirect(form.redirectTo);
}

const { name, slug, icon, sortOrder } = form.values;
const { errors, formError } = form;

const admin = await Astro.session?.get<{
  id: number;
  email: string;
  name: string;
}>("admin");
---

<AdminLayout title="Edit Facility" activePath="/admin/facilities">
  <!-- Topbar -->
  <header class="admin-topbar">
    <Breadcrumbs
      backHref="/admin/facilities"
      parentLabel="Facilities"
      current="Edit Facility"
    />

    <div class="admin-user">
      <div class="admin-avatar">
        {
          admin?.name
            ? admin.name
                .split(" ")
                .map((part) => part.charAt(0))
                .join("")
                .slice(0, 2)
                .toUpperCase()
            : "AD"
        }
      </div>

      <div class="admin-user-info">
        <strong>{admin?.name ?? "Administrator"}</strong>
        <span>Tokyo Station Guide</span>
      </div>
    </div>
  </header>

  <!-- Content -->
  <div class="admin-content">
    {
      facility ? (
        <>
          <!-- Page Header -->
          <div class="admin-page-header">
            <div>
              <h2>Edit Facility</h2>

              <p>
                Update facility information used throughout the Tokyo
                Station Guide.
              </p>
            </div>
          </div>

          <!-- Form Panel -->
          <section class="admin-panel">
            <div class="admin-panel-body">
              <div class="admin-operator-form">
                <!-- Form Header -->
                <div class="admin-operator-form-header">
                  <h2>Facility Details</h2>

                  <p>Update the information for this station facility.</p>
                </div>

                <!-- General Error -->
                {formError && <Alert>{formError}</Alert>}

                <!-- Facility Form -->
                <form
                  method="POST"
                  enctype="multipart/form-data"
                  class="admin-form"
                  id="edit-facility-form"
                >
                  <!-- Name -->
                  <div class="admin-form-group">
                    <label for="name">Name</label>

                    <input
                      id="name"
                      name="name"
                      type="text"
                      required
                      maxlength="150"
                      value={name}
                      aria-invalid={errors.name ? "true" : "false"}
                      aria-describedby={errors.name ? "name-error" : undefined}
                    />

                    {errors.name && (
                      <small id="name-error" class="admin-form-error">
                        {errors.name}
                      </small>
                    )}
                  </div>

                  <!-- Slug -->
                  <div class="admin-form-group">
                    <label for="slug">Slug</label>

                    <input
                      id="slug"
                      name="slug"
                      type="text"
                      required
                      maxlength="150"
                      value={slug}
                      aria-invalid={errors.slug ? "true" : "false"}
                      aria-describedby={errors.slug ? "slug-error" : undefined}
                    />

                    {errors.slug ? (
                      <small id="slug-error" class="admin-form-error">
                        {errors.slug}
                      </small>
                    ) : (
                      <small>
                        Use lowercase letters, numbers and hyphens.
                      </small>
                    )}
                  </div>

                  <!-- Icon -->
                  <FacilityIconField
                    value={icon}
                    saved={facility?.icon}
                    savedDark={facility?.icon_dark}
                    textError={errors.icon}
                    fileError={errors.iconFile}
                    darkFileError={errors.iconDarkFile}
                  />

                  <!-- Sort Order -->
                  <div class="admin-form-group">
                    <label for="sort_order">Sort Order</label>

                    <input
                      id="sort_order"
                      name="sort_order"
                      type="number"
                      required
                      min="0"
                      step="1"
                      value={sortOrder}
                      aria-invalid={errors.sortOrder ? "true" : "false"}
                      aria-describedby={
                        errors.sortOrder ? "sort-order-error" : undefined
                      }
                    />

                    {errors.sortOrder ? (
                      <small id="sort-order-error" class="admin-form-error">
                        {errors.sortOrder}
                      </small>
                    ) : (
                      <small>
                        Lower numbers appear first. Use 0 for the highest
                        priority.
                      </small>
                    )}
                  </div>

                  <!-- Actions -->
                  <div class="admin-form-actions">
                    <Button href="/admin/facilities" variant="secondary">
                      Cancel
                    </Button>

                    <Button
                      type="submit"
                      variant="primary"
                      id="save-facility-button"
                    >
                      Save Changes
                    </Button>
                  </div>
                </form>
              </div>
            </div>
          </section>
        </>
      ) : (
        <>
          <!-- Not Found Header -->
          <div class="admin-page-header">
            <div>
              <h2>Edit Facility</h2>
              <p>The requested facility could not be found.</p>
            </div>

            <Button href="/admin/facilities" variant="secondary">
              ← Back to Facilities
            </Button>
          </div>

          <!-- Not Found Panel -->
          <section class="admin-panel">
            <div class="admin-panel-body">
              <EmptyState
                icon="⚠"
                title="Facility Not Found"
                description="The requested facility does not exist or may have been removed."
              >
                <div class="admin-form-actions admin-not-found-actions">
                  <Button href="/admin/facilities" variant="secondary">
                    Back to Facilities
                  </Button>
                </div>
              </EmptyState>
            </div>
          </section>
        </>
      )
    }
  </div>

  <Fragment slot="after">
    {
      facility && (
        <ConfirmDialog
          id="save-facility-dialog"
          title="Save Changes"
          description="Are you sure you want to save these changes to this facility?"
          confirmText="Save Changes"
          cancelText="Cancel"
          variant="primary"
        />
      )
    }

    <script>
      import "../../../../scripts/admin/facilities-edit.ts";
    </script>
  </Fragment>
</AdminLayout>
