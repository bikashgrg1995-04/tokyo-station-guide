---
import "../../styles/global.css";
import "../../styles/header.css";
import "../../styles/home.css";
import "../../styles/station.css";
import "../../styles/gallery.css";
import "../../styles/footer.css";
import "../../styles/responsive.css";

import { getStationBySlug } from "../../lib/db/stations";

export const prerender = false;

const { env } = await import("cloudflare:workers");
const db = env.DB;

const { slug } = Astro.params;

const station = slug ? await getStationBySlug(db, slug) : null;

if (!station) {
  Astro.response.status = 404;
}

const pageTitle = station
  ? `${station.name} Station Guide | Tokyo Station Guide`
  : "Station Not Found | Tokyo Station Guide";

const pageDescription = station
  ? station.description ??
    `Complete guide to ${station.name} Station in Tokyo.`
  : "The requested station could not be found.";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />

    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    <meta name="robots" content="index, follow" />
  </head>

  <body>
    <header class="site-header">
      <div class="container header-inner">
        <a href="/" class="logo" aria-label="Tokyo Station Guide home">
          <span class="logo-mark">T</span>
          <span>Tokyo Station Guide</span>
        </a>

        <nav class="main-nav" aria-label="Main navigation">
          <a href="/">Home</a>
          <a href="/#stations">Stations</a>
          <a href="/#explore">Explore Tokyo</a>
        </nav>
      </div>
    </header>

    <main>
      {
        station ? (
          <>
            <!-- Station Introduction -->
            <section class="station-hero">
              <div class="container">
                <p class="eyebrow">STATION GUIDE</p>

                <h1>{station.name}</h1>

                {station.name_japanese && (
                  <p class="station-location">
                    {station.name_japanese}
                  </p>
                )}

                {station.description && (
                  <p class="hero-description">
                    {station.description}
                  </p>
                )}
              </div>
            </section>

            <!-- Train Lines -->
            <section class="section">
              <div class="container">
                <div class="section-heading">
                  <div>
                    <p class="eyebrow">TRANSPORT</p>
                    <h2>Train Lines</h2>
                  </div>
                </div>

                {station.lines.length > 0 ? (
                  <div class="feature-grid">
                    {station.lines.map((line) => (
                      <article class="feature-card">
                        <div class="feature-icon" aria-hidden="true">
                          🚆
                        </div>

                        <h3>{line.name}</h3>

                        {line.code && <p>Line code: {line.code}</p>}

                        <p>
                          Operated by {line.operator_name}.
                        </p>
                      </article>
                    ))}
                  </div>
                ) : (
                  <p>
                    No train lines have been assigned to this station yet.
                  </p>
                )}
              </div>
            </section>

            <!-- Station Information -->
            <section class="section section-light">
              <div class="container">
                <div class="section-heading">
                  <div>
                    <p class="eyebrow">STATION INFORMATION</p>
                    <h2>Station Details</h2>
                  </div>
                </div>

                <div class="place-grid">
                  <article class="place-card">
                    <h3>Station Name</h3>
                    <p>{station.name}</p>
                  </article>

                  {station.name_japanese && (
                    <article class="place-card">
                      <h3>Japanese Name</h3>
                      <p>{station.name_japanese}</p>
                    </article>
                  )}

                  {station.latitude !== null &&
                    station.longitude !== null && (
                      <article class="place-card">
                        <h3>Coordinates</h3>
                        <p>
                          {station.latitude}, {station.longitude}
                        </p>
                      </article>
                    )}
                </div>
              </div>
            </section>

            <!-- Station Exits -->
            <section class="station-section">
              <div class="container">
                <div class="section-heading">
                  <div>
                    <p class="section-label">Station information</p>
                    <h2>Station Exits</h2>
                  </div>
                </div>

                <p>
                  Exit information will be available here once station exits
                  are added through the admin panel.
                </p>
              </div>
            </section>

            <!-- Nearby Attractions -->
            <section class="station-section">
              <div class="container">
                <div class="section-heading">
                  <div>
                    <p class="section-label">Things to do</p>
                    <h2>Nearby Attractions</h2>
                  </div>
                </div>

                <p>
                  Nearby attractions will be displayed here once station
                  content is added.
                </p>
              </div>
            </section>

            <!-- Restaurants -->
            <section class="station-section">
              <div class="container">
                <div class="section-heading">
                  <div>
                    <p class="section-label">Food</p>
                    <h2>Nearby Restaurants & Food Areas</h2>
                  </div>
                </div>

                <p>
                  Restaurant information will be displayed here once station
                  content is added.
                </p>
              </div>
            </section>

            <!-- Hotels -->
            <section class="station-section">
              <div class="container">
                <div class="section-heading">
                  <div>
                    <p class="section-label">Stay nearby</p>
                    <h2>Nearby Hotels</h2>
                  </div>
                </div>

                <p>
                  Hotel information will be displayed here once station
                  content is added.
                </p>
              </div>
            </section>

            <!-- FAQ -->
            <section class="station-section">
              <div class="container">
                <div class="section-heading">
                  <div>
                    <p class="section-label">Common questions</p>
                    <h2>Frequently Asked Questions</h2>
                  </div>
                </div>

                <p>
                  Frequently asked questions will be added through the admin
                  panel.
                </p>
              </div>
            </section>

            <!-- Explore Nearby -->
            <section class="about-section">
              <div class="container about-content">
                <p class="eyebrow">EXPLORE NEARBY</p>

                <h2>Places near {station.name}</h2>

                <p>
                  Nearby attractions, restaurants, hotels, shopping areas,
                  and other useful places will be displayed here.
                </p>
              </div>
            </section>
          </>
        ) : (
          <section class="station-hero">
            <div class="container">
              <p class="eyebrow">STATION GUIDE</p>

              <h1>Station Not Found</h1>

              <p class="hero-description">
                The station you are looking for does not exist.
              </p>

              <a href="/stations">Back to Stations</a>
            </div>
          </section>
        )
      }
    </main>

    <footer class="site-footer">
      <div class="container footer-inner">
        <p>© 2026 Tokyo Station Guide</p>

        <div class="footer-links">
          <a href="/">Home</a>
          <a href="/#stations">Stations</a>
        </div>
      </div>
    </footer>
  </body>
</html>
