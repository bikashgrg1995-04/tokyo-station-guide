---
import "../styles/admin/shared.css";

import BaseLayout from "./BaseLayout.astro";
import AdminNavigation from "../components/AdminNavigation.astro";
import { SITE_NAME } from "../config/site";

export interface Props {
  title: string;
  activePath?: string;
}

const { title, activePath = "/admin" } = Astro.props;
---

<BaseLayout title={`${title} | Admin | ${SITE_NAME}`} robots="noindex, nofollow">
  <div class="admin-shell">
    <AdminNavigation activePath={activePath} />

    <main class="admin-main">
      <slot />
    </main>
  </div>

  <!-- Dialogs and page scripts that live outside the admin shell -->
  <slot name="after" />
</BaseLayout>
