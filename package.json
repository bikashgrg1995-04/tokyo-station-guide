{
  "name": "tokyo-station-guide",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "check": "astro check",
    "types": "wrangler types",
    "db:migrate:local": "wrangler d1 migrations apply tokyo-station-guide-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply tokyo-station-guide-db --remote",
    "db:seed:local": "wrangler d1 execute tokyo-station-guide-db --local --file=db/seed/seed-core.sql && wrangler d1 execute tokyo-station-guide-db --local --file=db/seed/seed-details.sql && wrangler d1 execute tokyo-station-guide-db --local --file=db/seed/seed-featured.sql",
    "db:reset:local": "wrangler d1 execute tokyo-station-guide-db --local --file=db/seed/reset.sql",
    "admin:hash": "node scripts/create-admin-hash.mjs"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.3.3",
    "astro": "^7.3.5"
  },
  "allowScripts": {
    "esbuild": true
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@cloudflare/workers-types": "^5.20261003.1",
    "typescript": "^6.0.3"
  }
}
